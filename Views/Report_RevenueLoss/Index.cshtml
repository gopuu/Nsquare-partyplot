@{
    ViewData["Title"] = "Report RevenueLoss";
    Layout = "_Layout";
}

<div class="content">
    <div class="pb-1">
        <div class="row g-2">
            <!-- From Date -->
            <div class="col-md-2">
                <label class="form-label fw-semibold">From Date</label>
                <input type="date" id="from-date" class="form-control">
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold">To Date</label>
                <input type="date" id="to-date" class="form-control">
            </div>
            <!-- Dropdown 1 -->
            <div class="col-md-2">
                <label class="form-label fw-semibold">Event Type</label>
                <select id="ddlEventType" class="form-select">
                    <option value="">-- Select Event Type --</option>
                </select>

            </div>
            <!-- Dropdown 2 -->
            <div class="col-md-2">
                <label class="form-label fw-semibold">Event Sub-type</label>
                <select id="ddlEventSubType" class="form-select" disabled>
                    <option value="">-- Select Event Sub Type --</option>
                </select>
            </div>
            <div class="col mt-5">
                <button class="btn btn-danger"
                        onclick="DownloadRevenueLossReport(event)">
                    <i class="fas fa-download"></i>
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/assets2/js/report_revenueloss/report_revenueloss.js" asp-append-version="true"></script>

}

