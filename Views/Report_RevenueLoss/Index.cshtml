@{
    ViewData["Title"] = "Report RevenueLoss";
    Layout = "_Layout";
}

<div class="content">
    <div class="pb-1">
        <div class="card shadow-sm">

            <!-- ================= CARD HEADER ================= -->
            <div class="card-header">
                <div class="d-flex align-items-center gap-2 flex-wrap">

                    <!-- TITLE -->
                    <h4 class="mb-0 fw-semibold me-auto">
                        Revenue Loss Report
                    </h4>

                    <!-- FROM DATE -->
                    <input type="date" id="from-date" class="form-control w-auto">

                    <!-- TO DATE -->
                    <input type="date" id="to-date" class="form-control w-auto">

                    <!-- FILTER DROPDOWN -->
                    <div class="dropdown">
                        <button class="btn btn-outline-secondary fw-bold dropdown-toggle"
                                type="button" data-bs-toggle="dropdown">
                            Filter : This Month
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item">Yesterday</a></li>
                            <li><a class="dropdown-item">Last 7 Days</a></li>
                            <li><a class="dropdown-item">Last 30 Days</a></li>
                            <li><a class="dropdown-item active">This Month</a></li>
                            <li><a class="dropdown-item">Last Month</a></li>
                            <li><a class="dropdown-item">Last 12 Months</a></li>
                            <li><a class="dropdown-item">Custom Range</a></li>
                        </ul>
                    </div>

                    <!-- EVENT TYPE -->
                    <select id="ddlEventType" class="form-select w-auto">
                        <option>-- Event Type --</option>
                    </select>

                    <!-- EVENT SUB TYPE -->
                    <select id="ddlEventSubType" class="form-select w-auto">
                        <option>-- Event Sub Type --</option>
                    </select>

                    <!-- DOWNLOAD -->
                    <button class="btn btn-outline-warning"
                            onclick="ViewRevenueLossReport('downloadPDF')">
                        <i class="fas fa-file-pdf"></i>
                    </button>

                    <button class="btn btn-outline-warning"
                            onclick="ViewRevenueLossReport('downloadExcel')">
                        <i class="fas fa-file-excel"></i>
                    </button>
                </div>
            </div>


            <!-- ================= CARD BODY ================= -->
            <div class="card-body pt-2">
                <div id="pdfPreviewContainer"
                     style="border: 1px solid #ddd;
                            padding: 10px;
                            width: 100%;
                            min-height: 600px;
                            height: calc(100vh - 180px);
                            overflow: auto;">
                    <p class="text-center text-muted">
                        PDF Preview will appear here...
                    </p>
                </div>
            </div>

        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>


@section Scripts {
    <script src="~/assets2/js/report_revenueloss/report_revenueloss.js" asp-append-version="true"></script>

}



