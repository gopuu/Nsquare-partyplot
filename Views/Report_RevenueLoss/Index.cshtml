@{
    ViewData["Title"] = "Report RevenueLoss";
    Layout = "_Layout";
}

<div class="content">
    <div class="pb-1">
        <div class="card shadow-sm">

            <!-- ================= CARD HEADER ================= -->
            <div class="card-header">
                <div class="row align-items-end">

                    <!-- LEFT : TITLE -->
                    <div class="col-md-3">
                        <h3 class="mb-0 fw-semibold">
                            Revenue Loss Report
                        </h3>
                    </div>
                    <!-- RIGHT : FILTERS + DOWNLOAD -->
                    <div class="col-md-9">
                        <div class="row g-2 justify-content-end align-items-end">

                            <!-- From Date -->
                            <div class="col-md-2">
                               
                                <input type="date" id="from-date" class="form-control">
                            </div>

                            <!-- To Date -->
                            <div class="col-md-2">
                               
                                <input type="date" id="to-date" class="form-control">
                            </div>

                            <!-- Event Type -->
                            <div class="col-md-3">
                               
                                <select id="ddlEventType" class="form-select">
                                    <option value="">-- Select Event Type --</option>
                                </select>
                            </div>

                            <!-- Event Sub-type -->
                            <div class="col-md-3">
                               
                                <select id="ddlEventSubType" class="form-select" disabled>
                                    <option value="">-- Select Event Sub Type --</option>
                                </select>
                            </div>

                            <!-- Download Button -->
                            <div class="col-md-auto">
                                <button class="btn btn-danger"
                                        onclick="ViewRevenueLossReport('downloadPDF')">
                                    <i class="fas fa-download"></i>
                                </button>
                            </div>

                        </div>
                    </div>

                </div>
            </div>

            <!-- ================= CARD BODY ================= -->
            <div class="card-body pt-2">
                <div id="pdfPreviewContainer"
                     style="border: 1px solid #ddd;
                            padding: 10px;
                            width: 100%;
                            min-height: 600px;
                            height: calc(100vh - 180px);
                            overflow: auto;">
                    <p class="text-center text-muted">
                        PDF Preview will appear here...
                    </p>
                </div>
            </div>

        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>


@section Scripts {
    <script src="~/assets2/js/report_revenueloss/report_revenueloss.js" asp-append-version="true"></script>

}



