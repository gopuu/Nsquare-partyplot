@{
    ViewData["Title"] = "Report Modification";
    Layout = "_Layout";
}

<style>
    .report-container {
        height: calc(100vh - 120px);
        display: flex;
        justify-content: center;
        align-items: center;
    }
</style>

<div class="report-container">
    <button class="btn btn-lg btn-primary" onclick="DownloadModificationReport()">
        <i class="fas fa-file-pdf me-2"></i> Download Report
    </button>
</div>

@section Scripts {
    <script src="~/assets2/js/report_modification/report_modification.js" asp-append-version="true"></script>


}
