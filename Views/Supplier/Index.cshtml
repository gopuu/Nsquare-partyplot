@{
    ViewData["Title"] = "Supplier Master";
    Layout = "_Layout";
}
<link href="/assets2/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<script src="/assets2/js/jquery.dataTables.min.js"></script>
<script src="/assets2/js/dataTables.bootstrap5.min.js"></script>
@section Styles {
    <link href="~/assets2/css/customdatatable/customdatatable.css" asp-append-version="true" rel="stylesheet" />
    <link href="~/assets2/css/Supplier/Supplier.css" rel="stylesheet" asp-append-version="true" />
}
@section Scripts {
    <script src="~/assets2/js/Supplier/Supplier.js" asp-append-version="true"></script>
}

<!-- MAIN -->
<div class="content">
    <div class="pb-1">
        <div class="row g-2">
            <div class="col-12 col-xxl-12">
                <div class="mb-12">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="mb-0 text-warning">Supplier Master</h4>
                        <button class="btn btn-outline-warning" id="btn-add">
                            <i class="fa fa-plus-circle"></i> Add Supplier
                        </button>
                    </div>

                    <div id="tableMain">
                        <table class="table table-striped table-bordered" style="width:100%"></table>
                    </div>

                </div>
            </div>
        </div>
    </div>

</div>

<!-- Add/Edit Modal -->
<div class="modal fade" id="addEventModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <!-- HEADER -->
            <div class="modal-header bg-warning text-white py-1">
                <h5 class="modal-title text-white" id="addEventModalTitle">Add Supplier</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="supplierId" value="0">

                <!-- ================= TAB NAVIGATION ================= -->
                <ul class="nav nav-tabs" id="supTabs" role="tablist">
                    <li class="nav-item">
                        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tabBasicInfo">Basic Info</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabAddress">Address</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabOtherDetails">Other Details</button>
                    </li>
                </ul>

                <!-- ================= TAB CONTENT ================= -->
                <div class="tab-content mt-3">

                    <!-- ============= TAB 1 : BASIC INFO ============= -->
                    <div class="tab-pane fade show active" id="tabBasicInfo">
                        <div class="row g-3">

                            <div class="col-md-12">
                                <label class="form-label">Name  <span class="text-danger">*</span></label>
                                <input type="text" id="supName" class="form-control"
                                       placeholder="Enter name" maxlength="100">
                            </div>

                            <div class="col-md-12">
                                <label class="form-label">Company Name <span class="text-danger">*</span></label>
                                <input type="text" id="supCompany" class="form-control"
                                       placeholder="Enter company name" maxlength="150">
                            </div>

                            <div class="col-md-12">
                                <label class="form-label">Email</label>

                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fa fa-envelope"></i>
                                    </span>
                                    <input type="email" id="supEmail" class="form-control"
                                           placeholder="Enter email" maxlength="100">
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Phone <span class="text-danger">*</span></label>

                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fa fa-phone"></i>
                                    </span>
                                    <input type="text" id="supPhone" class="form-control"
                                           placeholder="Enter phone no" maxlength="10">
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">GST No.</label>

                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fa fa-id-card"></i>
                                    </span>
                                    <input type="text" id="supGST" class="form-control"
                                           placeholder="Enter GST No." maxlength="15">
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ============= TAB 2 : ADDRESS ============= -->
                    <div class="tab-pane fade" id="tabAddress">
                        <div class="row g-3">

                            <div class="col-md-12">
                                <label class="form-label">Register Address</label>
                                <textarea id="supRegAddress" class="form-control" rows="4" placeholder="Enter register address"></textarea>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">State</label>
                                <select id="supRegStateId" class="form-select"></select>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">City</label>
                                <select id="supRegCity" class="form-select"></select>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Pincode</label>
                                <input type="text" id="supRegPincode" class="form-control" placeholder="Enter pincode" maxlength="6">
                            </div>

                            <div class="col-md-12">
                                <label class="form-label">Shipping Address</label>
                                <textarea id="supShipAddress" class="form-control" rows="4" placeholder="Enter shipping address"></textarea>
                            </div>

                        </div>
                    </div>

                    <!-- ============= TAB 3 : OTHER DETAILS ============= -->
                    <div class="tab-pane fade" id="tabOtherDetails">
                        <div class="row g-3">
                            <!--FSSAI-->
                            <div class="col-md-4">
                                <label class="form-label">
                                    FSSAI Lic No
                                    <i class="fa fa-info-circle text-primary"
                                       title="Food Safety and Standards Authority of India"></i>
                                </label>
                                <input type="text" id="supFSSAI" class="form-control"
                                       placeholder="Enter FSSAI No." maxlength="14">
                            </div>

                            <!--PAN-->
                            <div class="col-md-4">
                                <label class="form-label">
                                    PAN
                                    <i class="fa fa-info-circle text-primary" title="Permanent Account Number"></i>
                                </label>
                                <input type="text" id="supPAN" class="form-control"
                                       placeholder="Enter PAN" maxlength="10">
                            </div>

                            <!--MSME-->
                            <div class="col-md-4">
                                <label class="form-label">
                                    MSME
                                    <i class="fa fa-info-circle text-primary" title="Micro, Small & Medium Enterprises"></i>
                                </label>
                                <input type="text" id="supMSME" class="form-control"
                                       placeholder="Enter MSME" maxlength="20">
                            </div>

                            <!--TAN-->
                            <div class="col-md-4">
                                <label class="form-label">
                                    TAN
                                    <i class="fa fa-info-circle text-primary" title="Tax Deduction and Collection Account Number"></i>
                                </label>
                                <input type="text" id="supTAN" class="form-control"
                                       placeholder="Enter TAN" maxlength="10">
                            </div>

                            <!--CIN-->
                            <div class="col-md-4">
                                <label class="form-label">
                                    CIN
                                    <i class="fa fa-info-circle text-primary" title="Corporate Identification Number"></i>
                                </label>
                                <input type="text" id="supCIN" class="form-control"
                                       placeholder="Enter CIN" maxlength="21">
                            </div>

                            <!--TCS-->
                            <div class="col-md-4">
                                <label class="form-label">
                                    TCS (%)
                                    <i class="fa fa-info-circle text-primary" title="Tax Collected At Source"></i>
                                </label>

                                <div class="input-group">
                                    <input type="number" id="supTCS" class="form-control"
                                           placeholder="Enter TCS" min="0" max="100">
                                    <span class="input-group-text">%</span>
                                </div>
                            </div>

                            <!--SUPPLIER TYPE-->
                            <div class="col-md-12">
                                <label class="form-label">
                                    Supplier Type
                                </label>
                                <div class="d-flex gap-4 mt-1">

                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="supType" value="1" id="supTypeBoth">
                                        <label class="form-check-label" for="supTypeBoth">Both</label>
                                    </div>

                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="supType" value="2" id="supTypePurchase">
                                        <label class="form-check-label" for="supTypePurchase">Purchase</label>
                                    </div>

                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="supType" value="3" id="supTypeSale">
                                        <label class="form-check-label" for="supTypeSale">Sale</label>
                                    </div>

                                </div>

                            </div>

                            <!-- FILE UPLOAD -->
                            <div class="col-md-12">
                                <label class="form-label">Upload Document (jpg, png, jpeg, pdf) – Max 2MB</label>

                                <div class="input-group">
                                    <!-- File Upload -->
                                    <input type="file" id="supFile" class="form-control"
                                           accept=".jpg,.jpeg,.png,.pdf">

                                    <!-- Hidden input to store file URL -->
                                    <input type="hidden" id="supDocumentLink" value="">

                                    <!-- Download Button (hidden initially) -->
                                    <button id="btnDownloadSupDoc"
                                            type="button"
                                            class="btn btn-outline-primary btn-sm d-none">
                                        <i class="fa fa-download"></i>
                                    </button>
                                </div>
                            </div>

                            <!--IS ACTIVE-->
                            <div class="col-md-4">
                                <label class="form-label d-block d-none">Is Active</label>
                                <div class="form-check form-switch mt-2">
                                    <input type="checkbox" class="form-check-input" id="supIsActive" checked>
                                    <label class="form-check-label">Is Active ?</label>
                                </div>
                            </div>

                        </div>
                    </div>

                </div>
            </div>

            <!-- FOOTER WITH NEXT & PREV -->
            <div class="modal-footer d-flex justify-content-between align-items-center">

                <!-- LEFT SIDE -->
                <div>
                    <button class="btn btn-outline-secondary" id="btnPrev">
                        <i class="fa fa-arrow-left me-1"></i> Previous
                    </button>
                </div>

                <!-- RIGHT SIDE -->
                <div>
                    <button class="btn btn-outline-secondary" id="btnNext">
                        Next <i class="fa fa-arrow-right ms-1"></i>
                    </button>

                    <button class="btn btn-outline-warning" id="btnSave">
                        <i class="fa fa-save me-1"></i> Save
                    </button>
                </div>

            </div>

        </div>
    </div>
</div>

<!-- DELETE MODAL -->
<div class="modal fade zoomIn" id="deleteRecordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title text-white" id="deleteRecordModalLabel">Delete Confirmation</h5> <!-- Added Title -->
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" id="btn-close"></button>
            </div>
            <div class="modal-body">
                <div class="mt-2 text-center">
                    <lord-icon src="/assets2/js/gsqxdxog.json" trigger="loop" colors="primary:#f7b84b,secondary:#f06548" style="width:100px;height:100px"></lord-icon>
                    <div class="mt-4 pt-2 fs-15 mx-4 mx-sm-5">
                        <h4>Are you Sure ?</h4>
                        <p class="text-muted mx-4 mb-0">Delete this record?</p>
                    </div>
                </div>
                <div class="d-flex gap-2 justify-content-center mt-4 mb-2">
                    <button type="button" class="btn w-sm btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn w-sm btn-outline-danger" id="delete-record">Yes, Delete It!</button>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- END MODAL -->
