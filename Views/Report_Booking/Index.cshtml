@{
    ViewData["Title"] = "Report Booking";
    Layout = "_Layout";
}

<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>

<div class="content p-1 pt-11">
    <div class="pb-1">
        <div class="card shadow-sm">

            <!-- ================= CARD HEADER ================= -->
            <div class="card-header bg-warning p-1">
                <div class="row align-items-center">

                    <!-- LEFT : REPORT TITLE -->
                    <div class="col-md-3">
                        <h4 class="mb-0 fw-semibold text-white">Booking Report</h4>
                    </div>

                    <!-- RIGHT : FILTER + DOWNLOAD -->
                    <div class="col-md-9">
                        <div class="row g-2 align-items-center justify-content-end flex-nowrap">
                            <!--WIth Header-->
                            <div class="col-auto d-flex align-items-center gap-2">
                                <div class="form-check form-switch mb-0">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           id="toggleWithHeader">
                                    <label class="form-check-label fw-semibold text-white"
                                           for="toggleWithHeader">
                                        With Header
                                    </label>
                                </div>
                            </div>

                            <!-- DOWNLOAD DROPDOWN (ONLY ONE) -->
                            <div class="col-auto">
                                <div class="dropdown">
                                    <button class="btn btn-outline-light btn-sm dropdown-toggle"
                                            type="button"
                                            data-bs-toggle="dropdown">
                                        <i class="fas fa-download"></i>
                                    </button>

                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li>
                                            <a class="dropdown-item"
                                               href="javascript:void(0)"
                                               onclick="ViewBookingReport('downloadPDF')">
                                                <i class="fas fa-file-pdf text-danger me-2"></i> PDF
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item"
                                               href="javascript:void(0)"
                                               onclick="ViewBookingReport('downloadExcel')">
                                                <i class="fas fa-file-excel text-success me-2"></i> Excel
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </div>

                        </div>
                    </div>

                </div>
            </div>

            <!-- ================= CARD BODY ================= -->
            <div class="card-body p-0">
                <div class="report-layout">

                    <!-- PDF VIEWER -->
                    <div class="pdf-area">
                        <div id="pdfPreviewContainer">
                            <p class="text-center text-muted">
                                PDF Preview will appear here...
                            </p>
                        </div>
                    </div>

                    <!-- FILTER PANEL (FIXED RIGHT) -->
                    <div class="filter-area">
                        <div id="filterPanel" class="filter-panel-static">
                            <div class="filter-header">
                                <span class="text-warning">Filters</span>
                            </div>

                            <div class="filter-body">

                                <div class="mb-2">
                                    <label class="form-label">Event Type</label>
                                    <select id="ddlEventType" class="form-select form-select-sm">
                                        <option value="">All</option>
                                    </select>
                                </div>

                                <div class="mb-2">
                                    <label class="form-label">Event Sub Type</label>
                                    <select id="ddlEventSubType" class="form-select form-select-sm">
                                        <option value="">All</option>
                                    </select>
                                </div>

                                <div class="mb-2">
                                    <label class="form-label">Hall</label>
                                    <select id="ddlCompanyHall" class="form-select form-select-sm">
                                        <option value="">All</option>
                                    </select>
                                </div>

                                <div class="mb-2">
                                    <label class="form-label">From Date</label>
                                    <input type="date" id="fromDate" class="form-control form-control-sm">
                                </div>

                                <div class="mb-2">
                                    <label class="form-label">To Date</label>
                                    <input type="date" id="toDate" class="form-control form-control-sm">
                                </div>

                            </div>

                            <div class="filter-footer">
                                <button id="btnResetFilter" class="btn btn-sm btn-outline-secondary">Reset</button>
                                <button id="btnApplyFilter" class="btn btn-sm btn-warning">Apply</button>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="~/assets2/js/report_booking/report_booking.js" asp-append-version="true"></script>
}

@section Styles {
    <link href="~/assets2/css/report_booking/report_booking.css" rel="stylesheet" asp-append-version="true" />
}