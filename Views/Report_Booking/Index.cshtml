@{
    ViewData["Title"] = "Report Booking";
    Layout = "_Layout";
}

<div class="content">
    <div class="pb-1">
        <div class="row g-2">
            <!-- Dropdown 1 -->
            <div class="col-md-2">
                <label class="form-label fw-semibold">Event Type</label>
                <select id="ddlEventType" class="form-select">
                    <option value="">-- Select Event Type --</option>
                </select>

            </div>

            <!-- Dropdown 2 -->
            <div class="col-md-2">
                <label class="form-label fw-semibold">Event Sub-type</label>
                <select id="ddlEventSubType" class="form-select" disabled>
                    <option value="">-- Select Event Sub Type --</option>
                </select>
            </div>

            <!-- Dropdown 3 -->
            <div class="col-md-2">
                <label class="form-label fw-semibold">
                    Hall Name
                </label>
                <select id="ddlCompanyHall" class="form-select">
                    <option value="">-- Select Hall --</option>
                </select>

            </div>

            <!-- From Date -->
            <div class="col-md-2">
                <label class="form-label fw-semibold">Event Date</label>
                <input type="date" id="event-date" class="form-control">
            </div>

            <div class="col mt-5">
                <button type="button"
                        class="btn btn-danger"
                        onclick="ViewBookingReport('downloadPDF')">
                    <i class="fas fa-download"></i>
                </button>
            </div>

            <div class="card-body pt-0">
                <!-- PDF Preview Container -->
                <div id="pdfPreviewContainer" style="border: 1px solid #ddd; padding: 10px; width: 100%; min-height: 600px; height: calc(100vh - 100px); overflow: auto;">
                    <p style="text-align: center; color: gray;">PDF Preview will appear here...</p>
                </div>

                <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
                <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
            </div>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

@section Scripts {

    <script src="~/assets2/js/report_booking/report_booking.js" asp-append-version="true"></script>
}

@section Styles {
    <link href="~/assets2/css/report_booking/report_booking.css" rel="stylesheet" />

}