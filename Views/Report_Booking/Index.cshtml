@{
    ViewData["Title"] = "Report Booking";
    Layout = "_Layout";
}

<div class="content">
    <div class="pb-1">
        <div class="card shadow-sm">

            <!-- ================= CARD HEADER ================= -->
            <div class="card-header">
                <div class="row align-items-center">

                    <!-- LEFT : REPORT TITLE -->
                    <div class="col-md-3">
                        <h4 class="mb-0 fw-semibold">
                            Booking Report
                        </h4>
                    </div>

                    <!-- RIGHT : FILTERS -->
                    <div class="col-md-9">
                        <div class="row g-2 align-items-end justify-content-end">

                            <div class="col-md-2">
                                <select id="ddlEventType" class="form-select">
                                    <option value="">Event Type</option>
                                </select>
                            </div>

                            <div class="col-md-2">
                                <select id="ddlEventSubType" class="form-select" disabled>
                                    <option value="">Event Sub Type</option>
                                </select>
                            </div>

                            <div class="col-md-2">
                                <select id="ddlCompanyHall" class="form-select">
                                    <option value="">Hall</option>
                                </select>
                            </div>

                            <div class="col-md-2">
                                <input type="date" id="event-date" class="form-control">
                            </div>
                            <div class="col-md-2">
                                <div class="dropdown">
                                    <button class="btn btn-outline-secondary btn-sm fw-bold  dropdown-toggle"
                                            type="button" id="sortByDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                        Filter : This Month
                                    </button>
                                    <ul class="dropdown-menu" aria-labelledby="sortByDropdown">
                                        <li><a class="dropdown-item sort-option " data-value="yesterday" href="#">Yesterday</a></li>
                                        <li><a class="dropdown-item sort-option" data-value="days" href="#">Last 7 Days</a></li>
                                        <li><a class="dropdown-item sort-option" data-value="lastdays" href="#">Last 30 Days</a></li>
                                        <li><a class="dropdown-item sort-option active" data-value="thismonth" href="#">This Month</a></li>
                                        <li><a class="dropdown-item sort-option" data-value="lastmonth" href="#">Last Month</a></li>
                                        <li><a class="dropdown-item sort-option" data-value="12months" href="#">Last 12 Months</a></li>
                                        <li><a class="dropdown-item sort-option" data-value="customrange" href="#">Custom Range</a></li>
                                    </ul>
                                </div>
                            </div>
                            <div class="col-md-auto">
                                <button type="button"
                                        class="btn btn-outline-warning"
                                        onclick="ViewBookingReport('downloadPDF')">
                                    <i class="fas fa-download"></i>
                                </button>
                            </div>
                            <div class="col-md-auto">
                                <button type="button"
                                        class="btn btn-outline-warning"
                                        onclick="ViewBookingReport('downloadExcel')">
                                    <i class="fas fa-file-excel"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- ================= CARD BODY ================= -->
            <div class="card-body pt-2">
                <div id="pdfPreviewContainer"
                     style="border:1px solid #ddd;
                            padding:10px;
                            width:100%;
                            min-height:600px;
                            height:calc(100vh - 180px);
                            overflow:auto;">
                    <p class="text-center text-muted">
                        PDF Preview will appear here...
                    </p>
                </div>
            </div>

        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

@section Scripts {

    <script src="~/assets2/js/report_booking/report_booking.js" asp-append-version="true"></script>
}

@section Styles {
    <link href="~/assets2/css/report_booking/report_booking.css" rel="stylesheet" asp-append-version="true" />

}