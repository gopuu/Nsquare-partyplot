@{
    ViewData["Title"] = "Company";
    Layout = "_Layout";
}

<!-- Food Rates & Services Tab -->
<style>
    #subtab-add-edit-items .mt-2, 
    #subtab-addon-charges .mt-2 {
        overflow: hidden;
        max-height: none; /* fallback */
        transition: max-height 0.3s ease;
    }

    /* Active tab: custom background */
    #foodSubTabs .nav-link.active {
        background-color: #1976d2; /* Dark blue */
        color: #fff !important;
        border-radius: 4px;
    }

    /* Apply hover only on non-active tabs */
    #foodSubTabs .nav-link:not(.active):hover {
        background-color: #bbdefb;
        color: #000;
    }

    /* Add padding to all sub-tab links */
    #foodSubTabs .nav-link {
        padding: 8px 16px;
        margin-right: 8px; /* Optional: spacing between tabs */
    }
</style>

<style>
    /* Highlight all tabs */
    #companyTabs .nav-link {
        border: 1px solid #dee2e6; /* Light border for all tabs */
        border-bottom: none; /* So active tab connects visually to content */
        background-color: #f8f9fa; /* Light grey background */
        margin-right: 4px; /* Space between tabs */
        padding: 8px 15px;
        color: #495057; /* Bootstrap default text color */
        border-radius: 0.375rem 0.375rem 0 0; /* Rounded top corners */
        transition: background-color 0.2s, color 0.2s;
    }

        /* Hover effect for inactive tabs */
        #companyTabs .nav-link:hover {
            background-color: #e9ecef;
            color: #000;
        }

        /* Active tab styling */
        #companyTabs .nav-link.active {
            background-color: #6c757d; /* Bootstrap gray */
            border-color: #6c757d #6c757d #6c757d;
            color: #fff;
            font-weight: 600;
        }

    .time-slot {
        border-bottom: 1px solid #dee2e6;
        padding-bottom: 8px;
        margin-bottom: 8px;
    }

        .time-slot p {
            margin: 0 0 0 38px; /* align text with label after switch */
            font-size: 0.9rem;
            color: #555;
        }

</style>

<!--Facility icons-->
<style>
    .facility-table {
        width: 100%;
        border-collapse: collapse;
    }

    .facility-cell {
        position: relative;
        text-align: center;
        padding: 10px;
        cursor: pointer;
        vertical-align: top;
    }

        .facility-cell:hover {
            background-color: #f8f9fa;
        }

    .facility-checkbox {
        position: absolute;
        top: 5px;
        right: 5px;
    }

    .facility-icon {
        font-size: 40px; /* Increases icon size */
        display: block; /* Keeps icon on its own line */
        color: gray; /* Default color */
        transition: color 0.3s ease;
    }

    .facility-label {
        font-size: 0.85rem;
    }

    .facility-cell.checked {
        background-color: #e9ecef; /* Light gray background when checked */
    }

        .facility-cell.checked .facility-icon {
            color: red; /* Color when selected */
        }
</style>

<!-- Rules & Regulations -->
<style>
    .rules-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 15px; /* space between columns */
    }

    .rule-cell {
        padding: 10px;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        background-color: #f8f9fa;
    }

    .rule-wrapper {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
    }

    .rule-option {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        cursor: pointer;
        transition: background-color 0.3s ease;
        padding: 5px;
        border-radius: 6px;
        flex: 1;
    }

        .rule-option i {
            font-size: 2rem;
            margin-bottom: 5px;
        }

        .rule-option.selected {
            background-color: #e9ecef;
        }

            .rule-option.selected i {
                color: red;
            }

        .rule-option:not(.selected) i {
            color: gray;
        }

    /* Checkbox styling */
    .rule-checkbox {
        position: absolute;
        top: 5px;
        right: 5px;
        transform: scale(1.2);
        cursor: pointer;
    }
</style>

<!--Hall Rent-->
<style>
    .form-section {
        margin-bottom: 1.5rem;
    }

    .toggle-switch {
        display: inline-flex;
        align-items: center;
        cursor: pointer;
    }

        .toggle-switch input {
            display: none;
        }

    .toggle-slider {
        width: 50px;
        height: 26px;
        background: #ccc;
        border-radius: 15px;
        position: relative;
        transition: background-color 0.3s;
        margin-left: 10px;
    }

        .toggle-slider::before {
            content: "";
            position: absolute;
            width: 22px;
            height: 22px;
            left: 2px;
            top: 2px;
            background: white;
            border-radius: 50%;
            transition: transform 0.3s;
        }

    input:checked + .toggle-slider {
        background: #ff0055;
    }

        input:checked + .toggle-slider::before {
            transform: translateX(24px);
        }

    .toggle-label {
        font-weight: 600;
        color: #ff0055;
        margin-left: 10px;
    }

        .toggle-label.off {
            color: #999;
        }

    /* Grid layout for the big form */
    .grid-container {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        gap: 1rem;
    }

    /* Good for, Amenities icons styles */
    .option-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
        gap: 0.8rem;
    }

    .option-item {
        border: 1px solid #ddd;
        border-radius: 6px;
        padding: 8px;
        text-align: center;
        cursor: pointer;
        user-select: none;
    }

        .option-item.disabled {
            opacity: 0.4;
            cursor: default;
        }

        .option-item svg {
            width: 30px;
            height: 30px;
            margin-bottom: 4px;
            fill: #777;
        }

        .option-item.active {
            border-color: #ff0055;
            background: #ffe6f0;
        }

    /* Upload inputs vertical */
    .upload-group input[type="file"] {
        margin-bottom: 0.6rem;
    }

</style>

<style>
    .option-item {
        position: relative;
        text-align: center;
        padding: 10px;
        cursor: pointer;
        border: 1px solid #dee2e6;
        border-radius: 6px;
        transition: all 0.3s ease;
    }

    .option-item:hover {
        background-color: #f8f9fa;
    }

    .option-checkbox {
        position: absolute;
        top: 5px;
        right: 5px;
        transform: scale(1.2);
        cursor: pointer;
    }

    .option-item.active {
        border-color: #ff0055;
        background-color: #ffe6f0;
    }

    .option-item.active .facility-icon {
        color: #ff0055;
    }

    .facility-icon {
        font-size: 24px;
        display: block;
        margin-bottom: 5px;
        color: gray;
        transition: color 0.3s ease;
    }
</style>

<!--Food rates & services > Setup/Update Food Package -->
<style>
    #subtab-addon-charges .table th, #subtab-addon-charges .table td {
        vertical-align: middle;
    }

    #subtab-addon-charges .form-check-inline {
        margin-right: 10px;
    }

    #subtab-addon-charges .btn-sm {
        font-size: 0.8rem;
    }

    #subtab-addon-charges.badge {
        font-size: 0.75rem;
    }
</style>

<style>
    #inclusionModal .form-check-label {
        font-size: 0.85rem; /* Adjust as needed */
    }

    .inclusion-item {
        transition: background-color 0.2s ease, box-shadow 0.2s ease;
    }

    .inclusion-item:hover {
        background-color: #f8f9fa; /* light gray */
        box-shadow: 0 0 6px rgba(0,0,0,0.15);
        cursor: pointer;
    }

</style>

@*Company Master*@
<div class="content">
    <div class="pb-5">
        <div class="row g-4">
            <div class="col-12">
                <div class="mb-12">
                    <h4 class="mb-2 d-none">Company Settings</h4>

                    <!-- Tab Menu -->
                    <ul class="nav nav-underline fs-9" id="companyTabs" role="tablist">
                        <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#tab-company-profile" role="tab">Company Profile</a></li>
                        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-property-details" role="tab">Property Details</a></li>
                        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-hall-details" role="tab">Hall Rent & Details</a></li>
                        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-invoice-setup" role="tab">Invoice Setup</a></li>
                        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-food-services" role="tab">Food Rates & Services</a></li>
                        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-terms" role="tab">Terms & Conditions</a></li>
                    </ul>

                    <!-- Tab Content -->
                    <div class="tab-content mt-3">

                        <!-- Tab 1. Company Profile -->
                        <div class="tab-pane fade show active" id="tab-company-profile" role="tabpanel">
                            <div class="card shadow-sm border-0 rounded-3">
                                <div class="card-body">

                                    <!-- Section Title
                                    <h5 class="mb-3 border-bottom pb-2 text-primary">Company Profile</h5>
                                    -->
                                    <div class="row">
                                        <!-- LEFT SIDE : Text Inputs -->
                                        <div class="col-md-6">
                                            <div class="row g-3">

                                                <!-- Company Name -->
                                                <div class="col-12">
                                                    <label class="form-label fw-semibold">Company's Name</label>
                                                    <input type="text" class="form-control" id="CompanyProfile_CompanyName" maxlength="200" placeholder="Enter Company Name" />
                                                </div>

                                                <!-- Address -->
                                                <div class="col-12">
                                                    <label class="form-label fw-semibold">Address</label>
                                                    <textarea class="form-control" id="CompanyProfile_Address" maxlength="200" placeholder="Enter Address" rows="3"></textarea>
                                                </div>

                                                <!-- PAN -->
                                                <div class="col-12">
                                                    <label class="form-label fw-semibold">PAN No.</label>
                                                    <input type="text" class="form-control" id="CompanyProfile_PanNo" maxlength="10" placeholder="Enter PAN Number" />
                                                </div>

                                                <!-- VAT -->
                                                <div class="col-12">
                                                    <label class="form-label fw-semibold">Liquor/VAT Number</label>
                                                    <input type="text" class="form-control" id="CompanyProfile_VATNumber" maxlength="15" placeholder="Enter VAT Number" />
                                                </div>

                                                <!-- Switches -->
                                                <div class="col-12">
                                                    <div class="form-check form-switch mb-2">
                                                        <input class="form-check-input" type="checkbox" id="CompanyProfile_QuotationsWithTax">
                                                        <label class="form-check-label" for="CompanyProfile_QuotationsWithTax">Create Quotations With Tax</label>
                                                    </div>
                                                    <div class="form-check form-switch mb-2">
                                                        <input class="form-check-input" type="checkbox" id="CompanyProfile_MultipleFoodGST">
                                                        <label class="form-check-label" for="CompanyProfile_MultipleFoodGST">Multiple Food GST Slabs</label>
                                                    </div>
                                                    <div class="form-check form-switch">
                                                        <input class="form-check-input" type="checkbox" id="CompanyProfile_AcceptGST">
                                                        <label class="form-check-label" for="CompanyProfile_AcceptGST">Accept GST</label>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- RIGHT SIDE : Dropdowns, Uploads, Switches -->
                                        <div class="col-md-6">
                                            <div class="row g-3">

                                                <!-- City -->
                                                <div class="col-6">
                                                    <label class="form-label fw-semibold">City</label>
                                                    <input type="text" class="form-control" id="CompanyProfile_City" maxlength="200" placeholder="Enter City" />
                                                </div>

                                                <!-- State -->
                                                <div class="col-6">
                                                    <label class="form-label fw-semibold">State</label>
                                                    <div class="input-group">
                                                        <select class="form-select" id="CompanyProfile_State" onchange="loadCities(this.value)">
                                                            <option value="">Loading...</option>
                                                        </select>
                                                        <button type="button" class="btn btn-outline-primary" id="btnAddState" data-bs-toggle="modal" data-bs-target="#stateModal">
                                                            <i class="bi bi-plus"></i>
                                                        </button>
                                                    </div>
                                                </div>

                                                <!-- Upload PAN Card -->
                                                <div class="col-12">
                                                    <label class="form-label fw-semibold">Upload PAN Card</label>
                                                    <div class="d-flex align-items-center gap-3">
                                                        <input type="file" class="form-control" id="CompanyProfile_PanCardUpload" accept=".jpg,.jpeg,.png,.pdf" />
                                                        <img id="PanCardPreview" src="/assets2/img/image_icon.png"
                                                             alt="PAN Preview"
                                                             class="img-thumbnail"
                                                             style="width:80px; height:75px; object-fit:contain; cursor:pointer;" />
                                                    </div>
                                                </div>

                                                <!-- Email -->
                                                <div class="col-6">
                                                    <label class="form-label fw-semibold">Email</label>
                                                    <input type="email" class="form-control" id="CompanyProfile_Email" maxlength="200" placeholder="Enter Email" />
                                                </div>

                                                <!-- Mobile -->
                                                <div class="col-6">
                                                    <label class="form-label fw-semibold">Mobile</label>
                                                    <input type="text" class="form-control" id="CompanyProfile_Mobile" maxlength="10" placeholder="Enter Mobile Number" />
                                                </div>

                                                <!-- Banquet Type -->
                                                <div class="col-12">
                                                    <label class="form-label fw-semibold">Banquet Type</label>
                                                    <div class="input-group">
                                                        <select class="form-select" id="CompanyProfile_BanquetType">
                                                            <option value="">Loading...</option>
                                                        </select>
                                                        <button type="button" class="btn btn-outline-primary" id="btnAddBanquetType" data-bs-toggle="modal" data-bs-target="#banquetTypeModal">
                                                            <i class="bi bi-plus"></i>
                                                        </button>
                                                    </div>
                                                </div>

                                                <!-- GSTIN -->
                                                <div class="col-12" id="gstinContainer" style="display:none;">
                                                    <label class="form-label fw-semibold">GSTIN</label>
                                                    <input type="text" class="form-control" id="CompanyProfile_GSTIN" maxlength="15" placeholder="Enter GSTIN" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- BOTTOM SECTION : Checkboxes + Save -->
                                    <div class="row mt-4">
                                        <div class="col-12">
                                            <div class="form-check mb-3">
                                                <input type="checkbox" class="form-check-input" id="CompanyProfile_PrintCustomerDetails" />
                                                <label class="form-check-label" for="CompanyProfile_PrintCustomerDetails">
                                                    Print Customer Details on The Function Prospect
                                                </label>
                                            </div>
                                        </div>
                                        <div class="col-12 text-end">
                                            <button class="btn btn-primary px-4" onclick="saveCompanyProfileData()">
                                                <i class="bi bi-save me-1"></i> Save
                                            </button>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>

                        <!-- Tab 2. Property Details -->
                        <div class="tab-pane fade" id="tab-property-details" role="tabpanel">
                            <div class="row g-3">

                                <!-- City -->
                                <div class="col-md-2 d-flex align-items-end">
                                    <div style="flex: 1;">
                                        <label class="form-label">City</label>
                                        <select class="form-select" id="PropertyDetails_City" onchange="loadLocalities(this.value,0)">
                                            <option value="">Loading....</option>
                                        </select>
                                    </div>
                                    <button type="button" class="btn btn-outline-primary ms-2" id="btnAddCity" data-bs-toggle="modal" data-bs-target="#cityModal">
                                        +
                                    </button>
                                </div>

                                <!-- Locality -->
                                <div class="col-md-2 d-flex align-items-end">
                                    <div style="flex: 1;">
                                        <label class="form-label">Locality</label>
                                        <select class="form-select" id="PropertyDetails_Locality">
                                            <option value="">Loading....</option>
                                        </select>
                                    </div>
                                    <button type="button" class="btn btn-outline-primary ms-2" id="btnAddLocality" data-bs-toggle="modal" data-bs-target="#localityModal">
                                        +
                                    </button>
                                </div>

                                <!-- Pincode -->
                                <div class="col-md-2">
                                    <label class="form-label">Pincode</label>
                                    <input type="text" class="form-control" id="PropertyDetails_Pincode" maxlength="6" />
                                </div>

                                <!-- Manager Name -->
                                <div class="col-md-6">
                                    <label class="form-label">Manager</label>
                                    <input type="text" class="form-control" id="PropertyDetails_ManagerName" maxlength="200" />
                                </div>

                                <!-- Property Name -->
                                <div class="col-md-4">
                                    <label class="form-label">Name of Property</label>
                                    <input type="text" class="form-control" id="PropertyDetails_PropertyName" maxlength="200" />
                                </div>

                                <!-- Property Type -->
                                <div class="col-md-2 d-flex align-items-end">
                                    <div style="flex: 1;">
                                        <label class="form-label">Property Type</label>
                                        <select class="form-select" id="PropertyDetails_PropertyType">
                                            <option value="">Loading....</option>
                                        </select>
                                    </div>
                                    <button type="button" class="btn btn-outline-primary ms-2" id="btnAddPropertyType" data-bs-toggle="modal" data-bs-target="#propertyTypeModal">
                                        +
                                    </button>
                                </div>

                                <!-- Email -->
                                <div class="col-md-6">
                                    <label class="form-label">Email</label>
                                    <input type="email" class="form-control" id="PropertyDetails_Email" maxlength="200" />
                                </div>

                                <!--Address, Mobile, Monopoly, Are Hall Rates Negotiable?, Food Preference (Pure Veg)-->
                                <div class="row g-3 align-items-start">
                                    <!-- Address (50% width, rowspan 2 effect using flex) -->
                                    <div class="col-md-6">
                                        <label class="form-label">Address</label>
                                        <textarea class="form-control h-100" id="PropertyDetails_Address" rows="5" maxlength="200"></textarea>
                                    </div>

                                    <!-- Right side container (50%) -->
                                    <div class="col-md-6">
                                        <div class="row g-3">
                                            <!-- Row 1: Mobile & Monopoly -->
                                            <div class="col-md-6">
                                                <label class="form-label">Manager's Mobile</label>
                                                <input type="text" class="form-control" id="PropertyDetails_ManagerMobile" maxlength="10" />
                                            </div>
                                            <!-- Monopoly Preference -->
                                            <div class="col-md-6 d-flex align-items-end">
                                                <div style="flex: 1;">
                                                    <label class="form-label">Monopoly Preference</label>
                                                    <select class="form-select" id="PropertyDetails_MonopolyPreference">
                                                        <option value="">Loading....</option>
                                                    </select>
                                                </div>
                                                <button type="button" class="btn btn-outline-primary ms-2" id="btnAddMonopolyPreference" data-bs-toggle="modal" data-bs-target="#monopolyPreferenceModal">
                                                    +
                                                </button>
                                            </div>

                                            <!-- Row 2: Both Switch Buttons -->
                                            <div class="col-md-6 d-flex align-items-center">
                                                <div class="form-check form-switch m-0">
                                                    <input class="form-check-input" type="checkbox" id="PropertyDetails_HallRatesNegotiable">
                                                    <label class="form-check-label ms-2" for="HallRatesNegotiable">
                                                        Are Hall Rates Negotiable?
                                                    </label>
                                                </div>
                                            </div>
                                            <div class="col-md-6 d-flex align-items-center">
                                                <div class="form-check form-switch m-0">
                                                    <input class="form-check-input" type="checkbox" id="PropertyDetails_FoodPreference">
                                                    <label class="form-check-label ms-2" for="FoodPreference">
                                                        Food Preference (Pure Veg)
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Time Slot Toggles -->
                                <div class="col-6">
                                    <!-- Full Day -->
                                    <div class="time-slot">
                                        <div class="d-flex align-items-center mb-2">
                                            <div class="form-check form-switch m-0">
                                                <input class="form-check-input" type="checkbox" id="PropertyDetails_FullDaySlot" checked>
                                                <label class="form-check-label ms-2" for="PropertyDetails_FullDaySlot">
                                                    Full Day Time Slots
                                                </label>
                                            </div>
                                        </div>
                                        <p>Time Range: 12:00 AM - 12:00 AM</p>
                                    </div>

                                    <!-- Morning -->
                                    <div class="time-slot">
                                        <div class="d-flex align-items-center mb-2">
                                            <div class="form-check form-switch m-0">
                                                <input class="form-check-input" type="checkbox" id="PropertyDetails_MorningSlot" checked>
                                                <label class="form-check-label ms-2" for="PropertyDetails_MorningSlot">
                                                    Morning Time Slots
                                                </label>
                                            </div>
                                        </div>
                                        <p>Time Range: 06:00 AM - 10:00 AM</p>
                                    </div>

                                    <!-- Afternoon -->
                                    <div class="time-slot">
                                        <div class="d-flex align-items-center mb-2">
                                            <div class="form-check form-switch m-0">
                                                <input class="form-check-input" type="checkbox" id="PropertyDetails_AfternoonSlot" checked>
                                                <label class="form-check-label ms-2" for="PropertyDetails_AfternoonSlot">
                                                    Afternoon Time Slots
                                                </label>
                                            </div>
                                        </div>
                                        <p>Time Range: 11:00 AM - 03:00 PM</p>
                                    </div>

                                    <!-- Evening -->
                                    <div class="time-slot">
                                        <div class="d-flex align-items-center mb-2">
                                            <div class="form-check form-switch m-0">
                                                <input class="form-check-input" type="checkbox" id="PropertyDetails_EveningSlot" checked>
                                                <label class="form-check-label ms-2" for="PropertyDetails_EveningSlot">
                                                    Evening Time Slots
                                                </label>
                                            </div>
                                        </div>
                                        <p>Time Range: 04:00 PM - 06:00 PM</p>
                                    </div>

                                    <!-- Overnight -->
                                    <div class="time-slot">
                                        <div class="d-flex align-items-center mb-2">
                                            <div class="form-check form-switch m-0">
                                                <input class="form-check-input" type="checkbox" id="PropertyDetails_OvernightSlot" checked>
                                                <label class="form-check-label ms-2" for="PropertyDetails_OvernightSlot">
                                                    Overnight Time Slots
                                                </label>
                                            </div>
                                        </div>
                                        <p>Time Range: 06:00 PM - 11:00 PM</p>
                                    </div>
                                </div>

                                <!--Facilities-->
                                <div class="col-6">
                                    <label class="form-label">Facilities</label>
                                    <table class="facility-table">
                                        <tr>
                                            <td class="facility-cell" onclick="toggleFacility(this)">
                                                <input type="checkbox" class="PropertyDetails_facility-checkbox">
                                                <i class="bi bi-door-open-fill facility-icon"></i>
                                                <span>Grand Entrance</span>
                                            </td>
                                            <td class="facility-cell" onclick="toggleFacility(this)">
                                                <input type="checkbox" class="PropertyDetails_facility-checkbox">
                                                <i class="bi bi-tag-fill facility-icon"></i>
                                                <span>Valet Parking</span>
                                            </td>
                                            <td class="facility-cell" onclick="toggleFacility(this)">
                                                <input type="checkbox" class="PropertyDetails_facility-checkbox">
                                                <i class="bi bi-car-front-fill facility-icon"></i>
                                                <span>Free Parking</span>
                                            </td>
                                            <td class="facility-cell" onclick="toggleFacility(this)">
                                                <input type="checkbox" class="PropertyDetails_facility-checkbox">
                                                <i class="bi bi-cash-coin facility-icon"></i>
                                                <span>Pay & Park</span>
