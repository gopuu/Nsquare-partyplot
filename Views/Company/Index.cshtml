<script>
    // =============================
    // TAB: Add/Edit Food Items
    // =============================
    let headerCount_items = 0;
    let inclusionOptions = [];

    function toggleHeaderItems(headerId, btn) {
        const container = document.getElementById(headerId);
        if (!container) return;

        // Determine toggle action based on icon
        const isExpanded = btn.textContent.trim() === "▼";

        if (isExpanded) {
            // 🔹 Collapse
            container.style.maxHeight = container.scrollHeight + "px";
            requestAnimationFrame(() => {
                container.style.maxHeight = "0px";
            });
            btn.textContent = "◀";
        } else {
            // 🔹 Expand
            container.style.display = "block";
            container.style.maxHeight = container.scrollHeight + "px";
            btn.textContent = "▼";
        }
    }

    function addNewHeader_items(headerDbId = 0) {
        headerCount_items++;
        const headerId = `header-item-${headerCount_items}`;
        const container = document.createElement('div');
        container.className = 'border rounded mb-3 bg-white shadow-sm';

        container.innerHTML = `
            <!-- 🔑 Hidden input for header database ID -->
            <input type="hidden" class="food-header-id" value="${headerDbId}" />

            <!-- 🔹 Header Bar -->
            <div class="d-flex justify-content-between align-items-center px-3 py-2 rounded-top"
                 style="background-color: #e9f5ff; margin: 2 -0.5rem; border-bottom: 1px solid #cce5ff;">
                <div class="d-flex flex-grow-1 align-items-center">
                    <input type="text" class="form-control form-control-sm me-2 food-item-header fw-semibold border-0 bg-transparent"
                           placeholder="Header Name (e.g. Welcome Drink)" />
                </div>
                <div>
                    <button class="btn btn-sm btn-outline-primary me-2 toggle-arrow"
                            onclick="toggleHeaderItems('${headerId}', this)">▼</button>
                    <button class="btn btn-sm btn-outline-danger border fw-bold"
                            onclick="this.closest('.border').remove()">X</button>
                </div>
            </div>

            <!-- 🔹 Food Items Container -->
            <div class="mt-2 mb-2 px-2" id="${headerId}">
                ${generateFoodItemRow_items()}
                <div class="mt-2">
                    <button class="btn btn-outline-success btn-sm" onclick="addFoodItem_items('${headerId}')">+ Add more</button>
                </div>
            </div>
        `;
        document.getElementById('foodHeaderContainer_items').appendChild(container);
    }

    function generateFoodItemRow_items() {
        return `
            <div class="input-group mb-2 food-item-row">
                <input type="hidden" class="food-item-id" value="0"/>
                <input type="text" class="form-control food-item-name" placeholder="Food Item Name" />
                <input type="text" class="form-control food-item-description ms-2" placeholder="Description (optional)" />
            </div>
        `;
    }

    function addFoodItem_items(headerId) {
        const container = document.getElementById(headerId);
        const addMoreDiv = container.querySelector('.mt-2:last-child'); // button wrapper
        addMoreDiv.insertAdjacentHTML('beforebegin', generateFoodItemRow_items());
    }

    function saveFoodItems() {
        console.log("saveFoodItems clicked..");

        // Build cuisine dictionary
        let cuisines = {};
        $("#cuisineCheckboxContainer input[type=checkbox]").each(function () {
            cuisines[$(this).val()] = $(this).is(":checked");
        });

        userId = userId === null ? sessionStorage.getItem('userId') : userId;
        let foodItems = [];

        // 🔧 Loop through headers first
        $("#foodHeaderContainer_items > .border").each(function () {
            let headerName = $(this).find(".food-item-header").val();
            let headerId = $(this).find(".food-header-id").val() || 0; // if you have header id from DB

            let items = [];

            // Get all rows inside this header container
            $(this).find(".food-item-row").each(function () {
                let itemId = $(this).find(".food-item-id").val() || 0;
                let itemName = $(this).find(".food-item-name").val();
                let description = $(this).find(".food-item-description").val();

                items.push({
                    ItemId: itemId,  // match your C# model property
                    ItemName: itemName,
                    Description: description
                });
            });

            foodItems.push({
                Id: headerId,           // header ID (if editing existing)
                HeaderName: headerName, // header name
                Items: items            // all items under this header
            });
        });

        let requestData = {
            FoodItems: foodItems,
            ActionBy: userId,
            Cuisines: cuisines
        };

        console.log("Save FoodItem Data:", requestData);

        //showLoader();
        $.ajax({
            url: "/api/Company_FoodRate_Item/SaveCompanyFoodItems",
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify(requestData),
            success: function (res) {
                console.log("save res:", res);
                if (res.status === "Success") {
                    Swal.fire({
                        icon: 'success',
                        title: 'Saved!',
                        position: "top-end",
                        showConfirmButton: false,
                        timer: 900
                    });
                    loadFoodItems();
                } else {
                    Swal.fire({ icon: 'error', title: 'Oops...', text: res.message });
                }
            },
            error: function (xhr, status, error) {
                printAllErrors(xhr, status, error, 'SaveCompanyFoodItems');
                Swal.fire({ icon: 'error', title: 'Error', text: 'Something went wrong while saving food item.' });
            },
            complete: function () {
                //hideLoader();
            }
        });
    }

    function printAllErrors(xhr, status, error, srcApi=""){
        console.log("---- API ERROR ----");
        console.log("srcAPi:", srcApi, ", Status Code:", xhr.status);            // e.g., 404, 500
        console.log("srcAPi:", srcApi, ", Status Text:", xhr.statusText);        // e.g., Not Found, Internal Server Error
        console.log("srcAPi:", srcApi, ", Response Text:", xhr.responseText);    // server error message
        console.log("srcAPi:", srcApi, ", Ready State:", xhr.readyState);
        console.log("srcAPi:", srcApi, ", jQuery Status:", status);              // "timeout", "error", etc.
        console.log("srcAPi:", srcApi, ", Error Thrown:", error);                // exception object/message
        console.log("srcAPi:", srcApi, ", Full XHR Object:", xhr);               // dump everything
        console.log("-------------------");
    }

    function loadFoodItems(itemId = 0) {
        headerCount_items=0;
        inclusionOptions = [];

        //showLoader();

        $.ajax({
            url: "/api/Company_FoodRate_Item/GetCompanyFoodItem",
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify({ Id: itemId }),
            success: function (res) {
                console.log("Company_FoodRate_Item res:", res);
                if (res.status === "Success" && res.data) {
                    // ---------- Render cuisines ----------
                    if (res.data.Cuisines) {
                        const container = document.getElementById("cuisineCheckboxContainer");
                        container.innerHTML = ""; // clear old ones

                        Object.entries(res.data.Cuisines).forEach(([cuisine, isActive]) => {
                            const col = document.createElement("div");
                            col.className = "form-check col";

                            const checkbox = document.createElement("input");
                            checkbox.type = "checkbox";
                            checkbox.className = "form-check-input";
                            checkbox.id = cuisine.toLowerCase().replace(/\s+/g, '');
                            checkbox.name = "cuisine";
                            checkbox.value = cuisine;
                            checkbox.checked = isActive;

                            const label = document.createElement("label");
                            label.className = "form-check-label";
                            label.setAttribute("for", checkbox.id);
                            label.innerText = cuisine;

                            col.appendChild(checkbox);
                            col.appendChild(label);
                            container.appendChild(col);
                        });
                    }

                    // ---------- Render food items ----------
                    if (res.data.FoodItems && res.data.FoodItems.length > 0) {
                        const headerContainer = document.getElementById('foodHeaderContainer_items');
                        headerContainer.innerHTML = ''; // Clear existing headers

                        res.data.FoodItems.forEach((header, index) => {
                            addNewHeader_items(header.Id); // Pass DB Id ✅
                            const lastHeaderContainer = headerContainer.lastElementChild;

                            // Set header name
                            lastHeaderContainer.querySelector('.form-control.food-item-header').value = header.HeaderName || '';

                            const itemsDiv = lastHeaderContainer.querySelector('div.mt-2');
                            itemsDiv.innerHTML = '';

                            // Render items under this header
                            if (header.Items && header.Items.length > 0) {
                                header.Items.forEach(foodItem => {
                                    itemsDiv.insertAdjacentHTML('beforeend', `
                                        <div class="input-group mb-2 food-item-row">
                                            <input type="hidden" class="food-item-id" value="${foodItem.ItemId || 0}" />
                                            <input type="text" class="form-control food-item-name" placeholder="Food Item Name" value="${foodItem.ItemName || ''}" />
                                            <input type="text" class="form-control food-item-description ms-2" placeholder="Description" value="${foodItem.Description || ''}" />
                                            <button class="btn btn-outline-danger ms-2" type="button" onclick="deleteFoodItem(this)">X</button>
                                        </div>
                                    `);
                                });
                            }

                            // ✅ Re-append the "+ Add more" button inside the same container
                            itemsDiv.insertAdjacentHTML('beforeend', `
                                <div class="mt-2">
                                    <button class="btn btn-outline-success btn-sm" onclick="addFoodItem_items('${itemsDiv.id}')">+ Add more</button>
                                </div>
                            `);

                            // Hide all except first
                            setTimeout(() => {
                                const headerId = itemsDiv.id;
                                const toggleBtn = lastHeaderContainer.querySelector(".toggle-arrow");

                                if (index === 0) {
                                    // First row → keep open (down arrow)
                                    if (toggleBtn) toggleBtn.textContent = '▼';
                                } else {
                                    // Others → collapsed (left arrow)
                                    if (toggleBtn) {
                                        toggleHeaderItems(headerId, toggleBtn); // collapse animation
                                        toggleBtn.textContent = '◀';
                                    }
                                }
                            }, 50);

                        });

                    }
                    inclusionOptions = res.data.FoodItems;
                    loadFoodPackageData();
                    // Swal.fire({
                    //     icon: 'success',
                    //     title: 'Loaded!',
                    //     text: 'Food items fetched successfully.',
                    //     timer: 900,
                    //     showConfirmButton: false
                    // });
                } else {
                    // Swal.fire({
                    //     icon: 'info',
                    //     title: 'No Data',
                    //     text: 'No food items found.'
                    // });
                }
            },
            error: function (xhr, status, error) {
                printAllErrors(xhr,status, error, 'GetCompanyFoodItem');
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Failed to fetch food items.'
                });
            },
            complete: function () {
                //hideLoader();  // Hide after request completes (success or error)
            }
        });
    }

    function deleteFoodItem(button) {
        const row = button.closest('.food-item-row');
        const id = row.querySelector('.food-item-id')?.value || 0;

        if (!id || id == "0") {
            // If it's a newly added row (not saved in DB), just remove it
            row.remove();
            return;
        }

        const payload = {
            Id: parseInt(id),
            DeletedBy: 1 // replace with logged-in user ID
        };

        //showLoader();
        fetch('/api/Company_FoodRate_Item/DeleteCompanyFoodItem', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(payload)
        })
        .then(response => response.json())
        .then(data => {
            //hideLoader();  // Hide after request completes (success or error)
            if (data.status === "Success") {
                console.log("Deleted id=" + id);
                row.remove();
            } else {
                Swal.fire({
                    icon: "error",
                    title: "Error",
                    text: data.message,
                    confirmButtonColor: "#d33"
                });
            }
        })
        .catch(error => {
            //hideLoader();  // Hide after request completes (success or error)
            console.error("DeleteCompanyFoodItem error:", error);
            Swal.fire({
                icon: "error",
                title: "Failed",
                text: "Failed to delete food item.",
                confirmButtonColor: "#d33"
            });
        });
    }

    //TAB: Food Rate & Services > SubTab: Add/Edit Food Items -- START
    document.addEventListener("DOMContentLoaded", function () {
        loadFoodItems();
    });
</script>
