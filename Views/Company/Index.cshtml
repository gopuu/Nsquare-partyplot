@{
    ViewData["Title"] = "Company";
    Layout = "_Layout";
}

@section Styles {
    <link href="~/assets2/css/Company/Company.css" asp-append-version="true" rel="stylesheet" />
}

@section Scripts {
    <script src="~/assets2/js/Company/Company.js" asp-append-version="true"></script>
}

@*Company Master*@
<div class="content">
    <div class="pb-5">
        <div class="row g-4">
            <div class="col-12">
                <div class="mb-12">
                    <h4 class="mb-2 d-none">Company Settings</h4>

                    <!-- Tab Menu -->
                    <div class="sticky-tabs bg-warning text-white p-2">
                        <ul class="nav nav-underline fs-9" id="companyTabs" role="tablist">
                            <li class="nav-item">
                                <a class="nav-link active" data-bs-toggle="tab" href="#tab-company-profile" role="tab">Company Profile</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" data-bs-toggle="tab" href="#tab-property-details" role="tab">Property Details</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" data-bs-toggle="tab" href="#tab-hall-details" role="tab">Hall Rent & Details</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" data-bs-toggle="tab" href="#tab-invoice-setup" role="tab">Invoice Setup</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" data-bs-toggle="tab" href="#tab-food-services" role="tab">Food Rates & Services</a>
                            </li>
                            <li class="nav-item d-none">
                                <a class="nav-link" data-bs-toggle="tab" href="#tab-terms" role="tab">Terms & Conditions</a>
                            </li>
                        </ul>
                    </div>

                    <!-- Tab Content -->
                    <div class="tab-content mt-3">

                        <!-- Tab 1. Company Profile -->
                        <div class="tab-pane fade show active" id="tab-company-profile" role="tabpanel">
                            <div class="card shadow-sm border-0 rounded-3">
                                <div class="card-body">

                                    <!-- Section Title
                                    <h5 class="mb-3 border-bottom pb-2 text-primary">Company Profile</h5>
                                    -->
                                    <div class="row">
                                        <!-- LEFT SIDE : Text Inputs -->
                                        <div class="col-md-6">
                                            <div class="row g-3">

                                                <!-- Company Name -->
                                                <div class="col-12">
                                                    <label class="form-label fw-semibold">Company's Name</label>
                                                    <input type="text" class="form-control form-control-sm" id="CompanyProfile_CompanyName" maxlength="200" placeholder="Enter Company Name" />
                                                </div>

                                                <!-- Address -->
                                                <div class="col-12">
                                                    <label class="form-label fw-semibold">Address</label>
                                                    <textarea class="form-control form-control-sm" id="CompanyProfile_Address" maxlength="200" placeholder="Enter Address" rows="3"></textarea>
                                                </div>

                                                <!-- PAN -->
                                                <div class="col-6">
                                                    <label class="form-label fw-semibold">PAN No.</label>
                                                    <input type="text" class="form-control form-control-sm" id="CompanyProfile_PanNo" maxlength="10" placeholder="Enter PAN Number" />
                                                </div>

                                                <!-- VAT -->
                                                <div class="col-6">
                                                    <label class="form-label fw-semibold">Liquor/VAT Number</label>
                                                    <input type="text" class="form-control form-control-sm" id="CompanyProfile_VATNumber" maxlength="15" placeholder="Enter VAT Number" />
                                                </div>

                                                <!-- Switches -->
                                                <div class="col-12">
                                                    <div class="form-check form-switch mb-2">
                                                        <input class="form-check-input" type="checkbox" id="CompanyProfile_QuotationsWithTax">
                                                        <label class="form-check-label" for="CompanyProfile_QuotationsWithTax">Create Quotations With Tax</label>
                                                    </div>
                                                    <div class="form-check form-switch mb-2">
                                                        <input class="form-check-input" type="checkbox" id="CompanyProfile_MultipleFoodGST">
                                                        <label class="form-check-label" for="CompanyProfile_MultipleFoodGST">Multiple Food GST Slabs</label>
                                                    </div>
                                                    <div class="form-check form-switch">
                                                        <input class="form-check-input" type="checkbox" id="CompanyProfile_AcceptGST">
                                                        <label class="form-check-label" for="CompanyProfile_AcceptGST">Accept GST</label>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- RIGHT SIDE : Dropdowns, Uploads, Switches -->
                                        <div class="col-md-6">
                                            <div class="row g-3">

                                                <!-- City -->
                                                <div class="col-6">
                                                    <label class="form-label fw-semibold">Place</label>
                                                    <input type="text" class="form-control form-control-sm" id="CompanyProfile_City" maxlength="200" placeholder="Enter City" />
                                                </div>

                                                <!-- State -->
                                                <div class="col-6">
                                                    <label class="form-label fw-semibold">State</label>
                                                    <div class="input-group input-group-sm">
                                                        <select class="form-select form-select-sm" id="CompanyProfile_State" onchange="loadCities(this.value)">
                                                            <option value="">Loading...</option>
                                                        </select>
                                                        <button type="button" class="btn btn-outline-primary btn-sm" id="btnAddState" data-bs-toggle="modal" data-bs-target="#stateModal">
                                                            <i class="bi bi-plus"></i>
                                                        </button>
                                                    </div>
                                                </div>

                                                <!-- Upload PAN Card -->
                                                <div class="col-12">
                                                    <label class="form-label fw-semibold">Upload PAN Card</label>
                                                    <div class="d-flex align-items-center gap-3">
                                                        <input type="file" class="form-control form-control-sm" id="CompanyProfile_PanCardUpload" accept=".jpg,.jpeg,.png,.pdf" />
                                                        <img id="PanCardPreview" src="/assets2/img/image_icon.png"
                                                             alt="PAN Preview"
                                                             class="img-thumbnail"
                                                             style="width:80px; height:75px; object-fit:contain; cursor:pointer;" />
                                                    </div>
                                                </div>

                                                <!-- Email -->
                                                <div class="col-6">
                                                    <label class="form-label fw-semibold">Email</label>
                                                    <input type="email" class="form-control form-control-sm" id="CompanyProfile_Email" maxlength="200" placeholder="Enter Email" />
                                                </div>

                                                <!-- Mobile -->
                                                <div class="col-6">
                                                    <label class="form-label fw-semibold">Mobile</label>
                                                    <input type="text" class="form-control form-control-sm" id="CompanyProfile_Mobile" maxlength="10" placeholder="Enter Mobile Number" />
                                                </div>

                                                <!-- Banquet Type -->
                                                <div class="col-6">
                                                    <label class="form-label fw-semibold">Banquet Type</label>
                                                    <div class="input-group input-group-sm">
                                                        <select class="form-select form-select-sm" id="CompanyProfile_BanquetType">
                                                            <option value="">Loading...</option>
                                                        </select>
                                                        <button type="button" class="btn btn-outline-primary btn-sm" id="btnAddBanquetType" data-bs-toggle="modal" data-bs-target="#banquetTypeModal">
                                                            <i class="bi bi-plus"></i>
                                                        </button>
                                                    </div>
                                                </div>

                                                <!-- GSTIN -->
                                                <div class="col-6" id="gstinContainer" style="display:none;">
                                                    <label class="form-label fw-semibold">GSTIN</label>
                                                    <input type="text" class="form-control form-control-sm" id="CompanyProfile_GSTIN" maxlength="15" placeholder="Enter GSTIN" />
                                                </div>

                                                <!-- ReviewUrl -->
                                                <div class="col-12">
                                                    <label class="form-label fw-semibold">Business Review Link</label>
                                                    <input type="text" class="form-control form-control-sm" id="CompanyProfile_ReviewUrl" placeholder="https://google.com/businessreview" />
                                                </div>

                                            </div>
                                        </div>
                                    </div>

                                    <!-- BOTTOM SECTION : Checkboxes + Save -->
                                    <div class="row mt-4">
                                        <div class="col-12">
                                            <div class="form-check mb-3">
                                                <input type="checkbox" class="form-check-input" id="CompanyProfile_PrintCustomerDetails" />
                                                <label class="form-check-label" for="CompanyProfile_PrintCustomerDetails">
                                                    Print Customer Details on The Function Prospect
                                                </label>
                                            </div>
                                        </div>
                                        <div class="col-12 text-end">
                                            <button type="button" class="btn btn-warning btn-sm px-2" onclick="saveCompanyProfileData()"><i class="fa fa-save me-1"></i> Save</button>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>

                        <!-- Tab 2. Property Details -->
                        <div class="tab-pane fade" id="tab-property-details" role="tabpanel">
                            <div class="row g-3">

                                <!-- City -->
                                <div class="col-md-3">
                                    <label class="form-label fw-semibold">City</label>
                                    <div class="input-group input-group-sm">

                                        <select class="form-select form-select-sm"
                                                id="PropertyDetails_City"
                                                onchange="loadLocalities(this.value,0)">
                                            <option value="">Loading...</option>
                                        </select>

                                        <button type="button"
                                                class="btn btn-outline-primary btn-sm"
                                                id="btnAddCity"
                                                data-bs-toggle="modal"
                                                data-bs-target="#cityModal">
                                            <i class="bi bi-plus"></i>
                                        </button>

                                    </div>
                                </div>

                                <!-- Locality -->
                                <div class="col-md-3">
                                    <label class="form-label fw-semibold">Locality</label>

                                    <div class="input-group input-group-sm">

                                        <select class="form-select form-select-sm"
                                                id="PropertyDetails_Locality">
                                            <option value="">Loading...</option>
                                        </select>

                                        <button type="button"
                                                class="btn btn-outline-primary btn-sm"
                                                id="btnAddLocality"
                                                data-bs-toggle="modal"
                                                data-bs-target="#localityModal">
                                            <i class="bi bi-plus"></i>
                                        </button>

                                    </div>
                                </div>

                                <!-- Pincode -->
                                <div class="col-md-2">
                                    <label class="form-label">Pincode</label>
                                    <input type="text" class="form-control form-control-sm" id="PropertyDetails_Pincode" maxlength="6" />
                                </div>

                                <!-- Manager Name -->
                                <div class="col-md-4">
                                    <label class="form-label">Manager</label>
                                    <input type="text" class="form-control form-control-sm" id="PropertyDetails_ManagerName" maxlength="200" />
                                </div>

                                <!-- Property Name -->
                                <div class="col-md-4">
                                    <label class="form-label">Name of Property</label>
                                    <input type="text" class="form-control form-control-sm" id="PropertyDetails_PropertyName" maxlength="200" />
                                </div>

                                <!-- Property Type -->
                                <div class="col-md-4">
                                    <label class="form-label fw-semibold">Property Type</label>

                                    <div class="input-group input-group-sm">

                                        <select class="form-select form-select-sm"
                                                id="PropertyDetails_PropertyType">
                                            <option value="">Loading...</option>
                                        </select>

                                        <button type="button"
                                                class="btn btn-outline-primary btn-sm"
                                                id="btnAddPropertyType"
                                                data-bs-toggle="modal"
                                                data-bs-target="#propertyTypeModal">
                                            <i class="bi bi-plus"></i>
                                        </button>

                                    </div>
                                </div>

                                <!-- Email -->
                                <div class="col-md-4">
                                    <label class="form-label">Email</label>
                                    <input type="email" class="form-control form-control-sm" id="PropertyDetails_Email" maxlength="200" />
                                </div>

                                <!--Address, Mobile, Monopoly, Are Hall Rates Negotiable?, Food Preference (Pure Veg)-->
                                <div class="row g-3 align-items-start">
                                    <!-- Address (50% width, rowspan 2 effect using flex) -->
                                    <div class="col-md-6">
                                        <label class="form-label">Address</label>
                                        <textarea class="form-control h-100" id="PropertyDetails_Address" rows="5" maxlength="200"></textarea>
                                    </div>

                                    <!-- Right side container (50%) -->
                                    <div class="col-md-6">
                                        <div class="row g-3">
                                            <!-- Row 1: Mobile & Monopoly -->
                                            <div class="col-md-6">
                                                <label class="form-label">Manager's Mobile</label>
                                                <input type="text" class="form-control form-control-sm" id="PropertyDetails_ManagerMobile" maxlength="10" />
                                            </div>
                                            <!-- Monopoly Preference -->
                                            <div class="col-md-6">
                                                <label class="form-label fw-semibold">Monopoly Preference</label>

                                                <div class="input-group input-group-sm">

                                                    <select class="form-select form-select-sm"
                                                            id="PropertyDetails_MonopolyPreference">
                                                        <option value="">Loading...</option>
                                                    </select>

                                                    <button type="button"
                                                            class="btn btn-outline-primary btn-sm"
                                                            id="btnAddMonopolyPreference"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#monopolyPreferenceModal">
                                                        <i class="bi bi-plus"></i>
                                                    </button>

                                                </div>
                                            </div>
                                            <!-- Row 2: Both Switch Buttons -->
                                            <div class="col-md-6 d-flex align-items-center">
                                                <div class="form-check form-switch m-0">
                                                    <input class="form-check-input" type="checkbox" id="PropertyDetails_HallRatesNegotiable">
                                                    <label class="form-check-label ms-2" for="HallRatesNegotiable">
                                                        Are Hall Rates Negotiable?
                                                    </label>
                                                </div>
                                            </div>
                                            <div class="col-md-6 d-flex align-items-center">
                                                <div class="form-check form-switch m-0">
                                                    <input class="form-check-input" type="checkbox" id="PropertyDetails_FoodPreference">
                                                    <label class="form-check-label ms-2" for="FoodPreference">
                                                        Food Preference (Pure Veg)
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Time Slot Toggles -- START -->
                                <div class="col-6">
                                    <!-- Header -->
                                    <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2 bg-gradient">
                                        <!-- Left Side -->
                                        <div class="d-flex align-items-center gap-3">
                                            <h6 class="mb-0 fw-bold text-primary">
                                                Slot Management
                                            </h6>

                                            <span id="graceTimeLabel"
                                                  class="badge bg-light text-dark border"
                                                  data-bs-toggle="tooltip"
                                                  data-bs-placement="top">
                                            </span>
                                        </div>

                                        <!-- Right: Save Button -->
                                        <button class="btn btn-primary btn-xs" id="btnSaveSlots">
                                            <i class="fa fa-save me-1"></i> Save Slots
                                        </button>
                                    </div>

                                    <!-- Slots Container -->
                                    <div id="slotContainer" class="bg-gradient">
                                        <!-- Dynamic Slots Here -->
                                    </div>

                                    <!-- About Us and Terms & Conditions -->
                                    <div class="col-12">
                                        <label class="form-label">About Us and Terms & Conditions</label>
                                        <textarea class="form-control form-control-sm" rows="5" placeholder="Write here..." id="PropertyDetails_tnc"></textarea>
                                    </div>
                                </div>
                                <!-- Time Slot Toggles -- END -->

                                <!--Facilities-->
                                <div class="col-6">
                                    <label class="form-label">Facilities</label>
                                    <table class="facility-table">
                                        <tr>
                                            <td class="facility-cell" onclick="toggleFacility(this)">
                                                <input type="checkbox" class="PropertyDetails_facility-checkbox">
                                                <i class="bi bi-door-open-fill facility-icon"></i>
                                                <span>Grand Entrance</span>
                                            </td>
                                            <td class="facility-cell" onclick="toggleFacility(this)">
                                                <input type="checkbox" class="PropertyDetails_facility-checkbox">
                                                <i class="bi bi-tag-fill facility-icon"></i>
                                                <span>Valet Parking</span>
                                            </td>
                                            <td class="facility-cell" onclick="toggleFacility(this)">
                                                <input type="checkbox" class="PropertyDetails_facility-checkbox">
                                                <i class="bi bi-car-front-fill facility-icon"></i>
                                                <span>Free Parking</span>
                                            </td>
                                            <td class="facility-cell" onclick="toggleFacility(this)">
                                                <input type="checkbox" class="PropertyDetails_facility-checkbox">
                                                <i class="bi bi-cash-coin facility-icon"></i>
                                                <span>Pay & Park</span>
                                            </td>
                                            <td class="facility-cell" onclick="toggleFacility(this)">
                                                <input type="checkbox" class="PropertyDetails_facility-checkbox">
                                                <i class="bi bi-person-fill facility-icon"></i>
                                                <span>Darban</span>
                                            </td>
                                            <td class="facility-cell" onclick="toggleFacility(this)">
                                                <input type="checkbox" class="PropertyDetails_facility-checkbox">
                                                <i class="bi bi-tree-fill facility-icon"></i>
                                                <span>Garden</span>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="facility-cell" onclick="toggleFacility(this)">
                                                <input type="checkbox" class="PropertyDetails_facility-checkbox">
                                                <i class="bi bi-signpost-fill facility-icon"></i>
                                                <span>Welcome Board</span>
                                            </td>
                                            <td class="facility-cell" onclick="toggleFacility(this)">
                                                <input type="checkbox" class="PropertyDetails_facility-checkbox">
                                                <i class="bi bi-droplet-fill facility-icon"></i>
                                                <span>Fountain</span>
                                            </td>
                                            <td class="facility-cell" onclick="toggleFacility(this)">
                                                <input type="checkbox" class="PropertyDetails_facility-checkbox">
                                                <i class="bi bi-cup-straw facility-icon"></i>
                                                <span>Liquors Allowed</span>
                                            </td>
                                            <td class="facility-cell" onclick="toggleFacility(this)">
                                                <input type="checkbox" class="PropertyDetails_facility-checkbox">
                                                <i class="bi bi-wind facility-icon"></i>
                                                <span>Smoking Area</span>
                                            </td>
                                            <td class="facility-cell" onclick="toggleFacility(this)">
                                                <input type="checkbox" class="PropertyDetails_facility-checkbox">
                                                <i class="bi bi-egg-fried facility-icon"></i>
                                                <span>Catering Available</span>
                                            </td>
                                            <td class="facility-cell" onclick="toggleFacility(this)">
                                                <input type="checkbox" class="PropertyDetails_facility-checkbox">
                                                <i class="bi bi-lightning-charge-fill facility-icon"></i>
                                                <span>Power Backup</span>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="facility-cell" onclick="toggleFacility(this)">
                                                <input type="checkbox" class="PropertyDetails_facility-checkbox">
                                                <i class="bi bi-wifi facility-icon"></i>
                                                <span>WiFi</span>
                                            </td>
                                            <td class="facility-cell" onclick="toggleFacility(this)">
                                                <input type="checkbox" class="PropertyDetails_facility-checkbox">
                                                <i class="bi bi-heart-pulse-fill facility-icon"></i>
                                                <span>Doctor on Call</span>
                                            </td>
                                            <td class="facility-cell" onclick="toggleFacility(this)">
                                                <input type="checkbox" class="PropertyDetails_facility-checkbox">
                                                <i class="bi bi-water facility-icon"></i>
                                                <span>Swimming Pool</span>
                                            </td>
                                            <td class="facility-cell" onclick="toggleFacility(this)">
                                                <input type="checkbox" class="PropertyDetails_facility-checkbox">
                                                <i class="bi bi-universal-access facility-icon"></i>
                                                <span>Handicap Access</span>
                                            </td>
                                            <td class="facility-cell" onclick="toggleFacility(this)">
                                                <input type="checkbox" class="PropertyDetails_facility-checkbox">
                                                <i class="bi bi-fire facility-icon"></i>
                                                <span>Hawan Allowed</span>
                                            </td>
                                            <td class="facility-cell" onclick="toggleFacility(this)">
                                                <input type="checkbox" class="PropertyDetails_facility-checkbox">
                                                <i class="bi bi-music-note-beamed facility-icon"></i>
                                                <span>Barrat Allowed</span>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="facility-cell" onclick="toggleFacility(this)">
                                                <input type="checkbox" class="PropertyDetails_facility-checkbox">
                                                <i class="bi bi-stars facility-icon"></i>
                                                <span>Cracker Allowed</span>
                                            </td>
                                            <td class="facility-cell" onclick="toggleFacility(this)">
                                                <input type="checkbox" class="PropertyDetails_facility-checkbox">
                                                <i class="bi bi-airplane facility-icon"></i>
                                                <span>Helipad</span>
                                            </td>
                                            <td class="facility-cell" onclick="toggleFacility(this)">
                                                <input type="checkbox" class="PropertyDetails_facility-checkbox">
                                                <i class="bi bi-info-circle-fill facility-icon"></i>
                                                <span>Helpdesk</span>
                                            </td>
                                            <td class="facility-cell" onclick="toggleFacility(this)">
                                                <input type="checkbox" class="PropertyDetails_facility-checkbox">
                                                <i class="bi bi-building facility-icon"></i>
                                                <span>Lift/Elevator</span>
                                            </td>
                                            <td class="facility-cell"></td>
                                            <td class="facility-cell"></td>
                                        </tr>
                                    </table>
                                </div>

                                <!-- Rules & Regulations -->
                                <div class="col-12">
                                    <label class="form-label">Rules & Regulations - Select rules will be shown to users</label>
                                    <table class="rules-table">
                                        <tr>
                                            <td class="rule-cell">
                                                <div class="rule-wrapper">
                                                    <div class="rule-option selected" onclick="toggleRuleOption(this)">
                                                        <input type="checkbox" class="PropertyDetails_rule-checkbox" checked>
                                                        <i class="bi bi-cup-straw"></i>
                                                        <span>Liquor Allowed</span>
                                                    </div>
                                                    <div class="rule-option" onclick="toggleRuleOption(this)">
                                                        <input type="checkbox" class="PropertyDetails_rule-checkbox">
                                                        <i class="bi bi-cup-straw"></i>
                                                        <span>Liquor Not Allowed</span>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="rule-cell">
                                                <div class="rule-wrapper">
                                                    <div class="rule-option selected" onclick="toggleRuleOption(this)">
                                                        <input type="checkbox" class="PropertyDetails_rule-checkbox" checked>
                                                        <i class="bi bi-egg-fried"></i>
                                                        <span>Outside Caterers Allowed</span>
                                                    </div>
                                                    <div class="rule-option" onclick="toggleRuleOption(this)">
                                                        <input type="checkbox" class="PropertyDetails_rule-checkbox">
                                                        <i class="bi bi-egg-fried"></i>
                                                        <span>Outside Caterers Not Allowed</span>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="rule-cell">
                                                <div class="rule-wrapper">
                                                    <div class="rule-option selected" onclick="toggleRuleOption(this)">
                                                        <input type="checkbox" class="PropertyDetails_rule-checkbox" checked>
                                                        <i class="bi bi-brush"></i>
                                                        <span>Outside Decorator Allowed</span>
                                                    </div>
                                                    <div class="rule-option" onclick="toggleRuleOption(this)">
                                                        <input type="checkbox" class="PropertyDetails_rule-checkbox">
                                                        <i class="bi bi-brush"></i>
                                                        <span>Outside Decorator Not Allowed</span>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="rule-cell">
                                                <div class="rule-wrapper">
                                                    <div class="rule-option selected" onclick="toggleRuleOption(this)">
                                                        <input type="checkbox" class="PropertyDetails_rule-checkbox" checked>
                                                        <i class="bi bi-stars"></i>
                                                        <span>Crackers Allowed</span>
                                                    </div>
                                                    <div class="rule-option" onclick="toggleRuleOption(this)">
                                                        <input type="checkbox" class="PropertyDetails_rule-checkbox">
                                                        <i class="bi bi-stars"></i>
                                                        <span>Crackers Not Allowed</span>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="rule-cell">
                                                <div class="rule-wrapper">
                                                    <div class="rule-option selected" onclick="toggleRuleOption(this)">
                                                        <input type="checkbox" class="PropertyDetails_rule-checkbox" checked>
                                                        <i class="bi bi-fire"></i>
                                                        <span>Hawan Allowed</span>
                                                    </div>
                                                    <div class="rule-option" onclick="toggleRuleOption(this)">
                                                        <input type="checkbox" class="PropertyDetails_rule-checkbox">
                                                        <i class="bi bi-fire"></i>
                                                        <span>Hawan Not Allowed</span>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="rule-cell">
