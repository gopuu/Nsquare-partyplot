@{
    ViewData["Title"] = "Finance Dashboard";
    Layout = "_Layout";
}

<link href="/assets2/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<script src="/assets2/js/jquery.dataTables.min.js"></script>
<script src="/assets2/js/dataTables.bootstrap5.min.js"></script>

@section Styles {
    <link href="~/assets2/css/customdatatable/customdatatable.css" asp-append-version="true" rel="stylesheet" />
    <link href="~/assets2/css/financedashboard/financedashboard.css" rel="stylesheet" asp-append-version="true" />
}

<div class="content">
    <div class="row g-3 mb-4 align-items-center">
        <div class="col d-flex align-items-center">
            <!-- Buttons first -->
            <button class="btn btn-outline-success btn-sm px-5 me-2" id="btn-add-credit-transactions">+ Credit</button>
            <button class="btn btn-outline-danger btn-sm px-5" id="btn-add-debit-transactions">- Debit</button>
        </div>

        <div class="col d-flex justify-content-end">
            <div class="d-flex align-items-center gap-2 flex-wrap chart-filter-finance">

                <!-- Filter Dropdown -->
                <div class="dropdown">
                    <button class="btn btn-outline-secondary btn-sm fw-semibold dropdown-toggle"
                            type="button"
                            id="jobChartFilter"
                            data-bs-toggle="dropdown"
                            aria-expanded="false">
                        Filter : This Month
                    </button>

                    <ul class="dropdown-menu shadow-sm" aria-labelledby="jobChartFilter">
                        <li><a class="dropdown-item sort-option" data-value="yesterday" href="#">Yesterday</a></li>
                        <li><a class="dropdown-item sort-option" data-value="last7days" href="#">Last 7 days</a></li>
                        <li><a class="dropdown-item sort-option" data-value="last30days" href="#">Last 30 days</a></li>
                        <li><a class="dropdown-item sort-option active" data-value="thismonth" href="#">This Month</a></li>
                        <li><a class="dropdown-item sort-option" data-value="lastmonth" href="#">Last Month</a></li>
                        <li><a class="dropdown-item sort-option" data-value="last12months" href="#">Last 12 Months</a></li>
                        <li><a class="dropdown-item sort-option" data-value="customrange" href="#">Custom Range</a></li>
                    </ul>
                </div>

                <!-- From Date -->
                <input type="date"
                       class="form-control form-control-sm"
                       id="fromDate"
                       style="width: 140px;">

                <!-- To Date -->
                <input type="date"
                       class="form-control form-control-sm"
                       id="toDate"
                       style="width: 140px;">

                <!-- Reset Button -->
                <button class="btn btn-sm btn-outline-danger" id="btnReset">Reset</button>

            </div>
        </div>
    </div>

    <!-- ================= TOP FINANCEw KPIs ================= -->
    <div class="row g-3 mb-2">

        <!-- Total Income -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100 bg-warning-gradient">
                <div class="card-body">

                    <!-- Header -->
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="fw-bold mb-0 text-success custom-tooltip" data-tooltip="Total Revenue for the selected period">Revenue</h6>
                        <h5 class="text-success mb-0">
                            ₹ <span id="txtTotalIncomes" class="fs-7">0</span>
                        </h5>
                    </div>

                    <!-- Breakdown -->
                    <div class="small">

                        <!-- Invoice Income -->
                        <div class="d-flex justify-content-between">
                            <span class="custom-tooltip" data-tooltip="Revenue from invoices generated for selected period events">Invoice Revenue</span>
                            <span id="txtInvoiceIncome">0</span>
                        </div>
                        <div class="progress mb-2" style="height:6px;">
                            <div id="barInvoiceIncome" class="progress-bar bg-success"></div>
                        </div>

                        <!-- Categorised Income -->
                        <div class="d-flex justify-content-between">
                            <span class="custom-tooltip" data-tooltip="Revenue entries have been categorized from credit/income transactions">Categorised Income</span>
                            <span id="txtCategorisedIncome">0</span>
                        </div>
                        <div class="progress" style="height:6px;">
                            <div id="barCategorisedIncome" class="progress-bar bg-info"></div>
                        </div>

                    </div>

                </div>
            </div>
        </div>

        <!-- Total Expenses -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100 bg-warning-gradient">
                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="fw-bold mb-0 text-danger custom-tooltip" data-tooltip="Total Expense for the selected period">Expense</h6>
                        <h5 class="text-danger mb-0">
                            ₹ <span id="txtTotalExpenses" class="fs-7">0</span>
                        </h5>
                    </div>

                    <div class="small">

                        <!-- Purchase Expense -->
                        <div class="d-flex justify-content-between">
                            <span class="custom-tooltip" data-tooltip="Total expenses from inventory purchases for the selected period">Vendor Purchase</span>
                            <span id="txtPurchaseExpense">0</span>
                        </div>
                        <div class="progress mb-2" style="height:6px;">
                            <div id="barPurchaseExpense" class="progress-bar bg-danger"></div>
                        </div>

                        <!-- Categorised Expense -->
                        <div class="d-flex justify-content-between">
                            <span class="custom-tooltip" data-tooltip="Total expenses from inventory purchases for the selected period">Categorised Expense</span>
                            <span id="txtCategorisedExpense">0</span>
                        </div>
                        <div class="progress" style="height:6px;">
                            <div id="barCategorisedExpense" class="progress-bar bg-warning"></div>
                        </div>

                    </div>

                </div>
            </div>
        </div>

        <!-- Net Profit -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100 bg-warning-gradient">
                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">
                        <h6 class="fw-bold mb-0 custom-tooltip" data-tooltip="Net profit has been calculated from total revenue and total expenses">Net Profit/Loss</h6>
                        <h5 id="txtGrossProfit" class="mb-0 fs-7">₹ 0</h5>
                    </div>

                </div>
            </div>
        </div>

    </div>

    <div class="row g-4 mb-3">

        <!-- TXN LIST-->
        <div class="col-lg-12">
            <div class="card shadow-sm h-100">
                <div class="card-body bg-white p-3">

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="mb-0 text-dark fw-semibold">
                            Transactions
                        </h5>
                        <button class="btn btn-light btn-sm border"
                                data-bs-toggle="offcanvas"
                                data-bs-target="#incomeExpenseFilterPanel">
                            <i class="fa fa-filter me-1"></i> Filters
                        </button>
                    </div>

                    <div id="tableMain_Transactions">
                        <table class="table table-striped table-bordered w-100">
                            <thead></thead>
                            <tbody></tbody>
                            <tfoot class="table-light">
                                <tr>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th colspan="7"></th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<!--FILTERS -- START ---->
<div class="offcanvas offcanvas-end" tabindex="-1" id="incomeExpenseFilterPanel">
    <div class="offcanvas-header bg-warning py-2">
        <h5 class="text-secondary text-white">Filters</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
    </div>

    <div class="offcanvas-body">
        <!--TYPE-->
        <div class="mb-3">
            <label class="form-label">TYPE</label>

            <div class="d-flex gap-3">
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="filter_transaction_type" id="type_all" value="ALL" checked>
                    <label class="form-check-label" for="type_all">All</label>
                </div>

                <div class="form-check">
                    <input class="form-check-input" type="radio" name="filter_transaction_type" id="type_income" value="INCOME">
                    <label class="form-check-label text-success" for="type_income">Income</label>
                </div>

                <div class="form-check">
                    <input class="form-check-input" type="radio" name="filter_transaction_type" id="type_expense" value="EXPENSE">
                    <label class="form-check-label text-danger" for="type_expense">Expense</label>
                </div>
            </div>
        </div>

        <!-- INCOME FILTERS -->
        <div class="row g-3" id="incomeFilters">
            <div class="col-md-6 mb-3">
                <label class="form-label text-success">INCOME CATEGORY</label>
                <select id="filter_income_category" class="form-select">
                    <option value="">-- Select Category --</option>
                </select>
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label text-success">INCOME SUB-CATEGORY</label>
                <select id="filter_income_subcategory" class="form-select"></select>
            </div>
        </div>

        <!-- EXPENSE FILTERS -->
        <div class="row g-3" id="expenseFilters">
            <div class="col-md-6 mb-3">
                <label class="form-label text-danger">EXPENSE CATEGORY</label>
                <select id="filter_expense_category" class="form-select">
                    <option value="">-- Select Category --</option>
                </select>
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label text-danger">EXPENSE SUB-CATEGORY</label>
                <select id="filter_expense_subcategory" class="form-select"></select>
            </div>
        </div>

        <!-- ACCOUNT & PAYMENT -->
        <div class="row g-3">
            <!-- ACCOUNT -->
            <div class="col-md-6 mb-3">
                <label class="form-label">ACCOUNT</label>
                <select id="filter_transaction_account" class="form-select ddlAccount">
                    <option value="">All</option>
                </select>
            </div>

            <!-- PAYMENT MODE -->
            <div class="col-md-6 mb-3">
                <label class="form-label">PAYMENT MODE</label>
                <select id="filter_transaction_paymentmode" class="form-select ddlPaymentMode">
                    <option value="">All</option>
                </select>
            </div>
        </div>

        <!-- FILTER - DATE -->
        <div class="row g-3">
            <!-- FROM DATE -->
            <div class="col-md-6">
                <label class="form-label">FROM DATE</label>
                <input type="date" id="filter_transaction_fromdate" class="form-control">
            </div>

            <!-- TO DATE -->
            <div class="col-md-6">
                <label class="form-label">TO DATE</label>
                <input type="date" id="filter_transaction_todate" class="form-control">
            </div>
        </div>

        <!-- FILTER - AMOUNT -->
        <div class="row g-3">

            <!-- FROM AMOUNT -->
            <div class="col-md-6">
                <label class="form-label">FROM AMOUNT</label>

                <div class="input-group">
                    <!-- Rupee Prefix -->
                    <span class="input-group-text">₹</span>
                    <!-- Amount Input -->
                    <input type="number" id="filter_transaction_fromamount" class="form-control" placeholder="0">
                </div>
            </div>

            <!-- TO AMOUNT -->
            <div class="col-md-6">
                <label class="form-label">TO AMOUNT</label>
                <div class="input-group">
                    <!-- Rupee Prefix -->
                    <span class="input-group-text">₹</span>
                    <!-- Amount Input -->
                    <input type="number" id="filter_transaction_toamount" class="form-control" placeholder="0">
                </div>
            </div>

        </div>

        <!--VOUCHER NO-->
        <div class="mb-3">
            <label class="form-label">VOUCHER NO</label>

            <div class="input-group">
                <!-- Prefix -->
                <span class="input-group-text" id="voucherTypeText">
                    ALL (CR + EX)
                </span>

                <!-- Input -->
                <input type="text"
                       id="filter_voucher_no"
                       class="form-control"
                       placeholder="Enter Voucher No">

            </div>
        </div>
    </div>

    <div class="p-3 border-top d-flex justify-content-between">
        <button class="btn btn-outline-secondary"
                id="filter_transaction_reset">
            Reset
        </button>

        <button class="btn btn-warning"
                id="filter_transaction_apply">
            Apply
        </button>
    </div>
</div>
<!--FILTERS -- END ---->

<!--ADD Expense Transactions -- START -->
<div class="modal fade" id="ExpenseTransactionModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <!-- HEADER -->
            <div class="modal-header bg-danger text-white py-2">
                <h5 class="modal-title text-white d-flex align-items-center gap-2">
                    <span id="expenseTitleText">Add Expense</span>

                    <span id="expenseVoucherDisplay"
                          class="badge bg-light text-dark"
                          data-bs-toggle="tooltip"
                          title="Voucher No (Auto Generated)">
                    </span>
                </h5>

                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <!-- BODY -->
            <div class="modal-body">

                <input type="hidden" id="ExpenseTransactionId" value="0">
                <input type="hidden" id="paymentVoucherNo_Expense" />

                <!-- 💸 AMOUNT (PRIMARY FOCUS) -->
                <div class="text-center mb-4">
                    <label class="form-label text-muted">Amount Paid <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <!-- Rupee Prefix -->
                        <span class="input-group-text">₹</span>
                        <!-- Amount Input -->
                        <input type="number" id="txtAmount_Expense" class="form-control text-center fs-3 fw-bold border-danger" placeholder="0">
                    </div>
                </div>

                <!-- 📂 CATEGORY -->
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Category <span class="text-danger">*</span></label>
                        <select id="ddlExpenseCategory" class="form-select"></select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">SubCategory <span class="text-danger">*</span></label>
                        <select id="ddlSubCategory_Expense" class="form-select"></select>
                    </div>
                </div>

                <!-- 💳 DATE + ACCOUNT + MODE -->
                <div class="row g-3 mb-3">
                    <div class="col-md-3">
                        <label class="form-label">Transaction Date <span class="text-danger">*</span></label>
                        <input type="date" id="txtTransactionDate_Expense" class="form-control">
                    </div>

                    <div class="col-md-5">
                        <label class="form-label">Paid From <span class="text-danger">*</span></label>
                        <select id="ddlAccount_Expense" class="form-select ddlAccount"></select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Payment Mode <span class="text-danger">*</span></label>
                        <select class="form-select ddlPaymentMode" id="txtPaymentMode_Expense"></select>
                    </div>
                </div>

                <!-- 💳 PAYMENT DETAILS (Conditional Section) -->
                <div class="border rounded p-3 bg-light d-none" id="expensePaymentSection">
                    <h6 class="mb-3 text-muted">Payment Details</h6>

                    <div class="row g-2">
                        <div class="col-md-5 expensePayment_Fields" id="expense_txnId_wrap">
                            <label class="form-label">Transaction ID</label>
                            <input type="text" id="txtTransactionId_Expense" class="form-control">
                        </div>

                        <div class="col-md-5 expensePayment_Fields" id="expense_bank_wrap">
                            <label class="form-label">Bank</label>
                            <input type="text" id="paymentChequebank_Expense" class="form-control">
                        </div>

                        <div class="col-md-4 expensePayment_Fields" id="expense_chequeNo_wrap">
                            <label class="form-label">Cheque No</label>
                            <input type="text" id="paymentChequeNo_Expense" class="form-control">
                        </div>

                        <div class="col-md-3 expensePayment_Fields" id="expense_chequeDate_wrap">
                            <label class="form-label">Cheque Date</label>
                            <input type="date" id="paymentChequeDate_Expense" class="form-control">
                        </div>
                    </div>
                </div>

                <div class="row mt-3">

                    <!-- FILE UPLOAD (3 columns) -->
                    <div class="col-md-6">
                        <label class="form-label">Attachment (Expense Invoice)</label>

                        <div class="input-group">
                            <input type="file"
                                   id="BillFile_Expense"
                                   class="form-control"
                                   accept="image/*,application/pdf" />

                            <button type="button"
                                    class="btn btn-outline-danger"
                                    onclick="resetFile('#BillFile_Expense', '#BillFileBase64_Expense')">
                                <i class="fa fa-times"></i>
                            </button>
                        </div>

                        <input type="hidden" id="BillFileBase64_Expense" />
                    </div>

                    <!-- NOTES (9 columns) -->
                    <div class="col-md-6">
                        <label class="form-label">Notes</label>
                        <textarea id="txtNotes_Expense"
                                  class="form-control"
                                  rows="2"
                                  placeholder="Optional..."></textarea>
                    </div>

                </div>

                <!-- ℹ️ INFO -->
                <div class="form-text mt-3 text-primary">
                    Note: Selecting accurate Category, Subcategory, Source & Mode ensures better tracking and insights.
                </div>

            </div>

            <!-- FOOTER -->
            <div class="modal-footer">
                <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-danger px-4" id="btnSaveExpenseTransaction">
                    Save Expense
                </button>
            </div>

        </div>
    </div>
</div>
<!--ADD Expense Transactions -- END -->

<!--ADD Income Transactions -- START -->
<div class="modal fade" id="incomeTransactionModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <!-- HEADER -->
            <div class="modal-header bg-success text-white py-2">
                <h5 class="modal-title text-white d-flex align-items-center gap-2">
                    <span id="incomeTitleText">Add Income</span>

                    <span id="incomeVoucherDisplay"
                          class="badge bg-light text-dark"
                          data-bs-toggle="tooltip"
                          title="Voucher No (Auto Generated)">
                    </span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <!-- BODY -->
            <div class="modal-body">

                <input type="hidden" id="incomeTransactionId" value="0">
                <input type="hidden" id="paymentVoucherNo_Income" />

                <!-- 💰 AMOUNT (PRIMARY) -->
                <div class="text-center mb-4">
                    <label class="form-label text-muted">Amount <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <!-- Rupee Prefix -->
                        <span class="input-group-text">₹</span>
                        <!-- Amount Input -->
                        <input type="number" id="txtAmount_Income" class="form-control text-center fs-3 fw-bold border-success" placeholder="0">
                    </div>

                </div>

                <!-- 📂 CATEGORY -->
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Category <span class="text-danger">*</span></label>
                        <select id="ddlIncomeCategory" class="form-select"></select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">SubCategory <span class="text-danger">*</span></label>
                        <select id="ddlSubCategory_Income" class="form-select"></select>
                    </div>
                </div>

                <!-- 👤 DATE + RECEIVER + MODE -->
                <div class="row g-3 mb-3">
                    <div class="col-md-3">
                        <label class="form-label">Transaction Date <span class="text-danger">*</span></label>
                        <input type="date" id="txtTransactionDate_Income" class="form-control">
                    </div>

                    <div class="col-md-5">
                        <label class="form-label">Received In <span class="text-danger">*</span></label>
                        <select id="ddlAccount_Income" class="form-select ddlAccount"></select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Payment Mode <span class="text-danger">*</span></label>
                        <select class="form-select ddlPaymentMode" id="txtPaymentMode_Income"></select>
                    </div>
                </div>

                <!-- 💳 PAYMENT DETAILS (conditional) -->
                <div class="border rounded p-3 bg-light d-none" id="incomePaymentSection">
                    <h6 class="mb-3 text-muted">Payment Details</h6>

                    <div class="row g-2">
                        <div class="col-md-5 incomePayment_Fields" id="income_txnId_wrap">
                            <label class="form-label">Transaction ID</label>
                            <input type="text" id="txtTransactionId_Income" class="form-control">
                        </div>

                        <div class="col-md-5 incomePayment_Fields" id="income_bank_wrap">
                            <label class="form-label">Bank</label>
                            <input type="text" id="paymentChequebank_Income" class="form-control">
                        </div>

                        <div class="col-md-4 incomePayment_Fields" id="income_chequeNo_wrap">
                            <label class="form-label">Cheque No</label>
                            <input type="text" id="paymentChequeNo_Income" class="form-control">
                        </div>

                        <div class="col-md-3 incomePayment_Fields" id="income_chequeDate_wrap">
                            <label class="form-label">Cheque Date</label>
                            <input type="date" id="paymentChequeDate_Income" class="form-control">
                        </div>
                    </div>
                </div>

                <div class="row mt-3 align-items-end">

                    <!-- FILE UPLOAD (3 columns) -->
                    <div class="col-md-6">
                        <label class="form-label">Attachment (Income Invoice)</label>

                        <div class="input-group">
                            <input type="file"
                                   id="BillFile_Income"
                                   class="form-control"
                                   accept="image/*,application/pdf" />

                            <button type="button"
                                    class="btn btn-outline-danger"
                                    onclick="resetFile('#BillFile_Income', '#BillFileBase64_Income')">
                                <i class="fa fa-times"></i>
                            </button>
                        </div>

                        <input type="hidden" id="BillFileBase64_Income" />
                    </div>

                    <!-- NOTES (9 columns) -->
                    <div class="col-md-6">
                        <label class="form-label">Notes</label>
                        <textarea id="txtNotes_Income"
                                  class="form-control"
                                  rows="2"
                                  placeholder="Optional..."></textarea>
                    </div>

                </div>

                <!-- ℹ️ INFO -->
                <div class="form-text mt-3 text-primary">
                    Note: Selecting accurate Category, Subcategory, Receiver & Mode ensures better tracking and insights.
                </div>

            </div>

            <!-- FOOTER -->
            <div class="modal-footer">
                <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-success px-4" id="btnSaveIncomeTransaction">
                    Save Transaction
                </button>
            </div>

        </div>
    </div>
</div>
<!--ADD Income Transactions -- END -->

<!-- DELETE Income-->
<div class="modal fade zoomIn" id="deleteRecordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning py-2">
                <h5 class="modal-title text-white" id="deleteRecordModalLabel">Delete Confirmation</h5> <!-- Added Title -->
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" id="btn-close"></button>
            </div>
            <div class="modal-body">
                <div class="mt-2 text-center">
                    <lord-icon src="/assets2/js/gsqxdxog.json" trigger="loop" colors="primary:#f7b84b,secondary:#f06548" style="width:100px;height:100px"></lord-icon>
                    <div class="mt-4 pt-2 fs-15 mx-4 mx-sm-5">
                        <h4>Are you Sure ?</h4>
                        <p class="text-muted mx-4 mb-0">Delete this record?</p>
                    </div>
                </div>
                <div class="d-flex gap-2 justify-content-center mt-4 mb-2">
                    <button type="button" class="btn w-sm btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn w-sm btn-outline-danger" id="delete-record">Yes, Delete It!</button>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- END Income -->

@section Scripts {
    <script src="~/assets2/js/financedashboard/financedashboard.js" asp-append-version="true"></script>
}