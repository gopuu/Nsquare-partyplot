@{
    ViewData["Title"] = "Finance Dashboard";
    Layout = "_Layout";
}

<div class="content">

    <div class="row g-3 mb-4">
        <div class="col-md-12">
            <button class="btn btn-outline-success px-5">+ Credit</button>
            <button class="btn btn-outline-danger me-3 px-5">- Debit</button>
        </div>
    </div>

    <!-- ================= TOP FINANCEw KPIs ================= -->
    <div class="row g-3 mb-4">
        <!-- Total Revenue -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="fw-semibold">Total Revenue</h6>
                    <h3 class="text-success mt-2">
                        <i class="fa fa-inr me-1"></i> 12,45,000
                    </h3>
                    <small class="text-muted">Current Month</small>
                </div>
            </div>
        </div>

        <!-- Outstanding Receivables -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="fw-semibold">Outstanding Receivables</h6>
                    <h3 class="text-warning mt-2">
                        <i class="fa fa-inr me-1"></i> 3,20,000
                    </h3>
                    <small class="text-muted">Pending from clients</small>
                </div>
            </div>
        </div>

        <!-- Total Expenses -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="fw-semibold">Total Expenses</h6>
                    <h3 class="text-danger mt-2">
                        <i class="fa fa-inr me-1"></i> 7,80,000
                    </h3>
                    <small class="text-muted">Purchases + Vendors</small>
                </div>
            </div>
        </div>

        <!-- Net Profit -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100 bg-light">
                <div class="card-body">
                    <h6 class="fw-semibold">Net Profit</h6>
                    <h3 class="text-primary mt-2">
                        <i class="fa fa-inr me-1"></i> 4,65,000
                    </h3>
                    <small class="text-muted">After all expenses</small>
                </div>
            </div>
        </div>

    </div>

    <!-- ================= PAYMENT STATUS ================= -->
    <div class="row g-3 mb-4">

        <!-- Payment Collection -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="fw-semibold mb-3">Payment Collection Status</h6>

                    <div class="d-flex justify-content-between mb-2">
                        <span>Paid</span>
                        <span class="text-success">₹ 8,90,000</span>
                    </div>
                    <div class="progress mb-3">
                        <div class="progress-bar bg-success" style="width:70%"></div>
                    </div>

                    <div class="d-flex justify-content-between mb-2">
                        <span>Partial</span>
                        <span class="text-warning">₹ 2,10,000</span>
                    </div>
                    <div class="progress mb-3">
                        <div class="progress-bar bg-warning" style="width:17%"></div>
                    </div>

                    <div class="d-flex justify-content-between mb-2">
                        <span>Pending</span>
                        <span class="text-danger">₹ 1,45,000</span>
                    </div>
                    <div class="progress">
                        <div class="progress-bar bg-danger" style="width:13%"></div>
                    </div>

                </div>
            </div>
        </div>

        <!-- Upcoming Payments -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="fw-semibold mb-3">Upcoming Payments (Next 7 Days)</h6>

                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between">
                            <span>Wedding – Patel Family</span>
                            <span class="text-danger">₹ 75,000</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <span>Corporate Event – ABC Ltd</span>
                            <span class="text-danger">₹ 1,20,000</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <span>Birthday Party – Shah</span>
                            <span class="text-danger">₹ 45,000</span>
                        </li>
                    </ul>

                </div>
            </div>
        </div>

    </div>

    <!-- ================= VENDOR & EVENT FINANCE ================= -->
    <div class="row g-3">

        <!-- Vendor Payables -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="fw-semibold mb-3">Vendor Payables</h6>

                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Vendor</th>
                                <th>Pending</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Food Supplier</td>
                                <td>₹ 1,50,000</td>
                                <td><span class="badge bg-warning">Pending</span></td>
                            </tr>
                            <tr>
                                <td>Decorator</td>
                                <td>₹ 80,000</td>
                                <td><span class="badge bg-danger">Overdue</span></td>
                            </tr>
                            <tr>
                                <td>Sound & Lights</td>
                                <td>₹ 40,000</td>
                                <td><span class="badge bg-warning">Pending</span></td>
                            </tr>
                        </tbody>
                    </table>

                </div>
            </div>
        </div>

        <!-- Top Revenue Events -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="fw-semibold mb-3">Top Revenue Events</h6>

                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between">
                            <span>Wedding – Patel Family</span>
                            <strong>₹ 4,50,000</strong>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <span>Corporate Gala – ABC Ltd</span>
                            <strong>₹ 3,20,000</strong>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <span>Reception – Mehta</span>
                            <strong>₹ 2,75,000</strong>
                        </li>
                    </ul>

                </div>
            </div>
        </div>

    </div>

</div>
