@{
    ViewData["Title"] = "Finance Dashboard";
    Layout = "_Layout";
}
<link href="/assets2/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<script src="/assets2/js/jquery.dataTables.min.js"></script>
<script src="/assets2/js/dataTables.bootstrap5.min.js"></script>

@section Styles {
    <link href="~/assets2/css/customdatatable/customdatatable.css" asp-append-version="true" rel="stylesheet" />
    <link href="~/assets2/css/financedashboard/financedashboard.css" rel="stylesheet" asp-append-version="true" />
}

<div class="content">
    <div class="row g-3 mb-4 align-items-center">
        <div class="col d-flex align-items-center">
            <!-- Buttons first -->
            <button class="btn btn-outline-success px-5 me-2" id="btn-add-credit-transactions">+ Credit</button>
            <button class="btn btn-outline-danger px-5" id="btn-add-debit-transactions">- Debit</button>
        </div>

        <div class="col d-flex justify-content-end">
            <div class="d-flex align-items-center gap-2 flex-wrap chart-filter-finance">

                <!-- Filter Dropdown -->
                <div class="dropdown">
                    <button class="btn btn-outline-secondary btn-sm fw-semibold dropdown-toggle"
                            type="button"
                            id="jobChartFilter"
                            data-bs-toggle="dropdown"
                            aria-expanded="false">
                        Filter : This Month
                    </button>

                    <ul class="dropdown-menu shadow-sm" aria-labelledby="jobChartFilter">
                        <li><a class="dropdown-item sort-option" data-value="yesterday" href="#">Yesterday</a></li>
                        <li><a class="dropdown-item sort-option" data-value="days" href="#">Last 7 Days</a></li>
                        <li><a class="dropdown-item sort-option" data-value="lastdays" href="#">Last 30 Days</a></li>
                        <li><a class="dropdown-item sort-option active" data-value="thismonth" href="#">This Month</a></li>
                        <li><a class="dropdown-item sort-option" data-value="lastmonth" href="#">Last Month</a></li>
                        <li><a class="dropdown-item sort-option" data-value="12months" href="#">Last 12 Months</a></li>
                        <li><a class="dropdown-item sort-option" data-value="customrange" href="#">Custom Range</a></li>
                    </ul>
                </div>

                <!-- From Date -->
                <input type="date"
                       class="form-control form-control-sm"
                       id="fromDate"
                       style="width: 140px;">

                <!-- To Date -->
                <input type="date"
                       class="form-control form-control-sm"
                       id="toDate"
                       style="width: 140px;">

                <!-- Reset Button -->
                <button class="btn btn-sm btn-outline-danger"
                        id="btnReset">
                    Reset
                </button>

            </div>

        </div>
    </div>

    <!-- ================= TOP FINANCEw KPIs ================= -->
    <div class="row g-3 mb-2">

        <!-- Total Revenue -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="fw-semibold text-success"
                        data-bs-toggle="tooltip"
                        data-bs-placement="top"
                        title="Sum of GST Invoices (Grand Total) + Income Transactions within selected date range.">
                        Total Revenue
                    </h6>
                    <h3 class="text-success mt-2">
                        <i class="fa fa-inr me-1"></i>
                        <span id="txtTotalRevenue">0</span>
                    </h3>
                    <small class="text-muted d-none" id="lblRevenueDuration">Current Month</small>
                </div>
            </div>
        </div>

        <!-- Outstanding Receivables -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="fw-semibold text-warning"
                        data-bs-toggle="tooltip"
                        data-bs-placement="top"
                        title="Total Payable Amount from bookings minus total payments received from clients.">
                        Outstanding Receivables
                    </h6>
                    <h3 class="text-warning mt-2">
                        <i class="fa fa-inr me-1"></i>
                        <span id="txtOutstanding">0</span>
                    </h3>
                    <small class="text-muted d-none">Pending from clients</small>
                </div>
            </div>
        </div>

        <!-- Total Expenses -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="fw-semibold text-danger"
                        data-bs-toggle="tooltip"
                        data-bs-placement="top"
                        title="Purchase payments + Direct expense transactions recorded in selected period.">
                        Total Expenses
                    </h6>
                    <h3 class="text-danger mt-2">
                        <i class="fa fa-inr me-1"></i>
                        <span id="txtExpenses">0</span>
                    </h3>
                    <small class="text-muted d-none">Purchases + Vendors</small>
                </div>
            </div>
        </div>

        <!-- Net Profit -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="fw-semibold"
                        data-bs-toggle="tooltip"
                        data-bs-placement="top"
                        title="Total Revenue minus Total Expenses for the selected period.">
                        Net Profit
                    </h6>
                    <h3 class="mt-2" id="netProfitWrapper">
                        <i class="fa fa-inr me-1"></i>
                        <span id="txtNetProfit">0</span>
                    </h3>
                    <small class="text-muted d-none">After all expenses</small>
                </div>
            </div>
        </div>

    </div>

    <div class="row g-4 mb-3">

        <!-- INCOME TXN -->
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-body bg-white p-3">

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="mb-0 text-success fw-semibold">
                            Income Transactions
                        </h5>
                        <button class="btn btn-light btn-sm border"
                                data-bs-toggle="offcanvas"
                                data-bs-target="#incomeFilterPanel">
                            <i class="fa fa-filter me-1"></i> Filters
                        </button>
                    </div>

                    <div id="tableMain_Income">
                        <table class="table table-striped table-bordered w-100"></table>
                    </div>

                </div>
            </div>
        </div>

        <!-- EXPENSE TXN -->
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-body bg-white p-3">

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="mb-0 text-danger fw-semibold">
                            Expense Transactions
                        </h5>
                        <button class="btn btn-light btn-sm border"
                                data-bs-toggle="offcanvas"
                                data-bs-target="#expenseFilterPanel">
                            <i class="fa fa-filter me-1"></i> Filters
                        </button>
                    </div>

                    <div id="tableMain_Expense">
                        <table class="table table-striped table-bordered w-100"></table>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<!--FILTERS -- START ---->
<div class="offcanvas offcanvas-end" tabindex="-1" id="incomeFilterPanel">
    <div class="offcanvas-header">
        <h5 class="text-success">Filters (Income)</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>

    <div class="offcanvas-body">

        <div class="mb-3">
            <label class="form-label">CATEGORY</label>
            <select id="filter_income_category" class="form-select">
                <option value="">-- Select Category --</option>
                <option value="1">Category 1</option>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">SUB CATEGORY</label>
            <select id="filter_income_subcategory" class="form-select">
                <option value="0">Select Category</option>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">ACCOUNT</label>
            <select id="filter_income_account" class="form-select ddlAccount">
                <option value="">All</option>
                <option value="10">Ac 1</option>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">PAYMENT MODE</label>
            <select id="filter_income_paymentmode" class="form-select ddlPaymentMode">
                <option value="">All</option>
                <option value="10">PM 1</option>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">FROM DATE</label>
            <input type="date" id="filter_income_fromdate" class="form-control">
        </div>

        <div class="mb-3">
            <label class="form-label">TO DATE</label>
            <input type="date" id="filter_income_todate" class="form-control">
        </div>

    </div>

    <div class="p-3 border-top d-flex justify-content-between">
        <button class="btn btn-outline-secondary"
                id="filter_income_reset">
            Reset
        </button>

        <button class="btn btn-success"
                id="filter_income_apply">
            Apply
        </button>
    </div>
</div>

<div class="offcanvas offcanvas-end" tabindex="-1" id="expenseFilterPanel">
    <div class="offcanvas-header">
        <h5 class="text-danger">Filters (Expense)</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>

    <div class="offcanvas-body">

        <div class="mb-3">
            <label class="form-label">CATEGORY</label>
            <select id="filter_expense_category" class="form-select">
                <option value="">-- Select Category --</option>
                <option value="1">Category 1</option>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">SUB CATEGORY</label>
            <select id="filter_expense_subcategory" class="form-select">
                <option value="0">Select Category</option>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">ACCOUNT</label>
            <select id="filter_expense_account" class="form-select ddlAccount">
                <option value="">All</option>
                <option value="10">Ac 1</option>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">PAYMENT MODE</label>
            <select id="filter_expense_paymentmode" class="form-select ddlPaymentMode">
                <option value="">All</option>
                <option value="10">PM 1</option>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">FROM DATE</label>
            <input type="date" id="filter_expense_fromdate" class="form-control">
        </div>

        <div class="mb-3">
            <label class="form-label">TO DATE</label>
            <input type="date" id="filter_expense_todate" class="form-control">
        </div>

    </div>

    <div class="p-3 border-top d-flex justify-content-between">
        <button class="btn btn-outline-secondary"
                id="filter_expense_reset">
            Reset
        </button>

        <button class="btn btn-danger"
                id="filter_expense_apply">
            Apply
        </button>
    </div>
</div>

<!--FILTERS -- END ---->

<!--Expense Transactions -- START -->
<div class="modal fade" id="ExpenseTransactionModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <!-- HEADER -->
            <div class="modal-header bg-danger text-white py-1">
                <h5 class="modal-title text-white" id="ExpenseTransactionModalTitle">Add Expense (Debit) Transaction</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <!-- BODY -->
            <div class="modal-body">
                <input type="hidden" id="ExpenseTransactionId" value="0">

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Category<span class="text-danger">*</span></label>
                        <select id="ddlExpenseCategory" class="form-select">
                            <option value="">-- Select Category --</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">SubCategory</label>
                        <select id="ddlSubCategory_Expense" class="form-select">
                            <option value="">-- Select SubCategory --</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Amount<span class="text-danger">*</span></label>
                        <input type="number" id="txtAmount_Expense" class="form-control" placeholder="Enter Amount">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Account<span class="text-danger">*</span></label>
                        <select id="ddlAccount_Expense" class="form-select ddlAccount">
                            <option value="">-- Select Account --</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Transaction Date<span class="text-danger">*</span></label>
                        <input type="date" id="txtTransactionDate_Expense" class="form-control">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Payment Mode</label>
                        <select class="form-select ddlPaymentMode" id="txtPaymentMode_Expense"></select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Transaction Id </label>
                        <input type="text" id="txtTransactionId_Expense" class="form-control" placeholder="Enter Txn No">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Voucher No</label>
                        <input type="text" id="paymentVoucherNo_Expense" class="form-control" placeholder="Enter Voucher No">
                    </div>

                    <div class="col-md-12">
                        <label class="form-label">Cheque Bank</label>
                        <input type="text" id="paymentChequebank_Expense" class="form-control" placeholder="Enter Cheque Bank">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Cheque No</label>
                        <input type="text" id="paymentChequeNo_Expense" class="form-control" placeholder="Cheque No">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Cheque Date</label>
                        <input type="date" id="paymentChequeDate_Expense" class="form-control">
                    </div>

                    <!-- Notes Full Width -->
                    <div class="col-md-12">
                        <label class="form-label">Notes</label>
                        <textarea id="txtNotes_Expense" class="form-control" rows="3"></textarea>
                    </div>
                </div>
            </div>
            <!-- FOOTER -->
            <div class="modal-footer">
                <button class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Close</button>
                <button class="btn btn-danger btn-sm" id="btnSaveExpenseTransaction">Save</button>
            </div>
        </div>
    </div>
</div>
<!--Expense Transactions -- END -->

<!--Income Transactions -- START -->
<div class="modal fade" id="incomeTransactionModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <!-- HEADER -->
            <div class="modal-header bg-success text-white py-1">
                <h5 class="modal-title text-white" id="incomeTransactionModalTitle">Add Income Transaction</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <!-- BODY -->
            <div class="modal-body">
                <input type="hidden" id="incomeTransactionId" value="0">

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Category<span class="text-danger">*</span></label>
                        <select id="ddlIncomeCategory" class="form-select">
                            <option value="">-- Select Category --</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">SubCategory</label>
                        <select id="ddlSubCategory_Income" class="form-select">
                            <option value="">-- Select SubCategory --</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Amount<span class="text-danger">*</span></label>
                        <input type="number" id="txtAmount_Income" class="form-control" placeholder="Enter Amount">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Account<span class="text-danger">*</span></label>
                        <select id="ddlAccount_Income" class="form-select ddlAccount">
                            <option value="">-- Select Account --</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Transaction Date<span class="text-danger">*</span></label>
                        <input type="date" id="txtTransactionDate_Income" class="form-control">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Payment Mode</label>
                        <select class="form-select ddlPaymentMode" id="txtPaymentMode_Income"></select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Transaction Id </label>
                        <input type="text" id="txtTransactionId_Income" class="form-control" placeholder="Enter Txn No">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Voucher No</label>
                        <input type="text" id="paymentVoucherNo_Income" class="form-control" placeholder="Enter Voucher No">
                    </div>

                    <div class="col-md-12">
                        <label class="form-label">Cheque Bank</label>
                        <input type="text" id="paymentChequebank_Income" class="form-control" placeholder="Enter Cheque Bank">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Cheque No</label>
                        <input type="text" id="paymentChequeNo_Income" class="form-control" placeholder="Cheque No">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Cheque Date</label>
                        <input type="date" id="paymentChequeDate_Income" class="form-control">
                    </div>

                    <div class="col-md-12">
                        <label class="form-label">Notes</label>
                        <textarea id="txtNotes_Income" class="form-control" rows="3"></textarea>
                    </div>
                </div>
            </div>

            <!-- FOOTER -->
            <div class="modal-footer">
                <button class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Close</button>
                <button class="btn btn-success btn-sm" id="btnSaveIncomeTransaction">Save</button>
            </div>
        </div>
    </div>
</div>
<!--Income Transactions -- END -->

<!-- DELETE Income-->
<div class="modal fade zoomIn" id="deleteRecordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title text-white" id="deleteRecordModalLabel">Delete Confirmation</h5> <!-- Added Title -->
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" id="btn-close"></button>
            </div>
            <div class="modal-body">
                <div class="mt-2 text-center">
                    <lord-icon src="/assets/js/gsqxdxog.json" trigger="loop" colors="primary:#f7b84b,secondary:#f06548" style="width:100px;height:100px"></lord-icon>
                    <div class="mt-4 pt-2 fs-15 mx-4 mx-sm-5">
                        <h4>Are you Sure ?</h4>
                        <p class="text-muted mx-4 mb-0">Delete this record?</p>
                    </div>
                </div>
                <div class="d-flex gap-2 justify-content-center mt-4 mb-2">
                    <button type="button" class="btn w-sm btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn w-sm btn-outline-danger" id="delete-record">Yes, Delete It!</button>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- END Income -->

<!--Income Transactions -- END -->

@section Scripts {
    <script src="~/assets2/js/financedashboard/financedashboard.js" asp-append-version="true"></script>
}