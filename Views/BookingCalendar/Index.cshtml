@{
    ViewData["Title"] = "Booking Calendar";
    Layout = "_Layout";
}
<link href="/assets2/css/bootstrap.min.css" rel="stylesheet">
<script src="/assets2/js/bootstrap.bundle.min.js"></script>
<link href="/assets2/css/custom/bookingcalendar.css" rel="stylesheet">

<!--Booking View MODAL-->
<style>
    .card-body .d-flex:hover {
        background-color: #f8f9fa;
        transition: 0.15s ease-in-out;
    }
</style>

<!-- Main -->
<div class="content">
    <div class="pb-5">
        <div class="row g-4">
            <div class="col-12">
                <div class="mb-12">
                    <!-- Title + Controls -->
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h4 class="mb-0">Booking Calendar</h4>
                        <div class="d-flex gap-2">
                            <button class="btn btn-outline-primary btn-sm d-none" id="bookmapBtn">Bookmap</button>
                            <button class="btn btn-outline-secondary btn-sm" id="toggleViewBtn">List View</button>
                            <button class="btn btn-dark btn-sm d-none">Block</button>
                            <select class="form-select form-select-sm" id="yearSelect" style="width: 100px;"></select>
                            <div class="btn-group" id="monthButtons"></div>
                        </div>
                    </div>

                    <!-- Calendar View -->
                    <div class="container-fluid py-3" id="calendarView">
                        <div class="scroll-wrapper">
                            <div class="d-flex flex-column" id="booking-board"></div>
                        </div>
                    </div>

                    <!-- List View -->
                    <div class="container-fluid py-3 d-none" id="listView">
                        <table class="table table-bordered table-striped" id="listTable">
                            <thead class="table-dark">
                                <tr>
                                    <th>Date</th>
                                    <th>Day</th>
                                    <th>Enquiries</th>
                                    <th>Resource</th>
                                    <th>Shift Details</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>

                    <!-- Legend -->
                    <div class="d-flex flex-wrap mt-1 gap-3 justify-content-center">
                        <span class="badge bg-success p-2">Available</span>
                        <span class="badge bg-secondary p-2">Past Dates</span>
                        <span class="badge bg-danger p-2">Confirmed Booking</span>
                        <span class="badge bg-primary p-2">Online Booking</span>
                        <span class="badge bg-light text-dark p-2 border">Tentative Booking</span>
                        <span class="badge bg-dark p-2">Blocked</span>
                        <span class="badge bg-pink p-2">Mahurats</span>
                    </div>

                    <!-- Shift Abbreviations -->
                    <div class="alert alert-secondary p-2 m-2 ml-5">
                        <b>Shift Abbreviations:</b> FD-Full Day, MO-Morning, AF-Afternoon, EV-Evening, ON-Overnight, BF-Breakfast, LN-Lunch, HT-High Tea, DN-Dinner
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<!-- Booking Modal -->
<div class="modal fade" id="bookingModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-primary">
                <h5 class="modal-title text-white">Booking Details</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <form id="bookingForm">
                    <div class="row g-3 align-items-center mb-1">
                        <input type="hidden" id="BookingId" value="0">
                        <!-- Event Date (Left) -->
                        <div class="col-md-6">
                            <label class="form-label fw-bold fs-6 text-primary"> Event Date:</label>
                            <span class="text-danger fw-bold" id="label_date_shift" data-eventdate="2025-02-24" data-shiftid="1">24-Feb-2025, Fullday Slot</span>
                        </div>

                        <!-- GST Toggle (Right) -->
                        <div class="col-md-6 d-flex justify-content-end align-items-center">
                            <label class="form-label me-2 mb-0 fs-6 text-primary">Accept GST:</label>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="gstSwitch">
                                <label class="form-check-label" for="gstSwitch">
                                    <span id="gstSwitchText" class="text-danger fw-bold">Off</span>
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <!-- Event & Banquet Info -->
                        <!--banquetDropdown-->
                        <div class="col-md-2">
                            <label class="form-label">Banquets</label>
                            <select class="form-select" id="banquetDropdown">
                                <option value="0">Full Property</option>
                            </select>
                        </div>
                        <!--fromDate-->
                        <div class="col-md-2">
                            <label class="form-label">From Date</label>
                            <input type="date" class="form-control" id="fromDate">
                        </div>
                        <!--toDate-->
                        <div class="col-md-2">
                            <label class="form-label">Till Date</label>
                            <input type="date" class="form-control" id="toDate">
                        </div>
                        <!-- Function Start Time -->
                        <div class="col-md-3">
                            <label class="form-label">Function Start Time</label>
                            <div class="d-flex gap-1">
                                <input type="number" class="form-control" placeholder="HH" min="1" max="12" id="startHour" style="width: 100px;" disabled>
                                <input type="number" class="form-control" placeholder="MM" min="0" max="59" id="startMinute" style="width: 100px;" disabled>
                                <select class="form-select" id="startAMPM" style="width: 100px;" disabled>
                                    <option value="AM">AM</option>
                                    <option value="PM">PM</option>
                                </select>
                            </div>
                        </div>
                        <!-- Function End Time -->
                        <div class="col-md-3">
                            <label class="form-label">Function End Time</label>
                            <div class="d-flex gap-1">
                                <input type="number" class="form-control" placeholder="HH" min="1" max="12" id="endHour" style="width: 100px;" disabled>
                                <input type="number" class="form-control" placeholder="MM" min="0" max="59" id="endMinute" style="width: 100px;" disabled>
                                <select class="form-select" id="endAMPM" style="width: 100px;" disabled>
                                    <option value="AM">AM</option>
                                    <option value="PM">PM</option>
                                </select>
                            </div>
                        </div>

                        <!-- Client Info -->
                        <div class="col-md-3">
                            <label class="form-label">Select Client</label>
                            <select class="form-select" id="clientEnquiryDropdown">
                                <option>-- Select --</option>
                            </select>
                        </div>
                        <!-- Client Name-->
                        <div class="col-md-5">
                            <label class="form-label">Client Name</label>
                            <input type="text" class="form-control" placeholder="Enter Client Name" id="clientName">
                        </div>
                        <!-- Client Email-->
                        <div class="col-md-4">
                            <label class="form-label">Email</label>
                            <input type="email" class="form-control" placeholder="Enter Client Email" id="clientEmail">
                        </div>
                        <!-- Client Address-->
                        <div class="col-md-3">
                            <label class="form-label">Address</label>
                            <textarea class="form-control" rows="1" placeholder="Enter Client Address" id="clientAddress"></textarea>
                        </div>
                        <!-- Client Contact-->
                        <div class="col-md-3">
                            <label class="form-label">Contact</label>
                            <input type="text" class="form-control" placeholder="Enter Client Contact" id="clientContact" maxlength="10">
                        </div>
                        <!-- Client GSTIN-->
                        <div class="col-md-3">
                            <label class="form-label">Client's GSTIN</label>
                            <input type="text" class="form-control" placeholder="Enter Client GSTIN" id="clientGSTIN">
                        </div>
                        <!-- State Dropdown-->
                        <div class="col-md-3">
                            <label class="form-label">Client's State</label>
                            <select class="form-select" id="clientStateDropdown">
                                <option value="0">Select</option>
                            </select>
                        </div>

                        <!-- Booking Details -->
                        <div class="col-12 mb-1">
                            <h6 class="text-primary">Booking Details</h6>
                            <div class="row g-2 align-items-end">
                                <!-- Event (Dropdown, width 3) -->
                                <div class="col-md-3">
                                    <label class="form-label">Event</label>
                                    <select class="form-select" id="booking_subEventDropdown"></select>
                                </div>

                                <!-- Pax (Input, width 2) -->
                                <div class="col-md-2">
                                    <label class="form-label">Pax</label>
                                    <input type="number" class="form-control" value="0" id="booking_pax">
                                </div>

                                <!-- Hall Rent (Input, width 2) -->
                                <div class="col-md-2">
                                    <label class="form-label">Hall Rent</label>
                                    <input type="number" class="form-control" value="0" id="booking_hallRent">
                                </div>

                                <!-- GST (Input, width 2) -->
                                <div class="col-md-2">
                                    <label class="form-label">GST</label>
                                    <input type="number" class="form-control" value="0" disabled id="booking_gst">
                                </div>

                                <!-- Reference (Dropdown, width 3) -->
                                <div class="col-md-3">
                                    <label class="form-label">Reference</label>
                                    <select class="form-select" id="booking_leadReferenceDropdown"></select>
                                </div>
                            </div>
                        </div>

                        <!-- Food Package -->
                        <div class="col-12">
                            <label class="form-label">Select Menu Type</label>
                            <!-- Menu Type - Chef/Choice-->
                            <div class="d-flex gap-4 mt-1">
                                <!-- Choice Menu -->
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="menuType" id="foodPackage_choiceMenu" value="1" checked>
                                    <label class="form-check-label" for="foodPackage_choiceMenu">Choice Menu</label>
                                    <i class="fa fa-info-circle ms-1 text-primary" data-bs-toggle="tooltip" data-bs-placement="top" title="Choice Menu: You select the items from menu"></i>
                                </div>

                                <!-- Chef Menu -->
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="menuType" id="foodPackage_chefMenu" value="2">
                                    <label class="form-check-label" for="foodPackage_chefMenu">Chef Menu</label>
                                    <i class="fa fa-info-circle ms-1 text-primary" data-bs-toggle="tooltip" data-bs-placement="top" title="Chef Menu: Chef decide's the menu"></i>
                                </div>
                            </div>

                            <div id="foodPackageContainer">
                                <!-- Default first row -->
                                <div class="row g-2 food-row align-items-end">
                                    <!-- Food Package Dropdown -->
                                    <div class="col-md-3">
                                        <label class="form-label">Food Package</label>
                                        <select class="form-select foodPackageDropdown" id="foodPackage_PackageDropdown"></select>
                                        <input type="hidden" class="package_row_id" value="0" />
                                    </div>

                                    <!-- Per Plate -->
                                    <div class="col-md-1">
                                        <label class="form-label">Per Plate</label>
                                        <input type="number" class="form-control" placeholder="Per Plate" value="0" id="foodPackage_RatePerPlate">
                                    </div>

                                    <!-- Package Cost -->
                                    <div class="col-md-2">
                                        <label class="form-label">Package Cost</label>
                                        <input type="number" class="form-control" placeholder="Package Cost" value="0" id="foodPackage_PackageCost" disabled>
                                    </div>

                                    <!-- Addons -->
                                    <div class="col-md-1">
                                        <label class="form-label">Addons</label>
                                        <input type="number" class="form-control" placeholder="Addons" value="0" id="foodPackage_Addons" disabled>
                                    </div>

                                    <!-- GST -->
                                    <div class="col-md-1">
                                        <label class="form-label">GST</label>
                                        <input type="number" class="form-control" placeholder="GST" value="0" id="foodPackage_GST" disabled>
                                    </div>

                                    <!-- Addons Button + Total -->
                                    <div class="col-md-4 d-flex align-items-center justify-content-between">
                                        <button type="button" class="btn btn-outline-success btn-sm me-2 foodPackage_AddOnItems" onclick="event.preventDefault(); openAddonModal(0, this)">
                                            <i class="fa fa-check"></i> Addons
                                        </button>
                                        <span class="fw-bold">Total: <span class="foodPackage_TotalValue" id="foodPackage_TotalValue">0</span></span>
                                    </div>
                                </div>
                            </div>
                            <button type="button" id="addFoodBtn" class="btn btn-outline-primary btn-sm mt-2">+ Add more food package</button>
                        </div>

                        <!-- Other Charges -->
                        <div class="col-md-7" id="otherCharges">
                            <!-- Row 1 -->
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="mb-0 text-primary">Other Charges</h6>
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-outline-info btn-sm" id="otherCharges_Reset">Reset to 0</button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm" id="otherCharges_Restore">Restore Defaults</button>
                                </div>
                            </div>

                            <!-- Row 2 -->
                            <div class="row g-2 mb-2">
                                <div class="col-3">
                                    <label class="small">Decoraton</label>
                                    <input type="number" class="form-control" id="OtherCharges_Decoration_Amount" value="0">
                                </div>
                                <div class="col-3">
                                    <label class="small">GST</label>
                                    <input type="number" class="form-control" id="OtherCharges_Decoration_GST" value="0" disabled>
                                </div>
                                <div class="col-3">
                                    <label class="small">Room Charges</label>
                                    <input type="number" class="form-control" id="OtherCharges_RoomCharges_Amount" value="0">
                                </div>
                                <div class="col-3">
                                    <label class="small">GST</label>
                                    <input type="number" class="form-control" id="OtherCharges_RoomCharges_GST" value="0" disabled>
                                </div>
                            </div>

                            <!-- Row 3 -->
                            <div class="row g-2 mb-2">
                                <div class="col-3">
                                    <label class="small">Sound System</label>
                                    <input type="number" class="form-control" id="OtherCharges_SoundSystem_Amount" value="0">
                                </div>
                                <div class="col-3">
                                    <label class="small">GST</label>
                                    <input type="number" class="form-control" id="OtherCharges_SoundSystem_GST" value="0" disabled>
                                </div>
                                <div class="col-3">
                                    <label class="small">Projector & Screen</label>
                                    <input type="number" class="form-control" id="OtherCharges_ProjectorScreen_Amount" value="0">
                                </div>
                                <div class="col-3">
                                    <label class="small">GST</label>
                                    <input type="number" class="form-control" id="OtherCharges_ProjectorScreen_GST" value="0" disabled>
                                </div>
                            </div>

                            <!-- Button to toggle editors -->
                            <div class="mb-2">
                                <button type="button" id="OtherCharges_ToggleEditorsBtn" class="btn btn-outline-success btn-sm w-100">
                                    <i class="fa fa-pen"></i> Booking Note
                                </button>
                            </div>

                            <!-- Container for text editors (hidden by default) -->
                            <div id="OtherCharges_editorsContainer" style="display:none;">

                                <!-- Booking Note - Customer -->
                                <div class="mb-3">
                                    <label class="form-label small">Booking Note - Customer <span class="small">(Printed on FP)</span></label>
                                    <div id="OtherCharges_customerEditor" style="height: 120px;"></div>
                                </div>

                                <!-- Internal Office Note -->
                                <div class="mb-3">
                                    <label class="form-label small">Internal Office Note <span class="small">(Not shared with customer)</span></label>
                                    <div id="OtherCharges_internalEditor" style="height: 120px;"></div>
                                </div>

                            </div>
                        </div>

                        <!-- Payment Summary -->
                        <div class="col-md-5 border-start ps-3">
                            <h6 class="text-primary">Payment Summary</h6>
                            <table class="table table-borderless mb-0">
                                <tr class="fw-bold">
                                    <td>Taxable Amount</td>
                                    <td class="text-end" id="paymentSummary_TaxableAmount">0</td>
                                </tr>
                                <tr>
                                    <td>CGST</td>
                                    <td class="text-end" id="paymentSummary_CGST">0.00</td>
                                </tr>
                                <tr>
                                    <td>SGST</td>
                                    <td class="text-end" id="paymentSummary_SGST">0.00</td>
                                </tr>
                                <tr>
                                    <td>IGST</td>
                                    <td class="text-end" id="paymentSummary_IGST">0.00</td>
                                </tr>
                                <tr>
                                    <td>Total</td>
                                    <td class="text-end" id="paymentSummary_Total">0.00</td>
                                </tr>
                                <tr id="paymentSummary_BookingAmount_Row">
                                    <td>
                                        <div class="d-flex gap-2">
                                            Booking Amount
                                            <select class="form-select form-select-sm" id="paymentSummary_BookingAmount_Type" style="width: 100px;">
                                                <option value="1">Flat</option>
                                                <option value="2">Percent</option>
                                            </select>

                                            <input type="number" class="form-control form-control-sm" value="0" id="paymentSummary_BookingAmount_Amount" style="width:100px;">
                                        </div>
                                    </td>
                                    <td class="text-end" id="paymentSummary_BookingAmount">0</td>
                                </tr>
                                <tr class="table-warning fw-bold">
                                    <td>Payable Amount</td>
                                    <td class="text-end" id="paymentSummary_payableAmount">0</td>
                                </tr>
                            </table>
                        </div>

                        <!-- Booking Type & Agent Checkbox-->
                        <div class="d-flex align-items-center gap-3">
                            <!-- Booking Type -->
                            <div class="d-flex flex-column">
                                <label class="form-label mb-1 ">Booking Type</label>
                                <select class="form-select form-select-sm" id="BookingType">
                                    <option value="1">Confirmed</option>
                                    <option value="2">Tentative</option>
                                </select>
                            </div>

                            <!-- Agent Checkbox -->
                            <div class="form-check mt-4">
                                <input class="form-check-input" type="checkbox" value="" id="AgentCheck">
                                <label class="form-check-label" for="agentCheck">
                                    Agent
                                </label>
                            </div>
                        </div>

                        <!-- Payment Details -->
                        <div class="col-md-12">
                            <h6 class="text-primary">Payment Details</h6>
                            <div class="row g-2">
                                <div class="col-md-3">
                                    <label>Mode</label>
                                    <select class="form-select" id="PaymentDetails_Mode">
                                        <option value="1">Cash</option>
                                        <option value="2">Cheque</option>
                                        <option value="3">Online</option>
                                        <option value="4">Credit/Debit CCard</option>
                                        <option value="5">discount</option>
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label>Amount</label>
                                    <input type="number" class="form-control" value="0" id="PaymentDetails_Amount">
                                </div>
                                <div class="col-md-3">
                                    <label>Paid Time</label>
                                    <input type="time" class="form-control" id="PaymentDetails_PaidTime">
                                </div>
                                <div class="col-md-3">
                                    <label>Due Date</label>
                                    <input type="date" class="form-control" id="PaymentDetails_DueDate" value="2025-02-24">
                                </div>
                                <div class="col-12">
                                    <label>Payment Note</label>
                                    <textarea class="form-control" id="PaymentDetails_PaymentNote"></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" id="btnReset">Reset</button>
                <button type="button" class="btn btn-outline-primary" id="btnBook">Book</button>
            </div>
        </div>
    </div>
</div>

<!--AddOns -- MODAL -- START -->
<div class="modal fade" id="addonChargeModal" tabindex="-1" aria-labelledby="addonChargeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content rounded-3 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold text-white">Select Addon Charges</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <div class="row">
                    <!-- LEFT SIDE (ITEMS) -->
                    <div class="col-md-8 border-end pe-3" style="max-height:70vh; overflow-y:auto;">
                        <div id="addonItemsContainer" class="space-y-3">
                            <!-- Groups & Items will be injected dynamically -->
                        </div>
                    </div>

                    <!-- RIGHT SIDE (SUMMARY) -->
                    <div class="col-md-4 ps-4">
                        <h6 class="fw-bold mb-3">Summary</h6>
                        <div id="headerSummaryContainer" class="mb-3">
                            <!-- HeaderName -> Total will be appended here -->
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between fw-bold fs-5">
                            <span>Total</span>
                            <span id="finalTotal">0</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-outline-primary btn-saveAddOn">Save</button>
            </div>
        </div>
    </div>
</div>
<!--AddOns -- MODAL -- END -->

<!--Menu Item-- MODAL -- START -->
<div class=" modal fade" id="menuModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content rounded-3 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold text-white">Menu Items</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body" id="menuModalBody">
                <!-- Dynamic menus & items will load here -->
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-outline-primary btn-saveMenu">Save</button>
            </div>
        </div>
    </div>
</div>
<!--Menu Item-- MODAL -- END -->

<!-- Booking Info Modal -- START -->
<div class="modal fade" id="bookingReportModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content shadow-lg border-0 rounded-3">

            <!-- 🔹 Header -->
            <div class="modal-header bg-primary py-3 text-white">
                <div class="container-fluid">
                    <div class="row w-100">
                        <div class="col-md-6 d-flex align-items-center">
                            <h5 class="modal-title mb-0 fw-bold text-white">
                                <i class="fa-solid fa-calendar-check me-2 text-white"></i>Booking Information
                            </h5>
                        </div>
                        <div class="col-md-6 text-end">
                            <button class="btn btn-info btn-sm me-2" id="btnDownloadPDF">
                                <i class="fa-solid fa-file-pdf me-1"></i> Download Function Prospect
                            </button>
                            <button class="btn btn-info btn-sm" id="btnPrintProspect">
                                <i class="fa-solid fa-print me-1"></i> Print Function Prospect
                            </button>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 🔹 Hidden booking id -->
            <input type="hidden" id="bookingReport_BookingId" value="0">

            <!-- 🔹 Body -->
            <div class="modal-body bg-white" style="max-height: 75vh; overflow-y: auto;">
                <!--Buttons-->
                <section class="mb-3 p-0">
                    <div class="d-flex flex-wrap gap-2">

                        <button type="button"
                                class="btn btn-outline-danger btn-sm"
                                id="btnFoodLabels"
                                data-foodpackage="">
                            <i class="fa-solid fa-utensils me-1"></i> Food Labels
                        </button>


                        <button type="button" class="btn btn-outline-success btn-sm" id="btnVendorWorkOrders">
                            <i class="fa-solid fa-truck me-1"></i> Vendor Work Orders (0)
                        </button>

