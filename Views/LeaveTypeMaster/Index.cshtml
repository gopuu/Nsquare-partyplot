@{
    ViewData["Title"] = "LeaveType Master";
    Layout = "_Layout";
}

<link href="/assets2/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<script src="/assets2/js/jquery.dataTables.min.js"></script>
<script src="/assets2/js/dataTables.bootstrap5.min.js"></script>

<div class="content">
    <div class="pb-1">
        <div class="row g-2">
            <div class="col-12 col-xxl-8">
                <div class="mb-12">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="mb-0 text-warning">Leave Type Master</h4>
                        <button class="btn btn-outline-warning" id="btn-add">
                            <i class="fa fa-plus-circle"></i> Add Leave Type
                        </button>
                    </div>

                    <div id="tableMain">
                        <table class="table table-striped table-bordered" style="width:100%"></table>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<!-- ADD / EDIT MODAL -->
<div class="modal fade" id="leaveTypeModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning text-white">
                <h5 class="modal-title text-white" id="leaveTypeModalTitle">Add Leave Type</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="leaveTypeId" value="0" />
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label">Leave Type Name <span class="text-danger">*</span></label>
                        <input type="text" id="leaveTypeName" class="form-control" placeholder="Enter Leave Type Name" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Priority No</label>
                        <input type="number" id="priorityNo" class="form-control" placeholder="Enter Priority No" />
                    </div>
                </div>
            </div>
            <div class="modal-footer d-flex justify-content-between align-items-center">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="paidFlagSwitch">
                    <label class="form-check-label" for="paidFlagSwitch">Paid Leave</label>
                </div>
                <div>
                    <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                    <button class="btn btn-outline-warning ms-2" id="btnSaveLeaveType">Save</button>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- DELETE MODAL -->
<div class="modal fade zoomIn" id="deleteRecordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title text-white" id="deleteRecordModalLabel">Delete Confirmation</h5> <!-- Added Title -->
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" id="btn-close"></button>
            </div>
            <div class="modal-body">
                <div class="mt-2 text-center">
                    <lord-icon src="/assets/js/gsqxdxog.json" trigger="loop" colors="primary:#f7b84b,secondary:#f06548" style="width:100px;height:100px"></lord-icon>
                    <div class="mt-4 pt-2 fs-15 mx-4 mx-sm-5">
                        <h4>Are you Sure ?</h4>
                        <p class="text-muted mx-4 mb-0">Delete this record?</p>
                    </div>
                </div>
                <div class="d-flex gap-2 justify-content-center mt-4 mb-2">
                    <button type="button" class="btn w-sm btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn w-sm btn-outline-danger" id="delete-record">Yes, Delete It!</button>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- END MODAL -->


<script>
$(document).ready(function () {
    fetchLeaveTypeData();

    $(document).on('click', '#btn-add', function () {
        const canAdd = (sessionStorage.getItem('CanAdd') || localStorage.getItem('CanAdd')) === 'true';
        if (!canAdd) {
            Swal.fire("Access Denied", "You do not have permission to Add.", "error");
            return;
        }

        resetLeaveTypeForm();
        $('#leaveTypeModalTitle').text('Add Leave Type');
        $('#leaveTypeModal').modal('show');
    });

    $('#btnSaveLeaveType').on('click', function () {
        const name = $('#leaveTypeName').val().trim();
        if (!name) {
            Swal.fire("Validation", "Leave Type Name is required", "warning");
            return;
        }

        const payload = {
            Id: Number($('#leaveTypeId').val() || 0),
            LeaveTypeName: name,
            PaidFlag: $('#paidFlagSwitch').is(":checked"),
            PriorityNo: Number($('#priorityNo').val() || 0),
            ActionBy: sessionStorage.getItem('userId') ?? 0
        };

        $('#btnSaveLeaveType').prop('disabled', true);

        $.ajax({
            url: '/api/LeaveTypeMaster/SaveLeaveTypeMaster',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(payload),
            success: function (res) {
                if (res && res.status === "Success") {

                    Swal.fire({
                        position: "top-end",
                        icon: "success",
                        title: "Saved!",
                        showConfirmButton: false,
                        timer: 1200
                    });

                    $('#leaveTypeModal').modal('hide');
                    fetchLeaveTypeData();
                } else {
                    Swal.fire("Error", res?.message || "Save failed", "error");
                }
            },
            error: function (xhr, status, error) {
                handleApiError(xhr, status, error, "Save Leave Type Error");
            },
            complete: function () {
                $('#btnSaveLeaveType').prop('disabled', false);
            }
        });
    });

    $(document).on('click', '.btn-edit', function () {
    const canEdit = (sessionStorage.getItem('CanEdit') || localStorage.getItem('CanEdit')) === 'true';
    if (!canEdit) {
        Swal.fire("Access Denied", "You do not have permission to Edit.", "error");
        return;
    }

    const table = $('#tableMain table').DataTable();
    const row = $(this).closest('tr');
    const rowData = table.row(row).data();

    resetLeaveTypeForm();

    $('#leaveTypeId').val(rowData.Id);
    $('#leaveTypeName').val(rowData.LeaveTypeName);
    $('#priorityNo').val(rowData.PriorityNo);
    $('#paidFlagSwitch').prop("checked", rowData.PaidFlag);

    $('#leaveTypeModalTitle').text('Edit Leave Type');
    $('#leaveTypeModal').modal('show');

    });

    // Delete button click
    $(document).on('click', '.btn-delete', function () {
        const canDelete = (sessionStorage.getItem('CanDelete') || localStorage.getItem('CanDelete')) === 'true';
        if (!canDelete) {
            Swal.fire("Access Denied", "You do not have permission to Delete.", "error");
            return;
        }
        let table = $('#tableMain table').DataTable();
        let rowData = table.row($(this).closest('tr')).data();
        $("#deleteRecordModal")
            .data("id", rowData.Id)
            .modal("show");
    });

    // Confirm Delete
    $("#delete-record").click(function () {
        let id = $("#deleteRecordModal").data("id");
        let payload = {
            Id: id,
            ActionBy: sessionStorage.getItem("userId") ?? 0
        };
        $('#btn-loader').show();
        $.ajax({
            url: "/api/LeaveTypeMaster/DeleteLeaveTypeMaster",
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify(payload),

            success: function (response) {
                if (typeof response === "string") {
                    response = JSON.parse(response);
                }
                if (response.status === "Success") {

                    Swal.fire({
                        position: "top-end",
                        icon: "success",
                        title: "Leave Type Deleted!",
                        showConfirmButton: false,
                        timer: 1000
                    });

                } else {
                    Swal.fire("Delete Failed", response.message, "error");
                }

                $("#deleteRecordModal").modal("hide");
                fetchLeaveTypeData(); // reload updated list
            },
            error: function (xhr, status, error) {
                handleApiError(xhr, status, error, "Delete Leave Type Error");
            },
            complete: function () {
                $('#btn-loader').hide();
            }
        });
    });
});

function resetLeaveTypeForm() {
$('#leaveTypeId').val(0);
$('#leaveTypeName').val('');
$('#priorityNo').val('');
$('#paidFlagSwitch').prop('checked', false);
}

function fetchLeaveTypeData() {
$.ajax({
    url: '/api/LeaveTypeMaster/GetLeaveTypeMaster',
    type: 'POST',
    contentType: 'application/json',
    data: JSON.stringify({ Id: 0 }),

    success: function (res) {

        const data = (res && res.data) ? res.data : [];
        renderLeaveTypeTable(data);
    },
    error: function (xhr, status, error) {
        handleApiError(xhr, status, error, "Fetch Leave Type Error");
    }
});
}

function renderLeaveTypeTable(data) {

if ($.fn.dataTable.isDataTable('#tableMain table')) {
    $('#tableMain table').DataTable().clear().destroy();
}

if (!data || data.length === 0) {

    $('#tableMain table').DataTable({
        data: [],
        columns: [
            { data: 'srno', title: 'Sr. No.' },
            { data: 'LeaveTypeName', title: 'Leave Type' },
            { data: 'PaidFlag', title: 'Paid?', render: d => d ? 'Yes' : 'No' },
            { data: 'PriorityNo', title: 'Priority' },
            {
                data: null,
                title: 'Actions',
                render: function () {
                    return `
                        <button class="btn btn-outline-warning btn-action-xs btn-sm btn-edit"><i class="fa fa-edit"></i></button>
                        <button class="btn btn-outline-danger btn-action-xs btn-sm btn-delete"><i class="fa fa-trash"></i></button>
                `;
                }
            }
        ],
        pageLength: 10,
        ordering: true,
        searching: true,
        lengthChange: false
    });

    return;
}

data.forEach((x, i) => x.srno = i + 1);

$('#tableMain table').DataTable({
    data: data,
    columns: [
        { data: 'srno', title: 'Sr. No.' },
        { data: 'LeaveTypeName', title: 'Leave Type' },
        {
            data: 'PaidFlag',
            title: 'Paid?',
            render: d => d
                ? `<span class="badge bg-success">Paid</span>`
                : `<span class="badge bg-secondary">Unpaid</span>`
        },
        { data: 'PriorityNo', title: 'Priority' },

        {
            data: null,
            title: 'Actions',
            render: function () {
                return `
                    <div class="d-flex gap-2">
                        <button class="btn btn-outline-warning btn-action-xs btn-edit"><i class="fa fa-edit"></i></button>
                        <button class="btn btn-outline-danger btn-action-xs btn-delete"><i class="fa fa-trash"></i></button>
                    </div>
                `;
            }
        }
    ],
    columnDefs: [{ targets: 0, className: 'text-center' }],
    pageLength: 10,
    ordering: true,
    searching: true,
    lengthChange: false
});
}

</script>
