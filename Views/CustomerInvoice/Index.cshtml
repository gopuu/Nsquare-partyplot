                                </button>

                                <button type="button" id="bookingReport_btnViewAddOns" class="btn btn-outline-success btn-sm d-none">
                                    <i class="fa-solid fa-list me-1"></i> View Primary AddOns
                                </button>

                                <button type="button" id="bookingReport_btnEditAddress" class="btn btn-outline-primary btn-sm d-none">
                                    <i class="fa-solid fa-location-dot me-1"></i> Edit Primary Address
                                </button>

                                <button type="button" id="bookingReport_btnAddPackage" class="btn btn-outline-danger btn-sm d-none">
                                    <i class="fa-solid fa-plus me-1"></i> Add Food Package
                                </button>
                            </div>
                        </div>

                        <!-- 🔹 Card Body -->
                        <div class="card-body p-3 small">
                            <div class="row g-2">
                                <div class="col-12">
                                    <p class="mb-1">
                                        <strong>Food Package:</strong> <span id="bookingReport_FoodPackageName">—</span>
                                    </p>
                                </div>
                                <div class="col-12">
                                    <p class="mb-1">
                                        <strong>Updated By:</strong> <span id="bookingReport_FoodPackageUpdatedBy">—</span>
                                    </p>
                                </div>
                                <div class="col-12">
                                    <p class="mb-0">
                                        <strong>Updated On:</strong> <span id="bookingReport_FoodPackageUpdatedOn">—</span>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- 📋 Other Details -->
                <section class="mb-3 p-0">
                    <div class="card border-0 shadow-sm">
                        <!-- 🔹 Card Header (connected with parent) -->
                        <div class="bg-light border-bottom rounded-top px-3 py-2">
                            <h6 class="fw-bold text-primary mb-0">
                                <i class="fa-solid fa-circle-info me-2 text-primary"></i> Other Details
                            </h6>
                        </div>

                        <!-- 🔹 Card Body -->
                        <div class="card-body p-3 small">
                            <div class="row">
                                <div class="col-12 mb-2">
                                    <p class="mb-1">
                                        <strong>How did you reach us?</strong>
                                        <span id="bookingReport_ReachedUs">—</span>
                                    </p>
                                </div>
                                <div class="col-12">
                                    <p class="mb-0">
                                        <strong>Reference:</strong>
                                        <span id="bookingReport_Reference">—</span>
                                    </p>
