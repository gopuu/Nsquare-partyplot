@{
    ViewData["Title"] = "Customer Invoice";
    Layout = "_Layout";
}

<link href="~/assets2/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<link href="~/assets2/css/customdatatable/customdatatable.css" asp-append-version="true" rel="stylesheet" />
<script src="~/assets2/js/jquery.dataTables.min.js"></script>
<script src="~/assets2/js/dataTables.bootstrap5.min.js"></script>

@section Styles {
    <link href="~/assets2/css/customerinvoice/customerinvoice.css" asp-append-version="true" rel="stylesheet" />
    <link href="~/assets2/css/shared/layout.css" asp-append-version="true" rel="stylesheet" />
}

<!--MAIN-->
<div class="content">
    <div class="pb-1">
        <div class="row">
            <div class="col-12">
                <!-- HEADER -->
                <div class="mb-3 d-flex justify-content-between align-items-center">

                    <!-- LEFT SIDE -->
                    <h4 class="mb-0 fw-bold text-warning">
                        Customer Invoices
                    </h4>

                    <!-- RIGHT SIDE -->
                    <div class="d-flex align-items-center gap-3">

                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" id="toggleWithHeader">
                            <label class="form-check-label fw-semibold" for="toggleWithHeader">
                                With Header
                            </label>
                        </div>

                        <button class="btn btn-outline-info btn-sm" id="btn-select-columns">
                            <i class="fa fa-list-check me-1"></i> Columns
                        </button>

                        <div class="dropdown">
                            <button class="btn btn-outline-dark btn-sm dropdown-toggle"
                                    type="button"
                                    data-bs-toggle="dropdown">
                                <i class="fas fa-download"></i>
                            </button>

                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <a class="dropdown-item" href="javascript:void(0)"
                                       onclick="ViewCustomerInvoiceReport('downloadPDF')">
                                        <i class="fas fa-file-pdf text-danger me-2"></i> PDF
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="javascript:void(0)"
                                       onclick="ViewCustomerInvoiceReport('downloadExcel')">
                                        <i class="fas fa-file-excel text-success me-2"></i> Excel
                                    </a>
                                </li>
                            </ul>
                        </div>

                        <div class="form-check form-switch m-0">
                            <input class="form-check-input" type="checkbox" id="toggleWidgets">
                            <label class="form-check-label ms-2" id="widgetLabel" for="toggleWidgets">
                                Hide Widgets
                            </label>
                        </div>

                    </div>

                </div>
                <!-- ================= PAYMENT WIDGET ================= -->
                <div class="row g-3 mb-4" id="invoiceWidgets">

                    <!-- Payment Collection -->
                    <div class="col-md-3">
                        <div class="card shadow-sm border-0 h-100 kpi-card">

                            <!-- CARD HEADER -->
                            <div class="card-header kpi-header d-flex justify-content-between align-items-center py-2">
                                <h6 class="fw-bold mb-0 text-dark kpi-tooltip" id="paymentCollectionTitle">
                                    <i class="fa fa-chart-line me-1"></i> Payment Collection Status
                                </h6>

                                <div class="dropdown">
                                    <button class="btn btn-xs btn-light dropdown-toggle"
                                            type="button"
                                            id="PaymentChartFilter"
                                            data-bs-toggle="dropdown">
                                        This Month
                                    </button>

                                    <ul class="dropdown-menu shadow-sm" aria-labelledby="PaymentChartFilter">
                                        <li><a class="dropdown-item payment-option" data-value="yesterday" href="#">Yesterday</a></li>
                                        <li><a class="dropdown-item payment-option" data-value="last7days" href="#">Last 7 days</a></li>
                                        <li><a class="dropdown-item payment-option" data-value="last30days" href="#">Last 30 days</a></li>
                                        <li><a class="dropdown-item payment-option active" data-value="thismonth" href="#">This Month</a></li>
                                        <li><a class="dropdown-item payment-option" data-value="lastmonth" href="#">Last Month</a></li>
                                        <li><a class="dropdown-item payment-option" data-value="last12months" href="#">Last 12 Months</a></li>
                                        <li><a class="dropdown-item payment-option" data-value="customrange" href="#">Custom Range</a></li>
                                    </ul>
                                </div>
                            </div>

                            <!-- CARD BODY -->
                            <div class="card-body">

                                <!-- 🔹 Custom Date Range -->
                                <div id="paymentDateRange" class="row g-2 mb-2 d-none">
                                    <div class="col-6">
                                        <input type="date" id="paymentFromDate" class="form-control form-control-sm">
                                    </div>
                                    <div class="col-6">
                                        <input type="date" id="paymentToDate" class="form-control form-control-sm">
                                    </div>
                                </div>

                                <!-- Total Amount -->
                                <div class="kpi-item mb-3" id="totalAmountTitle">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class="d-flex align-items-center">

                                            <div class="kpi-icon bg-primary-subtle text-primary">
                                                <i class="fa fa-wallet"></i>
                                            </div>

                                            <span class="ms-2 small fw-medium text-muted custom-tooltip">
                                                Total Amount
                                            </span>

                                        </div>

                                        <span class="text-primary fw-bold">
                                            ₹ <span id="txtTotalAmount">0</span>
                                        </span>
                                    </div>

                                    <div class="progress mt-2 kpi-progress mb-3">
                                        <div id="barTotal" class="progress-bar bg-primary"></div>
                                    </div>
                                </div>

                                <!-- Payment Received -->
                                <div class="kpi-item mb-3" id="paymentReceivedTitle">
                                    <div class="d-flex justify-content-between align-items-center">

                                        <div class="d-flex align-items-center">
                                            <div class="kpi-icon bg-success-subtle text-success">
                                                <i class="fa fa-arrow-down"></i>
                                            </div>
                                            <span class="ms-2 small fw-medium text-muted custom-tooltip">
                                                Payment Received
                                             </span>
                                        </div>

                                        <span class="text-success fw-bold">
                                            ₹ <span id="txtPaidAmount">0</span>
                                        </span>
                                    </div>

                                    <div class="progress mt-2 kpi-progress mb-3">
                                        <div id="barPaid" class="progress-bar bg-success"></div>
                                    </div>
                                </div>

                                <!-- Payment Pending -->
                                <div class="kpi-item" id="upcomingPaymentTitle">
                                    <div class="d-flex justify-content-between align-items-center">

                                        <div class="d-flex align-items-center">
                                            <div class="kpi-icon bg-danger-subtle text-danger">
                                                <i class="fa fa-hourglass-half"></i>
                                            </div>
                                            <span class="ms-2 small fw-medium text-muted custom-tooltip">
                                                Payment Pending
                                            </span>
                                        </div>

                                        <span class="text-danger fw-bold">
                                            ₹ <span id="txtPendingAmount">0</span>
                                        </span>
                                    </div>

                                    <div class="progress mt-2 kpi-progress">
                                        <div id="barPending" class="progress-bar bg-danger"></div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>

                    <!-- Invoice Status -->
                    <div class="col-md-3">
                        <div class="card shadow-sm border-0 h-100 kpi-card">

                            <!-- CARD HEADER -->
                            <div class="card-header kpi-header d-flex justify-content-between align-items-center py-2">
                                <h6 class="fw-bold mb-0 text-dark kpi-tooltip" id="invoiceStatusTitle">
                                    <i class="fa fa-file-invoice-dollar me-1"></i> Invoice Status
                                </h6>

                                <div class="dropdown">
                                    <button class="btn btn-xs btn-light dropdown-toggle"
                                            type="button"
                                            id="InvoiceChartFilter"
                                            data-bs-toggle="dropdown">
                                        This Month
                                    </button>

                                    <ul class="dropdown-menu shadow-sm" aria-labelledby="InvoiceChartFilter">
                                        <li><a class="dropdown-item invoicestatus-option" data-value="yesterday" href="#">Yesterday</a></li>
                                        <li><a class="dropdown-item invoicestatus-option" data-value="last7days" href="#">Last 7 days</a></li>
                                        <li><a class="dropdown-item invoicestatus-option" data-value="last30days" href="#">Last 30 days</a></li>
                                        <li><a class="dropdown-item invoicestatus-option active" data-value="thismonth" href="#">This Month</a></li>
                                        <li><a class="dropdown-item invoicestatus-option" data-value="lastmonth" href="#">Last Month</a></li>
                                        <li><a class="dropdown-item invoicestatus-option" data-value="last12months" href="#">Last 12 Months</a></li>
                                        <li><a class="dropdown-item invoicestatus-option" data-value="customrange" href="#">Custom Range</a></li>
                                    </ul>
                                </div>
                            </div>

                            <!-- CARD BODY -->
                            <div class="card-body">

                                <!-- 🔹 Custom Date Range -->
                                <div id="invoiceDateRange" class="row g-2 mb-2 d-none">
                                    <div class="col-6">
                                        <input type="date" id="invoiceFromDate" class="form-control form-control-sm">
                                    </div>
                                    <div class="col-6">
                                        <input type="date" id="invoiceToDate" class="form-control form-control-sm">
                                    </div>
                                </div>

                                <!-- Invoice Generated -->
                                <div class="kpi-item mb-3" id="invoiceGeneratedTitle">
                                    <div class="d-flex justify-content-between align-items-center">

                                        <div class="d-flex align-items-center">
                                            <div class="kpi-icon bg-success-subtle text-success">
                                                <i class="fa fa-check-circle"></i>
                                            </div>
                                            <span class="ms-2 small fw-medium text-muted custom-tooltip"
                                                  data-tooltip="">
                                                Invoice Generated
                                            </span>
                                        </div>

                                        <span class="text-success fw-bold">
                                            <span id="txtInvoiceGeneratedCount">0</span>
                                        </span>
                                    </div>

                                    <div class="progress mt-2 kpi-progress mb-3">
                                        <div id="bar_InvoiceGenerated" class="progress-bar bg-success"></div>
                                    </div>
                                </div>

                                <!-- Invoice Pending -->
                                <div class="kpi-item" id="invoicePendingTitle">
                                    <div class="d-flex justify-content-between align-items-center">

                                        <div class="d-flex align-items-center">
                                            <div class="kpi-icon bg-danger-subtle text-danger">
                                                <i class="fa fa-clock"></i>
                                            </div>
                                            <span class="ms-2 small fw-medium text-muted custom-tooltip">
                                                Invoice Pending
                                            </span>
                                        </div>

                                        <span class="text-danger fw-bold">
                                            <span id="txtInvoicePending">0</span>
                                        </span>
                                    </div>

                                    <div class="progress mt-2 kpi-progress">
                                        <div id="bar_InvoicePending" class="progress-bar bg-danger"></div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>

                    <!-- RIGHT SIDE : FILTER -->
                    <div class="col-md-6">
                        <div class="card shadow-sm border-0 h-100" id="filtersSection">

                            <!-- HEADER -->
                            <div class="card-header kpi-header d-flex justify-content-between align-items-center py-2">
                                <h6 class="fw-bold mb-0 text-dark">
                                    <i class="fa fa-filter me-1"></i> Filters
                                </h6>

                                <div class="form-check form-switch m-0">
                                    <input class="form-check-input" type="checkbox" id="toggleWidgets_filter">
                                    <label class="form-check-label ms-2" id="widgetLabel_filter" for="toggleWidgets_filter">
                                        Hide Filter
                                    </label>
                                </div>
                            </div>

                            <!-- BODY -->
                            <div class="card-body">

                                <div class="row g-3" id="invoiceWidgets_filter">

                                    <!-- 🔍 SEARCH (Full Width) -->
                                    <div class="col-md-6">
                                        <label class="form-label">Name / Email / Contact</label>
                                        <input type="text" id="fltSearch"
                                               class="form-control form-control-sm"
                                               placeholder="Search">
                                    </div>

                                    <!-- EVENT -->
                                    <div class="col-md-3">
                                        <label class="form-label">Event</label>
                                        <select id="fltEvent" class="form-select form-select-sm"></select>
                                    </div>

                                    <!-- SLOT -->
                                    <div class="col-md-3">
                                        <label class="form-label">Slot</label>
                                        <select id="fltSlot" class="form-select form-select-sm"></select>
                                    </div>

                                    <!-- 📅 EVENT DATES -->
                                    <div class="col-md-3">
                                        <label class="form-label">Event From</label>
                                        <input type="date" id="fltEventFrom"
                                               class="form-control form-control-sm">
                                    </div>

                                    <div class="col-md-3">
                                        <label class="form-label">Event To</label>
                                        <input type="date" id="fltEventTo"
                                               class="form-control form-control-sm">
                                    </div>

                                    <!-- 📅 BOOKING DATES -->
                                    <div class="col-md-3">
                                        <label class="form-label">Booked From</label>
                                        <input type="date" id="fltBookedFrom"
                                               class="form-control form-control-sm">
                                    </div>

                                    <div class="col-md-3">
                                        <label class="form-label">Booked Till</label>
                                        <input type="date" id="fltBookedTill"
                                               class="form-control form-control-sm">
                                    </div>

                                    <!-- 📊 STATUS -->
                                    <div class="col-md-3">
                                        <label class="form-label">Payment Status</label>
                                        <select id="fltPaymentStatus" class="form-select form-select-s px-2">
                                            <option value="0">All</option>
                                            <option value="1">Payment Pending</option>
                                            <option value="2">Payment Received</option>
                                        </select>
                                    </div>

                                    <div class="col-md-3">
                                        <label class="form-label">Invoice Generation</label>
                                        <select id="fltIsInvoiceGenerated" class="form-select form-select-sm">
                                            <option value="">All</option>
                                            <option value="false">Pending</option>
                                            <option value="true">Generated</option>
                                        </select>
                                    </div>
                                    
                                    <!-- 🎯 ACTION BUTTONS -->
                                    <div class="col-md-6 d-flex align-items-end gap-3">

                                        <!-- FILTER DROPDOWN -->
                                        <div class="dropdown mt-2">
                                            <button class="btn btn-outline-secondary btn-sm fw-bold dropdown-toggle"
                                                    type="button" id="sortByDropdown" data-bs-toggle="dropdown">
                                                Filter :This Month
                                            </button>

                                            <ul class="dropdown-menu">
                                                <li><a class="dropdown-item sort-option" data-value="yesterday" href="#">Yesterday</a></li>
                                                <li><a class="dropdown-item sort-option" data-value="last7days" href="#">Last 7 days</a></li>
                                                <li><a class="dropdown-item sort-option" data-value="last30days" href="#">Last 30 days</a></li>
                                                <li><a class="dropdown-item sort-option active" data-value="thismonth" href="#">This Month</a></li>
                                                <li><a class="dropdown-item sort-option" data-value="lastmonth" href="#">Last Month</a></li>
                                                <li><a class="dropdown-item sort-option" data-value="last12months" href="#">Last 12 Months</a></li>
                                                <li><a class="dropdown-item sort-option" data-value="customrange" href="#">Custom Range</a></li>
                                            </ul>
                                        </div>

                                        <!-- BUTTONS -->
                                        <button class="btn btn-primary btn-sm px-3 mt-2"
                                                onclick="fetchData()">
                                             Apply
                                        </button>

                                        <button class="btn btn-outline-danger btn-sm px-3 mt-2"
                                                onclick="resetFilter()">
                                             Reset
                                        </button>

                                    </div>

                                </div>

                                <div id="filterHiddenMessage" class="text-center py-4" style="display:none">
                                    <div class="text-muted" onclick="$('#toggleWidgets_filter').click()" style="cursor:pointer;">
                                        <i class="fa fa-filter fa-2x mb-2 opacity-50"></i>

                                        <div class="fw-semibold">Filters are hidden</div>

                                        <div class="small">
                                            Click <b>"Show Filter"</b> to refine your results
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- TABLE -->
                <div id="tableMain">
                    <table id="invoiceTable" class="table table-striped table-bordered w-100">
                        <tfoot class="table-secondary fw-bold">
                            <tr class="table-footer-total">
                                <th colspan="9" class="text-end">TOTAL</th>
                                <th id="ftTotalAmount" class="text-end"></th>
                                <th id="ftPaidAmount" class="text-end text-success"></th>
                                <th id="ftOutstandingAmount" class="text-end text-danger"></th>
                                <th colspan="7"></th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════
     SELECT COLUMNS MODAL
═══════════════════════════════════════ -->
<div class="modal fade" id="modalColumns" tabindex="-1">
    <div class="modal-dialog modal-md">
        <div class="modal-content">

            <div class="modal-header bg-warning py-2">
                <h5 class="modal-title text-white">Select Columns</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="chk-select-all">
                        <label class="form-check-label fw-bold">Select All</label>
                    </div>
                    <button class="btn btn-sm btn-outline-secondary" id="btn-reset-columns">
                        <i class="fa fa-refresh"></i> Reset
                    </button>
                </div>
                <hr />
                <div id="column-list" class="row"></div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button class="btn btn-warning" id="btn-save-columns">
                    <i class="fa fa-save"></i> Save
                </button>
            </div>

        </div>
    </div>
</div>

<!-- ADD / EDIT INVOICE MODAL --> 
<div class="modal fade" id="invoiceModal" tabindex="-1">
    <div class="modal-dialog modal-xxl">
        <div class="modal-content">
            <div class="modal-header bg-warning py-1 text-white">

                <h6 class="modal-title text-white mb-0" id="invoiceModalTitle">
                    Add Invoice
                </h6>

                <!-- Push buttons to extreme right -->
                <div class="ms-auto d-flex align-items-center gap-2">

                    <!-- Delete Button -->
                    <button type="button"
                            class="btn btn-sm btn-danger d-none"
                            id="btnDeleteInvoice">
                        <i class="fa fa-trash me-1"></i> Delete
                    </button>

                    <!-- Close Button -->
                    <button type="button"
                            class="btn-close btn-close-white"
                            data-bs-dismiss="modal">
                    </button>
                </div>
            </div>

            <div class="modal-body invoice-modal-body">
                <input type="hidden" id="invoiceId" value="0" />
                <input type="hidden" id="invoiceNo" value="0" />
                <input type="hidden" id="gstInvoiceNo" value="0" />
                <input type="hidden" id="proformaInvoiceNo" value="0" />
                <input type="hidden" id="bookingId" value="0" />
                <input type="hidden" id="isExclusiveOfGST" value="false" />
                <input type="hidden" id="isInclusiveOfGST" value="false" />

                <!-- CUSTOMER / INVOICE INFO -->
                <div class="row g-2 customerInfo">

                    <div class="col-md-4">
                        <label class="form-label">Customer Name</label>
                        <input type="text" id="customerName" class="form-control">
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Invoice Date</label>
                        <input type="date" id="invoiceDate" class="form-control">
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">GSTIN</label>
                        <input type="text" id="gstin" class="form-control">
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Email</label>
                        <input type="email" id="emailId" class="form-control">
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">State</label>
                        <select id="customerState" class="form-select">
                        </select>
                    </div>

                    <div class="col-md-10">
                        <label class="form-label">Address</label>
                        <input type="text" id="address" class="form-control">
                    </div>

                </div>

                <!-- ITEMS -->
                <div class="row mt-3">
                    <div class="col-md-12">

                        <table class="table table-bordered table-sm invoice-items-table">
                            <thead class="table-light">
                                <tr>
                                    <th class="col-index">#</th>
                                    <th class="col-desc">Description</th>
                                    <th class="col-hsn">HSN</th>
                                    <th class="col-rate">Rate</th>
                                    <th class="col-qty">Qty</th>
                                    <th class="col-subtotal">SubTotal</th>
                                    <th class="col-discount-rate">Discount Rate</th>
                                    <th class="col-discount-type">Type</th>
                                    <th class="col-discount-amount">Discount Amt.</th>
                                    <th class="col-taxable">Taxable</th>
                                    <th class="col-gst">GST%</th>
                                    <th class="col-cgst">CGST</th>
                                    <th class="col-sgst">SGST</th>
                                    <th class="col-igst">IGST</th>
                                    <th class="col-total">Total</th>
                                    <th style="width:5px; padding:10px"></th>
                                </tr>
                            </thead>
                            <tbody id="invoiceItemsBody"></tbody>
                        </table>

                        <!-- ACTION ROW -->
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <!-- LEFT -->
                            <button type="button"
                                    class="btn btn-outline-success btn-sm"
                                    id="btnAddItem">
                                + Add more
                            </button>

                            <!-- RIGHT -->
                            <div class="d-flex align-items-center justify-content-end gap-3">

                                <!-- Difference (LEFT of Subtotal) -->
                                <button id="btnAdjustDiff" class="btn btn-sm btn-warning d-none">
                                    Adjust ₹<span id="diffValue"></span>
                                </button>
                                <!-- Subtotal -->
                                <div class="d-flex align-items-center gap-2">
                                    <label class="fw-semibold mb-0">Subtotal:</label>
                                    <input type="number"
                                           id="subTotal"
                                           class="form-control form-control-sm text-end"
                                           style="width:160px"
                                           readonly>
                                </div>

                            </div>
                        </div>

                    </div>
                </div>

                <!-- TOTALS -->
                <div class="row mt-4">

                    <!-- LEFT SIDE : PAYMENT DETAILS -->
                    <div class="col-md-7">
                        <div class="border rounded p-3 bg-white" id="paymentSection">
                            <!-- 🔹 Payment Header -->
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="fw-bold text-primary mb-0">
                                    Payment Details
                                </h6>
                                <span class="badge bg-light text-dark border">
                                    Invoice Payment
                                </span>
                            </div>

                            <div class="row g-2">

                                <!-- Mode -->
                                <div class="col-md-3">
                                    <label class="form-label">Payment Mode</label>
                                    <select class="form-select form-select-sm" id="invoicePayment_Mode"></select>
                                </div>

                                <!-- Account -->
                                <div class="col-md-3">
                                    <label class="form-label d-flex gap-2">
                                        Receiver
                                        <i class="fa fa-info-circle text-primary"
                                           data-bs-toggle="tooltip"
                                           data-bs-placement="top"
                                           title="The payment amount will be credited to this selected account. Please choose the correct account carefully.">
                                        </i>
                                    </label>
                                    <select class="form-select form-select-sm" id="invoicePayment_Account"></select>
                                </div>

                                <!-- Payment Date -->
                                <div class="col-md-3">
                                    <label class="form-label">Payment Date</label>
                                    <input type="date" id="invoicePayment_Date" class="form-control form-control-sm">
                                </div>

                                <!-- Payment Time -->
                                <div class="col-md-3">
                                    <label class="form-label">Payment Time</label>
                                    <input type="time" id="invoicePayment_Time" class="form-control form-control-sm">
                                </div>

                                <!-- Transaction Id -->
                                <div class="col-md-3 invoicePayment_Fields d-none">
