                            <div class="border rounded p-2 h-100 bg-light">
                                <div class="small text-muted">Contact</div>
                                <div class="fw-semibold text-dark"
                                     id="paymentModal_summary_contact">
                                    -
                                </div>
                            </div>
                        </div>

                        <div class="col-md-9 col-6">
                            <div class="border rounded p-2 h-100 bg-light">
                                <div class="small text-muted">Event (PAX)</div>
                                <div class="fw-semibold text-dark text-truncate"
                                     id="paymentModal_summary_event">
                                    -
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="row g-2">
                        <input type="hidden" id="outstanding_paymentBookingId">

                        <div class="col-md-3 mb-1">
                            <label class="form-label">Payment Mode</label>
                            <select class="form-select" id="outstandingPayment_Mode"></select>
                        </div>

                        <div class="col-md-3 mb-1">
                            <label class="form-label">
                                Receiver
                                <i class="fa fa-info-circle text-primary"
                                   data-bs-toggle="tooltip"
                                   data-bs-placement="top"
                                   title="The payment amount will be credited to this selected account. Please choose the correct account carefully.">
                                </i>
                            </label>
                            <select class="form-select" id="outstandingPayment_Account"></select>
                        </div>

                        <div class="col-md-3 mb-1">
                            <label class="form-label">Payment Date</label>
                            <input type="date" id="outstandingPayment_Date" class="form-control">
                        </div>

                        <div class="col-md-3 mb-1">
                            <label class="form-label">Payment Time</label>
                            <input type="time" id="outstandingPayment_Time" class="form-control">
                        </div>

                        <div class="col-md-3 mb-1 paymentModal_Fields">
                            <label class="form-label">Transaction Id </label>
                            <input type="text" id="outstandingPayment_Txn" class="form-control" placeholder="Enter Txn Id">
                        </div>

                        <div class="col-md-6 mb-1 paymentModal_Fields">
                            <label class="form-label">Cheque Bank</label>
                            <input type="text" id="outstandingPayment_Chequebank" class="form-control" placeholder="Enter Cheque Bank">
                        </div>

                        <div class="col-md-3 mb-1 paymentModal_Fields">
                            <label class="form-label">Cheque No</label>
                            <input type="text" id="outstandingPayment_ChequeNo" class="form-control" placeholder="Cheque No">
                        </div>

                        <div class="col-md-3 mb-1 paymentModal_Fields">
                            <label class="form-label">Cheque Date</label>
                            <input type="date" id="outstandingPayment_ChequeDate" class="form-control">
                        </div>

                        <div class="col-md-3 mb-1">
                            <label class="form-label">Amount</label>
                            <input type="number" id="outstandingPayment_Amount" class="form-control" placeholder="Enter Amount" min="0" step="0.01">
                            <!-- Quick Amount Buttons -->
                            <div class="mt-1 d-flex gap-1">
                                <button type="button" class="btn btn-xs btn-primary" id="outstandingPayment_btnPayFull">Pay Full</button>
                                <button type="button" class="btn btn-xs btn-warning" id="outstandingPayment_btnPayHalf">Pay Half</button>
                            </div>
                        </div>

                        <div class="col-md-3 mb-1">
                            <label class="form-label">Due Balance</label>
                            <input type="number" id="outstandingPayment_DueBalance" class="form-control" placeholder="Enter Due Balance" min="0" step="0.01">
                            <input type="hidden" id="outstandingPayment_originalDueAmount">
                            <small id="dueMessage" class="text-danger d-none">No Due</small>
                        </div>

                        <div class="col-md-3 mb-1">
                            <label class="form-label">Next Due Date</label>
                            <input type="date" id="outstandingPayment_NextDueDate" class="form-control">
                        </div>

                        <div class="col-md-3 mb-1 pt-4">
                                <input type="button" id="outstandingPayment_btnwritrnote"
                                       class="btn btn-outline-primary btn-sm"
                                       value="Add Remarks">
                        </div>

                        <!-- NOTE EDITOR -->
                        <div class="col-md-12 outstandingPayment_editorsContainer mt-2 d-none">
                            <div id="outstandingPayment_noteEditor">
                                <textarea class="form-control" rows="6" placeholder="Write your note here..."></textarea>
                            </div>
                        </div>

                        <div class="col-md-12 mt-3">
                            <div class="d-flex justify-content-end align-items-center gap-2">
                                <button type="reset" class="btn btn-sm btn-outline-secondary px-3">
                                    <i class="fa fa-rotate-left me-1"></i>
                                    Reset
                                </button>

                                <button type="button" class="btn btn-sm btn-primary px-4" id="btnSavePayment">
                                    <i class="fa fa-save me-1"></i>
                                    Save
                                </button>
                            </div>
                        </div>

                    </div>
                </form>
            </div>

            <hr />

            <!-- Payment History Table -->
            <div class="px-3 pb-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="fw-bold text-primary mb-0">
                        Payment History
                    </h6>

                    <button class="btn btn-outline-success btn-sm btn-download-all d-none">
                        <i class="fas fa-download"></i> All Receipts
                    </button>
                </div>
                <div class="table-responsive">
                    <div id="tblPaymentHistory">
                        <table class="table table-sm table-bordered align-middle mb-0 w-0">
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
<!-- outstanding paymentModal -- END -->

<!-- payment collection Details Modal --- START -->
<div class="modal fade" id="paymentDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">

            <div class="modal-header bg-warning-gradient py-2">
                <h5 class="modal-title" id="paymentModalTitle">Payment Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <!--TOTALS-->
                <div class="row g-2 mb-2">

                    <div class="col-md-3">
                        <div class="border rounded p-2 text-center bg-light">
                            <div class="small text-muted fw-bold">Bookings</div>
                            <div class="fw-bold" id="totalBookings">0</div>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="border rounded p-2 text-center bg-light">
                            <div class="small text-muted fw-bold">Total Amount</div>
                            <div class="fw-bold text-primary" id="totalAmount">₹ 0</div>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="border rounded p-2 text-center bg-light">
                            <div class="small text-muted fw-bold">Paid</div>
                            <div class="fw-bold text-success" id="paidAmount">₹ 0</div>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="border rounded p-2 text-center bg-light">
                            <div class="small text-muted fw-bold">Pending</div>
                            <div class="fw-bold text-danger" id="pendingAmount">₹ 0</div>
                        </div>
                    </div>

                </div>

                <!-- TABLE -->
                <table id="paymentDetailsTable" class="table table-striped table-bordered w-100">
                    <thead>
                        <tr>
                            <th>B.No#</th>
                            <th>Customer</th>
                            <th>Mobile</th>
                            <th>Event Date</th>
                            <th>Total</th>
                            <th>Paid</th>
                            <th>Pending</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>

            </div>

        </div>
    </div>
</div>
<!-- payment collection Details Modal --- END -->

