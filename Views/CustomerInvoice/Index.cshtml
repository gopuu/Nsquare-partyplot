@{
    ViewData["Title"] = "Customer Invoice";
    Layout = "_Layout";
}

<link href="~/assets2/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<link href="~/assets2/css/customdatatable/customdatatable.css" asp-append-version="true" rel="stylesheet" />
<script src="~/assets2/js/jquery.dataTables.min.js"></script>
<script src="~/assets2/js/dataTables.bootstrap5.min.js"></script>

@section Styles {
    <link href="~/assets2/css/customerinvoice/customerinvoice.css" asp-append-version="true" rel="stylesheet" />
}
<!--MAIN-->
<div class="content">
    <div class="pb-1">
        <div class="row">
            <div class="col-12">

                <!-- HEADER -->
                <div class="mb-3">
                    <h4 class="mb-0 fw-bold text-warning">
                        Customer Invoices
                    </h4>
                </div>

                <!-- ================= PAYMENT WIDGET ================= -->
                <div class="row g-3 mb-4">

                    <!-- Payment Collection -->
                    <div class="col-md-6">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-body">
                                <div class="col d-flex justify-content-between">
                                    <h6 class="fw-semibold mb-3">Payment Collection Status</h6>
                                    <div class="dropdown chart-filter-Payment">
                                        <button class="btn btn-outline-secondary btn-xs btn-sm dropdown-toggle"
                                                type="button"
                                                id="PaymentChartFilter"
                                                data-bs-toggle="dropdown"
                                                aria-expanded="false">
                                            This Month
                                        </button>

                                        <ul class="dropdown-menu shadow-sm" aria-labelledby="PaymentChartFilter">
                                            <li><a class="dropdown-item payment-option" data-value="yesterday" href="#">Yesterday</a></li>
                                            <li><a class="dropdown-item payment-option" data-value="days" href="#">Last 7 Days</a></li>
                                            <li><a class="dropdown-item payment-option" data-value="lastdays" href="#">Last 30 Days</a></li>
                                            <li><a class="dropdown-item payment-option active" data-value="thismonth" href="#">This Month</a></li>
                                            <li><a class="dropdown-item payment-option" data-value="lastmonth" href="#">Last Month</a></li>
                                            <li><a class="dropdown-item payment-option" data-value="12months" href="#">Last 12 Months</a></li>
                                            <li><a class="dropdown-item payment-option" data-value="customrange" href="#">Custom Range</a></li>
                                        </ul>
                                    </div>
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span>Paid</span>
                                    <span class="text-success">₹ <span id="txtPaidAmount">0</span></span>
                                </div>
                                <div class="progress mb-3">
                                    <div id="barPaid" class="progress-bar bg-success"></div>
                                </div>

                                <div class="d-flex justify-content-between mb-2">
                                    <span>Pending</span>
                                    <span class="text-danger">₹ <span id="txtPendingAmount">0</span></span>
                                </div>
                                <div class="progress">
                                    <div id="barPending" class="progress-bar bg-danger"></div>
                                </div>

                            </div>
                        </div>
                    </div>
                    <!--Upcoming Payment-->
                    <div class="col-md-6">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-body">
                                <div class="col d-flex justify-content-between">
                                    <h6 class="fw-semibold mb-3">Upcoming Payment</h6>
                                    <div class="dropdown chart-filter-finance">
                                        <button class="btn btn-outline-secondary btn-xs btn-sm dropdown-toggle"
                                                type="button"
                                                id="UpcomingChartFilter"
                                                data-bs-toggle="dropdown"
                                                aria-expanded="false">
                                            This Month
                                        </button>

                                        <ul class="dropdown-menu shadow-sm" aria-labelledby="UpcomingChartFilter">
                                            <li><a class="dropdown-item upcoming-option" data-value="yesterday" href="#">Yesterday</a></li>
                                            <li><a class="dropdown-item upcoming-option" data-value="days" href="#">Last 7 Days</a></li>
                                            <li><a class="dropdown-item upcoming-option active" data-value="thismonth" href="#">This Month</a></li>
                                            <li><a class="dropdown-item upcoming-option" data-value="lastdays" href="#">Last 30 Days</a></li>
                                            <li><a class="dropdown-item upcoming-option" data-value="lastmonth" href="#">Last Month</a></li>
                                            <li><a class="dropdown-item upcoming-option" data-value="12months" href="#">Last 12 Months</a></li>
                                            <li><a class="dropdown-item upcoming-option" data-value="customrange" href="#">Custom Range</a></li>
                                        </ul>
                                    </div>
                                </div>

                                <ul class="list-group list-group-flush" id="upcomingPaymentsList">
                                    <li class="list-group-item text-muted text-center">
                                        Loading...
                                    </li>
                                </ul>

                            </div>
                        </div>
                    </div>

                </div>


                <!-- FILTER CARD -->
                <div class="card invoice-filter-card shadow-sm mb-3">
                    <div class="card-body py-2">

                        <div class="row gx-2 align-items-end flex-nowrap">

                            <!-- Search -->
                            <div class="col-auto flex-grow-1" style="min-width:180px">
                                <label class="filter-label">Name / Email / Contact</label>
                                <input type="text" id="fltSearch"
                                       class="form-control form-control-sm"
                                       placeholder="Search">
                            </div>

                            <!-- Slot -->
                            <div class="col-auto" style="width:130px">
                                <label class="filter-label">Slot</label>
                                <select id="fltSlot" class="form-select form-select-sm">
                                </select>
                            </div>

                            <!-- Event From -->
                            <div class="col-auto" style="width:135px">
                                <label class="filter-label">Event From</label>
                                <input type="date" id="fltEventFrom"
                                       class="form-control form-control-sm">
                            </div>

                            <!-- Event To -->
                            <div class="col-auto" style="width:135px">
                                <label class="filter-label">Event To</label>
                                <input type="date" id="fltEventTo"
                                       class="form-control form-control-sm">
                            </div>

                            <!-- Booked From -->
                            <div class="col-auto" style="width:135px">
                                <label class="filter-label">Booked From</label>
                                <input type="date" id="fltBookedFrom"
                                       class="form-control form-control-sm">
                            </div>

                            <!-- Booked Till -->
                            <div class="col-auto" style="width:135px">
                                <label class="filter-label">Booked Till</label>
                                <input type="date" id="fltBookedTill"
                                       class="form-control form-control-sm">
                            </div>

                            <!-- Event -->
                            <div class="col-auto" style="width:140px">
                                <label class="filter-label">Event</label>
                                <select id="fltEvent" class="form-select form-select-sm">
                                </select>
                            </div>

                            <!-- Buttons -->
                            <div class="col-auto d-flex gap-2">
                                <button class="btn btn-primary btn-sm px-3" onclick="fetchData()">
                                    Apply
                                </button>
                                <button class="btn btn-outline-danger btn-sm px-3" onclick="resetFilter()">
                                    Reset
                                </button>
                            </div>

                        </div>
                    </div>
                </div>


                <!-- TABLE -->
                <div id="tableMain">
                    <table class="table table-striped table-bordered w-100"></table>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- ADD / EDIT INVOICE MODAL -->
<div class="modal fade" id="invoiceModal" tabindex="-1">
    <div class="modal-dialog modal-xxl">
        <div class="modal-content">
            <!--Header-->
            <div class="modal-header bg-warning py-1 text-white">
                <h6 class="modal-title text-white" id="invoiceModalTitle">Add Invoice</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body invoice-modal-body">
                <input type="hidden" id="invoiceId" value="0" />
                <input type="hidden" id="bookingId" value="0" />

                <!-- CUSTOMER / INVOICE INFO -->
                <div class="row g-2 customerInfo">

                    <div class="col-md-4">
                        <label class="form-label">Customer Name</label>
                        <input type="text" id="customerName" class="form-control">
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Invoice Date</label>
                        <input type="date" id="invoiceDate" class="form-control">
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">GSTIN</label>
                        <input type="text" id="gstin" class="form-control">
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Email</label>
                        <input type="email" id="emailId" class="form-control">
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">State</label>
                        <select id="customerState" class="form-select">
                        </select>
                    </div>

                    <div class="col-md-10">
                        <label class="form-label">Address</label>
                        <input type="text" id="address" class="form-control">
                    </div>

                    <div class="col-md-2 mt-4">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="isGstIncluded" checked>
                            <label class="form-check-label form-label" for="isGstIncluded">
                                Include GST?
                            </label>
                        </div>
                    </div>

                </div>

                <!-- ITEMS -->
                <div class="row mt-3">
                    <div class="col-md-12">

                        <table class="table table-bordered table-sm invoice-items-table">
                            <thead class="table-light">
                                <tr>
                                    <th class="col-index">#</th>
                                    <th class="col-desc">Description</th>
                                    <th class="col-hsn">HSN</th>
                                    <th class="col-rate">Rate</th>
                                    <th class="col-qty">Qty</th>
                                    <th class="col-subtotal">SubTotal</th>
                                    <th class="col-discount-rate">Discount</th>
                                    <th class="col-discount-type">Type</th>
                                    <th class="col-discount-amount">Discount</th>
                                    <th class="col-taxable">Taxable</th>
                                    <th class="col-gst">GST%</th>
                                    <th class="col-cgst">CGST</th>
                                    <th class="col-sgst">SGST</th>
                                    <th class="col-total">Total</th>
                                    <th style="width:5px; padding:10px"></th>
                                </tr>
                            </thead>
                            <tbody id="invoiceItemsBody"></tbody>
                        </table>

                        <!-- ACTION ROW -->
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <!-- LEFT -->
                            <button type="button"
                                    class="btn btn-outline-success btn-sm"
                                    id="btnAddItem">
                                + Add more
                            </button>

                            <!-- RIGHT -->
                            <div class="d-flex align-items-center gap-2">
                                <label class="fw-semibold mb-0">Subtotal:</label>
                                <input type="number"
                                       id="subTotal"
                                       class="form-control form-control-sm text-end"
                                       style="width:160px"
                                       readonly>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- TOTALS -->
                <div class="row mt-4">
                    <!-- EMPTY SPACE (LEFT) -->
                    <div class="col-md-7"></div>

                    <!-- TOTALS PANEL (RIGHT) -->
                    <div class="col-md-5">
                        <div class="totals-box border rounded p-3 bg-light">

                            <div class="total-row">
                                <span>Booking Discount</span>
                                <input type="number"
                                       id="bookingDiscount"
                                       class="form-control form-control-sm text-end">
                            </div>

                            <div class="total-row">
                                <span>Total Taxable</span>
                                <input type="number"
                                       id="totalTaxable"
                                       class="form-control form-control-sm text-end"
                                       readonly>
                            </div>

                            <div class="total-row">
                                <span>Total GST</span>
                                <input type="number"
                                       id="totalGST"
                                       class="form-control form-control-sm text-end"
                                       readonly>
                            </div>

                            <div class="total-row fw-bold border-top pt-2">
                                <span>Grand Total</span>
                                <input type="number"
                                       id="grandTotal"
                                       class="form-control form-control-sm text-end fw-bold"
                                       readonly>
                            </div>

                            <div class="total-row">
                                <span>Round Off</span>
                                <input type="number"
                                       id="roundOff"
                                       class="form-control form-control-sm text-end">
                            </div>

                            <div class="total-row">
                                <span>Advance Paid</span>
                                <input type="number"
                                       id="advancePaid"
                                       class="form-control form-control-sm text-end">
                            </div>

                            <div class="total-row fw-bold">
                                <span>Balance</span>
                                <input type="number"
                                       id="balanceAmount"
                                       class="form-control form-control-sm text-end fw-bold">
                            </div>

                        </div>
                    </div>
                </div>

            </div>

            <div class="modal-footer">
                <button class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                <button class="btn btn-sm btn-outline-warning" id="btnSaveInvoice">Save</button>
            </div>

        </div>
    </div>
</div>

<!-- DELETE MODAL -->
<div class="modal fade" id="deleteRecordModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning text-white py-1">
                <h5 class="modal-title">Delete Invoice</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <h5>Are you sure?</h5>
                <p class="text-muted">This action cannot be undone.</p>
                <div class="d-flex justify-content-center gap-2 mt-3">
                    <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button class="btn btn-outline-danger" id="delete-record">Yes, Delete</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Booking Info Modal -- START -->
<div class="modal fade" id="bookingReportModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content shadow-lg border-0 rounded-3">

            <!-- HEADER -->
            <div class="modal-header bg-primary py-1 text-white">
                <h5 class="modal-title text-white" id="bookingModalTitle">
                    <i class="fa-solid fa-calendar-check me-2 text-white"></i>Booking Summary
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <!-- 🔹 Hidden booking id -->
            <input type="hidden" id="bookingReport_BookingId" value="0">

            <!-- 🔹 Body -->
            <div class="modal-body bg-white" style="max-height: 75vh; overflow-y: auto;">
                <!--Client Details-->
                <section class="mb-2 p-0 border rounded">
                    <h6 class="fw-bold border-bottom pb-2 px-3 py-2 text-primary bg-light rounded-top">
                        Client Details
                    </h6>

                    <div class="p-3">
                        <div class="row mb-2">
                            <div class="col-md-12">
                                <p class="client-details-line mb-0">
                                    <strong>Client Name:</strong> <span id="bookingReport_clientName">—</span> •
                                    <strong>Contact:</strong> <span id="bookingReport_clientContact">—</span> •
                                    <strong>GSTIN:</strong> <span id="bookingReport_clientGSTIN">—</span> •
                                    <strong>Email:</strong> <span id="bookingReport_clientEmail">—</span> •
                                    <strong>Booked By:</strong> <span id="bookingReport_clientBookedBy">—</span>
                                </p>
                            </div>
                        </div>

                        <div class="row">
                            <!-- 🗒️ Internal Office Note -->
                            <div class="col-md-6 mb-2">
                                <h6 class="fw-bold border-bottom pb-2 px-3 py-2 text-secondary bg-light rounded-top">
                                    Internal Office Note
                                </h6>
                                <p class="fst-italic text-muted px-3" id="bookingReport_internalOfficeNote">—</p>
                            </div>

                            <!-- 🧾 Booking Note for Customer -->
                            <div class="col-md-6 mb-2">
                                <h6 class="fw-bold border-bottom pb-2 px-3 py-2 text-secondary bg-light rounded-top">
                                    Booking Note for Customer
                                </h6>
                                <p class="fst-italic text-muted px-3" id="bookingReport_bookingNoteCustomer">—</p>
                            </div>
                        </div>
                    </div>
                </section>

                <!--Booking Details-->
                <section class="mb-3 p-0">
                    <div class="row g-3">

                        <!-- 🟦 Booking Details -->
                        <div class="col-md-4">
                            <div class="card border-0 shadow-sm h-100">

                                <!-- Header -->
                                <div class="bg-light border-bottom rounded-top px-3 py-2">
                                    <h6 class="fw-bold text-primary mb-0">
                                        <i class="fa-solid fa-calendar-check me-1"></i> Booking Details
                                    </h6>
                                </div>

                                <!-- Body -->
                                <div class="card-body p-3">

                                    <!-- Booking Ref# -->
                                    <div class="d-flex justify-content-between py-2 border-bottom">
                                        <span class="fw-semibold">Booking Ref#</span>
                                        <span id="bookingReport_BookingRef" class="text-end">—</span>
                                    </div>

                                    <!-- Invoice -->
                                    <div class="d-flex justify-content-between py-2 border-bottom">
                                        <span class="fw-semibold">Invoice</span>
                                        <span id="bookingReport_Invoice" class="text-end">—</span>
                                    </div>

                                    <!-- Event Date -->
                                    <div class="d-flex justify-content-between py-2 border-bottom">
                                        <span class="fw-semibold">Event Date</span>
                                        <span id="bookingReport_EventDate" class="text-end">—</span>
                                    </div>

                                    <!-- Till Date -->
                                    <div class="d-flex justify-content-between py-2 border-bottom">
                                        <span class="fw-semibold">Till Date</span>
                                        <span id="bookingReport_TillDate" class="text-end">—</span>
                                    </div>

                                    <!-- Slot -->
                                    <div class="d-flex justify-content-between py-2 border-bottom">
                                        <span class="fw-semibold">Slot</span>
                                        <span id="bookingReport_Slot" class="text-end">—</span>
                                    </div>

                                    <!-- Booked On -->
                                    <div class="d-flex justify-content-between py-2 border-bottom">
                                        <span class="fw-semibold">Booked On</span>
                                        <span id="bookingReport_BookedOn" class="text-end">—</span>
                                    </div>

                                    <!-- Event -->
                                    <div class="d-flex justify-content-between py-2 border-bottom">
                                        <span class="fw-semibold">Event</span>
                                        <span id="bookingReport_EventName" class="text-end">—</span>
                                    </div>

                                    <!-- Banquet -->
                                    <div class="d-flex justify-content-between py-2 border-bottom">
                                        <span class="fw-semibold">Banquet</span>
                                        <span id="bookingReport_Banquet" class="text-end">—</span>
                                    </div>

                                    <!-- Halls -->
                                    <div class="d-flex justify-content-between py-2 border-bottom">
                                        <span class="fw-semibold">Halls</span>
                                        <span id="bookingReport_Hall" class="text-end">—</span>
                                    </div>

                                    <!-- Pax -->
                                    <div class="d-flex justify-content-between py-2">
                                        <span class="fw-semibold">No. of Pax</span>
                                        <span id="bookingReport_Pax" class="text-end">—</span>
                                    </div>

                                </div>

                            </div>
                        </div>

                        <!-- 🟨 Services & Charges -->
                        <div class="col-md-4">
                            <div class="card border-0 shadow-sm h-100">

                                <!-- Header -->
                                <div class="bg-light border-bottom rounded-top px-3 py-2">
                                    <h6 class="fw-bold text-primary mb-0">
                                        <i class="fa-solid fa-receipt me-1"></i> Services & Charges
                                    </h6>
                                </div>

                                <!-- Body -->
                                <div class="card-body p-3">

                                    <!-- Hall Rent -->
                                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                        <span class="fw-semibold">Hall Rent</span>
                                        <span class="text-end">₹<span id="bookingReport_HallRent">—</span></span>
                                    </div>

                                    <!-- Food -->
                                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                        <span class="fw-semibold">
                                            Food
                                            <small class="text-muted">(₹<span id="bookingReport_FoodRate">—</span> / plate)</small>
                                        </span>
                                        <span class="text-end">₹<span id="bookingReport_FoodAmount">—</span></span>
                                    </div>

                                </div>
                            </div>
                        </div>

                        <!-- 🟧 Payment Trail -->
                        <div class="col-md-4">
                            <div class="card border-0 shadow-sm h-100">

                                <!-- Header -->
                                <div class="bg-light border-bottom rounded-top px-3 py-2">
                                    <h6 class="fw-bold text-primary mb-0">
                                        <i class="fa-solid fa-credit-card me-1"></i> Payment Trail
                                    </h6>
                                </div>

                                <!-- Body -->
                                <div class="card-body p-3">

                                    <!-- Deal Amount -->
                                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                        <span class="fw-semibold">Deal Amount</span>
                                        <span class="fw-bold">₹<span id="bookingReport_DealAmount">—</span></span>
                                    </div>

                                    <!-- Tax -->
                                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                        <span class="fw-semibold">Tax</span>
                                        <span class="fw-bold">₹<span id="bookingReport_TaxAmount">—</span></span>
                                    </div>

                                    <!-- Booking Discount -->
                                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                        <span class="fw-semibold">Booking Discount</span>
                                        <span class="fw-bold">₹<span id="bookingReport_BookingDiscount">—</span></span>
                                    </div>

                                    <!-- Total Amount -->
                                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                        <span class="fw-semibold">Total Amount</span>
                                        <span class="fw-bold">₹<span id="bookingReport_TotalAmount">—</span></span>
                                    </div>

                                    <!-- Paid Till Date -->
                                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                        <span class="fw-semibold">Paid Till Date</span>
                                        <span class="fw-bold">₹<span id="bookingReport_PaidTillDate">—</span></span>
                                    </div>

                                    <!-- Discount -->
                                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                        <span class="fw-semibold">Discount</span>
                                        <span class="fw-bold">₹<span id="bookingReport_Discount">—</span></span>
                                    </div>

                                    <!-- Outstanding -->
                                    <div class="d-flex justify-content-between align-items-center py-2">
                                        <span class="fw-semibold">Outstanding Amount</span>
                                        <span class="fw-bold text-danger">₹<span id="bookingReport_OutstandingAmount">—</span></span>
                                    </div>

                                </div>
                            </div>
                        </div>

                    </div>
                </section>

                <!-- 🧾 Payment Details Table -->
                <section class="mb-3 p-0">
                    <div class="card border-0 shadow-sm">
                        <!-- Card Header -->
                        <div class="bg-light border-bottom rounded-top px-3 py-2">
                            <h6 class="fw-bold text-primary mb-0">
                                <i class="fa-solid fa-table me-1"></i> Payment Trail Details
                            </h6>
                        </div>

                        <!-- Card Body -->
                        <div class="card-body p-3">
                            <div class="table-responsive">
                                <table id="bookingReport_PaymentTrailTable" class="table table-bordered table-sm align-middle text-center mb-0 table-hover payment-table">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Sr#</th>
                                            <th>Receipt No.</th>
                                            <th>Mode</th>
                                            <th>Date</th>
                                            <th>Txn Id</th>
                                            <th>Cheque Bank</th>
                                            <th>Cheque No.</th>
                                            <th>Cheque Date</th>
                                            <th>Amount</th>
                                            <th>Due Balance</th>
                                            <th>Note</th>
                                            <th>Receipt</th>
                                            <th>Delete</th>
                                        </tr>
                                    </thead>
                                    <tbody id="bookingReport_PaymentTrailBody">
                                        <tr>
                                            <td colspan="13" class="text-muted small fst-italic text-center">
                                                No payment records found
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- 🍽️ Food Package and Selected Menu -->
                <section class="mb-3 p-0">
                    <div class="card border-0 shadow-sm">
                        <!-- 🔹 Card Header (Connected with Parent) -->
                        <div class="bg-light border-bottom rounded-top d-flex flex-wrap justify-content-between align-items-center px-3 py-2">
                            <h6 class="fw-bold text-primary mb-0">
                                <i class="fa-solid fa-utensils me-2 text-danger"></i> Food Package and Selected Menu
                            </h6>

                            <div class="d-flex flex-wrap gap-2">
