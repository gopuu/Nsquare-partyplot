@{
    ViewData["Title"] = "Report Enquiry";
    Layout = "_Layout";
}

<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<link href="/assets2/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<script src="/assets2/js/jquery.dataTables.min.js"></script>
<script src="/assets2/js/dataTables.bootstrap5.min.js"></script>
<link href="~/assets2/css/customdatatable/customdatatable.css" asp-append-version="true" rel="stylesheet" />

<!-- MAIN -->
<div class="content">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="text-warning mb-0">Enquiry Report</h4>

        <!-- RIGHT CONTROLS -->
        <div class="d-flex align-items-center gap-2">

            <!-- FILTER BUTTON -->
            <button class="btn btn-outline-warning btn-sm" id="btnToggleFilter">
                <i class="fa fa-filter me-1"></i> Filter
            </button>

            <!-- WITH HEADER -->
            <div class="form-check form-switch mb-0">
                <input class="form-check-input" type="checkbox" id="toggleWithHeader">
                <label class="form-check-label fw-semibold" for="toggleWithHeader">
                    With Header
                </label>
            </div>

            <!-- SELECT COLUMNS -->
            <button class="btn btn-outline-info btn-sm" id="btn-select-columns">
                <i class="fa fa-list-check me-1"></i> Columns
            </button>

            <!-- DOWNLOAD -->
            <div class="dropdown">
                <button class="btn btn-outline-dark btn-sm dropdown-toggle"
                        type="button"
                        data-bs-toggle="dropdown">
                    <i class="fas fa-download"></i>
                </button>

                <ul class="dropdown-menu dropdown-menu-end">
                    <li>
                        <a class="dropdown-item"
                           href="javascript:void(0)"
                           onclick="ViewEnquiryReport('downloadPDF')">
                            <i class="fas fa-file-pdf text-danger me-2"></i> PDF
                        </a>
                    </li>

                    <li>
                        <a class="dropdown-item"
                           href="javascript:void(0)"
                           onclick="ViewEnquiryReport('downloadExcel')">
                            <i class="fas fa-file-excel text-success me-2"></i> Excel
                        </a>
                    </li>
                </ul>
            </div>

        </div>
    </div>

    <!-- GRID VIEW -->
    <div id="tableMain">
        <table class="table table-striped table-bordered w-100">

            <thead>
                <tr>
                    <th>Enq. No.</th>
                    <th>Enq. Date</th>
                    <th>Event Date</th>
                    <th>Client Name</th>
                    <th>Event Type</th>
                    <th>Venue</th>
                    <th>Pax</th>
                    <th>Lead Source</th>
                    <th>Amount</th>
                    <th>Follow-ups</th>
                    <th>Status</th>
                </tr>
            </thead>

            <tfoot class="table-secondary fw-bold">
                <tr>
                    <th colspan="6" class="text-end">Total</th>
                    <th></th> <!-- Pax -->
                    <th></th> <!-- Lead Source -->
                    <th></th> <!-- Amount -->
                    <th></th> <!-- Follow-ups -->
                    <th></th> <!-- Status -->
                </tr>
            </tfoot>

        </table>
    </div>
</div>
<!-- /MAIN -->

<!-- RIGHT FILTER PANEL -->
<div id="filterPanel" class="filter-panel">

    <div class="filter-header bg-warning d-flex justify-content-between align-items-center px-3 py-2">
        <h6 class="mb-0 text-white">Filters</h6>

        <button type="button"
                class="btn-close btn-close-white"
                id="btnCloseFilter"
                aria-label="Close">
        </button>
    </div>

    <div class="filter-body">

        <!--Enquiry Date Range-->
        <div class="mb-3">
            <label class="form-label">Enquiry Duration</label>
            <select id="quickRange" class="form-select form-select-sm">
                <option value="yesterday">Yesterday</option>
                <option value="last7days">Last 7 days</option>
                <option value="last30days">Last 30 days</option>
                <option value="thismonth">This Month</option>
                <option value="lastmonth">Last Month</option>
                <option value="last12months">Last 12 Months</option>
                <option value="customrange">Custom Range</option>
            </select>
        </div>

        <div class="row g-2">
            <div class="col-md-6 mb-3">
                <label class="form-label">From Date (Enquiry)</label>
                <input type="date" id="enquiryFromDate" class="form-control form-control-sm">
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">To Date (Enquiry)</label>
                <input type="date" id="enquiryToDate" class="form-control form-control-sm">
            </div>
        </div>

        <!--Event Date Range-->
        <div class="row g-2">
            <div class="col-md-6 mb-3">
                <label class="form-label">From Date (Event)</label>
                <input type="date" id="eventFromDate" class="form-control form-control-sm">
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">To Date (Event)</label>
                <input type="date" id="eventToDate" class="form-control form-control-sm">
            </div>
        </div>

        <!--PAX Range-->
        <div class="row g-2">
            <div class="col-md-6 mb-3">
                <label class="form-label">PAX From</label>
                <input type="number" id="PAXfrom" class="form-control form-control-sm" step="1">
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">PAX To</label>
                <input type="number" id="PAXto" class="form-control form-control-sm" step="1">
            </div>
        </div>

        <!--Amount Range-->
        <div class="row g-2">
            <div class="col-md-6 mb-3">
                <label class="form-label">Amount From</label>
                <input type="number" id="AmountFrom" class="form-control form-control-sm" step="1">
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Amount To</label>
                <input type="number" id="AmountTo" class="form-control form-control-sm" step="1">
            </div>
        </div>

        <!--Search Name / Email / Contact-->
        <div class="mb-3">
            <label class="form-label">Name / Email / Contact</label>
            <input type="text"
                   id="txtSearch"
                   class="form-control form-control-sm"
                   placeholder="Search by Name, Email or Contact">
        </div>

        <!--Event Type-->
        <div class="mb-3">
            <label class="form-label">Event Type</label>
            <select id="ddlEventType" class="form-select form-select-sm"></select>
        </div>

        <!--Event Sub-Type-->
        <div class="mb-3">
            <label class="form-label">Event Sub-Type</label>
            <select id="ddlEventSubType" class="form-select form-select-sm"></select>
        </div>

        <!--Hall-->
        <div class="mb-3">
            <label class="form-label">Hall</label>
            <select id="ddlCompanyHall" class="form-select form-select-sm"></select>
        </div>

        <!--Lead Source-->
        <div class="mb-3">
            <label class="form-label">Lead Source</label>
            <select id="ddlLeadSource" class="form-select form-select-sm"></select>
        </div>

        <!--Status / Process-->
        <div class="mb-3">
            <label class="form-label">Status</label>
            <select id="ddlProcess" class="form-select form-select-sm"></select>
        </div>

    </div>

    <div class="filter-footer">
        <button id="btnResetFilter" class="btn btn-outline-secondary btn-sm">Reset</button>
        <button id="btnApplyFilter" class="btn btn-warning btn-sm">Apply</button>
    </div>

</div>

<!-- SELECT COLUMNS for REPORT -->
<div class="modal fade" id="modalColumns" tabindex="-1">
    <div class="modal-dialog modal-md">
        <div class="modal-content">

            <div class="modal-header bg-warning py-2">
                <h5 class="modal-title text-white">Select Columns</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <div class="d-flex justify-content-between align-items-center mb-2">

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="chk-select-all">
                        <label class="form-check-label fw-bold">Select All</label>
                    </div>

                    <button class="btn btn-sm btn-outline-secondary" id="btn-reset-columns">
                        <i class="fa fa-refresh"></i> Reset
                    </button>

                </div>

                <hr />

                <div id="column-list" class="row">
                </div>

            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button class="btn btn-warning" id="btn-save-columns"><i class="fa fa-save"></i> Save</button>
            </div>

        </div>
    </div>
</div>
<!-- END MODAL -->
@section Scripts {
    <script src="~/assets2/js/report_enquiry/report_enquiry.js" asp-append-version="true"></script>
}

@section Styles {
    <link href="~/assets2/css/report_enquiry/report_enquiry.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/assets2/css/report_filters/report_filters.css" rel="stylesheet" asp-append-version="true" />
}