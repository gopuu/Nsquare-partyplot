        <script>
            // Force navbarPosition and navbarTopShape to fixed values
              window.config.config.phoenixNavbarPosition = 'horizontal';
              window.config.config.phoenixNavbarTopShape = 'default';

            var navbarTopShape = window.config.config.phoenixNavbarTopShape;
            var navbarPosition = window.config.config.phoenixNavbarPosition;

            var body = document.querySelector('body');
            var navbarDefault = document.querySelector('#navbarDefault');
            var navbarTop = document.querySelector('#navbarTop');
            var topNavSlim = document.querySelector('#topNavSlim');
            var navbarTopSlim = document.querySelector('#navbarTopSlim');
            var navbarCombo = document.querySelector('#navbarCombo');
            var navbarComboSlim = document.querySelector('#navbarComboSlim');
            var dualNav = document.querySelector('#dualNav');

            var documentElement = document.documentElement;
            var navbarVertical = document.querySelector('.navbar-vertical');

            if (navbarPosition === 'dual-nav') {
              if(topNavSlim) topNavSlim.remove();
              if(navbarTop) navbarTop.remove();
              if(navbarTopSlim) navbarTopSlim.remove();
              if(navbarCombo) navbarCombo.remove();
              if(navbarComboSlim) navbarComboSlim.remove();
              if(navbarDefault) navbarDefault.remove();
              if(navbarVertical) navbarVertical.remove();
              if(dualNav) {
                dualNav.removeAttribute('style');
                documentElement.setAttribute('data-navigation-type', 'dual');
              }
            }
            else if (navbarTopShape === 'slim' && navbarPosition === 'vertical') {
              if(navbarDefault) navbarDefault.remove();
              if(navbarTop) navbarTop.remove();
              if(navbarTopSlim) navbarTopSlim.remove();
              if(navbarCombo) navbarCombo.remove();
              if(navbarComboSlim) navbarComboSlim.remove();
              if(topNavSlim) topNavSlim.style.display = 'block';
              if(navbarVertical) navbarVertical.style.display = 'inline-block';
              documentElement.setAttribute('data-navbar-horizontal-shape', 'slim');
            }
            else if (navbarTopShape === 'slim' && navbarPosition === 'horizontal') {
              if(navbarDefault) navbarDefault.remove();
              if(navbarVertical) navbarVertical.remove();
              if(navbarTop) navbarTop.remove();
              if(topNavSlim) topNavSlim.remove();
              if(navbarCombo) navbarCombo.remove();
              if(navbarComboSlim) navbarComboSlim.remove();
              if(dualNav) dualNav.remove();
              if(navbarTopSlim) navbarTopSlim.removeAttribute('style');
              documentElement.setAttribute('data-navbar-horizontal-shape', 'slim');
            }
            else if (navbarTopShape === 'slim' && navbarPosition === 'combo') {
              if(navbarDefault) navbarDefault.remove();
              if(navbarTop) navbarTop.remove();
              if(topNavSlim) topNavSlim.remove();
              if(navbarCombo) navbarCombo.remove();
              if(navbarTopSlim) navbarTopSlim.remove();
              if(dualNav) dualNav.remove();
              if(navbarComboSlim) navbarComboSlim.removeAttribute('style');
              if(navbarVertical) navbarVertical.removeAttribute('style');
              documentElement.setAttribute('data-navbar-horizontal-shape', 'slim');
            }
            else if (navbarTopShape === 'default' && navbarPosition === 'horizontal') {
              if(navbarDefault) navbarDefault.remove();
              if(topNavSlim) topNavSlim.remove();
              if(navbarVertical) navbarVertical.remove();
              if(navbarTopSlim) navbarTopSlim.remove();
              if(navbarCombo) navbarCombo.remove();
              if(navbarComboSlim) navbarComboSlim.remove();
              if(dualNav) dualNav.remove();
              if(navbarTop) navbarTop.removeAttribute('style');
              documentElement.setAttribute('data-navigation-type', 'horizontal');
            }
            else if (navbarTopShape === 'default' && navbarPosition === 'combo') {
              if(topNavSlim) topNavSlim.remove();
              if(navbarTop) navbarTop.remove();
              if(navbarTopSlim) navbarTopSlim.remove();
              if(navbarDefault) navbarDefault.remove();
              if(navbarComboSlim) navbarComboSlim.remove();
              if(dualNav) dualNav.remove();
              if(navbarCombo) navbarCombo.removeAttribute('style');
              if(navbarVertical) navbarVertical.removeAttribute('style');
              documentElement.setAttribute('data-navigation-type', 'combo');
            }
            else {
              if(topNavSlim) topNavSlim.remove();
              if(navbarTop) navbarTop.remove();
              if(navbarTopSlim) navbarTopSlim.remove();
              if(navbarCombo) navbarCombo.remove();
              if(navbarComboSlim) navbarComboSlim.remove();
              if(dualNav) dualNav.remove();
              if(navbarDefault) navbarDefault.removeAttribute('style');
              if(navbarVertical) navbarVertical.removeAttribute('style');
            }

            var navbarTopStyle = window.config.config.phoenixNavbarTopStyle;
            var navbarTopElem = document.querySelector('.navbar-top');
            if (navbarTopStyle === 'darker' && navbarTopElem) {
              navbarTopElem.setAttribute('data-navbar-appearance', 'darker');
            }

            var navbarVerticalStyle = window.config.config.phoenixNavbarVerticalStyle;
            var navbarVerticalElem = document.querySelector('.navbar-vertical');
            if (navbarVerticalStyle === 'darker' && navbarVerticalElem) {
              navbarVerticalElem.setAttribute('data-navbar-appearance', 'darker');
            }
        </script>

