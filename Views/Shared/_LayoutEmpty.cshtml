<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <!-- ===============================================-->
    <!--    Document Title-->
    <!-- ===============================================-->
    <title>Infinity</title>
    <!-- ===============================================-->
    <!--    Favicons-->
    <!-- ===============================================-->
    <link rel="apple-touch-icon" sizes="180x180" href="~/assets2/img/favicons/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="~/assets2/img/favicons/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="~/assets2/img/favicons/favicon-16x16.png">
    <link rel="shortcut icon" type="image/x-icon" href="~/assets2/img/favicons/favicon.ico">
    <link rel="manifest" href="~/assets2/img/favicons/manifest.json">
    <meta name="msapplication-TileImage" content="~/assets2/img/favicons/mstile-150x150.png">
    <meta name="theme-color" content="#ffffff">
    <script src="~/assets2/vendors/simplebar/simplebar.min.js"></script>
    <script src="~/assets2/js/config.js"></script>
    <!-- ===============================================-->
    <!--    Stylesheets-->
    <!-- ===============================================-->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
    <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@300;400;600;700;800;900&amp;display=swap" rel="stylesheet">
    <link href="~/assets2/vendors/simplebar/simplebar.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://unicons.iconscout.com/release/v4.0.8/css/line.css">
    <link href="~/assets2/css/theme-rtl.min.css" type="text/css" rel="stylesheet" id="style-rtl">
    <link href="~/assets2/css/theme.min.css" type="text/css" rel="stylesheet" id="style-default">
    <link href="~/assets2/css/user-rtl.min.css" type="text/css" rel="stylesheet" id="user-style-rtl">
    <link href="~/assets2/css/user.min.css" type="text/css" rel="stylesheet" id="user-style-default">
    <script src="https://code.jquery.com/jquery-3.6.4.min.js" crossorigin=""></script>

    <style>
    .bg-card-gradient {
       background: linear-gradient(180deg, #e5780b, #e5780b);
    }

    .tag-slide {
        position: absolute;
        white-space: nowrap;
        opacity: 0;
        transform: translateX(100%);
        transition: all 1.5s ease;
        font-size: 0.95rem;
        color: #6c757d;
    }

    .tag-slide.active {
        opacity: 1;
        transform: translateX(0);
    }

    .tag-slide.exit-left {
        opacity: 0;
        transform: translateX(-100%);
    }

    /* Loader overlay */
    #loaderOverlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(200, 200, 200, 0.7); /* light transparent gray */
        display: none; /* flex; */ /* show by default */
        justify-content: center;
        align-items: center;
        z-index: 9999;
    }

    /* Loader spinner */
    .spinner {
        border: 8px solid #f3f3f3;
        border-top: 8px solid #0d6efd;
        border-radius: 50%;
        width: 60px;
        height: 60px;
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }
    </style>
    <script>
        var phoenixIsRTL = window.config.config.phoenixIsRTL;
        if (phoenixIsRTL) {
          var linkDefault = document.getElementById('style-default');
          var userLinkDefault = document.getElementById('user-style-default');
          linkDefault.setAttribute('disabled', true);
          userLinkDefault.setAttribute('disabled', true);
          document.querySelector('html').setAttribute('dir', 'rtl');
        } else {
          var linkRTL = document.getElementById('style-rtl');
          var userLinkRTL = document.getElementById('user-style-rtl');
          linkRTL.setAttribute('disabled', true);
          userLinkRTL.setAttribute('disabled', true);
        }
    </script>
</head>

<body>
    <div id="loaderOverlay">
        <div class="spinner"></div>
    </div>
    <main class="main" id="top">
       
       @RenderBody()
    </main>
    
    <script>
        function showLoader() {
          document.getElementById("loaderOverlay").style.display = "flex";
        }

        function hideLoader() {
          document.getElementById("loaderOverlay").style.display = "none";
        }

             let ajaxActiveCount = 0;

        $(document).ajaxStart(function () {
            ajaxActiveCount++;
            console.log("ajaxActiveCount START:", ajaxActiveCount);
            showLoader();
        });

        $(document).ajaxStop(function () {
            ajaxActiveCount--;
            if (ajaxActiveCount <= 0) {
                ajaxActiveCount = 0;
                hideLoader();
            }
            console.log("ajaxActiveCount STOP:", ajaxActiveCount);
        });

        function handleApiError(xhr, status, error, title="Info!") {

            console.log("API Error:", xhr.responseText);

            let msg = "Something went wrong!";

            try {
                // Parse JSON response safely
                let resp = JSON.parse(xhr.responseText);

                // If message exists, show that only
                if (resp && resp.message) {
                    msg = resp.message;
                }
            } catch (e) {
                // If JSON parse fails, fallback to raw text
                msg = xhr.responseText;
            }

            // Show SweetAlert Error
            Swal.fire({
                icon: "info",
                title: title,
                text: msg
            });
        }
    </script>
    <!-- ===============================================-->
    <!--    JavaScripts-->
    <!-- ===============================================-->
    <script src="~/assets2/vendors/popper/popper.min.js"></script>
    <script src="~/assets2/vendors/bootstrap/bootstrap.min.js"></script>
    <script src="~/assets2/vendors/anchorjs/anchor.min.js"></script>
    <script src="~/assets2/vendors/is/is.min.js"></script>
    <script src="~/assets2/vendors/fontawesome/all.min.js"></script>
    <script src="~/assets2/vendors/lodash/lodash.min.js"></script>
    <script src="~/assets2/vendors/list.js/list.min.js"></script>
    <script src="~/assets2/vendors/feather-icons/feather.min.js"></script>
    <script src="~/assets2/vendors/dayjs/dayjs.min.js"></script>
    <script src="~/assets2/js/phoenix.js"></script>
</body>
</html>