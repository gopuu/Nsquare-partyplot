<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <!-- ===============================================-->
    <!--    Document Title-->
    <!-- ===============================================-->
    <title>Infinity</title>
    <!-- ===============================================-->
    <!--    Favicons-->
    <!-- ===============================================-->
    <link rel="apple-touch-icon" sizes="180x180" href="/assets2/img/favicons/infinity_apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/assets2/img/favicons/infinity_favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/assets2/img/favicons/infinity_favicon-16x16.png">
    <link rel="shortcut icon" type="image/x-icon" href="/assets2/img/favicons/infinity_favicon.ico">
    <link rel="manifest" href="~/assets2/img/favicons/manifest.json">
    <meta name="msapplication-TileImage" content="~/assets2/img/favicons/mstile-150x150.png">
    <meta name="theme-color" content="#ffffff">
    <script src="~/assets2/vendors/simplebar/simplebar.min.js"></script>
    <script src="~/assets2/js/config.js"></script>
    <!-- ===============================================-->
    <!--    Stylesheets-->
    <!-- ===============================================-->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
    <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@300;400;600;700;800;900&amp;display=swap" rel="stylesheet">
    <link href="~/assets2/vendors/simplebar/simplebar.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://unicons.iconscout.com/release/v4.0.8/css/line.css">
    <link href="~/assets2/css/theme-rtl.min.css" type="text/css" rel="stylesheet" id="style-rtl">
    <link href="~/assets2/css/theme.min.css" type="text/css" rel="stylesheet" id="style-default">
    <link href="~/assets2/css/user-rtl.min.css" type="text/css" rel="stylesheet" id="user-style-rtl">
    <link href="~/assets2/css/user.min.css" type="text/css" rel="stylesheet" id="user-style-default">
    <script src="https://code.jquery.com/jquery-3.6.4.min.js" crossorigin=""></script>
    <link href="~/assets2/css/shared/layoutempty.css" asp-append-version="true" rel="stylesheet" />

    <script>
        var phoenixIsRTL = window.config.config.phoenixIsRTL;
        if (phoenixIsRTL) {
          var linkDefault = document.getElementById('style-default');
          var userLinkDefault = document.getElementById('user-style-default');
          linkDefault.setAttribute('disabled', true);
          userLinkDefault.setAttribute('disabled', true);
          document.querySelector('html').setAttribute('dir', 'rtl');
        } else {
          var linkRTL = document.getElementById('style-rtl');
          var userLinkRTL = document.getElementById('user-style-rtl');
          linkRTL.setAttribute('disabled', true);
          userLinkRTL.setAttribute('disabled', true);
        }
    </script>
</head>

<body>
    <div id="loaderOverlay">
        <div class="spinner"></div>
    </div>
    <main class="main" id="top">       
       @RenderBody()
    </main>

    <!-- ===============================================-->
    <!--    JavaScripts-->
    <!-- ===============================================-->
    <script src="~/assets2/vendors/popper/popper.min.js"></script>
    <script src="~/assets2/vendors/bootstrap/bootstrap.min.js"></script>
    <script src="~/assets2/vendors/anchorjs/anchor.min.js"></script>
    <script src="~/assets2/vendors/is/is.min.js"></script>
    <script src="~/assets2/vendors/fontawesome/all.min.js"></script>
    <script src="~/assets2/vendors/lodash/lodash.min.js"></script>
    <script src="~/assets2/vendors/list.js/list.min.js"></script>
    <script src="~/assets2/vendors/feather-icons/feather.min.js"></script>
    <script src="~/assets2/vendors/dayjs/dayjs.min.js"></script>
    <script src="~/assets2/js/phoenix.js"></script>
    @RenderSection("Scripts", required: false)
    @RenderSection("Styles", required: false)

    <script src="~/assets2/js/shared/layoutempty.js" asp-append-version="true"></script>

</body>
</html>