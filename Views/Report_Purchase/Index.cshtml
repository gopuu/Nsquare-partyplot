@{
    ViewData["Title"] = "Purchase Report";
    Layout = "_Layout";
}

<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<link href="/assets2/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<script src="/assets2/js/jquery.dataTables.min.js"></script>
<script src="/assets2/js/dataTables.bootstrap5.min.js"></script>
<link href="~/assets2/css/customdatatable/customdatatable.css" asp-append-version="true" rel="stylesheet" />

<div class="content">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="text-warning mb-0">Purchase Report</h4>

        <div class="d-flex align-items-center gap-2">

            <button class="btn btn-outline-warning btn-sm" id="btnToggleFilter">
                <i class="fa fa-filter me-1"></i> Filter
            </button>

            <div class="form-check form-switch mb-0">
                <input class="form-check-input" type="checkbox" id="toggleWithHeader">
                <label class="form-check-label fw-semibold" for="toggleWithHeader">
                    With Header
                </label>
            </div>

            <button class="btn btn-outline-info btn-sm" id="btn-select-columns">
                <i class="fa fa-list-check me-1"></i> Columns
            </button>

            <div class="dropdown">
                <button class="btn btn-outline-dark btn-sm dropdown-toggle"
                        type="button"
                        data-bs-toggle="dropdown">
                    <i class="fas fa-download"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li>
                        <a class="dropdown-item cursor-pointer" href="javascript:void(0)"
                           onclick="ViewPurchaseReport('downloadPDF')">
                            <i class="fas fa-file-pdf text-danger me-2"></i> PDF
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item cursor-pointer" href="javascript:void(0)"
                           onclick="ViewPurchaseReport('downloadExcel')">
                            <i class="fas fa-file-excel text-success me-2"></i> Excel
                        </a>
                    </li>
                </ul>
            </div>

        </div>
    </div>

    <!-- GRID -->
    <div id="tableMain">
        <table id="tblPurchase" class="table table-striped table-bordered w-100">
            <tfoot class="table-secondary fw-bold">
                <tr>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                </tr>
            </tfoot>
        </table>
    </div>

</div>

<!-- FILTER PANEL -->
<div id="filterPanel" class="filter-panel">

    <div class="filter-header bg-warning d-flex justify-content-between align-items-center px-3 py-2">
        <h6 class="mb-0 text-white">Filters</h6>
        <button type="button" class="btn-close btn-close-white" id="btnCloseFilter"></button>
    </div>

    <div class="filter-body">

        <div class="mb-3">
            <label class="form-label">Duration</label>
            <select id="quickRange" class="form-select form-select-sm">
                <option value="thismonth">This Month</option>
                <option value="lastmonth">Last Month</option>
                <option value="last7days">Last 7 days</option>
                <option value="last30days">Last 30 days</option>
                <option value="yesterday">Yesterday</option>
                <option value="last12months">Last 12 Months</option>
                <option value="customrange">Custom Range</option>
            </select>
        </div>

        <div class="row g-2">
            <div class="col-md-6 mb-3">
                <label class="form-label">From Date</label>
                <input type="date" id="fromDate" class="form-control form-control-sm">
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">To Date</label>
                <input type="date" id="toDate" class="form-control form-control-sm">
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Supplier</label>
            <select id="ddlSupplier" class="form-select form-select-sm"></select>
        </div>

    </div>

    <div class="filter-footer">
        <button id="btnResetFilter" class="btn btn-outline-secondary btn-sm">Reset</button>
        <button id="btnApplyFilter" class="btn btn-warning btn-sm">Apply</button>
    </div>

</div>

<!-- COLUMNS MODAL -->
<div class="modal fade" id="modalColumns" tabindex="-1">
    <div class="modal-dialog modal-md">
        <div class="modal-content">

            <div class="modal-header bg-warning py-2">
                <h5 class="modal-title text-white">Select Columns</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="chk-select-all">
                        <label class="form-check-label fw-bold">Select All</label>
                    </div>
                    <button class="btn btn-sm btn-outline-secondary" id="btn-reset-columns">
                        <i class="fa fa-refresh"></i> Reset
                    </button>
                </div>
                <hr />
                <div id="column-list" class="row"></div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button class="btn btn-warning" id="btn-save-columns">
                    <i class="fa fa-save"></i> Save
                </button>
            </div>

        </div>
    </div>
</div>

<!--Purchase Invoice Modal-->
<div class="modal fade" id="purchaseInvoiceModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">

            <div class="modal-header bg-warning py-2">
                <h5 class="modal-title text-white">Purchase Invoice</h5>
                <div class="ms-auto d-flex align-items-center gap-2">
                    <div class="dropdown">
                        <button class="btn btn-outline-dark btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
                            <i class="fas fa-download"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <a class="dropdown-item cursor-pointer" id="btnDownloadInvoice">
                                    <i class="fas fa-file-pdf text-danger me-2"></i> PDF
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item cursor-pointer" id="btnDownloadInvoice_Excel">
                                    <i class="fas fa-file-excel text-success me-2"></i> Excel
                                </a>
                            </li>
                        </ul>
                    </div>

                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
            </div>

            <div class="modal-body">

                <!-- Invoice Info -->
                <div class="row mb-3">
                    <div class="col-md-3">
                        <b>Invoice No</b>
                        <div id="inv_no"></div>
                    </div>

                    <div class="col-md-3">
                        <b>Date</b>
                        <div id="inv_date"></div>
                    </div>

                    <div class="col-md-3">
                        <b>Supplier</b>
                        <div id="inv_supplier"></div>
                    </div>

                    <div class="col-md-3">
                        <b>Phone</b>
                        <div id="inv_phone"></div>
                    </div>
                </div>

                <!-- Items Table -->
                <table class="table table-bordered table-sm" id="invoiceItemsTable">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Raw Material</th>
                            <th>Qty</th>
                            <th>Unit</th>
                            <th class="text-end">Price</th>
                            <th class="text-end">Cost</th>
                            <th class="text-end">CGST</th>
                            <th class="text-end">SGST</th>
                            <th class="text-end">IGST</th>
                            <th class="text-end">GST</th>
                            <th class="text-end">Total</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>

                <!-- Totals -->
                <div class="row justify-content-end">
                    <div class="col-md-4">

                        <table class="table table-sm table-bordered">
                            <tr>
                                <td>Sub Total</td>
                                <td class="text-end" id="t_subtotal"></td>
                            </tr>

                            <tr>
                                <td>Other Charges</td>
                                <td class="text-end" id="t_charges"></td>
                            </tr>

                            <tr>
                                <td>Other Taxes</td>
                                <td class="text-end" id="t_taxes"></td>
                            </tr>

                            <tr>
                                <td>Discount</td>
                                <td class="text-end" id="t_discount"></td>
                            </tr>

                            <tr class="fw-bold">
                                <td>Grand Total</td>
                                <td class="text-end" id="t_total"></td>
                            </tr>

                        </table>

                    </div>
                </div>

            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="~/assets2/js/report_purchase/report_purchase.js" asp-append-version="true"></script>
    <script src="~/assets2/js/Shared/utility.js" asp-append-version="true"></script>
}

@section Styles {
    <link href="~/assets2/css/report_purchase/report_purchase.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/assets2/css/report_filters/report_filters.css" rel="stylesheet" asp-append-version="true" />
}