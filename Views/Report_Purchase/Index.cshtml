@{
    ViewData["Title"] = "Report Purchase";
    Layout = "_Layout";
}


<div class="content">
    <div class="pb-1">
        <div class="card shadow-sm">
            <!-- CARD HEADER -->
            <div class="card-header d-flex justify-content-between align-items-center">
                <h4 class="mb-0 fw-semibold">
                    Purchase Report
                </h4>
                <div class="row g-2 align-items-end justify-content-end">
                    <div class="col-auto">
                        <input type="date" id="from-date" class="form-control form-control-sm">
                    </div>

                    <div class="col-auto">
                        <input type="date" id="to-date" class="form-control form-control-sm">
                    </div>

                    <div class="col-auto">
                        <div class="dropdown">
                            <button class="btn btn-outline-secondary btn-sm fw-bold dropdown-toggle"
                                    type="button" id="sortByDropdown"
                                    data-bs-toggle="dropdown">
                                Filter : This Month
                            </button>

                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item sort-option" data-value="yesterday" href="#">Yesterday</a></li>
                                <li><a class="dropdown-item sort-option" data-value="days" href="#">Last 7 Days</a></li>
                                <li><a class="dropdown-item sort-option" data-value="lastdays" href="#">Last 30 Days</a></li>
                                <li><a class="dropdown-item sort-option active" data-value="thismonth" href="#">This Month</a></li>
                                <li><a class="dropdown-item sort-option" data-value="lastmonth" href="#">Last Month</a></li>
                                <li><a class="dropdown-item sort-option" data-value="12months" href="#">Last 12 Months</a></li>
                                <li><a class="dropdown-item sort-option" data-value="customrange" href="#">Custom Range</a></li>
                            </ul>
                        </div>
                    </div>

                    <div class="col-md-auto">
                        <button class="btn btn-outline-warning"
                                onclick="ViewPurchaseReport('downloadPDF')">
                            <i class="fas fa-file-pdf"></i>
                        </button>
                    </div>

                    <div class="col-md-auto">
                        <button class="btn btn-outline-warning"
                                onclick="ViewPurchaseReport('downloadExcel')">
                            <i class="fas fa-file-excel"></i>
                        </button>
                    </div>
                </div>
            </div>
            <div class="card-body pt-0">
                <!-- PDF Preview Container -->
                <div id="pdfPreviewContainer" style="border: 1px solid #ddd; padding: 10px; width: 100%; min-height: 600px; height: calc(100vh - 100px); overflow: auto;">
                    <p style="text-align: center; color: gray;">PDF Preview will appear here...</p>
                </div>

                <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
                <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/assets2/js/report_purchase/report_purchase.js" asp-append-version="true"></script>
}
