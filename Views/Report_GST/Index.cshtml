@{
    ViewData["Title"] = "Report GST";
    Layout = "_Layout";
}


<div class="content">
    <div class="pb-1">
        <div class="row g-2">
            <div class="col-md-2">
                <label class="form-label fw-semibold">Invoice  Date</label>
                <input type="date" id="invoice-date" class="form-control">
            </div>

            <div class="col mt-5">
                <button class="btn btn-danger"
                        onclick="DownloadGSTReport(event)">
                    <i class="fas fa-download"></i>

                </button>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/assets2/js/report_gst/report_gst.js" asp-append-version="true"></script>
}

