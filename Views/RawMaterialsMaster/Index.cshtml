@{
    ViewData["Title"] = "Raw Materials Master";
    Layout = "_Layout";
}

<link href="/assets2/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<script src="/assets2/js/jquery.dataTables.min.js"></script>
<script src="/assets2/js/dataTables.bootstrap5.min.js"></script>

@section Styles {
    <link href="~/assets2/css/customdatatable/customdatatable.css" asp-append-version="true" rel="stylesheet" />
    <link href="~/assets2/css/RawMaterialsMaster/RawMaterialsMaster.css" asp-append-version="true" rel="stylesheet" />
}

@section Scripts {
    <script src="~/assets2/js/RawMaterialsMaster/RawMaterialsMaster.js" asp-append-version="true"></script>
}

<!-- MAIN -->
<div class="content">
    <div class="pb-1">
        <div class="row g-2">
            <div class="col-12">
                <div class="mb-12">

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="mb-0 text-warning">Raw Materials Master</h4>
                        <button class="btn btn-outline-warning" id="btn-add">
                            <i class="fa fa-plus-circle"></i> Add Raw Material
                        </button>
                    </div>

                    <!-- CATEGORY SUMMARY WRAPPER -->
                    <div class="d-flex align-items-center">

                        <!-- LEFT BUTTON -->
                        <button class="btn btn-light me-2" id="catScrollPrev">
                            <i class="fa fa-chevron-left"></i>
                        </button>

                        <!-- SCROLL AREA -->
                        <div id="categorySummaryContainer"
                             class="d-flex gap-3 p-2 rounded"
                             style="overflow-x:auto; white-space:nowrap; scroll-behavior:smooth; background:#fff4e5;">
                        </div>

                        <!-- RIGHT BUTTON -->
                        <button class="btn btn-light ms-2" id="catScrollNext">
                            <i class="fa fa-chevron-right"></i>
                        </button>

                    </div>

                    <!--DATA GRID-->
                    <div id="tableMain">
                        <table class="table table-striped table-bordered" style="width:100%"></table>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
<!-- END MAIN -->

<!-- ADD / EDIT RAW MATERIAL MODAL -->
<div class="modal fade" id="addEventModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header bg-warning text-white py-2">
                <h5 class="modal-title text-white" id="addEventModalTitle">Add Raw Material</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <input type="hidden" id="rmId" value="0">

                <!-- ================= TAB NAVIGATION ================= -->
                <ul class="nav nav-tabs" id="rmTabs" role="tablist">
                    <li class="nav-item">
                        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tabBasic">Basic Details</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabPrices">Prices</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabTaxes">Taxes</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabLevels">Set Levels</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabCodes">Related Codes</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabOther">Other Details</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabExcise">For Excise</button>
                    </li>
                </ul>

                <!-- ================= TAB CONTENT ================= -->
                <div class="tab-content mt-3">

                    <!-- ============= TAB 1 : BASIC DETAILS ============= -->
                    <div class="tab-pane fade show active" id="tabBasic">

                        <div class="row g-3">
                            <!--Name-->
                            <div class="col-md-12">
                                <label class="form-label">Name</label>
                                <input type="text" id="rmName" class="form-control" placeholder="Enter Name">
                            </div>

                            <!--Category-->
                            <div class="col-md-8">
                                <label class="form-label">Category</label>
                                <select id="itemCategoryId" class="form-select">
                                    <option value="">Select Category</option>
                                </select>
                            </div>

                            <!--Current Qty-->
                            <div class="col-md-4">
                                <label class="form-label">Current Qty</label>
                                <input type="text" id="currentQty" class="form-control" placeholder="Enter Current Qty" value="0">
                            </div>

                            <!-- PURCHASE UNITS - MULTI SELECT-->
                            <div class="col-md-6">
                                <label class="form-label">Purchase Units</label>

                                <div class="dropdown w-100">
                                    <button class="btn btn-light border w-100 text-start"
                                            type="button"
                                            id="purchaseUnitsDropdown"
                                            data-bs-toggle="dropdown">
                                        Select Units
                                    </button>

                                    <div class="dropdown-menu p-2 w-100" id="purchaseUnitsMenu">

                                        <!-- SEARCH BOX -->
                                        <input type="text" id="purchaseUnitSearch" class="form-control form-control-sm mb-2" placeholder="Search...">

                                        <!-- SELECT ALL -->
                                        <div class="form-check mb-2">
                                            <input type="checkbox" class="form-check-input" id="selectAllPurchaseUnits">
                                            <label class="form-check-label" for="selectAllPurchaseUnits">Select All</label>
                                        </div>

                                        <ul class="list-unstyled m-0" id="purchaseUnitsList">
                                            <!-- Dynamically loaded checkboxes here -->
                                        </ul>

                                    </div>
                                </div>
                            </div>

                            <!--Consumption Unit-->
                            <div class="col-md-6">
                                <label class="form-label">Consumption Unit</label>
                                <select id="consumptionUnitId" class="form-select">
                                    <option value="0">Select Unit</option>
                                </select>
                            </div>

                            <div class="col-md-12 d-none" id="conversionContainer">
                                <label class="form-label fw-semibold">Conversion Rules</label>
                                <small class="text-muted d-block mb-2">
                                    Define conversion from Purchase Unit to Consumption Unit.
                                </small>
                                <div id="conversionScrollArea">
                                    <div id="conversionRows"></div>
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- ============= TAB 2 : PRICES ============= -->
                    <div class="tab-pane fade" id="tabPrices">

                        <div class="row g-3">
                            <div class="col-md-12">
                                <label class="form-label">Purchase Price</label>
                                <div class="input-group">
                                    <span class="input-group-text">₹</span>
                                    <input type="number" step="1" id="purchasePrice" class="form-control">
                                </div>
                            </div>

                            <div class="col-md-12">
                                <label class="form-label">Transfer Price</label>
                                <div class="input-group">
                                    <span class="input-group-text">₹</span>
                                    <input type="number" step="1" id="transferPrice" class="form-control">
                                </div>

                            </div>

                            <div class="col-md-12">
                                <label class="form-label">Reconciliation Price</label>
                                <div class="input-group">
                                    <span class="input-group-text">₹</span>
                                    <input type="number" step="1" id="reconPrice" class="form-control">
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- ============= TAB 3 : TAXES ============= -->
                    <div class="tab-pane fade" id="tabTaxes">

                        <div class="row g-3">
                            <div class="col-md-12">
                                <label class="form-label">Tax Type</label>
                                <div class="d-flex gap-3">
                                <div class="form-check">
                                    <input type="radio" name="taxType" value="1" id="gstRadio" class="form-check-input">
                                    <label class="form-check-label">GST</label>
                                </div>

                                <div class="form-check">
                                    <input type="radio" name="taxType" value="2" id="vatRadio" class="form-check-input">
                                    <label class="form-check-label">VAT</label>
                                </div>
                            </div>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Tax (%)</label>
                                <div class="input-group">
                                    <input type="number" step="1" id="taxPercent" class="form-control">
                                    <span class="input-group-text">%</span>
                                </div>
                            </div>
                            
                            <div class="col-md-4 d-none" id="exciseWrapper">
                                <label class="form-label">Excise Duty (in Amount)</label>
                                <div class="input-group">
                                    <span class="input-group-text">₹</span>
                                    <input type="number" step="1" id="exciseDutyAmount" class="form-control">
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- ============= TAB 4 : SET LEVELS ============= -->
                    <div class="tab-pane fade" id="tabLevels">

                        <div class="row g-3">

                            <div class="col-md-6">
                                <label class="form-label">Minimum Stock Unit</label>
                                <select id="minStockUnitId" class="form-select"></select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Minimum Stock Level</label>
                                <input type="number" step="1" id="minStockLevel" class="form-control">
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">At Par Stock Unit</label>
                                <select id="atParUnitId" class="form-select"></select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">At Par Stock Level</label>
                                <input type="number" step="1" id="atParLevel" class="form-control">
                            </div>

                            <!-- MULTI SELECT: CLOSING STOCK UPDATED ON -->
                            <div class="col-md-6">
                                <label class="form-label">Closing Stock Updated On</label>

                                <div class="dropdown w-100">
                                    <button class="btn btn-light border w-100 text-start"
                                            type="button"
                                            id="dayFreqDropdown"
                                            data-bs-toggle="dropdown">
                                        Select Frequency
                                    </button>

                                    <div class="dropdown-menu p-2 w-100" id="dayFreqMenu" style="max-height: 280px; overflow-y: auto;">

                                        <!-- SEARCH -->
                                        <input type="text" id="dayFreqSearch" class="form-control form-control-sm mb-2" placeholder="Search...">

                                        <!-- SELECT ALL -->
                                        <div class="form-check mb-2">
                                            <input type="checkbox" class="form-check-input" id="dayFreqSelectAll">
                                            <label class="form-check-label" for="dayFreqSelectAll">Select All</label>
                                        </div>

                                        <!-- LIST -->
                                        <ul class="list-unstyled m-0" id="dayFreqList">
                                            <!-- dynamic checkboxes -->
                                        </ul>

                                    </div>
                                </div>
                            </div>

                            <!--Allow Restock Level-->
                            <div class="col-md-6">
                                <div class="form-check form-switch mt-5">
                                    <input type="checkbox" id="allowRestock" class="form-check-input">
                                    <label class="form-check-label">Allow Restock Level</label>
                                </div>
                            </div>

                            <!-- RESTOCK TABLE -->
                            <div class="col-md-12 d-none" id="restockTableWrapper" style="max-height:300px; overflow-y:auto; overflow-x:auto;">
                                <table class="table table-bordered">
                                    <thead>
                                        <tr>
                                            <th>Restock Qty</th>
                                            <th>Unit</th>
                                            <th width="80">Remove</th>
                                        </tr>
                                    </thead>
                                    <tbody id="restockBody">
                                        <!-- rows added dynamically -->
                                    </tbody>
                                </table>
                                <button class="btn btn-warning btn-sm" id="addRestockRow">Add Row</button>
                            </div>

                        </div>

                    </div>

                    <!-- ============= TAB 5 : RELATED CODES ============= -->
                    <div class="tab-pane fade" id="tabCodes">

                        <div class="row g-3">
                            <div class="col-md-12">
                                <div class="col-md-4">
                                    <label class="form-label">Barcode / Shortcode</label>
                                    <input type="text" id="barcode" class="form-control">
                                </div>
                            </div>

                            <div class="col-md-12">
                                <div class="col-md-4">
                                    <label class="form-label">HSN Code</label>
                                    <input type="text" id="hsn" class="form-control">
                                </div>

                            </div>
                        </div>

                    </div>

                    <!-- ============= TAB 6 : OTHER DETAILS ============= -->
                    <div class="tab-pane fade" id="tabOther">

                        <div class="row g-3">

                            <div class="col-md-4">
                                <label class="form-label">Exclusive to Restaurant</label>
                                <select id="exclusiveRest" class="form-select">
                                    <option value="0">NO</option>
                                    <option value="1">YES</option>
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Is Expiry</label>
                                <select id="isExpiry" class="form-select">
                                    <option value="0">NO</option>
                                    <option value="1">YES</option>
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Allow Decimal Qty</label>
                                <select id="allowDecimal" class="form-select">
                                    <option value="0">NO</option>
                                    <option value="1">YES</option>
                                </select>
                            </div>

                            <div class="col-md-12">
                                <label class="form-label">Description</label>
                                <textarea id="description" class="form-control" rows="4"></textarea>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Normal Loss (%)</label>
                                <div class="input-group">
                                    <input type="number" step="1" id="lossPercent" class="form-control">
                                    <span class="input-group-text">%</span>
                                </div>

                            </div>

                        </div>

                    </div>

                    <!-- ============= TAB 7 : EXCISE REPORT ============= -->
                    <div class="tab-pane fade" id="tabExcise">
                        <div class="row g-3">

                            <div class="col-md-12">
                                <div class="col-md-4">
                                    <label class="form-label">Quantity (gm/ml)</label>
                                    <input type="number" step="1" id="qtyGmMl" class="form-control">
                                </div>
                            </div>

                            <div class="col-md-12">
                                <div class="col-md-4">
                                    <label class="form-label">GTIN</label>
                                    <input type="text" id="gtin" class="form-control">
                                </div>
                            </div>

                            <div class="col-md-12">
                                <div class="col-md-4">
                                    <label class="form-label">Brand</label>
                                    <input type="text" id="brand" class="form-control">
                                </div>
                            </div>

                        </div>
                    </div>

                </div>

            </div>

            <!-- FOOTER WITH NEXT & PREV -->
            <div class="modal-footer d-flex justify-content-between align-items-center">

                <!-- LEFT SIDE -->
                <div>
                    <button class="btn btn-outline-secondary" id="btnPrev">
                        <i class="fa fa-arrow-left me-1"></i> Previous
                    </button>
                </div>

                <!-- RIGHT SIDE -->
                <div>
                    <button class="btn btn-outline-secondary" id="btnNext">
                        Next <i class="fa fa-arrow-right ms-1"></i>
                    </button>

                    <button class="btn btn-outline-warning" id="btnSaveFinal">
                        <i class="fa fa-save me-1"></i> Save
                    </button>
                </div>

            </div>
        </div>
    </div>
</div>

<!--DELETE MODAL-->
<div class="modal fade zoomIn" id="deleteRecordModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header bg-warning">
                <h5 class="modal-title text-white">Delete Raw Material</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body text-center">
                <lord-icon src="/assets2/js/gsqxdxog.json" trigger="loop"
                           colors="primary:#f7b84b,secondary:#f06548"
                           style="width:100px;height:100px">
                </lord-icon>

                <p class="mt-3">Are you sure you want to delete this record?</p>

                <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-outline-danger" id="btnDeleteConfirm">Delete</button>
            </div>

        </div>
    </div>
</div>