@{
    ViewData["Title"] = "Asset Ledger";
    Layout = "_Layout";
}

<link href="/assets2/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<script src="/assets2/js/jquery.dataTables.min.js"></script>
<script src="/assets2/js/dataTables.bootstrap5.min.js"></script>

@section Styles {
    <link href="~/assets2/css/customdatatable/customdatatable.css" asp-append-version="true" rel="stylesheet" />
    <link href="~/assets2/css/AssetLedger/AssetLedger.css" asp-append-version="true" rel="stylesheet" />
}
@section Scripts {
    <script src="~/assets2/js/AssetLedger/AssetLedger.js" asp-append-version="true"></script>
}

<!-- MAIN -->
<div class="content">
    <div class="pb-1">
        <div class="row g-2">
            <div class="col-12 col-xxl-12">
                <div class="mb-12">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="mb-0 text-warning">Asset Ledger</h4>
                    </div>

                    <!-- Filters -->
                    <div class="d-flex flex-wrap gap-2 align-items-center mb-3">

                        <!-- Asset -->
                        <select id="filterAsset" class="form-select form-select-sm w-auto">
                            <option value="0">All Assets</option>
                        </select>

                        <!-- Transaction Type -->
                        <select id="filterTransactionType" class="form-select form-select-sm w-auto">
                            <option value="">All Transactions</option>
                            <option value="Purchase">Purchase</option>
                            <option value="Remove">Remove</option>
                            <option value="RepairSent">Repair Sent</option>
                            <option value="RepairReceived">Repair Received</option>
                            <option value="EventIssue">Event Issue</option>
                            <option value="EventReturn">Event Return</option>
                        </select>

                        <!-- Reference Table -->
                        <select id="filterReferenceTable" class="form-select form-select-sm w-auto">
                            <option value="">All Sources</option>
                            <option value="AssetPurchase">Asset Purchase</option>
                            <option value="AssetRemove">Asset Remove</option>
                            <option value="AssetRepair">Asset Repair</option>
                        </select>

                        <!-- Reversal -->
                        <select id="filterReversal" class="form-select form-select-sm w-auto">
                            <option value="">All</option>
                            <option value="0">Normal</option>
                            <option value="1">Reversal</option>
                        </select>

                        <!-- Duration Dropdown -->
                        <div class="dropdown">

                            <button class="btn btn-outline-secondary btn-sm fw-bold dropdown-toggle"
                                    id="ledgerDurationDropdown"
                                    data-bs-toggle="dropdown">

                                Filter : This Month

                            </button>

                            <ul class="dropdown-menu">

                                <li><a class="dropdown-item ledger-duration" data-value="Yesterday" href="#">Yesterday</a></li>
                                <li><a class="dropdown-item ledger-duration" data-value="Last7days" href="#">Last 7 days</a></li>
                                <li><a class="dropdown-item ledger-duration active" data-value="ThisMonth" href="#">This Month</a></li>
                                <li><a class="dropdown-item ledger-duration" data-value="LastMonth" href="#">Last Month</a></li>
                                <li><a class="dropdown-item ledger-duration" data-value="Last12Months" href="#">Last 12 Months</a></li>
                                <li><a class="dropdown-item ledger-duration" data-value="Custom" href="#">Custom Range</a></li>

                            </ul>

                        </div>

                        <!-- From Date -->
                        <input type="date"
                               class="form-control form-control-sm w-auto"
                               id="filterFromDate">

                        <!-- To Date -->
                        <input type="date"
                               class="form-control form-control-sm w-auto"
                               id="filterToDate">

                        <!-- Reset -->
                        <button class="btn btn-sm btn-outline-danger" id="btnResetLedger">
                            Reset
                        </button>

                    </div>

                    <div id="tableMain">
                        <table class="table table-striped table-bordered" style="width:100%"></table>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
