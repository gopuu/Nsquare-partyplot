@{
    ViewData["Title"] = "Designation";
    Layout = "_Layout";
}

<div class="content">
    <div class="pb-5">
        <div class="row g-4">
            <div class="col-12 col-xxl-6">
                <div class="mb-12">
                    <h2 class="mb-2">Designation!</h2>
                    <h5 class="text-body-tertiary fw-semibold">Designation Page.</h5>
                </div>
            </div>
        </div>
    </div>
</div>

@*
<script>
    // Static data array
    const data = [];

    function renderTable(data) {
        console.log("data:", data);

        // Destroy existing DataTable if present
        if ($.fn.dataTable.isDataTable('#tableExample3 table')) {
            $('#tableExample3 table').DataTable().clear().destroy();
        }

        // Check if data is null or empty
        if (!data || data.length === 0) {
            console.log("No Data Found");

            // Ensure table headers remain visible and add "No Data Found" row in the tbody
            $('#tableExample3 tbody').html(`
                    <tr>
                        <td colspan="15" class="text-center fw-bold text-danger">No Data Found !!</td>
                    </tr>
                `);

            // Initialize an empty DataTable with headers intact
            $('#tableExample3 table').DataTable({
                data: [],
                columns: [
                    { data: 'srno', title: 'Sr. No.' },
                    { data: 'name', title: 'Name' }, // Using 'name' instead of 'ProcessName'
                    { data: 'band', title: 'Band' }, // Using 'band' instead of 'IndexNo'
                    { data: 'code', title: 'Code' }, // Using 'code' instead of 'ProcessId'
                    {
                        data: null,
                        title: 'Actions',
                        render: function (data, type, row) {
                            return `
                                <button class="btn btn-outline-warning btn-sm me-1 mb-0 btn-edit">
                                    <i class="fa fa-edit"></i>
                                </button>
                                <button class="btn btn-outline-danger btn-sm me-1 mb-0 btn-delete">
                                    <i class="fa fa-trash"></i>
                                </button>
                            `;
                        }
                    }
                ],
                pageLength: 10,
                ordering: true,
                searching: true,
                lengthChange: false,
                pagingType: "full_numbers"
            });

            return; // Exit function
        }

        let processData = data;
        // Adding Sr. No.
        processData.forEach((item, index) => {
            item.srno = index + 1;
        });

        // Destroy the previous DataTable instance before reinitializing
        if ($.fn.dataTable.isDataTable('#tableExample3 table')) {
            $('#tableExample3 table').DataTable().clear().destroy();
        }

        $('#tableExample3 table').DataTable({
            data: processData,
            columns: [
                { data: 'srno', title: 'Sr. No.' },
                { data: 'name', title: 'Name' }, // Using 'name' instead of 'ProcessName'
                { data: 'band', title: 'Band' }, // Using 'band' instead of 'IndexNo'
                { data: 'code', title: 'Code' }, // Using 'code' instead of 'ProcessId'
                {
                    data: null,
                    title: 'Actions',
                    render: function (data, type, row) {
                        return `
                        <div class="d-flex flex-column flex-sm-row gap-2">
                            <button class="btn btn-outline-warning btn-sm me-1 mb-0 btn-edit">
                                <i class="fa fa-edit"></i>
                            </button>
                            <button class="btn btn-outline-danger btn-sm me-1 mb-0 btn-delete">
                                <i class="fa fa-trash"></i>
                            </button>
                        </div>
                            `;
                    }
                }
            ],
            pageLength: 10,
            ordering: true,
            searching: true,
            lengthChange: false,
            pagingType: "full_numbers"
        });
    }

    // Function to render rows
    function renderTable2(data) {
        const tableBody = document.querySelector(".list");
        tableBody.innerHTML = ""; // Clear existing content

        if (!data || data.length === 0) {
            // If no data, display "No Data Found" row
            const row = document.createElement("tr");
            row.innerHTML = `<td colspan="4" style="text-align:center;">No Data Found</td>`;
            tableBody.appendChild(row);
            $('#btn-loader').hide();
            return; // Exit the function
        }
        //hide/show tfoot
        $('#tfoot').hide();
        if (data.length > 10) {
            $('#tfoot').show();
        }

        let i = 0;
        data.forEach(item => {
            const row = document.createElement("tr");
            row.innerHTML = `
                    <td class="id" style="display:none;">${item.id}</td>
                    <td class="srno" style="width:5%">${++i}</td>
                    <td class="name">${item.name}</td>
                    <td class="band">${item.band}</td>
                    <td class="code">${item.code}</td>
                    <td class="actions">
                        <button class="btn btn-outline-warning btn-sm me-1 mb-0 btn-edit" type="button"><i class="fa fa-edit"></i></button>
                        <button class="btn btn-outline-danger btn-sm me-1 mb-0 btn-delete" type="button"><i class="fa fa-trash"></i></button>
                    </td>
                `;
            tableBody.appendChild(row);
        });

        // Reinitialize sorting after rendering new data
        initializeSorting();

        $('#btn-loader').hide();
    }
    
    // Initialize sorting
    function initializeSorting() {
        const options = {
            valueNames: ["srno", "name", "band", "code"],
            page: 10,
            pagination: true
        };
        const list = new List('tableExample3', options); // Initialize List.js or your sorting library
    }

    //Fetch Data
    function fetchData() {
        $('#btn-loader').show();

        $('.search').val('');

        $.ajax({
            type: "GET",
            url: "/api/Designation/GetDesignationList", // Correct Swagger API endpoint
            contentType: "application/json", // Ensure proper content type
            dataType: "json", // Expecting JSON response
            success: function (response) {
                //data = response; // Store the fetched data
                //console.log("response fetchData:", response);
                var data = response.data;
                try {
                    var jsonResponse = data.split('}{')[0] + "}"; // Adjust split and cleanup as needed
                    data = JSON.parse(jsonResponse);
                    renderTable(data);
                }
                catch
                {
                    renderTable(data);
                }
                //$('#btn-loader').hide();
            },
            error: function (xhr) {
                //$('#btn-loader').hide();
                ////console.log(xhr.responseText);
                Swal.fire({
                    title: "Fetch Designation Error",
                    text: xhr.responseText,
                    icon: "error"
                });
            },
            complete: function () {
                $('#btn-loader').hide(); // Ensure loader is hidden in any case
            }

        });
    }

    // Reset form fields
    function resetFormFields() {
        // Reset hidden ID field
        $('#id').val('0');

        // Reset Designation-related fields
        $('#name').val('').removeClass('is-invalid');
        $('#band').val('').removeClass('is-invalid');
        $('#code').val('').removeClass('is-invalid');

        // Reset error labels
        $('#nameError').hide();
        $('#bandError').hide();
        $('#codeError').hide();

        // Hide save button spinner
        $('#savebtnD').prop('hidden', true);
        $('#savebtn').prop('hidden', false);
    }

    // Validate form fields
    function validateAddEventForm() {
        var isValid = true; // Track overall validity

        // Get trimmed values from the form
        var name = $('#name').val().trim();
        var band = $('#band').val().trim();
        var code = $('#code').val().trim();

        // Clear previous errors
        $('.form-control').removeClass('is-invalid');
        $('.invalid-feedback').hide();

        // Validate Name
        if (name === "") {
            $('#name').addClass('is-invalid');
            $('#nameError').show();
            isValid = false;
        }

        // Validate band
        if (band === "") {
            $('#band').addClass('is-invalid');
            $('#bandError').show();
            isValid = false;
        }

        // Validate code
        if (code === "") {
            $('#code').addClass('is-invalid');
            $('#codeError').show();
            isValid = false;
        }
        return isValid; // Return the overall validity
    }

    document.addEventListener("DOMContentLoaded", function () {
        // Render the table using the static data array
        //renderTable(data);
        fetchData();
        // Reset the form when the modal is shown
        $(document).on('click', '#btn-add, #resetbtn', function () {
            // Check Add Permission from Session or Local Storage
            var canAdd = (sessionStorage.getItem('CanAdd') || localStorage.getItem('CanAdd')) === 'true';
            if (!canAdd) {
                // Display Access Denied Message
                Swal.fire({
                    icon: "error",
                    title: "Access Denied",
                    text: "You don't have permission to Add. Please contact admin.",
                    confirmButtonText: "OK"
                });
                event.preventDefault(); // Stop the modal from opening
                $('#addEventModal').modal('hide');
            } else {
                resetFormFields(); // Reset form fields when modal is shown
                $('#addEventModal').modal('show');
            }
        });

        // Edit button click
        $(document).on('click', '.btn-edit', function () {
            var canEdit = (sessionStorage.getItem('CanEdit') || localStorage.getItem('CanEdit')) === 'true';
            if (!canEdit) {
                Swal.fire({
                    icon: "error",
                    title: "Access Denied",
                    text: "You don't have permission to Edit. Please contact admin.",
                    confirmButtonText: "OK"
                });
                event.preventDefault(); // Stop navigation
                $('#addEventModal').modal('hide');
            }
            else { 
                resetFormFields();
                // Get the DataTable instance
                var table = $('#tableExample3 table').DataTable();

                // Get the row object for the clicked Edit button
                var row = $(this).closest('tr');
                var rowData = table.row(row).data(); // Get the data object for this row

                // Extract values from the row data object
                var id = rowData.id; // Using 'id' instead of 'ProcessId'
                var name = rowData.name; // Using 'name' instead of 'ProcessName'
                var band = rowData.band; // Using 'band' instead of 'IndexNo'
                var code = rowData.code; // Using 'code' instead of 'ProcessId'

                // Populate the modal with the values
                $('#id').val(id); // Populate hidden input or ID field in the modal
                $('#name').val(name); // Set the Designation Name field
                $('#band').val(band); // Set the Designation Number field
                $('#code').val(code); // Set the code field

                // Show the modal with the pre-filled data
                $('#addEventModal').modal('show');
            }
        });

        // SAVE - Handle form submission
        $('#addEventForm').submit(function (event) {
            $('#btn-loader').show();
            event.preventDefault(); // Prevent the default form submission
            
            if (validateAddEventForm()) {
                // Extract form data
                var id = $('#id').val(); // Fetch the ID from the form (hidden input)
                var name = $('#name').val().trim();
                var band = $('#band').val().trim();
                var code = $('#code').val().trim();

                var inputData = {
                    "id": id,
                    "name": name,
                    "band": band,
                    "code": code,
                };

                //console.log("inputData:", inputData)
                // Send AJAX request
                $.ajax({
                    type: "POST",
                    url: "/api/Designation/SaveDesignation", // Replace with your actual API endpoint
                    data: JSON.stringify(inputData),
                    contentType: "application/json",
                    dataType: 'text', // Expected response data type
                    beforeSend: function (xhr) {
                        xhr.setRequestHeader("accept", "text/plain"); // Ensure Accept header is set to text/plain
                    },
                    success: function (response) {
                        //console.log("submit response:", response);
                        var obj = JSON.parse(response);
                        //debugger
                        // Handle success response
                        if (obj.status.toLowerCase() == "success") {
                            //$('#btn-loader').hide();
                            Swal.fire({
                                position: "top-end",
                                icon: "success",
                                title: "Saved!",
                                showConfirmButton: false,
                                timer: 900
                            });
                            fetchData();
                            resetFormFields();  // Reset the form fields
                            $('#addEventModal').modal('hide');  // Close the modal
                        } else {
                            $('#message').removeAttr('hidden');
                            $('#message').text(obj.message).css('color', 'red').fadeIn(300).delay(5000).fadeOut(300);
                            //$('#btn-loader').hide();
                        }
                    },
                    error: function (xhr, status, error) {
                        // Handle error response
                        //$('#btn-loader').hide();
                        Swal.fire({
                            title: "Save Designation Error",
                            text: xhr.responseText,
                            icon: "error"
                        });
                    },
                    complete: function () {
                        $('#btn-loader').hide();  // Hide the loader always at the end
                    }
                });
            } else {
                // If validation failed, hide the loader
                $('#btn-loader').hide();
            }
        });

        //DELETE
        // Event handler for remove button click
        $(document).on('click', '.btn-delete', function () {
            var canDelete = (sessionStorage.getItem('CanDelete') || localStorage.getItem('CanDelete')) === 'true';
            if (!canDelete) {
                Swal.fire({
                    icon: "error",
                    title: "Access Denied",
                    text: "You don't have permission to Delete. Please contact admin.",
                    confirmButtonText: "OK"
                });
                event.preventDefault(); // Stop navigation
                $('#deleteRecordModal').modal('hide');
            } else {
                // Get the DataTable instance
                var table = $('#tableExample3 table').DataTable();

                // Get the row object for the clicked Edit button
                var row = $(this).closest('tr');
                var rowData = table.row(row).data(); // Get the data object for this row

                // Extract values from the row data object
                var id = rowData.id; // Using 'id' instead of 'ProcessId'

                $('#deleteRecordModal').data('id', id).modal('show');
            }
        });

        // Handle delete confirmation
        $('#delete-record').click(function () {
            $('#btn-loader').show();
            var id = $('#deleteRecordModal').data('id');            

            $.ajax({
                type: "GET",
                url: "/api/Designation/DeleteDesignation/" + id,  // Append the DesignationId to the URL
                headers: {
                    'accept': 'text/plain'  // Include the accept header
                },
                dataType: 'text',  // Set the expected response type to text
                success: function (response) {
                    //console.log("Delete Data:", response);
                    // Parse the response if it's a string
                    if (typeof response === 'string') {
                        response = JSON.parse(response);
                    }

                    //debugger
                    if (response.status.toLowerCase() == "success") {
                        Swal.fire({
                            position: "top-end",
                            icon: "success",
                            title: "Deleted !!",
                            showConfirmButton: false,
                            timer: 900
                        });
                    }
                    else {
                        Swal.fire({
                            title: "Delete Fail..!!",
                            text: response.message,
                            icon: "error"
                        });
                    }
                    fetchData();
                    //$('#btn-loader').hide();
                    $('#deleteRecordModal').modal('hide');
                },
                error: function (xhr) {
                    //$('#btn-loader').hide();
                    //alert('Failed to delete record: ' + xhr.responseText);
                    console.log(xhr.responseText);
                    Swal.fire({
                        title: "Delete Designation Error",
                        text: xhr.responseText,
                        icon: "error"
                    });
                },
                complete: function () {
                    $('#btn-loader').hide();  // Hide the loader always at the end
                }
            });
            $('#deleteRecordModal').modal('hide');
        });

    });
</script>
