@{
    ViewData["Title"] = "Emergency Contact Master";
    Layout = "_Layout";
}

<link href="/assets2/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
@section Styles {

    <link href="~/assets2/css/customdatatable/customdatatable.css" asp-append-version="true" rel="stylesheet" />
}
<script src="/assets2/js/jquery.dataTables.min.js"></script>
<script src="/assets2/js/dataTables.bootstrap5.min.js"></script>

<!--MAIN-->
<div class="content">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="text-warning mb-0">Emergency Contact Master</h4>
        <div class="d-flex align-items-center gap-2">

            <!-- CATEGORY -->
            <select class="form-select form-select-sm" id="ddlFilter_Category" style="width:170px;">
                <option value="0">All Categories</option>
            </select>

            <!-- SUB CATEGORY -->
            <select class="form-select form-select-sm" id="ddlFilter_SubCategory" style="width:180px;">
                <option value="0">All Sub Categories</option>
            </select>

            <!-- STATUS -->
            <select class="form-select form-select-sm" id="ddlFilter_Status" style="width:120px;">
                <option value="">All Status</option>
                <option value="1">Active</option>
                <option value="0">Inactive</option>
            </select>

            <!-- WITH HEADER -->
            <div class="form-check form-switch mb-0">
                <input class="form-check-input"
                       type="checkbox"
                       id="toggleEmergencyHeader">

                <label class="form-check-label fw-semibold"
                       for="toggleEmergencyHeader">
                    With Header
                </label>
            </div>

            <!-- SELECT COLUMNS -->
            <button class="btn btn-outline-info btn-sm" id="btn-select-columns">
                <i class="fa fa-list-check me-1"></i> Columns
            </button>

            <!-- DOWNLOAD DROPDOWN -->
            <div class="dropdown">

                <button class="btn btn-outline-dark btn-sm dropdown-toggle"
                        type="button"
                        data-bs-toggle="dropdown">
                    <i class="fas fa-download"></i>
                </button>

                <ul class="dropdown-menu dropdown-menu-end">

                    <li>
                        <a class="dropdown-item"
                           href="javascript:void(0)"
                           onclick="ViewEmergencyContactReport('downloadPDF')">

                            <i class="fas fa-file-pdf text-danger me-2"></i>
                            PDF

                        </a>
                    </li>

                    <li>
                        <a class="dropdown-item"
                           href="javascript:void(0)"
                           onclick="ViewEmergencyContactReport('downloadExcel')">

                            <i class="fas fa-file-excel text-success me-2"></i>
                            Excel

                        </a>
                    </li>

                </ul>

            </div>

            <!-- NEW CONTACT -->
            <button class="btn btn-outline-warning btn-sm" id="btn-add-contact">
                <i class="fa fa-plus-circle me-1"></i> New Contact
            </button>

        </div>

    </div>
    <div id="tableMain">
        <table class="table table-striped table-bordered w-100"></table>
    </div>
</div>
<!--/MAIN-->

<!-- ADD/EDIT MODAL -->
<div class="modal fade" id="ContactModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header bg-warning text-white py-1">
                <h5 class="modal-title text-white" id="ContactModalTitle"></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="ContactId">

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Category</label>
                        <select id="CategoryId" class="form-select"></select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Sub-Category</label>
                        <select id="SubCategoryId" class="form-select"></select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Contact Type</label>
                        <input type="text" id="ContactType" class="form-control" placeholder="Enter Contact Type">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Contact Name</label>
                        <input type="text" id="ContactName" class="form-control" placeholder="Enter Contact Name">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Mobile No</label>
                        <input type="text" id="MobileNo" class="form-control" maxlength="10" placeholder="Enter Mobile No">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Mobile No 2</label>
                        <input type="text" id="MobileNo2" class="form-control" maxlength="10" placeholder="Enter Mobile No2">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Location</label>
                        <input type="text" id="Location" class="form-control" placeholder="Enter Location">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Remarks</label>
                        <input type="text" id="Remarks" class="form-control" placeholder="Enter Remarks">
                    </div>
                </div>
            </div>

            <div class="modal-footer d-flex justify-content-between align-items-center">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="IsActive">
                    <label class="form-check-label" for="IsActive">Active</label>
                </div>
                <div>
                    <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                    <button class="btn btn-outline-warning" id="btnSaveContact">Save</button>
                </div>
            </div>

        </div>
    </div>
</div>
<!-- END MODAL -->

<!-- DELETE MODAL -->
<div class="modal fade zoomIn" id="deleteRecordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title text-white" id="deleteRecordModalLabel">Delete Confirmation</h5> <!-- Added Title -->
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" id="btn-close"></button>
            </div>
            <div class="modal-body">
                <div class="mt-2 text-center">
                    <lord-icon src="/assets2/js/gsqxdxog.json" trigger="loop" colors="primary:#f7b84b,secondary:#f06548" style="width:100px;height:100px"></lord-icon>
                    <div class="mt-4 pt-2 fs-15 mx-4 mx-sm-5">
                        <h4>Are you Sure ?</h4>
                        <p class="text-muted mx-4 mb-0">Delete this record?</p>
                    </div>
                </div>
                <div class="d-flex gap-2 justify-content-center mt-4 mb-2">
                    <button type="button" class="btn w-sm btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn w-sm btn-outline-danger" id="delete-record">Yes, Delete It!</button>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- END MODAL -->

<!-- SELECT COLUMNS for REPORT -->
<div class="modal fade" id="modalColumns" tabindex="-1">
    <div class="modal-dialog modal-md">
        <div class="modal-content">

            <div class="modal-header bg-warning py-2">
                <h5 class="modal-title text-white">Select Columns</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <div class="d-flex justify-content-between align-items-center mb-2">

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="chk-select-all">
                        <label class="form-check-label fw-bold">Select All</label>
                    </div>

                    <button class="btn btn-sm btn-outline-secondary" id="btn-reset-columns">
                        <i class="fa fa-refresh"></i> Reset
                    </button>

                </div>

                <hr />

                <div id="column-list" class="row">
                </div>

            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button class="btn btn-warning" id="btn-save-columns"><i class="fa fa-save"></i> Save</button>
            </div>

        </div>
    </div>
</div>
<!-- END MODAL -->

@section Scripts {
    <script src="~/assets2/js/emergencycontactmaster/emergencycontactmaster.js" asp-append-version="true"></script>
}
