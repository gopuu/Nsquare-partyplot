@{
    ViewData["Title"] = "Support Ticket Priority";
    Layout = "_Layout";
}

<link href="/assets2/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<script src="/assets2/js/jquery.dataTables.min.js"></script>
<script src="/assets2/js/dataTables.bootstrap5.min.js"></script>

@section Styles {
    <link href="~/assets2/css/customdatatable/customdatatable.css" rel="stylesheet" asp-append-version="true" />

}


<!-- MAIN -->
<div class="content">
    <div class="pb-1">
        <div class="row g-2">
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="mb-0 text-warning">Support Ticket Priority</h4>
                    <button class="btn btn-outline-warning" id="btn-add-priority">
                        <i class="fa fa-plus-circle"></i> Add Priority
                    </button>
                </div>

                <div id="PriorityTable">
                    <table class="table table-striped table-bordered" style="width:100%"></table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ADD / EDIT MODAL -->
<div class="modal fade" id="PriorityModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning text-white">
                <h5 class="modal-title text-white" id="PriorityModalTitle">Add Priority</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="PriorityId" value="0" />

                <div class="mb-3">
                    <label class="form-label">Code <span class="text-danger">*</span></label>
                    <input type="text" id="PriorityCode" class="form-control" placeholder="Enter Code" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Priority Name <span class="text-danger">*</span></label>
                    <input type="text" id="PriorityName" class="form-control" placeholder="Enter Priority Name" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Sort Order</label>
                    <input type="number" id="SortOrder" class="form-control" />
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                <button class="btn btn-outline-warning" id="btnSavePriority">Save</button>
            </div>
        </div>
    </div>
</div>

<!-- DELETE MODAL -->
<div class="modal fade" id="deletePriorityModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title text-white">Delete Confirmation</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <h4>Are you sure?</h4>
                <p class="text-muted">Delete this priority?</p>
                <div class="d-flex justify-content-center gap-2 mt-3">
                    <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button class="btn btn-outline-danger" id="confirmDeletePriority">Delete</button>
                </div>
            </div>
        </div>
    </div>
</div>



@section Scripts {
    <script src="~/assets2/js/supportticketpriority/supportticketpriority.js" asp-append-version="true"></script>

}
