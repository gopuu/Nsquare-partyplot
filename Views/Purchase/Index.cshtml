@{
    ViewData["Title"] = "Purchase";
    Layout = "_Layout";
}
<link href="/assets2/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<script src="/assets2/js/jquery.dataTables.min.js"></script>
<script src="/assets2/js/dataTables.bootstrap5.min.js"></script>

@section Styles {
    <link href="~/assets2/css/customdatatable/customdatatable.css" asp-append-version="true" rel="stylesheet" />
    <link href="~/assets2/css/Purchase/Purchase.css" asp-append-version="true" rel="stylesheet" />
}
@section Scripts {
    <script src="~/assets2/js/Purchase/Purchase.js" asp-append-version="true"></script>
}

<!-- MAIN -->
<div class="content">
    <div class="pb-1">
        <div class="row g-2">
            <div class="col-12 col-xxl-12">
                <div class="mb-12">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h5 class="mb-0 text-warning">Purchase</h5>
                        <button class="btn btn-outline-warning btn-sm" id="btn-add">
                            <i class="fa fa-plus-circle"></i> Add Purchase Invoice
                        </button>
                    </div>

                    <!-- 🔹 Insights Widgets -->
                    <div class="row g-3 align-items-stretch mb-3">

                        <!-- 1️⃣ Total Purchase -->
                        <div class="col-lg-2">
                            <div class="card finance-metric-card h-100">
                                <div class="card-body">
                                    <div class="metric-label">Purchase Invoices</div>
                                    <div class="metric-amount text-dark">
                                        ₹ <span id="widget_total_purchase">0</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 2️⃣ Outstanding -->
                        <div class="col-lg-2">
                            <div class="card finance-metric-card h-100">
                                <div class="card-body">
                                    <div class="metric-label">Outstanding</div>
                                    <div class="metric-amount text-danger">
                                        ₹ <span id="widget_outstanding">0</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 3️⃣ Tax Paid -->
                        <div class="col-lg-2">
                            <div class="card finance-metric-card h-100">
                                <div class="card-body">
                                    <div class="metric-label">Tax Paid</div>
                                    <div class="metric-amount text-primary">
                                        ₹ <span id="widget_tax_paid">0</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 4️⃣ Vendor Payables -->
                        <div class="col-lg-6">
                            <div class="card shadow-sm border-0 h-100 vendor-card">
                                <div class="card-body">

                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <h6 class="metric-label">Vendor Payables</h6>

                                        <div class="dropdown chart-filter-Vendor">
                                            <button class="btn btn-outline-secondary btn-xs dropdown-toggle"
                                                    type="button"
                                                    id="VendorChartFilter"
                                                    data-bs-toggle="dropdown">
                                                This Month
                                            </button>

                                            <ul class="dropdown-menu shadow-sm">
                                                <li><a class="dropdown-item payment-option active" data-value="thismonth" href="#">This Month</a></li>
                                                <li><a class="dropdown-item payment-option" data-value="lastmonth" href="#">Last Month</a></li>
                                                <li><a class="dropdown-item payment-option" data-value="lastdays" href="#">Last 30 Days</a></li>
                                                <li><a class="dropdown-item payment-option" data-value="days" href="#">Last 7 Days</a></li>
                                                <li><a class="dropdown-item payment-option" data-value="yesterday" href="#">Yesterday</a></li>
                                                <li><a class="dropdown-item payment-option" data-value="12months" href="#">Last 12 Months</a></li>
                                            </ul>
                                        </div>
                                    </div>

                                    <div class="vendor-table-wrapper">
                                        <table class="table table-sm align-middle mb-0">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>Vendor</th>
                                                    <th class="text-end">Pending</th>
                                                    <th class="text-center">Status</th>
                                                </tr>
                                            </thead>
                                            <tbody id="vendorPayablesBody">
                                                <tr>
                                                    <td colspan="3" class="text-muted text-center">
                                                        Loading...
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>

                                </div>
                            </div>
                        </div>

                    </div>


                    <!--tableMain-->
                    <div id="tableMain">
                        <table class="table table-striped table-bordered" style="width:100%"></table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Purchase Order MODAL-->
<div class="modal fade" id="addEventModal" tabindex="-1">
    <div class="modal-dialog modal-95 modal-fullscreen-md-down">
        <div class="modal-content">

            <!-- HEADER -->
            <div class="modal-header bg-warning text-white py-1">
                <h5 class="modal-title text-white" id="addEventModalTitle">Purchase Invoice</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="purchaseId" value="0" />

                <!-- ====================== BASIC INFO SECTION ======================= -->
                <div class="row g-2 mb-2 align-items-end">
                    <!--Purchase From-->
                    <div class="col-md-2">
                        <label class="form-label">Purchase From</label>
                        <div class="d-flex gap-2 align-items-center">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="purchaseFrom" id="purchaseFromSupplier" value="1" checked>
                                <label class="form-check-label" for="purchaseFromSupplier">Supplier</label>
                            </div>
                        </div>
                    </div>

                    <!--Supplier-->
                    <div class="col-md-3">
                        <label class="form-label">Supplier <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <select class="form-select" id="purchaseSupplier">
                                <option value="0">-- Select Supplier --</option>
                            </select>
                            <button class="btn btn-sm btn-outline-secondary d-none" id="btnEditSupplier" title="Add/Edit supplier">
                                <i class="fa fa-pen"></i>
                            </button>
                        </div>
                    </div>

                    <!--Invoice Date-->
                    <div class="col-md-2">
                        <label class="form-label">Invoice Date <span class="text-danger">*</span></label>
                        <input type="date" id="purchaseInvoiceDate" class="form-control" />
                    </div>

                    <!--Invoice Number-->
                    <div class="col-md-3">
                        <label class="form-label">Invoice Number</label>
                        <input type="text" id="purchaseInvoiceNo" class="form-control" placeholder="Invoice No" />
                    </div>

                    <!--PO No-->
                    <div class="col-md-2">
                        <label class="form-label">PO No. <span class="text-danger">*</span></label>

                        <div class="input-group">
                            <input type="text" id="purchasePONo" class="form-control" placeholder="PO No" disabled>

                            <button class="btn btn-sm btn-outline-secondary" type="button" id="togglePONo">
                                <i class="fa fa-pen"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- ======================ITEMS TABLE (FULL WIDTH)======================= -->
                <div class="card border-0 mb-2">
                    <div class="card-body p-0">
                        <!--Buttons-->
                        <div class="row g-3 align-items-center p-1">
                            <div class="col-md-12 d-flex justify-content-end align-items-center gap-4">

                                <!-- Add Item Button -->
                                <button id="btnAddLine" class="btn btn-sm btn-outline-primary mt-3">
                                    <i class="fa fa-plus"></i> Add Item
                                </button>

                                <!-- Invoice Upload + Download -->
                                <div class="d-flex flex-column text-end">
                                    <label class="form-label fw-semibold mb-1">Invoice Upload</label>
                                    <div class="input-group">
                                        <!-- File Upload -->
                                        <input type="file" id="uploadInvoiceFile"
                                               accept="image/*,application/pdf"
                                               class="form-control form-control-sm"
                                               style="max-width: 250px;">

                                        <!-- Download Button (hidden by default) -->
                                        <input type="hidden" id="invoiceFileLink" value="">
                                        <button id="btnDownloadInvoice"
                                                class="btn btn-sm btn-outline-primary d-none"
                                                type="button">
                                            <i class="fa fa-download"></i>
                                        </button>
                                    </div>
                                </div>

                            </div>
                        </div>

                        <!--purchaseItemsTable-->
                        <div class="table-responsive compact-table">
                            <table class="table table-borderless table-hover mb-0" id="purchaseItemsTable">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width:32px" class="text-center align-middle"><input type="checkbox" id="selectAllItems"></th>
                                        <th style="width:32px" class="text-center align-middle">#</th>
                                        <th>Raw Material <span class="text-danger">*</span></th>
                                        <th style="width:100px">Qty <span class="text-danger">*</span></th>
                                        <th style="width:120px">Unit <span class="text-danger">*</span></th>
                                        <th style="width:120px">Order Qty</th>
                                        <th style="width:120px">Price</th>
                                        <th style="width:120px">Amount</th>
                                        <th style="width:260px" class="text-center align-middle">Tax (%)</th>
                                        <th style="width:50px">Action</th>
                                    </tr>
                                </thead>
                                <tbody id="purchaseItemsBody"></tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- ======================TOTALS SECTION (RIGHT) BELOW ITEMS ======================= -->

                <div class="row">   

                    <!-- LEFT SIDE DETAILS PANELS -->
                    <div class="col-lg-6">

                        <!-- DISCOUNT DETAILS -->
                        <div id="discountDetails" class="detail-box totals-card">

                            <div class="detail-title fw-bold text-primary">Discount Details</div>

                            <label class="form-label">Discount Type</label>
                            <div class="d-flex gap-4 mb-2">
                                <label><input type="radio" name="discountType" value="1" checked> Amount (₹)</label>
                                <label><input type="radio" name="discountType" value="2"> Percentage (%)</label>
                            </div>

                            <label class="form-label">Total Discount Included in Invoice</label>
                            <input type="number" id="discountValue" class="form-control form-control-sm" value="0">

                            <small>
                                Total amount of discount applicable:
                                <strong id="discountCalc">00.00</strong>
                            </small>

                            <hr>

                            <label class="form-label">Determine when tax is applicable</label>
                            <div class="d-flex gap-4 mb-2">
                                <label><input type="radio" name="discountTaxType" value="1" checked> Before Tax</label>
                                <label><input type="radio" name="discountTaxType" value="2"> After Tax</label>
                            </div>

                            <div class="detail-note">
                                Discounts apply before tax by default; select the option if applying after tax.
                            </div>
                        </div>

                        <!-- OTHER CHARGE DETAILS -->
                        <div id="otherChargeDetails" class="detail-box totals-card">

                            <div class="detail-title fw-bold text-primary">Other Charge Details</div>

                            <label>Delivery Charge Included in Invoice</label>
                            <input type="number" id="deliveryCharge" class="form-control form-control-sm">

                            <div class="row mt-2">
                                <div class="col-6">
                                    <label>CGST %</label>
                                    <div class="input-group input-group-sm">
                                        <input type="number" id="deliveryCGST" class="form-control" placeholder="0">
                                        <span class="input-group-text">%</span>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <label>SGST %</label>
                                    <div class="input-group input-group-sm">
                                        <input type="number" id="deliverySGST" class="form-control" placeholder="0">
                                        <span class="input-group-text">%</span>
                                    </div>

                                </div>
                            </div>

                        </div>

                        <!-- OTHER TAXES DETAILS -->
                        <div id="otherTaxDetails" class="detail-box totals-card">

                            <div class="detail-title fw-bold text-primary">Tax Details</div>

                            <label>Tax collected at source (TCS)</label>
                            <div class="input-group input-group-sm">
                                <input type="number" id="tcsPercent" class="form-control" placeholder="0">
                                <span class="input-group-text">%</span>
                            </div>

                            <small>Total TCS applicable: <strong id="tcsCalc">00.00</strong></small>

                            <hr>

                            <label>Tax deducted at source (TDS)</label>
                            <div class="input-group input-group-sm">
                                <input type="number" id="tdsPercent" class="form-control" placeholder="0">
                                <span class="input-group-text">%</span>
                            </div>

                            <small>Total TDS deducted: <strong id="tdsCalc">00.00</strong></small>

                        </div>

                    </div>

                    <!-- RIGHT SIDE TOTALS -->
                    <div class="col-lg-6">

                        <div class="card totals-card">
                            <div class="card-body">

                                <!-- SUB TOTAL -->
                                <div class="totals-row border-bottom mb-2 pb-2">
                                    <div>
                                        <strong>Sub Total</strong>
                                        <button class="icon-btn" id="btnSubTotalMenu"><i class="fa fa-ellipsis-v"></i></button>
                                    </div>
                                    <div class="totals-amount" id="txtSubTotal">0.00</div>
                                </div>

                                <!-- DISCOUNT -->
                                <div class="totals-row">
                                    <button class="btn btn-outline-primary totals-btn" id="btnTotalDiscount">+ Total Discount</button>
                                    <div class="totals-amount" id="txtTotalDiscount">0.00</div>
                                </div>

                                <!-- OTHER CHARGES -->
                                <div class="totals-row">
                                    <button class="btn btn-outline-primary totals-btn" id="btnOtherCharges">+ Add Other Charges</button>
                                    <div class="totals-amount" id="txtOtherCharges">0.00</div>
                                </div>

                                <!-- OTHER TAXES -->
                                <div class="totals-row">
                                    <button class="btn btn-outline-primary totals-btn" id="btnOtherTaxes">+ Other Taxes</button>
                                    <div class="totals-amount" id="txtOtherTaxes">0.00</div>
                                </div>

                                <hr>

                                <!-- PAYMENT TYPE -->
                                <div class="mb-2">
                                    <label class="form-label mb-1">Payment Type:</label><br>
                                    <div class="btn-group" role="group">
                                        <input type="radio" class="btn-check" name="paymentType" id="payUnpaid" checked value="1">
                                        <label class="btn btn-outline-secondary btn-sm" for="payUnpaid">Unpaid</label>

                                        <input type="radio" class="btn-check" name="paymentType" id="payPaid" value="2">
                                        <label class="btn btn-outline-secondary btn-sm" for="payPaid">Paid</label>
                                    </div>
                                </div>

                                <!-- PAID SECTION -->
                                <div id="paidSection" class="border rounded p-2 d-none">
                                    <div class="row g-2">

                                        <!-- Payment Date -->
                                        <div class="col-md-6">
                                            <label class="form-label">Payment Date <span class="text-danger">*</span></label>
                                            <input type="date" id="paymentDate" class="form-control form-control-sm">
                                        </div>

                                        <!-- Paid Amount -->
                                        <div class="col-md-6">
                                            <label class="form-label">Paid Amount <span class="text-danger">*</span></label>
                                            <input type="number" id="paidAmount" class="form-control form-control-sm"
                                                   min="0" step="0.01" placeholder="0.00">
                                        </div>

                                        <!-- Payment Mode -->
                                        <div class="col-md-6">
                                            <label class="form-label">Payment Mode <span class="text-danger">*</span></label>
                                            <select id="paymentModeId" class="form-select form-select-sm">
                                                <option value="">-- Select Mode --</option>
                                            </select>
                                        </div>

                                        <!-- Account -->
                                        <div class="col-md-6">
                                            <label class="form-label">Payment Source<span class="text-danger">*</span></label>
                                            <select id="paymentAccountId" class="form-select form-select-sm">
                                                <option value="">-- Select Source --</option>
                                            </select>
                                        </div>

                                        <!-- Payment Reference -->
                                        <div class="col-md-6">
                                            <label class="form-label">Payment Ref. No.</label>
                                            <input type="text" id="paymentRefNo" class="form-control form-control-sm"
                                                   placeholder="UTR / Txn ID / Ref No">
                                        </div>

                                        <!-- Payment Remarks -->
                                        <div class="col-md-6">
                                            <label class="form-label">Payment Remarks</label>
                                            <input type="text" id="paymentRemarks" class="form-control form-control-sm"
                                                   placeholder="Remarks (optional)">
                                        </div>

                                        <!-- Cheque Bank -->
                                        <div class="col-md-6 cheque-fields d-none">
                                            <label class="form-label">Cheque Bank</label>
                                            <input type="text" id="chequeBank" class="form-control form-control-sm"
                                                   placeholder="Bank Name">
                                        </div>

                                        <!-- Cheque No -->
                                        <div class="col-md-3 cheque-fields d-none">
                                            <label class="form-label">Cheque No</label>
                                            <input type="text" id="chequeNo" class="form-control form-control-sm"
                                                   placeholder="Cheque Number">
                                        </div>

                                        <!-- Cheque Date -->
                                        <div class="col-md-3 cheque-fields d-none">
                                            <label class="form-label">Cheque Date</label>
                                            <input type="date" id="chequeDate" class="form-control form-control-sm">
                                        </div>

                                    </div>
                                </div>

                                <!-- GRAND TOTAL -->
                                <div class="totals-row">
                                    <strong>Grand Total</strong>
                                    <strong class="totals-amount" id="txtGrandTotal">0.00</strong>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- FOOTER BUTTONS -->
            <div class="modal-footer d-flex justify-content-between align-items-center">

                <!-- LEFT SIDE CHECKBOX -->
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="chkUpdateInventory">
                    <label class="form-check-label" for="chkUpdateInventory">
                        Update Inventory Stock
                    </label>
                </div>

                <!-- RIGHT SIDE BUTTONS -->
                <div>
                    <button class="btn btn-outline-secondary btn-sm" id="btnResetForm">Reset</button>
                    <button class="btn btn-warning btn-sm ms-2" id="btnSavePurchase">Save</button>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- SubTotal Breakdown Modal -->
<div class="modal fade" id="subTotalBreakdownModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-top-10">
        <div class="modal-content">

            <div class="modal-header bg-warning text-white py-1">
                <h5 class="modal-title text-white">Sub Total Breakdown</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <table class="table table-bordered table-sm" id="subTotalBreakdownTable">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Raw Material</th>
                            <th>Amount</th>
                            <th>CGST</th>
                            <th>SGST</th>
                            <th>IGST</th>
                        </tr>
                    </thead>
                    <tbody></tbody>

                    <!-- SUM ROW -->
                    <tfoot>
                        <tr class="fw-bold bg-light">
                            <td colspan="2">Total Taxed Amount</td>
                            <td id="sumAmount">0.00</td>
                            <td id="sumCGST">0.00</td>
                            <td id="sumSGST">0.00</td>
                            <td id="sumIGST">0.00</td>
                        </tr>

                        <tr class="fw-bold bg-warning-light">
                            <td colspan="2">Final Sub Total</td>
                            <td colspan="4" id="finalSubTotal" class="text-end">0.00</td>
                        </tr>
                    </tfoot>
                </table>
            </div>

        </div>
    </div>
</div>

<!-- DELETE MODAL -->
<div class="modal fade zoomIn" id="deleteRecordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning py-1">
                <h5 class="modal-title text-white" id="deleteRecordModalLabel">Delete Confirmation</h5> <!-- Added Title -->
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" id="btn-close"></button>
            </div>
            <div class="modal-body">
                <div class="mt-2 text-center">
                    <lord-icon src="/assets2/js/gsqxdxog.json" trigger="loop" colors="primary:#f7b84b,secondary:#f06548" style="width:100px;height:100px"></lord-icon>
                    <div class="mt-4 pt-2 fs-15 mx-4 mx-sm-5">
                        <h4>Are you Sure ?</h4>
                        <p class="text-muted mx-4 mb-0">Delete this record?</p>
                    </div>
                </div>
                <div class="d-flex gap-2 justify-content-center mt-4 mb-2">
                    <button type="button" class="btn w-sm btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn w-sm btn-outline-danger" id="delete-record">Yes, Delete It!</button>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- END MODAL -->

<!-- Outstanding Due MODAL -- START -->
<!-- ================= Outstanding Payment Modal ================= -->
<div class="modal fade" id="outstandingPaymentModal" tabindex="-1">
    <div class="modal-dialog modal-md modal-dialog-centered">
        <div class="modal-content">

            <!-- HEADER -->
            <div class="modal-header bg-warning-gradient py-2">
                <h6 class="modal-title fw-bold text-dark">
                    Pay Outstanding Amount
                </h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <!-- BODY -->
            <div class="modal-body">

                <!-- Hidden -->
                <input type="hidden" id="outPurchaseId">
                <input type="hidden" id="outRemainingAmount">

                <!-- INFO -->
                <div class="alert alert-light border mb-3">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="fw-semibold text-dark">PO No</div>
                            <div id="outPONo" class="text-muted">-</div>
                        </div>
                        <div class="text-end">
                            <div class="fw-semibold text-dark">Outstanding Due Amount</div>
                            <div class="fw-bold text-warning fs-5">
                                ₹ <span id="outRemainingText">0</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- FORM -->
                <div class="row g-2">

                    <!-- Payment Date -->
                    <div class="col-md-6">
                        <label class="form-label">Payment Date <span class="text-danger">*</span></label>
                        <input type="date" id="outPaymentDate" class="form-control form-control-sm">
                    </div>

                    <!-- Paid Amount -->
                    <div class="col-md-6">
                        <label class="form-label">Paid Amount <span class="text-danger">*</span></label>
                        <input type="number" id="outPaidAmount"
                               class="form-control form-control-sm"
                               min="0" step="0.01">
                    </div>

                    <!-- Payment Mode -->
                    <div class="col-md-6">
                        <label class="form-label">Payment Mode <span class="text-danger">*</span></label>
                        <select id="outPaymentModeId" class="form-select form-select-sm">
                            <option value="">-- Select Mode --</option>
                        </select>
                    </div>

                    <!-- Account -->
                    <div class="col-md-6">
                        <label class="form-label">Payment Account <span class="text-danger">*</span></label>
                        <select id="outAccountId" class="form-select form-select-sm">
                            <option value="">-- Select Account --</option>
                        </select>
                    </div>

                    <!-- Reference -->
                    <div class="col-md-6">
                        <label class="form-label">Reference No</label>
                        <input type="text" id="outReferenceNo"
                               class="form-control form-control-sm"
                               placeholder="UTR / Txn ID">
                    </div>

                    <!-- Remarks -->
                    <div class="col-md-6">
                        <label class="form-label">Remarks</label>
                        <input type="text" id="outRemarks"
                               class="form-control form-control-sm">
                    </div>

                    <!-- Cheque Fields -->
                    <div class="col-md-6 cheque-out d-none">
                        <label class="form-label">Cheque Bank</label>
                        <input type="text" id="outChequeBank"
                               class="form-control form-control-sm">
