@{
    ViewData["Title"] = "Purchase";
    Layout = "_Layout";
}
<link href="/assets2/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<script src="/assets2/js/jquery.dataTables.min.js"></script>
<script src="/assets2/js/dataTables.bootstrap5.min.js"></script>

@section Styles {
    <link href="~/assets2/css/customdatatable/customdatatable.css" asp-append-version="true" rel="stylesheet" />
    <link href="~/assets2/css/Purchase/Purchase.css" asp-append-version="true" rel="stylesheet" />
    <link href="~/assets2/css/shared/layout.css" asp-append-version="true" rel="stylesheet" />
}
@section Scripts {
    <script src="~/assets2/js/Purchase/Purchase.js" asp-append-version="true"></script>
    <script src="~/assets2/js/Shared/Utility.js" asp-append-version="true"></script>
}

<!-- MAIN -->
<div class="content">
    <div class="pb-1">
        <div class="row g-2">
            <div class="col-12 col-xxl-12">
                <div class="mb-12">
                    <!-- HEADER -->
                    <div class="mb-3 d-flex justify-content-between align-items-center">

                        <!-- LEFT SIDE -->
                        <h4 class="mb-0 fw-bold text-warning">
                            Purchase
                        </h4>

                        <!-- RIGHT SIDE -->
                        <div class="d-flex align-items-center gap-3">

                            <button class="btn btn-outline-warning btn-sm" id="btn-add">
                                <i class="fa fa-plus-circle"></i> Add Purchase Invoice
                            </button>

                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" id="toggleWithHeader">
                                <label class="form-check-label fw-semibold" for="toggleWithHeader">
                                    With Header
                                </label>
                            </div>

                            <button class="btn btn-outline-info btn-sm" id="btn-select-columns">
                                <i class="fa fa-list-check me-1"></i> Columns
                            </button>

                            <div class="dropdown">
                                <button class="btn btn-outline-dark btn-sm dropdown-toggle"
                                        type="button"
                                        data-bs-toggle="dropdown">
                                    <i class="fas fa-download"></i>
                                </button>

                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item" href="javascript:void(0)"
                                           onclick="ViewPurchaseInvoiceReport('downloadPDF')">
                                            <i class="fas fa-file-pdf text-danger me-2"></i> PDF
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="javascript:void(0)"
                                           onclick="ViewPurchaseInvoiceReport('downloadExcel')">
                                            <i class="fas fa-file-excel text-success me-2"></i> Excel
                                        </a>
                                    </li>
                                </ul>
                            </div>

                            <div class="form-check form-switch m-0">
                                <input class="form-check-input" type="checkbox" id="toggleWidgets">
                                <label class="form-check-label ms-2" id="widgetLabel" for="toggleWidgets">
                                    Hide Widgets
                                </label>
                            </div>

                        </div>

                    </div>

                    <!-- 🔹 Insights Widgets -->
                    <div class="row g-3 align-items-stretch mb-3" id="purchaseWidgets">

                        <!-- 1 Widget -->
                        <div class="col-lg-3">
                            <div class="card shadow-sm border-0 h-100 kpi-card">

                                <!-- 🔹 HEADER -->
                                <div class="card-header kpi-header d-flex justify-content-between align-items-center py-2">
                                    <h6 class="fw-bold mb-0 text-dark kpi-tooltip">
                                        <i class="fa fa-chart-bar me-1"></i> Purchase Overview
                                    </h6>

                                    <!-- FILTER -->
                                    <div class="dropdown">
                                        <button class="btn btn-xs btn-light dropdown-toggle"
                                                type="button"
                                                id="purchaseFilter"
                                                data-bs-toggle="dropdown">
                                            This Month
                                        </button>

                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li><a class="dropdown-item filter-option2" data-value="yesterday" href="#">Yesterday</a></li>
                                            <li><a class="dropdown-item filter-option2" data-value="last7days" href="#">Last 7 days</a></li>
                                            <li><a class="dropdown-item filter-option2" data-value="last30days" href="#">Last 30 days</a></li>
                                            <li><a class="dropdown-item filter-option2 active" data-value="thismonth" href="#">This Month</a></li>
                                            <li><a class="dropdown-item filter-option2" data-value="lastmonth" href="#">Last Month</a></li>
                                            <li><a class="dropdown-item filter-option2" data-value="last12months" href="#">Last 12 Months</a></li>
                                            <li><a class="dropdown-item filter-option2" data-value="customrange" href="#">Custom Range</a></li>
                                        </ul>
                                    </div>
                                </div>

                                <!-- 🔹 BODY -->
                                <div class="card-body">

                                    <!-- 🔹 CUSTOM DATE RANGE -->
                                    <div id="customDateRange2" class="mb-3" style="display:none;">
                                        <div class="d-flex gap-2">
                                            <input type="date" id="fltInvoiceFrom2" class="form-control form-control-sm" placeholder="From">
                                            <input type="date" id="fltInvoiceTo2" class="form-control form-control-sm" placeholder="To">
                                        </div>
                                    </div>

                                    <!-- Total Purchase -->
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <div class="d-flex align-items-center">
                                            <div class="kpi-icon bg-primary-subtle text-primary">
                                                <i class="fa fa-shopping-cart"></i>
                                            </div>
                                            <span class="ms-2 small text-muted">Total Purchase</span>
                                        </div>

                                        <span class="fw-bold text-dark">
                                            <span id="widget_total_purchase">0</span>
                                        </span>
                                    </div>

                                    <!-- Outstanding -->
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <div class="d-flex align-items-center">
                                            <div class="kpi-icon bg-danger-subtle text-danger">
                                                <i class="fa fa-exclamation-circle"></i>
                                            </div>
                                            <span class="ms-2 small text-muted">Outstanding</span>
                                        </div>

                                        <span class="fw-bold text-danger">
                                            <span id="widget_outstanding">0</span>
                                        </span>
                                    </div>

                                    <!-- Total Orders -->
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class="d-flex align-items-center">
                                            <div class="kpi-icon bg-success-subtle text-success">
                                                <i class="fa fa-box"></i>
                                            </div>
                                            <span class="ms-2 small text-muted">Total Orders</span>
                                        </div>

                                        <span class="fw-bold text-dark">
                                            <span id="widget_total_orders">0</span>
                                        </span>
                                    </div>

                                </div>
                            </div>
                        </div>

                        <!-- 2 Filters -->
                        <div class="col-lg-9">
                            <div class="card shadow-sm border-0 h-100" id="filtersSection">

                                <!-- HEADER -->
                                <div class="card-header kpi-header d-flex justify-content-between align-items-center py-2">
                                    <h6 class="fw-bold mb-0 text-dark">
                                        <i class="fa fa-filter me-1"></i> Filters
                                    </h6>
                                </div>

                                <!-- BODY -->
                                <div class="card-body">
                                    <div class="row g-3" id="purchaseWidgets_filter">

                                        <!-- 📊 Invoice No -->
                                        <div class="col-md-2">
                                            <label class="form-label">Invoice No</label>
                                            <input type="text" id="fltInvoiceNo" class="form-control form-control-sm">
                                        </div>

                                        <!-- 📊 PO No -->
                                        <div class="col-md-2">
                                            <label class="form-label">PO No.</label>
                                            <input type="text" id="fltPONo" class="form-control form-control-sm">
                                        </div>

                                        <!-- 🔍 SEARCH (Full Width) -->
                                        <div class="col-md-5">
                                            <label class="form-label">Supplier Name / Contact / Email</label>
                                            <input type="text" id="fltSearch"
                                                   class="form-control form-control-sm"
                                                   placeholder="Search">
                                        </div>

                                        <!-- 📊 Supplier -->
                                        <div class="col-md-3">
                                            <label class="form-label">Supplier</label>
                                            <select id="fltSupplier" class="form-select form-select-sm"></select>
                                        </div>

                                        <!-- 📊 STATUS -->
                                        <div class="col-md-2">
                                            <label class="form-label">Payment Status</label>
                                            <select id="fltPaymentStatus" class="form-select form-select-sm">
                                                <option value="0">All</option>
                                                <option value="1">Payment Pending</option>
                                                <option value="2">Payment Received</option>
                                            </select>
                                        </div>

                                        <!-- 📅 INVOICE DATES -->
                                        <div class="col-md-2">
                                            <label class="form-label">Invoice From</label>
                                            <input type="date" id="fltInvoiceFrom"
                                                   class="form-control form-control-sm">
                                        </div>

                                        <div class="col-md-2">
                                            <label class="form-label">Invoice To</label>
                                            <input type="date" id="fltInvoiceTo"
                                                   class="form-control form-control-sm">
                                        </div>

                                        <!-- 🎯 ACTION BUTTONS -->
                                        <div class="col-md-6 d-flex align-items-end gap-3">

                                            <!-- FILTER DROPDOWN -->
                                            <div class="dropdown mt-2">
                                                <button class="btn btn-outline-secondary btn-sm fw-bold dropdown-toggle"
                                                        type="button" id="sortByDropdown" data-bs-toggle="dropdown">
                                                    Filter :This Month
                                                </button>

                                                <ul class="dropdown-menu">
                                                    <li><a class="dropdown-item sort-option" data-value="yesterday" href="#">Yesterday</a></li>
                                                    <li><a class="dropdown-item sort-option" data-value="last7days" href="#">Last 7 days</a></li>
                                                    <li><a class="dropdown-item sort-option" data-value="last30days" href="#">Last 30 days</a></li>
                                                    <li><a class="dropdown-item sort-option active" data-value="thismonth" href="#">This Month</a></li>
                                                    <li><a class="dropdown-item sort-option" data-value="lastmonth" href="#">Last Month</a></li>
                                                    <li><a class="dropdown-item sort-option" data-value="last12months" href="#">Last 12 Months</a></li>
                                                    <li><a class="dropdown-item sort-option" data-value="customrange" href="#">Custom Range</a></li>
                                                </ul>
                                            </div>

                                            <!-- BUTTONS -->
                                            <button class="btn btn-primary btn-sm px-3 mt-2"
                                                    onclick="fetchData()">
                                                Apply
                                            </button>

                                            <button class="btn btn-outline-danger btn-sm px-3 mt-2"
                                                    onclick="resetFilter()">
                                                Reset
                                            </button>

                                        </div>
                                    </div>

                                    <div id="filterHiddenMessage" class="text-center py-4" style="display:none">
                                        <div class="text-muted" onclick="$('#toggleWidgets_filter').click()" style="cursor:pointer;">
                                            <i class="fa fa-filter fa-2x mb-2 opacity-50"></i>

                                            <div class="fw-semibold">Filters are hidden</div>

                                            <div class="small">
                                                Click <b>"Show Filter"</b> to refine your results
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                    <!--tableMain-->
                    <div id="tableMain">
                        <table class="table table-striped table-bordered" style="width:100%">
                            <tfoot class="table-secondary fw-bold">
                                <tr class="table-footer-total fs-9">
                                    <th colspan="5" class="text-end">TOTAL</th>
                                    <th id="ftSubTotalAmount" class="text-end"></th>
                                    <th id="ftTaxAmount" class="text-end"></th>
                                    <th id="ftChargesAmount" class="text-end"></th>
                                    <th id="ftDiscountAmount" class="text-end"></th>
                                    <th id="ftTotalAmount" class="text-end"></th>
                                    <th id="ftPaidAmount" class="text-end"></th>
                                    <th id="ftOutstandingAmount" class="text-end"></th>
                                    <th colspan="3"></th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════
     SELECT COLUMNS MODAL
═══════════════════════════════════════ -->
<div class="modal fade" id="modalColumns" tabindex="-1">
    <div class="modal-dialog modal-md">
        <div class="modal-content">

            <div class="modal-header bg-warning py-2">
                <h5 class="modal-title text-white">Select Columns</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="chk-select-all">
                        <label class="form-check-label fw-bold">Select All</label>
                    </div>
                    <button class="btn btn-sm btn-outline-secondary" id="btn-reset-columns">
                        <i class="fa fa-refresh"></i> Reset
                    </button>
                </div>
                <hr />
                <div id="column-list" class="row"></div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button class="btn btn-warning" id="btn-save-columns">
                    <i class="fa fa-save"></i> Save
                </button>
            </div>

        </div>
    </div>
</div>

<!-- Purchase Order MODAL-->
<div class="modal fade" id="addEventModal" tabindex="-1">
    <div class="modal-dialog modal-95 modal-fullscreen-md-down">
        <div class="modal-content">

            <!-- HEADER -->
            <div class="modal-header bg-warning text-white py-1">
                <h5 class="modal-title text-white" id="addEventModalTitle">Purchase Invoice</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="purchaseId" value="0" />

                <!-- ====================== BASIC INFO SECTION ======================= -->
                <div class="row g-2 mb-2 align-items-end">
                    <!--Purchase From-->
                    <div class="col-md-2">
                        <label class="form-label">Purchase From</label>
                        <div class="d-flex gap-2 align-items-center">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="purchaseFrom" id="purchaseFromSupplier" value="1" checked>
                                <label class="form-check-label" for="purchaseFromSupplier">Supplier</label>
                            </div>
                        </div>
                    </div>

                    <!--Supplier-->
                    <div class="col-md-3">
                        <label class="form-label">Supplier <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <select class="form-select" id="purchaseSupplier">
                                <option value="0">-- Select Supplier --</option>
                            </select>
                            <button class="btn btn-sm btn-outline-secondary d-none" id="btnEditSupplier" title="Add/Edit supplier">
                                <i class="fa fa-pen"></i>
                            </button>
                        </div>
                    </div>

                    <!--Invoice Date-->
                    <div class="col-md-2">
                        <label class="form-label">Invoice Date <span class="text-danger">*</span></label>
                        <input type="date" id="purchaseInvoiceDate" class="form-control" />
                    </div>

                    <!--Invoice Number-->
                    <div class="col-md-3">
                        <label class="form-label">Invoice Number</label>
                        <input type="text" id="purchaseInvoiceNo" class="form-control" placeholder="Invoice No" />
                    </div>

                    <!--PO No-->
                    <div class="col-md-2">
                        <label class="form-label">PO No. <span class="text-danger">*</span></label>

                        <div class="input-group">
                            <input type="text" id="purchasePONo" class="form-control" placeholder="PO No" disabled>

                            <button class="btn btn-sm btn-outline-secondary" type="button" id="togglePONo">
                                <i class="fa fa-pen"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- ======================ITEMS TABLE (FULL WIDTH)======================= -->
                <div class="card border-0 mb-2">
                    <div class="card-body p-0">
                        <!--Buttons-->
                        <div class="row g-3 align-items-center p-1">
                            <div class="col-md-12 d-flex justify-content-end align-items-center gap-4">

                                <!-- Add Item Button -->
                                <button id="btnAddLine" class="btn btn-sm btn-outline-primary mt-3">
                                    <i class="fa fa-plus"></i> Add Item
                                </button>

                                <!-- Invoice Upload + Download -->
                                <div class="d-flex flex-column text-end">
                                    <label class="form-label fw-semibold mb-1">Invoice Upload</label>
                                    <div class="input-group">
                                        <!-- File Upload -->
                                        <input type="file" id="uploadInvoiceFile"
                                               accept="image/*,application/pdf"
                                               class="form-control form-control-sm"
                                               style="max-width: 250px;">

                                        <!-- Download Button (hidden by default) -->
                                        <input type="hidden" id="invoiceFileLink" value="">
                                        <button id="btnDownloadInvoice"
                                                class="btn btn-sm btn-outline-primary d-none"
                                                type="button">
                                            <i class="fa fa-download"></i>
                                        </button>
                                    </div>
                                </div>

                            </div>
                        </div>

                        <!--purchaseItemsTable-->
                        <div class="table-responsive compact-table">
                            <table class="table table-borderless table-hover mb-0" id="purchaseItemsTable">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width:32px" class="text-center align-middle"><input type="checkbox" id="selectAllItems"></th>
                                        <th style="width:32px" class="text-center align-middle">#</th>
                                        <th>Raw Material <span class="text-danger">*</span></th>
                                        <th style="width:100px">Qty <span class="text-danger">*</span></th>
                                        <th style="width:120px">Unit <span class="text-danger">*</span></th>
                                        <th style="width:120px">Order Qty</th>
                                        <th style="width:120px">Price</th>
                                        <th style="width:120px">Amount</th>
                                        <th style="width:260px" class="text-center align-middle">Tax (%)</th>
                                        <th style="width:50px">Action</th>
                                    </tr>
                                </thead>
                                <tbody id="purchaseItemsBody"></tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- ======================TOTALS SECTION (RIGHT) BELOW ITEMS ======================= -->

                <div class="row">   

                    <!-- LEFT SIDE DETAILS PANELS -->
                    <div class="col-lg-6">

                        <!-- DISCOUNT DETAILS -->
                        <div id="discountDetails" class="detail-box totals-card">

                            <div class="detail-title fw-bold text-primary">Discount Details</div>

                            <label class="form-label">Discount Type</label>
                            <div class="d-flex gap-4 mb-2">
                                <label><input type="radio" name="discountType" value="1" checked> Amount (₹)</label>
                                <label><input type="radio" name="discountType" value="2"> Percentage (%)</label>
                            </div>

                            <label class="form-label">Total Discount Included in Invoice</label>
                            <input type="number" id="discountValue" class="form-control form-control-sm" value="0">

                            <small>
                                Total amount of discount applicable:
                                <strong id="discountCalc">00.00</strong>
                            </small>

                            <hr>

                            <label class="form-label">Determine when tax is applicable</label>
                            <div class="d-flex gap-4 mb-2">
                                <label><input type="radio" name="discountTaxType" value="1" checked> Before Tax</label>
                                <label><input type="radio" name="discountTaxType" value="2"> After Tax</label>
                            </div>

                            <div class="detail-note">
                                Discounts apply before tax by default; select the option if applying after tax.
                            </div>
                        </div>

                        <!-- OTHER CHARGE DETAILS -->
                        <div id="otherChargeDetails" class="detail-box totals-card">

                            <div class="detail-title fw-bold text-primary">Other Charge Details</div>

                            <label>Delivery Charge Included in Invoice</label>
                            <input type="number" id="deliveryCharge" class="form-control form-control-sm">

                            <div class="row mt-2">
                                <div class="col-6">
                                    <label>CGST %</label>
                                    <div class="input-group input-group-sm">
                                        <input type="number" id="deliveryCGST" class="form-control" placeholder="0">
                                        <span class="input-group-text">%</span>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <label>SGST %</label>
                                    <div class="input-group input-group-sm">
                                        <input type="number" id="deliverySGST" class="form-control" placeholder="0">
                                        <span class="input-group-text">%</span>
                                    </div>

                                </div>
                            </div>

                        </div>

                        <!-- OTHER TAXES DETAILS -->
                        <div id="otherTaxDetails" class="detail-box totals-card">

                            <div class="detail-title fw-bold text-primary">Tax Details</div>

                            <label>Tax collected at source (TCS)</label>
                            <div class="input-group input-group-sm">
                                <input type="number" id="tcsPercent" class="form-control" placeholder="0">
                                <span class="input-group-text">%</span>
                            </div>

                            <small>Total TCS applicable: <strong id="tcsCalc">00.00</strong></small>

                            <hr>

                            <label>Tax deducted at source (TDS)</label>
                            <div class="input-group input-group-sm">
                                <input type="number" id="tdsPercent" class="form-control" placeholder="0">
                                <span class="input-group-text">%</span>
                            </div>

                            <small>Total TDS deducted: <strong id="tdsCalc">00.00</strong></small>

                        </div>

                    </div>

                    <!-- RIGHT SIDE TOTALS -->
                    <div class="col-lg-6">

                        <div class="card totals-card">
                            <div class="card-body">

                                <!-- SUB TOTAL -->
                                <div class="totals-row border-bottom mb-2 pb-2">
                                    <div>
                                        <strong>Sub Total</strong>
                                        <button class="icon-btn" id="btnSubTotalMenu"><i class="fa fa-ellipsis-v"></i></button>
                                    </div>
                                    <div class="totals-amount" id="txtSubTotal">0.00</div>
                                </div>

                                <!-- DISCOUNT -->
                                <div class="totals-row">
                                    <button class="btn btn-outline-primary totals-btn" id="btnTotalDiscount">+ Total Discount</button>
                                    <div class="totals-amount" id="txtTotalDiscount">0.00</div>
                                </div>

                                <!-- OTHER CHARGES -->
                                <div class="totals-row">
                                    <button class="btn btn-outline-primary totals-btn" id="btnOtherCharges">+ Add Other Charges</button>
                                    <div class="totals-amount" id="txtOtherCharges">0.00</div>
                                </div>

                                <!-- OTHER TAXES -->
                                <div class="totals-row">
                                    <button class="btn btn-outline-primary totals-btn" id="btnOtherTaxes">+ Other Taxes</button>
                                    <div class="totals-amount" id="txtOtherTaxes">0.00</div>
                                </div>

                                <hr>

                                <!-- PAYMENT TYPE -->
                                <div class="mb-2">
                                    <label class="form-label mb-1">Payment Type:</label><br>
                                    <div class="btn-group" role="group">
                                        <input type="radio" class="btn-check" name="paymentType" id="payUnpaid" checked value="1">
                                        <label class="btn btn-outline-secondary btn-sm" for="payUnpaid">Unpaid</label>

                                        <input type="radio" class="btn-check" name="paymentType" id="payPaid" value="2">
                                        <label class="btn btn-outline-secondary btn-sm" for="payPaid">Paid</label>
                                    </div>
                                </div>

                                <!-- PAID SECTION -->
                                <div id="paidSection" class="border rounded p-2 d-none">
                                    <div class="row g-2">

                                        <!-- Payment Date -->
                                        <div class="col-md-6">
                                            <label class="form-label">Payment Date <span class="text-danger">*</span></label>
                                            <input type="date" id="paymentDate" class="form-control form-control-sm">
                                        </div>

                                        <!-- Paid Amount -->
                                        <div class="col-md-6">
                                            <label class="form-label">Paid Amount <span class="text-danger">*</span></label>
                                            <input type="number" id="paidAmount" class="form-control form-control-sm"
                                                   min="0" step="1" placeholder="0.00">
                                        </div>

                                        <!-- Payment Mode -->
                                        <div class="col-md-6">
                                            <label class="form-label">Payment Mode <span class="text-danger">*</span></label>
