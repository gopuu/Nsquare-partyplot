@{
    ViewData["Title"] = "Purchase Transactions";
    Layout = "_Layout";
}

<link href="/assets2/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<script src="/assets2/js/jquery.dataTables.min.js"></script>
<script src="/assets2/js/dataTables.bootstrap5.min.js"></script>

@section Styles {
    <link href="~/assets2/css/customdatatable/customdatatable.css" asp-append-version="true" rel="stylesheet" />
}

@section Scripts {
    <script src="~/assets2/js/PurchaseTransactions/PurchaseTransactions.js" asp-append-version="true"></script>
}

<!-- MAIN -->
<div class="content">
    <div class="pb-1">
        <div class="row g-2">
            <div class="col-12">
                <div class="mb-12">

                    <div class="d-flex justify-content-between align-items-center mb-4">

                        <!-- TITLE -->
                        <h4 class="mb-0 text-warning">Purchase Transactions</h4>

                        <!-- FILTERS -->
                        <div class="dropdown">
                            <button class="btn btn-outline-secondary btn-sm fw-bold py-1 px-2 dropdown-toggle"
                                    type="button"
                                    id="filterDropdown"
                                    data-bs-toggle="dropdown"
                                    data-bs-auto-close="outside">
                                Filters
                            </button>

                            <div class="dropdown-menu p-3 shadow-sm" style="width: 280px;">

                                <!-- Duration -->
                                <label class="form-label fw-semibold mb-1">Duration</label>
                                <select class="form-select form-select-sm mb-2" id="ddlDuration">
                                    <option value="yesterday">Yesterday</option>
                                    <option value="last7days">Last 7 days</option>
                                    <option value="last30days">Last 30 days</option>
                                    <option value="thismonth" selected>This Month</option>
                                    <option value="lastmonth">Last Month</option>
                                    <option value="last12months">Last 12 Months</option>
                                    <option value="customrange">Custom Range</option>
                                </select>

                                <!-- Custom Date Range -->
                                <div id="customDateRange" class="d-none">
                                    <div class="row g-2">
                                        <div class="col-6">
                                            <label class="form-label mb-1">From Date</label>
                                            <input type="date" class="form-control form-control-sm" id="fromDate">
                                        </div>

                                        <div class="col-6">
                                            <label class="form-label mb-1">To Date</label>
                                            <input type="date" class="form-control form-control-sm" id="toDate">
                                        </div>
                                    </div>
                                </div>

                                <!-- Supplier -->
                                <label class="form-label fw-semibold mb-1">Supplier</label>
                                <select class="form-select form-select-sm mb-2" id="ddlSupplier">
                                    <option value="0">-- All Suppliers --</option>
                                    <!-- Dynamic options later -->
                                </select>

                                <!-- Payment Mode -->
                                <label class="form-label fw-semibold mb-1">Payment Mode</label>
                                <select class="form-select form-select-sm mb-2" id="ddlPaymentMode">
                                    <option value="0">-- All Modes --</option>
                                    <!-- Dynamic options later -->
                                </select>

                                <!-- Account -->
                                <label class="form-label fw-semibold mb-1">Payment Source</label>
                                <select class="form-select form-select-sm mb-3" id="ddlAccount">
                                    <option value="0">-- All Source --</option>
                                    <!-- Dynamic options later -->
                                </select>


                                <!-- Amount Range -->
                                <label class="form-label fw-semibold mb-1">Amount Range</label>
                                <div class="d-flex gap-2 mb-3">
                                    <input type="number" class="form-control form-control-sm" id="fromAmount" placeholder="Min">
                                    <input type="number" class="form-control form-control-sm" id="toAmount" placeholder="Max">
                                </div>

                                <!-- ACTIONS -->
                                <div class="d-flex justify-content-end gap-2">
                                    <button class="btn btn-light btn-sm" id="btnResetFilters">Reset</button>
                                    <button class="btn btn-warning btn-sm fw-bold" id="btnApplyFilters">Apply</button>
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- TABLE -->
                    <div id="tableMain">
                        <table class="table table-striped table-bordered" style="width:100%"></table>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
