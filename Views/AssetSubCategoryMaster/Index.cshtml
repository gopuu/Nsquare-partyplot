@{
    ViewData["Title"] = "Asset Category Master";
    Layout = "_Layout";
}
<link href="/assets2/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<script src="/assets2/js/jquery.dataTables.min.js"></script>
<script src="/assets2/js/dataTables.bootstrap5.min.js"></script>

<div class="content">
    <div class="pb-1">
        <div class="row g-2">
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="mb-0 text-warning">Asset Sub Category Master</h4>
                    <button class="btn btn-outline-warning" id="btn-add">
                        <i class="fa fa-plus-circle"></i> Add Asset Sub Category
                    </button>
                </div>

                <div id="tableAssetSubCategory">
                    <table class="table table-striped table-bordered w-100"></table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="assetSubCategoryModal">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header bg-warning text-white">
                <h5 class="modal-title text-white" id="modalTitle">Add Asset Sub Category</h5>
                <button class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="assetSubCategoryId" value="0">
                <div class="row g-3">
                    <!-- Category -->
                    <div class="col-12">
                        <label class="form-label">Asset Category <span class="text-danger">*</span></label>
                        <select id="ddlAssetCategory" class="form-select"></select>
                    </div>

                    <div class="col-12">
                        <label class="form-label">Sub Category Name *</label>
                        <input type="text" id="subCategoryName" class="form-control">
                    </div>

                    <div class="col-12">
                        <label class="form-label">Code</label>
                        <input type="text" id="subCategoryCode" class="form-control">
                    </div>

                    <div class="col-12">
                        <label class="form-label">Description</label>
                        <textarea id="subCategoryDescription" class="form-control"></textarea>
                    </div>

                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                <button class="btn btn-outline-warning" id="btnSave">Save</button>
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="deleteRecordModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title text-white">Delete Confirmation</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <h4>Are you sure?</h4>
                <p class="text-muted">Delete this asset category?</p>
                <div class="d-flex justify-content-center gap-2">
                    <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                    <button class="btn btn-outline-danger" id="delete-record">Yes, Delete</button>
                </div>
            </div>
        </div>
    </div>
</div>


<script>
$(document).ready(function () {
    fetchSubCategoryData();
    loadAssetCategoryDropdown();

    // ADD
    $("#btn-add").click(function () {
        resetFields();
        $("#modalTitle").text("Add Asset Sub Category");
        $("#assetSubCategoryModal").modal("show");
    });
    // SAVE
    $("#btnSave").click(function () {
      if ($("#ddlAssetCategory").val() == "0" || $("#subCategoryName").val().trim() === "") {
            Swal.fire("Validation", "Category & Name required", "warning");
            return;
        }
        let payload = {
            Id: $("#assetSubCategoryId").val(),
            CategoryId: $("#ddlAssetCategory").val(),
            Name: $("#subCategoryName").val(),
            Code: $("#subCategoryCode").val(),
            Description: $("#subCategoryDescription").val(),
            ActionBy: sessionStorage.getItem("userId") ?? 0
        };
        $.ajax({
            url: "/api/AssetSubCategory/SaveAssetSubCategoryMaster",
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify(payload),
            success: function () {
                    Swal.fire({
                        position: "top-end",
                        icon: "success",
                        title: "Saved!",
                        showConfirmButton: false,
                        timer: 900
                    });
                $("#assetSubCategoryModal").modal("hide");
                fetchSubCategoryData();
            },
            error: function (xhr, status, error) {
                handleApiError(xhr, status, error, "Save AssetCategory Error");
            }
        });
    });

    // EDIT
    $(document).on("click", ".btn-edit", function () {
        let data = $("#tableAssetSubCategory table")
            .DataTable()
            .row($(this).closest("tr"))
            .data();

        $("#assetSubCategoryId").val(data.Id);
        $("#subCategoryName").val(data.Name);
        $("#subCategoryCode").val(data.Code);
        $("#subCategoryDescription").val(data.Description);
        // 🔥 IMPORTANT
        loadAssetCategoryDropdown(data.CategoryId);
        $("#assetSubCategoryModal").modal("show");
        $("#assetSubCategoryModal").text("Edit Asset Sub Category");

    });


    // DELETE
    $(document).on("click", ".btn-delete", function () {
        let data = $("#tableAssetSubCategory table").DataTable()
            .row($(this).closest("tr")).data();
        $("#deleteRecordModal").data("id", data.Id).modal("show");
    });
    $("#delete-record").click(function () {
        $.ajax({
            url: "/api/AssetSubCategory/DeleteAssetSubCategoryMaster",
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify({
                Id: $("#deleteRecordModal").data("id"),
                ActionBy: sessionStorage.getItem("userId") ?? 0
            }),
            success: function () {
                Swal.fire("Deleted!", "", "success");
                $("#deleteRecordModal").modal("hide");
                fetchSubCategoryData();
            },
            error: function (xhr, status, error) {
                handleApiError(xhr, status, error, "Delete AssetSubCategory Error");
            }
        });
    });
});

function fetchSubCategoryData() {
    $.ajax({
        url: "/api/AssetSubCategory/GetAssetSubCategoryMaster",
        type: "POST",
        contentType: "application/json",
        data: JSON.stringify({ Id: 0, CategoryId: 0 }),
        success: function (res) {
            renderTable(res.data || []);
        }
    });
}

function renderTable(data) {
    if ($.fn.dataTable.isDataTable("#tableAssetSubCategory table")) {
        $("#tableAssetSubCategory table").DataTable().destroy();
    }
    data.forEach((x, i) => x.srno = i + 1);
    $("#tableAssetSubCategory table").DataTable({
        data: data,
        columns: [
            { data: "srno", title: "Sr No", className: "text-center" },
            { data: "CategoryName", title: "Category" },
            { data: "Name", title: "Sub Category" },
            { data: "Code", title: "Code" },
            {
                data: "Description",
                title: "Description",
                render: d => d ?? "-"
            },
            {
                data: null,
                title: "Action",
                orderable: false,
                render: () => `
                    <button class="btn btn-outline-warning btn-edit btn-action-xs">
                        <i class="fa fa-edit"></i>
                    </button>
                    <button class="btn btn-outline-danger btn-delete btn-action-xs">
                        <i class="fa fa-trash"></i>
                    </button>`
            }
        ]
    });
}

function resetFields() {
    $("#assetSubCategoryId").val(0);
    $("#ddlAssetCategory").val(0);
    $("#subCategoryName").val("");
    $("#subCategoryCode").val("");
    $("#subCategoryDescription").val("");
}

function loadAssetCategoryDropdown(selectedId = 0) {
    $.ajax({
        url: "/api/AssetCategory/GetAssetCategoryMaster",
        type: "POST",
        contentType: "application/json",
        data: JSON.stringify({ Id: 0 }),
        success: function (response) {
            let dropdown = $("#ddlAssetCategory");
            dropdown.empty();
            dropdown.append(`<option value="0">-- Select Asset Category --</option>`);
            if (response && response.status === "Success" && Array.isArray(response.data)) {
                response.data.forEach(item => {
                    dropdown.append(`
                        <option value="${item.Id}" ${selectedId == item.Id ? "selected" : ""}>
                            ${item.Name}
                        </option>
                    `);
                });
            }
        },
        error: function (xhr, status, error) {
            handleApiError(xhr, status, error, "Failed to load Asset Category");
        }
    });
}

</script>