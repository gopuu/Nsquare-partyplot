@{
    ViewData["Title"] = "Expense Report";
    Layout = "_Layout";
}

<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<link href="/assets2/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<script src="/assets2/js/jquery.dataTables.min.js"></script>
<script src="/assets2/js/dataTables.bootstrap5.min.js"></script>
<link href="~/assets2/css/customdatatable/customdatatable.css" asp-append-version="true" rel="stylesheet" />

<!--MAIN-->
<div class="content">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 id="expenseReportTitle" class="text-warning mb-0">Expense Report</h4>

        <div class="d-flex align-items-center gap-2">

            <button class="btn btn-outline-warning btn-sm" id="btnToggleFilter">
                <i class="fa fa-filter me-1"></i> Filter
            </button>

            <div class="form-check form-switch mb-0">
                <input class="form-check-input" type="checkbox" id="toggleWithHeader">
                <label class="form-check-label fw-semibold" for="toggleWithHeader">
                    With Header
                </label>
            </div>

            <button class="btn btn-outline-info btn-sm" id="btn-select-columns">
                <i class="fa fa-list-check me-1"></i> Columns
            </button>

            <div class="dropdown">
                <button class="btn btn-outline-dark btn-sm dropdown-toggle"
                        type="button"
                        data-bs-toggle="dropdown">
                    <i class="fas fa-download"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li>
                        <a class="dropdown-item" href="javascript:void(0)"
                           onclick="ViewExpenseReport('downloadPDF')">
                            <i class="fas fa-file-pdf text-danger me-2"></i> PDF
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item" href="javascript:void(0)"
                           onclick="ViewExpenseReport('downloadExcel')">
                            <i class="fas fa-file-excel text-success me-2"></i> Excel
                        </a>
                    </li>
                </ul>
            </div>

        </div>
    </div>

    <!-- EXPENSE DETAIL GRID -->
    <div id="tableMain">
        <table id="tblExpenseDetail"
               class="table table-striped table-bordered w-100">

            <tfoot class="table-secondary fw-bold">
                <tr>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                </tr>
            </tfoot>

        </table>
    </div>

</div>

<!-- FILTER PANEL -->
<div id="filterPanel" class="filter-panel">

    <div class="filter-header bg-warning d-flex justify-content-between align-items-center px-3 py-2">
        <h6 class="mb-0 text-white">Filters</h6>
        <button type="button" class="btn-close btn-close-white" id="btnCloseFilter"></button>
    </div>

    <div class="filter-body">

        <!--DURATION-->
        <div class="mb-3">
            <label class="form-label">Duration</label>
            <select id="quickRange" class="form-select form-select-sm">
                <option value="thismonth">This Month</option>
                <option value="lastmonth">Last Month</option>
                <option value="days">Last 7 days</option>
                <option value="lastdays">Last 30 days</option>
                <option value="yesterday">Yesterday</option>
                <option value="last12months">Last 12 Months</option>
                <option value="customrange">Custom Range</option>
            </select>
        </div>

        <!--DATE RANGE-->
        <div class="row g-2">
            <div class="col-md-6 mb-3">
                <label class="form-label">From Date</label>
                <input type="date" id="fromDate" class="form-control form-control-sm">
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">To Date</label>
                <input type="date" id="toDate" class="form-control form-control-sm">
            </div>
        </div>

        <!-- Voucher -->
        <div class="col">
            <label class="form-label small mb-1">Voucher No</label>
            <input type="text"
                   id="txtDetailVoucherNo"
                   class="form-control form-control-sm"
                   placeholder="Voucher No"
                   maxlength="50">
        </div>

        <!-- Sub Category -->
        <div class="mb-3">
            <label class="form-label">Expense Category</label>
            <select id="ddlDetailCategory" class="form-select form-select-sm"></select>
        </div>

        <!-- Sub Category -->
        <div class="col">
            <label class="form-label small mb-1">Expense Sub-Category</label>
            <select id="ddlDetailSubCategory"
                    class="form-select form-select-sm">
            </select>
        </div>

        <!-- Account -->
        <div class="col">
            <label class="form-label small mb-1">Account</label>
            <select id="ddlDetailAccount"
                    class="form-select form-select-sm">
            </select>
        </div>

        <!-- Payment Mode -->
        <div class="col">
            <label class="form-label small mb-1">Payment Mode</label>
            <select id="ddlDetailPaymentMode"
                    class="form-select form-select-sm">
            </select>
        </div>

    </div>

    <div class="filter-footer">
        <button id="btnResetFilter" class="btn btn-outline-secondary btn-sm">Reset</button>
        <button id="btnApplyFilter" class="btn btn-warning btn-sm">Apply</button>
    </div>

</div>

<!-- COLUMNS MODAL -->
<div class="modal fade" id="modalColumns" tabindex="-1">
    <div class="modal-dialog modal-md">
        <div class="modal-content">

            <div class="modal-header bg-warning py-2">
                <h5 class="modal-title text-white">Select Columns</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="chk-select-all">
                        <label class="form-check-label fw-bold">Select All</label>
                    </div>
                    <button class="btn btn-sm btn-outline-secondary" id="btn-reset-columns">
                        <i class="fa fa-refresh"></i> Reset
                    </button>
                </div>
                <hr />
                <div id="column-list" class="row"></div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button class="btn btn-warning" id="btn-save-columns">
                    <i class="fa fa-save"></i> Save
                </button>
            </div>

        </div>
    </div>
</div>

<!-- EXPENSE DETAILS -->
<div class="modal fade" id="expenseDetailModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">

 

            <!-- BODY -->
            <div class="modal-body">
                <!-- FILTERS -->
                <div class="row g-2 align-items-end mb-3">



                    <!-- Actions -->
                    <div class="col-auto">
                        <div class="d-flex gap-1">

                            <button type="button"
                                    id="btnApplyExpenseDetail"
                                    class="btn btn-outline-warning btn-sm text-nowrap">
                                <i class="fas fa-filter me-1"></i>
                                Apply
                            </button>

                            <button type="button"
                                    class="btn btn-outline-danger btn-sm text-nowrap"
                                    onclick="ViewExpenseDetailReport('downloadPdf')">
                                <i class="fas fa-file-pdf me-1"></i>
                                PDF
                            </button>

                            <button type="button"
                                    class="btn btn-outline-success btn-sm text-nowrap"
                                    onclick="ViewExpenseDetailReport('downloadExcel')">
                                <i class="fas fa-file-excel me-1"></i>
                                Excel
                            </button>

                        </div>
                    </div>

                </div>

                <!-- GRID AREA -->
                <div id="expenseDetailTableMain">

                    <!-- Data Loader -->
                    <div id="expenseDetailLoader"
                         class="text-center py-5 text-muted d-none">

                        <div class="spinner-border spinner-border-sm me-2"
                             role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>

                        <span>Fetching Expense Details...</span>
                    </div>

                    <!-- Error -->
                    <div id="expenseDetailError"
                         class="alert alert-danger d-none mb-0">
                        Failed to load expense details. Please try again.
                    </div>

                    <!-- Grid -->
                    <div id="expenseDetailGrid" class="d-none">

                        <table id="tblExpenseDetail"
                               class="table table-striped table-bordered w-100">

                            <tfoot>
                                <tr>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th></th>
                                    <th class="text-end"></th>
                                    <th class="text-end"></th>
                                </tr>
                            </tfoot>

                        </table>

                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="~/assets2/js/report_expense_details/report_expense_details.js" asp-append-version="true"></script>
}

@section Styles {
    <link href="~/assets2/css/report_expense_details/report_expense_details.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/assets2/css/report_filters/report_filters.css" rel="stylesheet" asp-append-version="true" />
}