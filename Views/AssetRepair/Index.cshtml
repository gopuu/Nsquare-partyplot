@{
    ViewData["Title"] = "Asset-Repair";
    Layout = "_Layout";
}
<link href="/assets2/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<script src="/assets2/js/jquery.dataTables.min.js"></script>
<script src="/assets2/js/dataTables.bootstrap5.min.js"></script>

@section Styles {
    <link href="~/assets2/css/customdatatable/customdatatable.css" asp-append-version="true" rel="stylesheet" />
    <link href="~/assets2/css/AssetRepair/AssetRepair.css" asp-append-version="true" rel="stylesheet" />
}

@section Scripts {
    <script src="~/assets2/js/AssetRepair/AssetRepair.js" asp-append-version="true"></script>
}

<!-- MAIN -->
<div class="content">
    <div class="pb-1">
        <div class="row g-2">
            <div class="col-12 col-xxl-12">
                <div class="mb-12">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h5 class="mb-0 text-warning">Asset Repair</h5>
                        <button class="btn btn-outline-warning btn-sm" id="btn-add">
                            <i class="fa fa-plus-circle"></i> New Order
                        </button>
                    </div>

                    <!--tableMain-->
                    <div id="tableMain">
                        <table class="table table-striped table-bordered" style="width:100%"></table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Asset Repair Modal -->
<div class="modal fade" id="assetRepairModal" tabindex="-1">
    <div class="modal-dialog modal-xxl">
        <div class="modal-content">
            <!-- HEADER -->
            <div class="modal-header bg-warning text-white py-1">
                <h5 class="modal-title text-white" id="RepairModalTitle">Add Asset Repair Order</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <input type="hidden" id="RepairId" value="0">

                <div class="row g-3">

                    <!-- Booking -->
                    <div class="col-md-4">
                        <label class="form-label">Booking</label>
                        <select id="bookingId" class="form-select">
                            <option value="0">-- Select Booking --</option>
                        </select>
                    </div>

                    <!-- Repair Vendor -->
                    <div class="col-md-8">
                        <label class="form-label">Repair Vendor</label>
                        <input type="text" id="repairVendor" class="form-control">
                    </div>

                </div>

                <hr>

                <!-- ITEMS -->
                <div class="d-flex justify-content-between mb-2">
                    <h6 class="mb-0">Repair Items</h6>

                    <button class="btn btn-sm btn-outline-primary" id="btnAddRepairItem">
                        <i class="fa fa-plus"></i> Add Item
                    </button>
                </div>

                <div class="table-responsive">

                    <table class="table table-bordered table-sm">

                        <thead class="table-light">
                            <tr>
                                <th style="width:40px">#</th>
                                <th>Asset</th>
                                <th style="width:90px">Qty</th>
                                <th style="width:150px">Service Cost / Item</th>
                                <th style="width:120px">Total Cost</th>
                                <th style="width:140px">Status</th>
                                <th style="width:180px">Sent Date</th>
                                <th style="width:180px">Received Date</th>
                                <th style="width:50px"></th>
                            </tr>
                        </thead>

                        <tbody id="RepairItemsBody"></tbody>

                    </table>

                </div>

                <div class="row mt-3">

                    <div class="col-md-9">
                        <label class="form-label">Remarks</label>
                        <textarea id="remarks" class="form-control" rows="2"></textarea>
                    </div>

                    <!-- Total Cost -->
                    <div class="col-md-3">
                        <label class="form-label">Total Repair Cost</label>
                        <input type="number" id="repairTotalCost" class="form-control" readonly>
                    </div>

                </div>

            </div>

            <!-- FOOTER -->
            <div class="modal-footer">

                <button class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">
                    Cancel
                </button>

                <button class="btn btn-warning btn-sm" id="btnSaveRepair">
                    Save
                </button>

            </div>
        </div>
    </div>
</div>

<!-- DELETE MODAL -->
<div class="modal fade zoomIn" id="deleteRecordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning py-1">
                <h5 class="modal-title text-white" id="deleteRecordModalLabel">Delete Confirmation</h5> <!-- Added Title -->
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" id="btn-close"></button>
            </div>
            <div class="modal-body">
                <div class="mt-2 text-center">
                    <lord-icon src="/assets2/js/gsqxdxog.json" trigger="loop" colors="primary:#f7b84b,secondary:#f06548" style="width:100px;height:100px"></lord-icon>
                    <div class="mt-4 pt-2 fs-15 mx-4 mx-sm-5">
                        <h4>Are you Sure ?</h4>
                        <p class="text-muted mx-4 mb-0">Delete this record?</p>
                    </div>
                </div>
                <div class="d-flex gap-2 justify-content-center mt-4 mb-2">
                    <button type="button" class="btn w-sm btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn w-sm btn-outline-danger" id="delete-record">Yes, Delete It!</button>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- END MODAL -->
