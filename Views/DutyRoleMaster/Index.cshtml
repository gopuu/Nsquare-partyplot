@{
    ViewData["Title"] = "DutyRole Master";
    Layout = "_Layout";
}

<link href="/assets2/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<script src="/assets2/js/jquery.dataTables.min.js"></script>
<script src="/assets2/js/dataTables.bootstrap5.min.js"></script>


<div class="content">
    <div class="pb-1">
        <div class="row g-2">
            <div class="col-12 col-xxl-8">
                <div class="mb-12">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="mb-0 text-warning">Duty Role Master</h4>
                        <button class="btn btn-outline-warning" id="btn-add">
                            <i class="fa fa-plus-circle"></i> Add Duty Role
                        </button>
                    </div>

                    <div id="tableDutyRole">
                        <table class="table table-striped table-bordered" style="width:100%"></table>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<!-- ADD / EDIT DUTY ROLE MODAL -->
<div class="modal fade" id="DutyRoleModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning text-white">
                <h5 class="modal-title text-white" id="DutyRoleModalTitle">Add Duty Role</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="DutyRoleId" value="0" />
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label">Role Name <span class="text-danger">*</span></label>
                        <input type="text" id="RoleName" class="form-control" placeholder="Enter Role Name" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Priority No</label>
                        <input type="number" id="PriorityNo" class="form-control" placeholder="Enter Priority No" />
                    </div>
                </div>
            </div>

            <div class="modal-footer d-flex align-items-center">
                <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                <button class="btn btn-outline-warning ms-2" id="btnSaveDutyRole">Save</button>
            </div>

        </div>
    </div>
</div>

<!-- DELETE MODAL -->
<div class="modal fade zoomIn" id="deleteDutyRoleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title text-white">Delete Confirmation</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">

                <h4>Are you sure?</h4>
                <p class="text-muted">Delete this duty role?</p>

                <div class="mt-4 d-flex gap-2 justify-content-center">
                    <button type="button" class="btn w-sm btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn w-sm btn-outline-danger" id="delete-dutyrole">Yes, Delete</button>
                </div>

            </div>
        </div>
    </div>
</div>


<script>
$(document).ready(function () {

    loadDutyRoleData();

    // ➤ ADD BUTTON CLICK
    $("#btn-add").click(function () {

        const canAdd = (sessionStorage.getItem("CanAdd") === "true");
        if (!canAdd) return Swal.fire("Access Denied", "You cannot Add.", "error");

        resetForm();
        $("#DutyRoleModalTitle").text("Add Duty Role");
        $("#DutyRoleModal").modal("show");
    });

    // ➤ SAVE DUTY ROLE
    $("#btnSaveDutyRole").click(function () {

        let roleName = $("#RoleName").val();
        if (!roleName) {
            Swal.fire("Validation", "Role Name is required!", "warning");
            return;
        }

        const payload = {
            Id: Number($("#DutyRoleId").val() || 0),
            RoleName: roleName,
            PriorityNo: Number($("#PriorityNo").val() || 0),
            ActionBy: sessionStorage.getItem("userId") ?? 0
        };

        $("#btnSaveDutyRole").prop("disabled", true);

        $.ajax({
            url: "/api/DutyRoleMaster/SaveDutyRoleMaster",
            type: "POST",
            data: JSON.stringify(payload),
            contentType: "application/json",
            success: function (res) {
                if (res.status === "Success") {
                       Swal.fire({
                        position: "top-end",
                        icon: "success",
                        title: "Saved",
                        showConfirmButton: false,
                        timer: 1000
                    });
                    $("#DutyRoleModal").modal("hide");
                    loadDutyRoleData();
                } else {
                    Swal.fire("Error", res.message, "error");
                }
            },
            error: handleApiError,
            complete: () => $("#btnSaveDutyRole").prop("disabled", false)
        });
    });

    // ➤ EDIT BUTTON
    $(document).on("click", ".btn-edit", function () {

        const canEdit = (sessionStorage.getItem("CanEdit") === "true");
        if (!canEdit) return Swal.fire("Access Denied", "You cannot Edit.", "error");

        let row = $("#tableDutyRole table").DataTable().row($(this).closest("tr")).data();

        resetForm();
        $("#DutyRoleId").val(row.Id);
        $("#RoleName").val(row.RoleName);
        $("#PriorityNo").val(row.PriorityNo);

        $("#DutyRoleModalTitle").text("Edit Duty Role");
        $("#DutyRoleModal").modal("show");
    });

    // ➤ DELETE BUTTON
    $(document).on("click", ".btn-delete", function () {

        const canDelete = (sessionStorage.getItem("CanDelete") === "true");
        if (!canDelete) return Swal.fire("Access Denied", "You cannot Delete.", "error");

        let row = $("#tableDutyRole table").DataTable().row($(this).closest("tr")).data();

        $("#deleteDutyRoleModal").data("id", row.Id).modal("show");
    });

    // ➤ CONFIRM DELETE
    $("#delete-dutyrole").click(function () {

        let id = $("#deleteDutyRoleModal").data("id");

        const payload = {
            Id: id,
            ActionBy: sessionStorage.getItem("userId") ?? 0
        };

        $.ajax({
            url: "/api/DutyRoleMaster/DeleteDutyRoleMaster",
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify(payload),
            success: function (res) {

                if (res.status === "Success") {
                    Swal.fire("Success", "Deleted!", "success");
                } else {
                    Swal.fire("Error", res.message, "error");
                }

                $("#deleteDutyRoleModal").modal("hide");
                loadDutyRoleData();
            },
            error: handleApiError
        });
    });

});

// RESET FORM
function resetForm() {
    $("#DutyRoleId").val(0);
    $("#RoleName").val("");
    $("#PriorityNo").val("");
}

// LOAD DATA
function loadDutyRoleData() {

    $.ajax({
        url: "/api/DutyRoleMaster/GetDutyRoleMaster",
        type: "POST",
        contentType: "application/json",
        data: JSON.stringify({ Id: 0 }),
        success: function (res) {
            renderDutyRoleTable(res.data);
        },
        error: handleApiError
    });
}

// RENDER TABLE
function renderDutyRoleTable(data) {

    if ($.fn.dataTable.isDataTable("#tableDutyRole table")) {
        $("#tableDutyRole table").DataTable().destroy();
    }

    data.forEach((x, i) => x.srno = i + 1);

    $("#tableDutyRole table").DataTable({
        data: data,
        columns: [
            { data: "srno", title: "Sr No" },
            { data: "RoleName", title: "Role Name" },
            { data: "PriorityNo", title: "Priority No" },
            {
                data: null,
                title: "Actions",
                render: () => `
                        <button class="btn btn-outline-warning btn-action-xs  btn-edit"><i class="fa fa-edit"></i></button>
                        <button class="btn btn-outline-danger btn-action-xs btn-delete"><i class="fa fa-trash"></i></button>
                `
            }
        ]
    });
}

</script>