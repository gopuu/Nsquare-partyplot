@{
    ViewData["Title"] = "Staff Master";
    Layout = "_Layout";
}

<link href="/assets2/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<script src="/assets2/js/jquery.dataTables.min.js"></script>
<script src="/assets2/js/dataTables.bootstrap5.min.js"></script>

<div class="content">
    <div class="pb-1">
        <div class="row g-2">
            <div class="col-12 col-xxl-12">
                <div class="mb-12">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="mb-0 text-warning">Staff Master</h4>
                        <button class="btn btn-outline-warning btn-sm" id="btn-add">
                            <i class="fa fa-plus-circle"></i> Add Staff
                        </button>
                    </div>

                    <div id="tableStaff">
                        <table class="table table-striped table-bordered" style="width:100%"></table>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<!--Add NEW-->
<div class="modal fade" id="staffModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">

            <div class="modal-header bg-warning text-white py-1">
                <h5 class="modal-title text-white" id="staffModalTitle">Add Staff</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="staffId" value="0" />

                <!-- ================= ROW 1 ================= -->
                <div class="row g-3 mb-3">

                    <!-- ===== STAFF BASIC INFO (8) ===== -->
                    <div class="col-md-8">
                        <div class="card h-100 border-0 shadow-sm">
                            <div class="card-header bg-light fw-semibold py-1">
                                👤 Staff Basic Information
                            </div>
                            <div class="card-body">
                                <div class="row g-2 py-1">

                                    <div class="col-md-8">
                                        <label class="form-label">Name *</label>
                                        <input type="text" id="txtName" class="form-control">
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label">Employee Code</label>
                                        <input type="text" id="txtEmpCode" class="form-control">
                                    </div>

                                    <div class="col-md-8">
                                        <label class="form-label">Address</label>
                                        <textarea id="txtAddress" class="form-control" rows="2"></textarea>
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label">Phone No *</label>
                                        <input type="text" id="txtPhoneNo" maxlength="10" class="form-control">
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label">Emergency Phone</label>
                                        <input type="text" id="txtEmergencyPhone" maxlength="10" class="form-control">
                                    </div>

                                    <div class="col-md-8">
                                        <label class="form-label">Email</label>
                                        <input type="email" id="txtEmail" class="form-control">
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label">Designation</label>
                                        <select id="ddlDesignation" class="form-select"></select>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label">Aadhar No</label>
                                        <input type="text" id="txtAadhar" maxlength="12" class="form-control">
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ===== EMPLOYMENT DETAILS (4) ===== -->
                    <div class="col-md-4">
                        <div class="card h-100 border-0 shadow-sm">
                            <div class="card-header bg-light fw-semibold py-1">
                                🏢 Employment Details
                            </div>
                            <div class="card-body">
                                <div class="row g-3">

                                    <div class="col-12">
                                        <label class="form-label">Joining Date</label>
                                        <input type="date" id="txtJoiningDate" class="form-control">
                                    </div>

                                    <div class="col-12">
                                        <label class="form-label">Birth Date</label>
                                        <input type="date" id="txtBirthDate" class="form-control">
                                    </div>

                                    <div class="col-12">
                                        <label class="form-label">Anniversary Date</label>
                                        <input type="date" id="txtAnniversaryDate" class="form-control">
                                    </div>

                                    <div class="col-12">
                                        <label class="form-label">Salary</label>
                                        <input type="number" id="txtSalary" class="form-control">
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- ================= ROW 2 ================= -->
                <div class="row g-3 mb-3">

                    <!-- ===== BANK DETAILS (8) ===== -->
                    <div class="col-md-8">
                        <div class="card h-100 border-0 shadow-sm">
                            <div class="card-header bg-light fw-semibold py-1">
                                🏦 Bank Details
                            </div>
                            <div class="card-body">
                                <div class="row g-3">

                                    <div class="col-md-4">
                                        <label class="form-label">Bank Name</label>
                                        <input type="text" id="txtBankName" class="form-control">
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label">Branch</label>
                                        <input type="text" id="txtBankBranch" class="form-control">
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label">IFSC</label>
                                        <input type="text" id="txtIFSC" class="form-control">
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label">Account No</label>
                                        <input type="text" id="txtAccountNo" class="form-control">
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label">Account Holder</label>
                                        <input type="text" id="txtBankAccountHolderName" class="form-control">
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label">UPI ID</label>
                                        <input type="text" id="txtBankUPIId" class="form-control">
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ===== LOGIN DETAILS (4) ===== -->
                    <div class="col-md-4">
                        <div class="card h-100 border-0 shadow-sm">
                            <div class="card-header bg-light fw-semibold py-1">
                                🔐 Login Details
                            </div>
                            <div class="card-body">
                                <div class="row g-3">

                                    <div class="col-12">
                                        <label class="form-label">User Name</label>
                                        <input type="text" id="txtUserName" class="form-control">
                                    </div>

                                    <div class="col-12">
                                        <label class="form-label">Password</label>
                                        <input type="password" id="txtPassword" class="form-control">
                                    </div>

                                    <div class="col-12">
                                        <label class="form-label">Photo</label>
                                        <div class="input-group">
                                            <input type="file" id="txtPhoto" class="form-control" accept="image/*">
                                            <button id="btnDownloadInvoice"
                                                    class="btn btn-outline-primary d-none"
                                                    type="button">
                                                <i class="fa fa-download"></i>
                                            </button>
                                        </div>
                                        <input type="hidden" id="invoiceFileLink">
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- ================= ROW 3 ================= -->
                <div class="row g-3">

                    <div class="col-12">
                        <div class="card border-0 shadow-sm">
                            <div class="card-header bg-light fw-semibold py-1">
                                📄 Staff Documents
                            </div>
                            <div class="card-body">

                                <div id="documentsContainer"></div>

                                <button type="button"
                                        class="btn btn-sm btn-outline-primary mt-2"
                                        id="btnAddDocument">
                                    ➕ Add Document
                                </button>

                            </div>
                        </div>
                    </div>

                </div>

                <!-- DOCUMENT TEMPLATE -->
                <script type="text/template" id="docRowTemplate">
                    <div class="row g-2 align-items-center document-row mb-2" data-index="{{index}}">
                        <div class="col-md-5">
                            <input type="text" class="form-control doc-name" placeholder="Document Name">
                        </div>
                        <div class="col-md-5">
                            <input type="file" class="form-control doc-file" accept="image/*,.pdf">
                        </div>
                        <div class="col-md-1 text-center">
                            <span class="text-success d-none uploaded-label">✔</span>
                        </div>
                        <div class="col-md-1 text-end">
                            <button type="button" class="btn btn-sm btn-outline-danger btnRemoveDoc">✖</button>
                        </div>
                    </div>
                </script>

            </div>

            <div class="modal-footer d-flex justify-content-between">
                <div class="d-flex gap-4">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="switchIsSuperUser">
                        <label class="form-check-label">Is Super User</label>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="switchIsAutoLogin">
                        <label class="form-check-label">Auto Login</label>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="switchIsActive">
                        <label class="form-check-label">Is Active</label>
                    </div>
                </div>

                <div>
                    <button class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Close</button>
                    <button class="btn btn-outline-warning btn-sm" id="btnSaveStaff">Save</button>
                </div>
            </div>

        </div>
    </div>

</div>

<!-- DELETE MODAL -->
<div class="modal fade zoomIn" id="deleteRecordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title text-white" id="deleteRecordModalLabel">Delete Confirmation</h5> <!-- Added Title -->
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" id="btn-close"></button>
            </div>
            <div class="modal-body">
                <div class="mt-2 text-center">
                    <lord-icon src="/assets/js/gsqxdxog.json" trigger="loop" colors="primary:#f7b84b,secondary:#f06548" style="width:100px;height:100px"></lord-icon>
                    <div class="mt-4 pt-2 fs-15 mx-4 mx-sm-5">
                        <h4>Are you Sure ?</h4>
                        <p class="text-muted mx-4 mb-0">Delete this record?</p>
                    </div>
                </div>
                <div class="d-flex gap-2 justify-content-center mt-4 mb-2">
                    <button type="button" class="btn w-sm btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn w-sm btn-outline-danger" id="delete-record">Yes, Delete It!</button>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- END MODAL -->

@section Scripts {
    <script src="~/assets2/js/staffmaster/staffmaster.js" asp-append-version="true"></script>
}

@section Styles {
    <link href="~/assets2/css/customdatatable/customdatatable.css"  asp-append-version="true" rel="stylesheet" />
}
