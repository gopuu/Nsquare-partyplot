         $("#btnSaveAttendance").on("click", function () {
        let table = $('#tableAttendance table').DataTable();
        let rows = table.rows().data().toArray();
        let attendanceList = [];

        rows.forEach(r => {
            let rowId = r.AttendanceId; // ✅ fix here

