<div class="content">
    <div class="pb-1">
        <div class="row align-items-center g-2">
            <!-- Title on left -->
            <div class="col-auto">
                <h4 class="mb-0 text-warning">Staff Attendance</h4>
            </div>

            <!-- Push filters and buttons to right -->
            <div class="col d-flex justify-content-end align-items-center gap-2">
                <!-- Status -->
                <div class="col-auto">
                    <label class="form-label mb-0">Status</label>
                    <select id="ddlStatus" class="form-select form-select-sm">
                        <option value="0">All</option>
                    </select>
                </div>

                <!-- Staff -->
                <div class="col-auto">
                    <label class="form-label mb-0">Staff</label>
                    <select id="ddlStaff" class="form-select form-select-sm">
                        <option value="0">All</option>
                    </select>
                </div>

                <!-- From Date -->
                <div class="col-auto">
                    <label class="form-label mb-0">From</label>
                    <input type="date" id="txtfromdate" class="form-control form-control-sm">
                </div>

                <!-- To Date -->
                <div class="col-auto">
                    <label class="form-label mb-0">To</label>
                    <input type="date" id="txttodate" class="form-control form-control-sm">
                </div>

                <!-- Buttons -->
                <div class="col-auto d-flex gap-1 mt-5">
                    <button class="btn btn-outline-warning btn-sm btn-edit"><i class="fa fa-edit"></i> Edit</button>
                    <button class="btn btn-outline-warning btn-sm d-none" id="btnSaveAttendance">Save</button>
                </div>
            </div>
        </div>

        <!-- Table -->
        <div id="tableAttendance" class="mt-2">
            <table class="table table-striped table-bordered" style="width:100%"></table>
        </div>
    </div>
</div>

