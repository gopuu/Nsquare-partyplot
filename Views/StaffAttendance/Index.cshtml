<script>
    let statusList = [];

    // Helper: convert HH:MM AM/PM to 24-hour format (for input type=time)
          function convertTo24Hour(timeStr) {
        if (!timeStr) return ""; // handle null/undefined/empty

        // Expecting format like "09:05 AM"
        const parts = timeStr.trim().split(' ');
        if (parts.length !== 2) return ""; // invalid format

        let [time, modifier] = parts;
        if (!modifier) return "";

        let [hours, minutes] = time.split(':').map(Number);
        if (isNaN(hours) || isNaN(minutes)) return "";

        modifier = modifier.toUpperCase();

        if (modifier === 'PM' && hours < 12) hours += 12;
        if (modifier === 'AM' && hours === 12) hours = 0;

        return `${hours.toString().padStart(2, '0')}:${minutes.toString().padStart(2, '0')}`;
    }


    $(document).ready(function () {
        // 1️⃣ Set default dates (today)
        let today = new Date().toISOString().split('T')[0];
        $("#txtfromdate, #txttodate").val(today);

        // 2️⃣ Load dropdowns
        loadStaffDropdown();
        loadStatusDropdown().then(() => {
            fetchAttendanceData();
        });

        // 3️⃣ Change events to refresh table
        $("#ddlStaff, #ddlStatus, #txtfromdate, #txttodate").on("change", function(){
            fetchAttendanceData();
        });
    });

    // ----------------------
    // Load Staff Dropdown
    // ----------------------
    function loadStaffDropdown() {
        $.ajax({
            url: '/api/StaffMaster/GetStaffMaster',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ Id: 0, StatusType: "Attendance" }),
            success: function (res) {
                const staff = res?.data || [];
                $('#ddlStaff').append(staff.map(x => `<option value="${x.Id}">${x.Name}</option>`));
            }
        });
    }

    // ----------------------
    // Load Status Dropdown
    // ----------------------
    function loadStatusDropdown() {
        return new Promise((resolve) => {
            $.ajax({
                url: '/api/StatusMaster/GetStatusMaster',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ Id: 0, StatusType: "Attendance" }),
                success: function (res) {
                    statusList = res?.data || [];
                    $('#ddlStatus').append(statusList.map(s => `<option value="${s.Id}">${s.StatusName}</option>`));
                    resolve();
                },
                error: function () {
                    statusList = [];
                    resolve();
                }
            });
        });
    }

    // ----------------------
    // Fetch Attendance Data
    // ----------------------
    function fetchAttendanceData() {
        let staffId = parseInt($("#ddlStaff").val()) || 0;
        let statusId = parseInt($("#ddlStatus").val()) || 0;
        let fromDate = $("#txtfromdate").val();
        let toDate = $("#txttodate").val();

        $.ajax({
            url: "/api/StaffAttendance/GetStaffAttendance",
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify({
                StaffId: staffId,
                StatusId: statusId,
                FromDate: fromDate,
                ToDate: toDate
            }),
            success: function (res) {
                renderAttendanceTable(res?.data || []);
            }
        });
    }

    // ----------------------
    // Render DataTable
    // ----------------------
    function renderAttendanceTable(data) {
        if ($.fn.dataTable.isDataTable('#tableAttendance table')) {
            $('#tableAttendance table').DataTable().clear().destroy();
        }

        data.forEach((x, i) => x.srno = i + 1);

        $('#tableAttendance table').DataTable({
            data: data,
            columns: [
                { data: "srno", title: "Sr No" },
                { data: "StaffName", title: "Staff" },
                { data: "AttendanceId", title: "AttendanceId", visible:false },
                {
                    data: "AttendanceDateFormat",
                    title: "Date",
                    render: function (d) {
                        if (!d) return '';
                        let date = new Date(d);
                        let formattedDate = date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
                        let dayName = date.toLocaleDateString('en-US', { weekday: 'long' });
                        return `${formattedDate} (${dayName})`;
                    }
                },
                {
                    data: "CheckInTime",
                    title: "Check In",
                    render: function(d, type, row){
                        let val = d ? convertTo24Hour(d) : '';
                        return `<input type="time" class="form-control checkin-time" value="${val}" data-id="${row.AttendanceId}"/>`;
                    }
                },
                {
                    data: "CheckOutTime",
                    title: "Check Out",
                    render: function(d, type, row){
                        let val = d ? convertTo24Hour(d) : '';
                        return `<input type="time" class="form-control checkout-time" value="${val}" data-id="${row.AttendanceId}"/>`;
                    }
                },
                {
                    data: "StatusId",
                    title: "Status",
                    render: function(d, type, row){
                        let options = `<option value="">-- Select Status --</option>`;
                        options += statusList.map(s => `<option value="${s.Id}" ${s.Id==d ? "selected" : ""}>${s.StatusName}</option>`).join('');
                        return `<select class="form-select duty-status" data-id="${row.AttendanceId}">${options}</select>`;
                    }
                }
            ]
        });

        disableAttendanceInputs(); // optional: disable editing by default
    }

    // Optional helper to disable all inputs initially
    function disableAttendanceInputs(){
        $('.checkin-time, .checkout-time, .duty-status').prop('disabled', true);
    }
</script>