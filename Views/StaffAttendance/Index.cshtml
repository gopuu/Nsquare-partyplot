@{
    ViewData["Title"] = "StaffAttendance";
    Layout = "_Layout";
}

<link href="/assets2/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<script src="/assets2/js/jquery.dataTables.min.js"></script>
<script src="/assets2/js/dataTables.bootstrap5.min.js"></script>

<div class="content">
    <div class="pb-1">
        <div class="row g-2">
            <div class="col-12 col-xxl-8">
                <div class="mb-12">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="mb-0 text-warning">StaffAttendance</h4>
                        <button class="btn btn-outline-warning" id="btn-add">
                            <i class="fa fa-plus-circle"></i> Add StaffAttendance
                        </button>
                    </div>

                    <div id="tableAttendance">
                        <table class="table table-striped table-bordered" style="width:100%"></table>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>


<!-- ADD / EDIT STAFF ATTENDANCE MODAL -->
<div class="modal fade" id="attendanceModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-warning text-white">
                <h5 class="modal-title" id="attendanceModalTitle">Add Attendance</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="attendanceId" value="0" />

                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Staff <span class="text-danger">*</span></label>
                        <select id="ddlStaff" class="form-select"></select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Attendance Date <span class="text-danger">*</span></label>
                        <input type="date" id="txtAttendanceDate" class="form-control">
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Check In Time</label>
                        <input type="time" id="txtCheckInTime" class="form-control">
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Check Out Time</label>
                        <input type="time" id="txtCheckOutTime" class="form-control">
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Status <span class="text-danger">*</span></label>
                        <select id="ddlStatus" class="form-select"></select>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                <button class="btn btn-outline-warning" id="btnSaveAttendance">Save</button>
            </div>
        </div>
    </div>
</div>


<!-- DELETE MODAL -->
<div class="modal fade zoomIn" id="deleteRecordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title text-white" id="deleteRecordModalLabel">Delete Confirmation</h5> <!-- Added Title -->
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" id="btn-close"></button>
            </div>
            <div class="modal-body">
                <div class="mt-2 text-center">
                    <lord-icon src="/assets/js/gsqxdxog.json" trigger="loop" colors="primary:#f7b84b,secondary:#f06548" style="width:100px;height:100px"></lord-icon>
                    <div class="mt-4 pt-2 fs-15 mx-4 mx-sm-5">
                        <h4>Are you Sure ?</h4>
                        <p class="text-muted mx-4 mb-0">Delete this record?</p>
                    </div>
                </div>
                <div class="d-flex gap-2 justify-content-center mt-4 mb-2">
                    <button type="button" class="btn w-sm btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn w-sm btn-outline-danger" id="delete-record">Yes, Delete It!</button>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- END MODAL -->

<script>
$(document).ready(function () {
    fetchAttendanceData();
    loadStaffDropdown();
    loadStatusDropdown();

    // ADD Button
    $(document).on('click', '#btn-add', function () {
        const canAdd = (sessionStorage.getItem('CanAdd') || localStorage.getItem('CanAdd')) === 'true';
        if (!canAdd) {
            Swal.fire("Access Denied", "You do not have permission to Add.", "error");
         return;
        }
        resetAttendanceForm();
        $('#attendanceModalTitle').text('Add Attendance');
        $('#attendanceModal').modal('show');
    });

    // SAVE Attendance
    $('#btnSaveAttendance').on('click', function () {
        const staffId = Number($('#ddlStaff').val() || 0);
        const statusId = Number($('#ddlStatus').val() || 0);
        const date = $('#txtAttendanceDate').val();
        const checkIn = $('#txtCheckInTime').val();
        const checkOut = $('#txtCheckOutTime').val();

        if (!staffId || !statusId || !date) {
        Swal.fire("Validation", "Staff, Status & Date are required!", "warning");
        return;
        }

        const payload = {
        Id: Number($('#attendanceId').val() || 0),
        StaffId: staffId,
        AttendanceDate: date,
        CheckInTime: checkIn || null,
        CheckOutTime: checkOut || null,
        StatusId: statusId,
        ActionBy: sessionStorage.getItem('userId') ?? 0
        };

        $('#btnSaveAttendance').prop("disabled", true);

        $.ajax({
            url: "/api/StaffAttendance/SaveStaffAttendance",
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify(payload),
            success: function (res) {
                if (res?.status === "Success") {
                    Swal.fire({
                        icon: "success",
                        title: "Saved!",
                        showConfirmButton: false,
                        timer: 1000
                    });
                    $('#attendanceModal').modal('hide');
                    fetchAttendanceData();
                } else {
                    Swal.fire("Error", res?.message || "Save failed", "error");
                }
            },
            complete: function () {
                $('#btnSaveAttendance').prop("disabled", false);
            }
        });
    });

    $(document).on('click', '.btn-edit', function () {
        const canEdit = (sessionStorage.getItem('CanEdit') || localStorage.getItem('CanEdit')) === 'true';
        if (!canEdit) {
            Swal.fire("Access Denied", "You do not have permission to Edit.", "error");
            return;
        }

        const table = $('#tableAttendance table').DataTable();
        const rowData = table.row($(this).closest('tr')).data();
        resetAttendanceForm();

        $('#attendanceId').val(rowData.Id);
        $('#ddlStaff').val(rowData.StaffId);

        // Format date for <input type="date">
        if (rowData.AttendanceDate) {
            const date = new Date(rowData.AttendanceDate);
            const yyyy = date.getFullYear();
            const mm = String(date.getMonth() + 1).padStart(2, '0');
            const dd = String(date.getDate()).padStart(2, '0');
            $('#txtAttendanceDate').val(`${yyyy}-${mm}-${dd}`);
        }

        // Format time for <input type="time">
        if (rowData.CheckInTime) {
            const timeIn = new Date(rowData.CheckInTime);
            const hh = String(timeIn.getHours()).padStart(2, '0');
            const mi = String(timeIn.getMinutes()).padStart(2, '0');
            $('#txtCheckInTime').val(`${hh}:${mi}`);
        }

        if (rowData.CheckOutTime) {
            const timeOut = new Date(rowData.CheckOutTime);
            const hh = String(timeOut.getHours()).padStart(2, '0');
            const mi = String(timeOut.getMinutes()).padStart(2, '0');
            $('#txtCheckOutTime').val(`${hh}:${mi}`);
        }

        $('#ddlStatus').val(rowData.StatusId);

        $('#attendanceModalTitle').text("Edit Attendance");
        $('#attendanceModal').modal('show');
    });

    // Delete button click
    $(document).on('click', '.btn-delete', function () {
        const canDelete = (sessionStorage.getItem('CanDelete') || localStorage.getItem('CanDelete')) === 'true';
        if (!canDelete) {
        Swal.fire("Access Denied", "You do not have permission to Delete.", "error");
        return;
        }
        let table = $('#tableAttendance  table').DataTable();
        let rowData = table.row($(this).closest('tr')).data();
        $("#deleteRecordModal")
        .data("id", rowData.Id)
        .modal("show");
    });

    // Confirm Delete
    $("#delete-record").click(function () {
        let id = $("#deleteRecordModal").data("id");
        let payload = {
        Id: id,
        ActionBy: sessionStorage.getItem("userId") ?? 0
        };
        $('#btn-loader').show();
        $.ajax({
            url: "/api/StaffAttendance/DeleteStaffAttendance",
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify(payload),
            success: function (response) {
                if (typeof response === "string") {
                    response = JSON.parse(response);
                }
                if (response.status === "Success") {
                    Swal.fire({
                        position: "top-end",
                        icon: "success",
                        title: "Leave Type Deleted!",
                        showConfirmButton: false,
                        timer: 1000
                    });
                } else {
                    Swal.fire("Delete Failed", response.message, "error");
                }
                $("#deleteRecordModal").modal("hide");
                 fetchAttendanceData(); // reload updated list
            },
            error: function (xhr, status, error) {
                handleApiError(xhr, status, error, "Delete Leave Type Error");
            },
            complete: function () {
                $('#btn-loader').hide();
            }
        });
    });

    });

    // RESET FORM
    function resetAttendanceForm() {
        $('#attendanceId').val(0);
        $('#ddlStaff').val('');
        $('#txtAttendanceDate').val('');
        $('#txtCheckInTime').val('');
        $('#txtCheckOutTime').val('');
        $('#ddlStatus').val('');
    }

    // FETCH ATTENDANCE DATA
    function fetchAttendanceData() {
        $.ajax({
            url: "/api/StaffAttendance/GetStaffAttendance",
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify({ Id: 0 }),
            success: function (res) {
                renderAttendanceTable(res?.data || []);
            }
        });
    }

    // RENDER DATATABLE
    function renderAttendanceTable(data) {
        if ($.fn.dataTable.isDataTable('#tableAttendance table')) {
            $('#tableAttendance table').DataTable().clear().destroy();
        }
        data.forEach((x, i) => x.srno = i + 1);
        $('#tableAttendance table').DataTable({
            data: data,
            columns: [
                { data: "srno", title: "Sr No" },
                { data: "StaffName", title: "Staff" },
                {
                    data: "AttendanceDate",
                    title: "Date",
                    render: function(d) {
                        if (!d) return '';
                        let date = new Date(d);
                        return date.toLocaleDateString(); // shows only date
                    }
                },
                {
                    data: "CheckInTime",
                    title: "Check In",
                    render: function(d) {
                        if (!d) return '';
                        let date = new Date(d);
                        return date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }); // shows only time HH:MM
                    }
                },
                {
                    data: "CheckOutTime",
                    title: "Check Out",
                    render: function(d) {
                        if (!d) return '';
                        let date = new Date(d);
                        return date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                    }
                },
                { data: "StatusName", title: "Status" },
                    {
                        data: null,
                        title: "Actions",
                        render: () => `
                         <button class="btn btn-outline-warning btn-sm btn-edit  btn-action-xs"><i class="fa fa-edit"></i></button>
                         <button class="btn btn-outline-danger btn-sm btn-delete  btn-action-xs"><i class="fa fa-trash"></i></button>`
                }
            ]
        });

    }

    // LOAD STAFF DROPDOWN
    function loadStaffDropdown() {
        $.ajax({
            url: '/api/StaffMaster/GetStaffMaster',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ Id: 0 }),
            success: function (res) {
                const staff = res?.data || [];
                $('#ddlStaff').html(staff.map(x => `<option value="${x.Id}">${x.Name}</option>`));
            }
        });
    }

    // LOAD STATUS DROPDOWN
    function loadStatusDropdown() {
        $.ajax({
            url: '/api/StatusMaster/GetStatusMaster',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ Id: 0 }),
            success: function (res) {
                const status = res?.data || [];
                $('#ddlStatus').html(status.map(x => `<option value="${x.Id}">${x.StatusName}</option>`));
            }
        });
    }


</script>

