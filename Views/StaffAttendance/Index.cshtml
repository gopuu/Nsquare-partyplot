@{
    ViewData["Title"] = "Staff Attendance";
    Layout = "_Layout";
}

<link href="/assets2/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<script src="/assets2/js/jquery.dataTables.min.js"></script>
<script src="/assets2/js/dataTables.bootstrap5.min.js"></script>

<div class="content">
    <div class="pb-1">
        <div class="row align-items-center g-2">
            <!-- Title on left -->
            <div class="col-auto">
                <h4 class="mb-0 text-warning">Staff Attendance</h4>
            </div>

            <!-- Push filters and buttons to right -->
            <div class="col d-flex justify-content-end align-items-center gap-2">
                <!-- Status -->
                <div class="col-auto">
                    <label class="form-label mb-0">Status</label>
                    <select id="ddlStatus" class="form-select form-select-sm">
                        <option value="0">All</option>
                    </select>
                </div>

                <!-- Staff -->
                <div class="col-auto">
                    <label class="form-label mb-0">Staff</label>
                    <select id="ddlStaff" class="form-select form-select-sm">
                        <option value="0">All</option>
                    </select>
                </div>

                <!-- From Date -->
                <div class="col-auto">
                    <label class="form-label mb-0">From</label>
                    <input type="date" id="txtfromdate" class="form-control form-control-sm">
                </div>

                <!-- To Date -->
                <div class="col-auto">
                    <label class="form-label mb-0">To</label>
                    <input type="date" id="txttodate" class="form-control form-control-sm">
                </div>

                <!-- Buttons -->
                <div class="col-auto d-flex gap-1 mt-4">
                    <button class="btn btn-outline-warning btn-sm" id="btnSaveAttendance">Save</button>
                </div>
            </div>
        </div>

        <!-- Table -->
        <div id="tableAttendance" class="mt-2">
            <table class="table table-striped table-bordered" style="width:100%"></table>
        </div>
    </div>
</div>

<!-- DELETE MODAL -->
<div class="modal fade zoomIn" id="deleteRecordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title text-white" id="deleteRecordModalLabel">Delete Confirmation</h5> <!-- Added Title -->
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" id="btn-close"></button>
            </div>
            <div class="modal-body">
                <div class="mt-2 text-center">
                    <lord-icon src="/assets2/js/gsqxdxog.json" trigger="loop" colors="primary:#f7b84b,secondary:#f06548" style="width:100px;height:100px"></lord-icon>
                    <div class="mt-4 pt-2 fs-15 mx-4 mx-sm-5">
                        <h4>Are you Sure ?</h4>
                        <p class="text-muted mx-4 mb-0">Delete this record?</p>
                    </div>
                </div>
                <div class="d-flex gap-2 justify-content-center mt-4 mb-2">
                    <button type="button" class="btn w-sm btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn w-sm btn-outline-danger" id="delete-record">Yes, Delete It!</button>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- END MODAL -->

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>


@section Scripts {
    <script src="~/assets2/js/staffattendance/staffattendance.js" asp-append-version="true"></script>
}

@section Styles {
    <link href="~/assets2/css/customdatatable/customdatatable.css" asp-append-version="true" rel="stylesheet" />

}
