@{
    ViewData["Title"] = "Sales Funnel Master";
    Layout = "_Layout";
}

<!-- MAIN -->
<div class="content">
    <div class="pb-1">
        <div class="row g-2">
            <div class="col-12 col-xxl-12">
                <div class="mb-12">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="mb-0 text-warning">Sales Funnel Master</h4>
                        <button class="btn btn-outline-warning d-none" id="btn-add">
                            <i class="fa fa-plus-circle"></i> Add
                        </button>
                    </div>

                    <div id="tableMain">
                        <table class="table table-bordered table-striped align-middle" id="processTable">
                            
                        </table>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Add Process -->
<div class="modal fade" id="processModal" tabindex="-1" aria-labelledby="processModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <!-- Made modal larger -->
        <div class="modal-content">
            <div class="modal-header bg-warning py-2">
                <h5 class="modal-title text-white" id="processModalLabel">Add Sales Funnel </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <!-- Modal Body -->
            <div class="modal-body">
                <!-- Form -->
                <form id="processForm" class="d-flex align-items-start gap-2">
                    <input type="hidden" id="processId" value="0">

                    <!-- Process Name -->
                    <div class="flex-grow-1 d-flex flex-column">
                        <label for="processName" class="form-label">Name</label>
                        <input type="text" class="form-control mt-1" id="processName">
                        <div class="text-danger small mt-1 error-msg d-none">Please enter name</div>
                    </div>

                    <!-- Index No -->
                    <div class="d-flex flex-column" style="width: 120px;">
                        <label for="indexNo" class="form-label">Step</label>
                        <input type="number" class="form-control mt-1" id="processIndexNo" step="0.01" min="0">
                        <div class="text-danger small mt-1 error-msg d-none">Please enter step no</div>
                    </div>

                    <!-- Button aligned at bottom -->
                    <div class="d-flex align-items-end">
                        <button type="button" class="btn btn-outline-warning mt-3" id="btnprocess">Save</button>
                    </div>
                </form>

                
            </div>
        </div>
    </div>
</div>


<!-- DELETE MODAL -->
<div class="modal fade zoomIn" id="deleteRecordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title text-white">Delete Confirmation</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="text-center mt-2">
                    <h4>Are you sure?</h4>
                    <p class="text-muted">Delete this account type?</p>
                </div>
                <div class="d-flex gap-2 justify-content-center mt-4 mb-2">
                    <button type="button" class="btn w-sm btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn w-sm btn-outline-danger" id="delete-record">Yes, Delete!</button>
                </div>
            </div>
        </div>
    </div>
</div>



<link href="/assets2/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<script src="/assets2/js/jquery.dataTables.min.js"></script>
<script src="/assets2/js/dataTables.bootstrap5.min.js"></script>

@section Scripts {
    <script src="~/assets2/js/processmaster/processmaster.js" asp-append-version="true"></script>
}




