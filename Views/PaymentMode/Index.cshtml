@{
    ViewData["Title"] = "Payment Mode Master";
    Layout = "_Layout";
}
<link href="/assets2/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<script src="/assets2/js/jquery.dataTables.min.js"></script>
<script src="/assets2/js/dataTables.bootstrap5.min.js"></script>
@section Styles {
    <link href="~/assets2/css/customdatatable/customdatatable.css" asp-append-version="true" rel="stylesheet" />
    <link href="~/assets2/css/PaymentModeMaster/PaymentModeMaster.css" asp-append-version="true" rel="stylesheet" />
}
@section Scripts {
    <script src="~/assets2/js/PaymentModeMaster/PaymentModeMaster.js" asp-append-version="true"></script>
}

<!-- MAIN -->
<div class="content">
    <div class="pb-1">
        <div class="row g-2">
            <div class="col-12 col-xxl-12">
                <div class="mb-12">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="mb-0 text-warning">Payment Mode Master</h4>
                        <button class="btn btn-outline-warning d-none" id="btn-add">
                            <i class="fa fa-plus-circle"></i> Add Item Frequency
                        </button>
                    </div>

                    <div id="tableMain">
                        <table class="table table-striped table-bordered" style="width:100%"></table>
                    </div>

                </div>
            </div>
        </div>
    </div>

</div>

<!-- ========== Modal ========== -->
<div class="modal fade" id="addEventModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <!-- HEADER -->
            <div class="modal-header bg-warning text-white">
                <h5 class="modal-title text-white" id="addEventModalTitle">Add Payment Mode</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <!-- BODY -->
            <div class="modal-body">
                <input type="hidden" id="paymentModeId" value="0">

                <div class="row g-3">

                    <!-- Payment Mode Name -->
                    <div class="col-12">
                        <label class="form-label">Payment Mode <span class="text-danger">*</span></label>
                        <input type="text" id="paymentModeName" class="form-control" placeholder="Enter Payment Mode">
                    </div>

                    <!-- Description -->
                    <div class="col-12">
                        <label class="form-label">Description</label>
                        <textarea id="paymentModeDescription" class="form-control" rows="4" placeholder="Enter Description"></textarea>
                    </div>

                </div>
            </div>

            <!-- FOOTER -->
            <div class="modal-footer d-flex justify-content-between align-items-center">

                <!-- LEFT SIDE EMPTY (For Alignment) -->
                <div>
                    <!-- Active Toggle -->
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" id="isPaymentModeActive" checked>
                        <label class="form-check-label" for="isPaymentModeActive">Active</label>
                    </div>
                </div>

                <!-- RIGHT SIDE -->
                <div class="d-flex align-items-center gap-3">
                    <!-- Buttons -->
                    <div>
                        <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                        <button class="btn btn-outline-warning" id="btnSaveAddEventModal">Save</button>
                    </div>

                </div>

            </div>
        </div>
    </div>
</div>

<!-- DELETE MODAL -->
<div class="modal fade zoomIn" id="deleteRecordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title text-white" id="deleteRecordModalLabel">Delete Confirmation</h5> <!-- Added Title -->
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" id="btn-close"></button>
            </div>
            <div class="modal-body">
                <div class="mt-2 text-center">
                    <lord-icon src="/assets2/js/gsqxdxog.json" trigger="loop" colors="primary:#f7b84b,secondary:#f06548" style="width:100px;height:100px"></lord-icon>
                    <div class="mt-4 pt-2 fs-15 mx-4 mx-sm-5">
                        <h4>Are you Sure ?</h4>
                        <p class="text-muted mx-4 mb-0">Delete this record?</p>
                    </div>
                </div>
                <div class="d-flex gap-2 justify-content-center mt-4 mb-2">
                    <button type="button" class="btn w-sm btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn w-sm btn-outline-danger" id="delete-record">Yes, Delete It!</button>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- END MODAL -->

