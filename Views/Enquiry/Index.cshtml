@{
    ViewData["Title"] = "Lead (Enquiry)";
    Layout = "_Layout";
}

<link href="/assets2/vendors/flatpickr/flatpickr.min.css" rel="stylesheet" />
<script src="/assets2/vendors/flatpickr/flatpickr.min.js"></script>

<!-- MAIN -->
<div class="content">
    <div class="pb-5">
        <div class="row g-4">
            <div class="col-12">
                <div class="mb-12">
                    <!-- Title + Buttons + Sort in same row -->
                    <div class="row align-items-center mb-2">

                        <!-- LEFT SIDE : TITLE -->
                        <div class="col-4">
                            <h4 class="mb-0 fw-bold text-warning">Lead Management (Enquiry)</h4>
                        </div>

                        <!-- RIGHT SIDE : BUTTONS + DROPDOWN + FILTERS -->
                        <div class="col-8">

                            <div class="d-flex justify-content-end align-items-center gap-2">

                                <!-- Add Process -->
                                <button class="btn btn-outline-primary btn-sm fw-bold py-1 px-2 d-none"
                                        data-bs-toggle="modal" data-bs-target="#processModal" id="btnProcess">
                                    + Process
                                </button>

                                <!-- Add Deal -->
                                <button class="btn btn-outline-warning btn-sm fw-bold py-1 px-2"
                                        data-bs-toggle="modal" data-bs-target="#dealModal">
                                    + Deal
                                </button>

                                <!-- Filters -->
                                <div class="dropdown">
                                    <button class="btn btn-outline-secondary btn-sm fw-bold py-1 px-2 dropdown-toggle"
                                            type="button"
                                            id="filterDropdown"
                                            data-bs-toggle="dropdown"
                                            data-bs-auto-close="outside">
                                        Filters
                                    </button>

                                    <div class="dropdown-menu p-3" style="width: 280px;">
        
                                        <!-- Duration -->
                                        <label class="form-label fw-semibold mb-1">Duration</label>
                                        <select class="form-select form-select-sm mb-2" id="ddlDuration">
                                            <option value="yesterday">Yesterday</option>
                                            <option value="last7days">Last 7 Days</option>
                                            <option value="last30days">Last 30 Days</option>
                                            <option value="thismonth" selected>This Month</option>
                                            <option value="lastmonth">Last Month</option>
                                            <option value="last12months">Last 12 Months</option>
                                            <option value="customrange">Custom Range</option>
                                        </select>

                                        <!-- Custom Date Range (Hidden by default) -->
                                        <div id="customDateRange" class="d-none">
                                            <label class="form-label mb-1">From Date</label>
                                            <input type="date" class="form-control form-control-sm mb-2" id="fromDate">

                                            <label class="form-label mb-1">To Date</label>
                                            <input type="date" class="form-control form-control-sm mb-2" id="toDate">
                                        </div>

                                        <!-- Amount Range -->
                                        <label class="form-label fw-semibold mb-1">Amount Range</label>
                                        <div class="d-flex gap-2 mb-2">
                                            <input type="number" class="form-control form-control-sm" id="fromAmount" placeholder="Min">
                                            <input type="number" class="form-control form-control-sm" id="toAmount" placeholder="Max">
                                        </div>

                                        <!-- Actions -->
                                        <div class="d-flex justify-content-end gap-2">
                                            <button class="btn btn-light btn-sm" id="btnResetFilters">Reset</button>
                                            <button class="btn btn-warning btn-sm fw-bold" id="btnApplyFilters">Apply</button>
                                        </div>
                                    </div>
                                </div>

                            </div>

                        </div>
                    </div>

                    <!-- Board -->
                    <div class="container-fluid py-3">
                        <div id="processBoard" class="process-board d-flex flex-row overflow-auto" style="gap: 1rem;">
                            <!-- Columns will be injected here dynamically -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Add Deal -->
<div class="modal fade" id="dealModal" tabindex="-1" aria-labelledby="dealModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <!-- extra wide modal -->
        <div class="modal-content">
            <div class="modal-header bg-warning py-1">
                <h5 class="modal-title text-white" id="dealModalLabel">Add Deal (Enquiry)</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="dealForm" class="row g-3">
                    <input type="hidden" id="dealId">

                    <!-- Row 1: Process / Stage, Name, Contact -->
                    <div class="col-md-4">
                        <label for="dealProcess" class="form-label">
                            Process / Stage <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <select id="dealProcess" class="form-select form-select-sm"></select>
                        </div>
                        <button type="button" class="btn btn-outline-primary d-none" id="openProcessModal">+</button>
                        <div class="text-danger small mt-1 error-msg d-none">Please select process</div>
                    </div>
                    <div class="col-md-6">
                        <label for="dealName" class="form-label">Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control form-control-sm" id="dealName" placeholder="Name" maxlength="100">
                        <div class="text-danger small mt-1 error-msg d-none">Please enter name</div>
                    </div>
                    <div class="col-md-2">
                        <label for="dealContact" class="form-label">Whatsapp No. <span class="text-danger">*</span></label>
                        <input type="text" class="form-control form-control-sm" id="dealContact" placeholder="1234567890" maxlength="10">
                        <div class="text-danger small mt-1 error-msg d-none">Please enter Whatsapp no.</div>
                    </div>

                    <!-- Row 2: Address, Email -->
                    <div class="col-md-6">
                        <label for="dealAddress" class="form-label">Address</label>
                        <textarea class="form-control form-control-sm" id="dealAddress" placeholder="address" maxlength="250"></textarea>
                    </div>
                    <div class="col-md-6">
                        <label for="dealEmail" class="form-label">Email</label>
                        <input type="email" class="form-control form-control-sm" id="dealEmail" placeholder="email id" maxlength="100">
                    </div>

                    <!-- Row 3: Event Type, Event Subtype, Banquet Hall-->
                    <div class="row">
                        <!-- Event Type -->
                        <div class="col-md-4">
                            <label for="eventTypeDropdown" class="form-label">
                                Event Type <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <select id="eventTypeDropdown" class="form-select form-select-sm">
                                    <option value="0">-- Select Event Type --</option>
                                </select>
                                <button type="button" class="btn btn-outline-primary btn-sm" id="openEventTypeModal">+</button>
                            </div>
                            <div class="text-danger small mt-1 error-msg d-none">Please select event type</div>
                        </div>

                        <!-- Event Sub-Type -->
                        <div class="col-md-4">
                            <label for="eventSubTypeDropdown" class="form-label">
                                Event Sub-Type <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <select id="eventSubTypeDropdown" class="form-select form-select-sm">
                                    <option value="0">-- Select Event Sub-Type --</option>
                                </select>
                                <button type="button" class="btn btn-outline-primary btn-sm" id="openEventSubTypeModal">+</button>
                            </div>
                            <div class="text-danger small mt-1 error-msg d-none">Please select event sub-type</div>
                        </div>

                        <!-- Banquet Hall -->
                        <div class="col-md-4">
                            <label for="banquetHallDropdown" class="form-label">
                                Banquet Hall <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <select id="banquetHallDropdown" class="form-select form-select-sm">
                                    <option value="0">-- Select Banquet Hall --</option>
                                </select>
                            </div>
                            <div class="text-danger small mt-1 error-msg d-none">Please select banquet hall</div>
                        </div>

                        <!-- Info Line -->
                        <div class="col-12">
                            <p class="text-muted small mt-1 mb-2">
                                <i class="fa fa-info-circle me-1 text-primary"></i>
                                <span class="text-primary">
                                    Select <strong>Event Type</strong> & <strong>Sub-Type</strong> carefully — this helps us deliver precise reports.
                                </span>
                            </p>
                        </div>
                    </div>

                    <!-- Row 4: Event Date, Start Time, End Time, Pax -->
                    <div class="col-md-2">
                        <label for="eventDate" class="form-label">Date Of Event <span class="text-danger">*</span></label>
                        <input class="form-control form-control-sm datetimepicker flatpickr-input" id="eventDate" type="text" placeholder="dd/mm/yyyy" data-options="{&quot;disableMobile&quot;:true,&quot;dateFormat&quot;:&quot;d/m/Y&quot;}" readonly="readonly">
                        <div class="text-danger small mt-1 error-msg d-none">Please enter date</div>
                        <div id="slotStatusMsg" class="small fw-semibold mt-2 d-none"></div>
                    </div>

                    <!-- START TIME FIELD -->
                    <div class="col-md-2 position-relative">
                        <label for="eventStart" class="form-label">
                            Start Time <span class="text-danger">*</span>
                        </label>
                        <input type="text" id="eventStart" class="form-control form-control-sm text-center" placeholder="Select Time" readonly>
                        <div class="text-danger small mt-1 error-msg d-none">Please select start time</div>

                        <!-- CLOCK PICKER -->
                        <div id="clockPicker" class="custom-clock-picker shadow-lg rounded-3 p-3 d-none">
                            <div class="text-center mb-3">
                                <span id="hourDisplay" class="fw-bold fs-3 text-primary clickable">12</span>
                                <span class="fs-3 text-dark">:</span>
                                <span id="minuteDisplay" class="fw-bold fs-3 text-dark clickable">00</span>
                            </div>

                            <!-- AM/PM toggle -->
                            <div class="d-flex justify-content-center mb-3">
                                <button type="button" id="amBtn" class="btn btn-outline-primary btn-action-xs me-2 active">AM</button>
                                <button type="button" id="pmBtn" class="btn btn-outline-primary btn-action-xs me-2">PM</button>
                                <button type="button" id="setTimeBtn" class="btn btn-outline-primary btn-action-xs">Set Time</button>
                            </div>

                            <!-- Clock face -->
                            <div class="clock-face mx-auto mb-3">
                                <div class="clock-hand hour-hand" id="hourHand"></div>
                                <div class="clock-hand minute-hand" id="minuteHand"></div>
                                <div class="center-dot"></div>

                                <!-- Hour numbers -->
                                <div class="clock-number" style="--i:1;">1</div>
                                <div class="clock-number" style="--i:2;">2</div>
                                <div class="clock-number" style="--i:3;">3</div>
                                <div class="clock-number" style="--i:4;">4</div>
                                <div class="clock-number" style="--i:5;">5</div>
                                <div class="clock-number" style="--i:6;">6</div>
                                <div class="clock-number" style="--i:7;">7</div>
                                <div class="clock-number" style="--i:8;">8</div>
                                <div class="clock-number" style="--i:9;">9</div>
                                <div class="clock-number" style="--i:10;">10</div>
                                <div class="clock-number" style="--i:11;">11</div>
                                <div class="clock-number" style="--i:12;">12</div>
                            </div>
                        </div>
                    </div>

                    <!-- END TIME FIELD -->
                    <div class="col-md-2 position-relative">
                        <label for="eventEnd" class="form-label">
                            End Time <span class="text-danger">*</span>
                        </label>
                        <input type="text" id="eventEnd" class="form-control form-control-sm text-center" placeholder="Select Time" readonly>
                        <div class="text-danger small mt-1 error-msg d-none">Please select end time</div>

                        <!-- CLOCK PICKER -->
                        <div id="clockPickerEnd" class="custom-clock-picker shadow-lg rounded-3 p-3 d-none">
                            <div class="text-center mb-3">
                                <span id="hourDisplayEnd" class="fw-bold fs-3 text-primary clickable">12</span>
                                <span class="fs-3 text-dark">:</span>
                                <span id="minuteDisplayEnd" class="fw-bold fs-3 text-dark clickable">00</span>
                            </div>

                            <!-- AM/PM toggle -->
                            <div class="d-flex justify-content-center mb-3">
                                <button id="amBtnEnd" type="button" class="btn btn-outline-primary btn-action-xs me-2 active">AM</button>
                                <button id="pmBtnEnd" type="button" class="btn btn-outline-primary btn-action-xs me-2">PM</button>
                                <button id="setTimeBtnEnd" type="button" class="btn btn-outline-primary btn-action-xs">Set Time</button>
                            </div>

                            <!-- Clock face -->
                            <div class="clock-face mx-auto mb-3">
                                <div class="clock-hand hour-hand" id="hourHandEnd"></div>
                                <div class="clock-hand minute-hand" id="minuteHandEnd"></div>
                                <div class="center-dot"></div>

                                <!-- Hour numbers -->
                                <div class="clock-number" style="--i:1;">1</div>
                                <div class="clock-number" style="--i:2;">2</div>
                                <div class="clock-number" style="--i:3;">3</div>
                                <div class="clock-number" style="--i:4;">4</div>
                                <div class="clock-number" style="--i:5;">5</div>
                                <div class="clock-number" style="--i:6;">6</div>
                                <div class="clock-number" style="--i:7;">7</div>
                                <div class="clock-number" style="--i:8;">8</div>
                                <div class="clock-number" style="--i:9;">9</div>
                                <div class="clock-number" style="--i:10;">10</div>
                                <div class="clock-number" style="--i:11;">11</div>
                                <div class="clock-number" style="--i:12;">12</div>
                            </div>
                        </div>
                    </div>

                    <!-- Row 5: Follow-up Date, Estimated Amount, Lead Source -->
                    <div class="col-md-2">
                        <label for="followUpDate" class="form-label">Follow-up Date</label>
                        <input class="form-control form-control-sm datetimepicker flatpickr-input" id="followUpDate" type="text" placeholder="dd/mm/yyyy" data-options="{&quot;disableMobile&quot;:true,&quot;dateFormat&quot;:&quot;d/m/Y&quot;}" readonly="readonly">
                    </div>

                    <!--Lead Source Dropdown-->
                    <div class="col-md-4">
                        <label for="leadSourceDropdown" class="form-label">Lead Source <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <select id="leadSourceDropdown" class="form-select form-select-sm">
                                <option value="0">-- Select Lead Source --</option>
                            </select>
                            <button type="button" class="btn btn-outline-primary btn-sm" id="openLeadSourceModal">+</button>
                        </div>
                        <div class="text-danger small mt-1 error-msg d-none">Please select lead source</div>
                        <!-- ℹ️ Info Line -->
                        <p class="text-muted small mt-1 mb-2">
                            <i class="fa fa-info-circle me-1 text-primary"></i>
                            <span class="text-primary">
                                Please select proper <strong>Lead Source</strong> to ensure accurate reports for Future Insights.
                            </span>
                        </p>
                    </div>

                    <!--pax-->
                    <div class="col-md-2">
                        <label for="pax" class="form-label">Pax <span class="text-danger">*</span></label>
                        <input type="number" class="form-control form-control-sm" id="pax" placeholder="pax" min="0" step="1">
                        <div class="text-danger small mt-1 error-msg d-none">Please enter Pax</div>
                    </div>

                    <!-- Estimated Package Amount -->
                    <div class="col-md-3">
                        <label for="packageAmount" class="form-label">
                            Estimated Package Amount <span class="text-danger">*</span>
                        </label>
                        <input type="number" class="form-control form-control-sm" id="packageAmount" placeholder="Per Pax Amount" step="1" min="0">
                        <div class="text-danger small mt-1 error-msg d-none">Please enter valid Package Amount</div>
                    </div>

                    <!--Estimated Amount-->
                    <div class="col-md-3">
                        <label for="estimatedAmount" class="form-label">Estimated Amount <span class="text-danger">*</span></label>
                        <input type="number" class="form-control form-control-sm" id="estimatedAmount" placeholder="amount" value="0" step="1" min="0">
                        <div class="text-danger small mt-1 error-msg d-none">Please enter valid Amount</div>

                        <!-- ℹ️ Info Line -->
                        <p class="text-muted small mt-1 mb-2">
                            <i class="fa fa-info-circle me-1 text-primary"></i>
                            <span class="text-primary">
                                For Accurate reporting, Enter the <strong>Estimated Bill Amount</strong> as per PAX & Interested Package of the Guest.
                            </span>
                        </p>
                    </div>

                    <!-- Row 6: Remarks -->
                    <div class="col-md-4">
                        <label for="remark" class="form-label">Remarks / Notes</label>
                        <textarea class="form-control form-control-sm" id="remark" rows="2" placeholder="Remarks"></textarea>
                    </div>

                    <!-- Submit -->
                    <div class="col-md-12 text-end">
                        <button type="button" class="btn btn-action-xs btn-outline-danger d-none" id="deleteDealBtn">
                            <i class="fa fa-trash"></i> Delete
                        </button>
                        <button type="submit" class="btn btn-action-xs btn-outline-warning" id="saveDealBtn">
                            <i class="fa fa-save"></i> Save Enquiry
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Follow-Up Modal -->
<div class="modal fade" id="followupModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header bg-warning py-1">
                <h5 class="modal-title text-white fw-semibold d-flex align-items-center gap-2">
                    Follow-Up
                    <span class="badge bg-light text-dark fw-normal px-2 py-1" style="font-size: 0.75rem;">
                        (Optional) Skip If not needed
                    </span>
                </h5>

                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <input type="hidden" id="hfEnquiryDealId" />
                <input type="hidden" id="hfFollowUpId" value="0">

                <!-- SECTION 1 : enquiry DETAILS (Display Only) -->
                <div class="small mb-2 border p-2 shadow-sm rounded" id="enquiryDetails">

                    <!-- Row 1 -->
                    <div class="row mb-1">

                        <!-- Long Field -->
                        <div class="col-md-5">
                            <span class="text-secondary fw-semibold">Enquirer:</span>
                            <span class="fw-bold" id="inqName"></span>
                        </div>

                        <!-- Short Field -->
                        <div class="col-md-2">
                            <span class="text-secondary fw-semibold">Contact:</span>
                            <span class="fw-bold" id="inqContact"></span>
                        </div>

                        <!-- Short Field -->
                        <div class="col-md-1">
                            <span class="text-secondary fw-semibold">Slot:</span>
                            <span class="fw-bold" id="inqSlot"></span>
                        </div>

                        <!-- Short Field -->
                        <div class="col-md-1">
                            <span class="text-secondary fw-semibold">Pax:</span>
                            <span class="fw-bold" id="inqPax"></span>
                        </div>

                        <!-- Long Field -->
                        <div class="col-md-3">
                            <span class="text-secondary fw-semibold">Event:</span>
                            <span class="fw-bold" id="inqEvent"></span>
                        </div>
                    </div>

                    <!-- Row 2 -->
                    <div class="row mb-1">

                        <div class="col-md-5">
                            <span class="text-secondary fw-semibold">Event Date:</span>
                            <span class="fw-bold" id="inqEventDate"></span>
                        </div>

                        <div class="col-md-3">
                            <span class="text-secondary fw-semibold">Halls:</span>
                            <span class="fw-bold" id="inqHalls"></span>
                        </div>

                        <div class="col-md-4">
                            <span class="text-secondary fw-semibold">Email:</span>
                            <span class="fw-bold" id="inqEmail"></span>
                        </div>

                        <div class="col-md-5">
                            <span class="text-secondary fw-semibold">Address:</span>
                            <span class="fw-bold" id="inqAddress"></span>
                        </div>

                        <div class="col-md-6">
                            <span class="text-secondary fw-semibold">Note:</span>
                            <span class="fw-bold" id="inqNote"></span>
                        </div>
                    </div>

                </div>

                <!-- SECTION 2: Follow-Up Form -->
                <div class="mb-2 pb-2 border-bottom">
                    <div class="row g-2">

                        <div class="col-2">
                            <label class="form-label">Type</label>
                            <select class="form-select form-select-sm" id="ddlFollowUpType"></select>
                        </div>

                        <div class="col-2">
                            <label class="form-label">Status</label>
                            <select class="form-select form-select-sm" id="ddlStatus"></select>
                        </div>

                        <div class="col-2">
                            <label class="form-label">Mood</label>
                            <select class="form-select form-select-sm" id="ddlMood"></select>
                        </div>

                        <div class="col-4">
                            <label class="form-label">Next Follow-Up</label>

                            <div class="row g-1">
                                <div class="col-6">
                                    <input type="date" class="form-control form-control-sm" id="nextFollowUpDate_modalFollowup">
                                </div>

                                <div class="col-4">
                                    <select class="form-select form-select-sm" id="nextFollowUpTime_modalFollowup"></select>
                                </div>
                            </div>

                            <!-- Hidden field storing final datetime in ISO format -->
                            <input type="hidden" id="txtNextFollowUpDateTime">
                        </div>

                        <div class="col-2">
                            <label class="form-label">Probability (%)</label>
                            <input type="number" class="form-control form-control-sm" id="txtProbability" min="0" max="100">
                        </div>

                        <div class="col-6">
                            <label class="form-label">Discussion Notes</label>
                            <textarea class="form-control form-control-sm" id="txtDiscussionNotes" rows="7"></textarea>
                        </div>

                        <div class="col-6">
                            <label for="attachment" class="form-label">Attachment (Optional)</label>
                            <div id="attachmentDropzone_followUp" class="border border-2 border-dashed rounded p-1 text-center bg-light" style="cursor: pointer;">
                                <i class="fa fa-cloud-upload fa-2x mb-0 text-primary"></i>
                                <p class="mb-0 fw-semibold">Drop file here or Click to upload</p>
                                <p class="small text-muted mb-0">Allowed: Images, Videos, PDF, DOC, Excel, PPT, Text</p>
                                <p class="small text-muted">Max Size: 5 MB</p>
                                <input type="file" id="attachment_followUp" class="d-none"
                                       accept=".jpg,.jpeg,.png,.gif,.mp4,.mov,.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt">
                            </div>
                            <input type="hidden" id="attachmentBase64_followUp">
                        </div>
                    </div>

                    <div class="text-end mt-2">
                        <button class="btn btn-outline-warning btn-sm px-3" id="btnSaveFollowUp">
                            Save Follow-Up
                        </button>
                    </div>
                </div>

                <!-- SECTION 3: Follow-Up History Table -->
                <h6 class="fw-bold mb-2">Previous Follow-Ups</h6>

                <div id="followupHistoryWrapper">
                    <table class="table table-sm table-bordered mb-0" id="followupHistoryTable">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Date</th>
                                <th>Type</th>
                                <th>Status</th>
                                <th>Mood</th>
                                <th>Next Date</th>
                                <th>Notes</th>
                                <th>Assigned</th>
                                <th>Probability</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody id="followupHistoryBody">
                            <!-- Dynamic rows inserted via JS -->
                        </tbody>
                    </table>
                </div>

            </div>

            <div class="modal-footer py-1">
                <button type="button" class="btn btn-secondary btn-sm d-none" data-bs-dismiss="modal">Close</button>
            </div>

        </div>
    </div>
</div>

<!-- Modal: Event Type Master -->
<div class="modal fade" id="eventTypeModal" tabindex="-1" aria-labelledby="eventTypeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <!-- Large modal -->
        <div class="modal-content">
            <div class="modal-header bg-warning py-1">
                <h5 class="modal-title text-white" id="eventTypeModalLabel">Event Type Master</h5>
