<script>
    let attachmentBase64 = "";
    const dropzone = document.getElementById("attachmentDropzone");
    const fileInput = document.getElementById("attachment");
    const hiddenBase64 = document.getElementById("attachmentBase64_enquiryMove");

    // When user clicks dropzone, open file picker
    dropzone.addEventListener("click", () => fileInput.click());

    // Dragging over
    dropzone.addEventListener("dragover", (e) => {
        e.preventDefault();
        dropzone.classList.add("bg-primary", "text-white");
    });

    // Leaving drop area
    dropzone.addEventListener("dragleave", () => {
        dropzone.classList.remove("bg-primary", "text-white");
    });

    // When file dropped
    dropzone.addEventListener("drop", (e) => {
        e.preventDefault();
        dropzone.classList.remove("bg-primary", "text-white");
        const file = e.dataTransfer.files[0];
        handleFile(file);
    });

    // When file selected manually
    fileInput.addEventListener("change", () => {
        const file = fileInput.files[0];
        handleFile(file);
    });

    // Convert to Base64
    function handleFile(file) {
    if (!file) return;

    // Validate file size (max 5 MB)
    if (file.size > 5 * 1024 * 1024) {
        alert("File size exceeds 5 MB limit!");
        fileInput.value = "";
        attachmentBase64 = "";
        hiddenBase64.value = "";
        return;
    }

    const reader = new FileReader();
    reader.onload = function (e) {
        //attachmentBase64 = e.target.result; // base64 string (with data: prefix)
        attachmentBase64 = e.target.result.split(',')[1];
        hiddenBase64.value = attachmentBase64;
        dropzone.querySelector("p.fw-semibold").innerText = `Selected: ${file.name}`;
    };
    reader.readAsDataURL(file);
}

</script>
