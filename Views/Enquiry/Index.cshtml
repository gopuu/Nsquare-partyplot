@{
    ViewData["Title"] = "Enquiry";
    Layout = "_Layout";
}

<link href="/assets2/vendors/flatpickr/flatpickr.min.css" rel="stylesheet" />
<script src="/assets2/vendors/flatpickr/flatpickr.min.js"></script>

<style> 
    .picker-transition {
        transition: opacity 0.3s ease, transform 0.3s ease;
        opacity: 1;
    }

    .picker-hide {
        opacity: 0;
        transform: translateY(-5px); /* subtle move */
    }
.process-board {
    display: grid;
    grid-template-columns: repeat(6, 1fr); /* exactly 6 equal columns */
    gap: 15px;
}

.process-column {
    width: 100%; 
}
.followup-row {
    cursor: pointer;
    border-top: 1px solid #eee;
}
.followup-row:hover {
    background-color: #f6f6f6;
}

</style>

<!-- MAIN -->
<div class="content">
    <div class="pb-5">
        <div class="row g-4">
            <div class="col-12">
                <div class="mb-12">
                    <!-- Title + Buttons + Sort in same row -->
                    <div class="row align-items-center mb-2">

                        <!-- LEFT SIDE : TITLE -->
                        <div class="col-4">
                            <h4 class="mb-0 fw-semibold">Enquiry / Lead Management</h4>
                        </div>

                        <!-- RIGHT SIDE : BUTTONS + DROPDOWN + FILTERS -->
                        <div class="col-8">

                            <div class="d-flex justify-content-end align-items-center gap-2">

                                <!-- Add Process -->
                                <button class="btn btn-outline-primary btn-sm fw-bold py-1 px-2 d-none"
                                        data-bs-toggle="modal" data-bs-target="#processModal" id="btnProcess">
                                    + Process
                                </button>

                                <!-- Add Deal -->
                                <button class="btn btn-outline-warning btn-sm fw-bold py-1 px-2"
                                        data-bs-toggle="modal" data-bs-target="#dealModal">
                                    + Deal
                                </button>

                                <!-- Sort Dropdown -->
                                <div class="dropdown">
                                    <button class="btn btn-outline-secondary btn-sm fw-bold py-1 px-2 dropdown-toggle"
                                            type="button" id="sortByDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                        Sort By: This Month
                                    </button>
                                    <ul class="dropdown-menu" aria-labelledby="sortByDropdown">
                                        <li><a class="dropdown-item sort-option" data-value="today" href="#">Today</a></li>
                                        <li><a class="dropdown-item sort-option" data-value="week" href="#">This Week</a></li>
                                        <li><a class="dropdown-item sort-option active" data-value="month" href="#">This Month</a></li>
                                        <li><a class="dropdown-item sort-option" data-value="year" href="#">This Year</a></li>
                                    </ul>
                                </div>

                                <!-- Amount Filters -->
                                ₹ <input type="number" class="form-control form-control-sm"
                                       style="width: 110px;" id="fromAmount" placeholder="Min Amt">

                                <input type="number" class="form-control form-control-sm"
                                       style="width: 110px;" id="toAmount" placeholder="Max Amt">

                                <!-- Reset Filters -->
                                <button class="btn btn-outline-secondary btn-sm fw-bold py-1 px-2" id="btnResetFilters">
                                    Reset
                                </button>

                            </div>

                        </div>
                    </div>

                    <!-- Board -->
                    <div class="container-fluid py-3">
                        <div id="processBoard" class="process-board d-flex flex-row overflow-auto" style="gap: 1rem;">
                            <!-- Columns will be injected here dynamically -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- Modal: Add Deal -->
<div class="modal fade" id="dealModal" tabindex="-1" aria-labelledby="dealModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <!-- extra wide modal -->
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title text-white" id="dealModalLabel">Add Enquiry / Deal</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="dealForm" class="row g-3">
                    <input type="hidden" id="dealId">

                    <!-- Row 1: Process / Stage, Name, Contact -->
                    <div class="col-md-4">
                        <label for="dealProcess" class="form-label">
                            Process / Stage <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <select id="dealProcess" class="form-select"></select>
                        </div>
                        <button type="button" class="btn btn-outline-primary d-none" id="openProcessModal">+</button>
                        <div class="text-danger small mt-1 error-msg d-none">Please select process</div>
                    </div>
                    <div class="col-md-4">
                        <label for="dealName" class="form-label">Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="dealName" placeholder="Name" maxlength="100">
                        <div class="text-danger small mt-1 error-msg d-none">Please enter name</div>
                    </div>
                    <div class="col-md-4">
                        <label for="dealContact" class="form-label">Contact <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="dealContact" placeholder="1234567890" maxlength="10">
                        <div class="text-danger small mt-1 error-msg d-none">Please enter contact no.</div>
                    </div>

                    <!-- Row 2: Address, Email -->
                    <div class="col-md-6">
                        <label for="dealAddress" class="form-label">Address</label>
                        <textarea class="form-control" id="dealAddress" placeholder="address" maxlength="250"></textarea>
                    </div>
                    <div class="col-md-6">
                        <label for="dealEmail" class="form-label">Email</label>
                        <input type="email" class="form-control" id="dealEmail" placeholder="email id" maxlength="100">
                    </div>

                    <!-- Row 3: Event Type, Event Subtype, Banquet Hall-->
                    <div class="row">
                        <!-- Event Type -->
                        <div class="col-md-4">
                            <label for="eventTypeDropdown" class="form-label">
                                Event Type <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <select id="eventTypeDropdown" class="form-select">
                                    <option value="0">-- Select Event Type --</option>
                                </select>
                                <button type="button" class="btn btn-outline-primary" id="openEventTypeModal">+</button>
                            </div>
                            <div class="text-danger small mt-1 error-msg d-none">Please select event type</div>
                        </div>

                        <!-- Event Sub-Type -->
                        <div class="col-md-4">
                            <label for="eventSubTypeDropdown" class="form-label">
                                Event Sub-Type <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <select id="eventSubTypeDropdown" class="form-select">
                                    <option value="0">-- Select Event Sub-Type --</option>
                                </select>
                                <button type="button" class="btn btn-outline-primary" id="openEventSubTypeModal">+</button>
                            </div>
                            <div class="text-danger small mt-1 error-msg d-none">Please select event sub-type</div>
                        </div>

                        <!-- Banquet Hall -->
                        <div class="col-md-4">
                            <label for="banquetHallDropdown" class="form-label">
                                Banquet Hall <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <select id="banquetHallDropdown" class="form-select">
                                    <option value="0">-- Select Banquet Hall --</option>
                                </select>
                            </div>
                            <div class="text-danger small mt-1 error-msg d-none">Please select banquet hall</div>
                        </div>

                        <!-- Info Line -->
                        <div class="col-12">
                            <p class="text-muted small mt-1 mb-2">
                                <i class="fa fa-info-circle me-1 text-primary"></i>
                                <span class="text-primary">
                                    Select <strong>Event Type</strong> & <strong>Sub-Type</strong> carefully — this helps us deliver precise reports.
                                </span>
                            </p>
                        </div>
                    </div>

                    <!-- Row 4: Event Date, Start Time, End Time, Pax -->
                    <div class="col-md-4">
                        <label for="eventDate" class="form-label">Date Of Event <span class="text-danger">*</span></label>
                        <input class="form-control datetimepicker flatpickr-input" id="eventDate" type="text" placeholder="dd/mm/yyyy" data-options="{&quot;disableMobile&quot;:true,&quot;dateFormat&quot;:&quot;d/m/Y&quot;}" readonly="readonly">
                        <div class="text-danger small mt-1 error-msg d-none">Please enter date</div>
                    </div>

                    <!-- START TIME FIELD -->
                    <div class="col-md-2 position-relative">
                        <label for="eventStart" class="form-label">
                            Start Time <span class="text-danger">*</span>
                        </label>
                        <input type="text" id="eventStart" class="form-control text-center" placeholder="Select Time" readonly>
                        <div class="text-danger small mt-1 error-msg d-none">Please select start time</div>

                        <!-- CLOCK PICKER -->
                        <div id="clockPicker" class="custom-clock-picker shadow-lg rounded-3 p-3 d-none">
                            <div class="text-center mb-3">
                                <span id="hourDisplay" class="fw-bold fs-3 text-primary clickable">12</span>
                                <span class="fs-3 text-dark">:</span>
                                <span id="minuteDisplay" class="fw-bold fs-3 text-dark clickable">00</span>
                            </div>

                            <!-- AM/PM toggle -->
                            <div class="d-flex justify-content-center mb-3">
                                <button type="button" id="amBtn" class="btn btn-outline-primary btn-action-xs me-2 active">AM</button>
                                <button type="button" id="pmBtn" class="btn btn-outline-primary btn-action-xs me-2">PM</button>
                                <button type="button" id="setTimeBtn" class="btn btn-outline-primary btn-action-xs">Set Time</button>
                            </div>

                            <!-- Clock face -->
                            <div class="clock-face mx-auto mb-3">
                                <div class="clock-hand hour-hand" id="hourHand"></div>
                                <div class="clock-hand minute-hand" id="minuteHand"></div>
                                <div class="center-dot"></div>

                                <!-- Hour numbers -->
                                <div class="clock-number" style="--i:1;">1</div>
                                <div class="clock-number" style="--i:2;">2</div>
                                <div class="clock-number" style="--i:3;">3</div>
                                <div class="clock-number" style="--i:4;">4</div>
                                <div class="clock-number" style="--i:5;">5</div>
                                <div class="clock-number" style="--i:6;">6</div>
                                <div class="clock-number" style="--i:7;">7</div>
                                <div class="clock-number" style="--i:8;">8</div>
                                <div class="clock-number" style="--i:9;">9</div>
                                <div class="clock-number" style="--i:10;">10</div>
                                <div class="clock-number" style="--i:11;">11</div>
                                <div class="clock-number" style="--i:12;">12</div>
                            </div>
                        </div>
                    </div>

                    <!-- END TIME FIELD -->
                    <div class="col-md-2 position-relative">
                        <label for="eventEnd" class="form-label">
                            End Time <span class="text-danger">*</span>
                        </label>
                        <input type="text" id="eventEnd" class="form-control text-center" placeholder="Select Time" readonly>
                        <div class="text-danger small mt-1 error-msg d-none">Please select end time</div>

                        <!-- CLOCK PICKER -->
                        <div id="clockPickerEnd" class="custom-clock-picker shadow-lg rounded-3 p-3 d-none">
                            <div class="text-center mb-3">
                                <span id="hourDisplayEnd" class="fw-bold fs-3 text-primary clickable">12</span>
                                <span class="fs-3 text-dark">:</span>
                                <span id="minuteDisplayEnd" class="fw-bold fs-3 text-dark clickable">00</span>
                            </div>

                            <!-- AM/PM toggle -->
                            <div class="d-flex justify-content-center mb-3">
                                <button id="amBtnEnd" type="button" class="btn btn-outline-primary btn-action-xs me-2 active">AM</button>
                                <button id="pmBtnEnd" type="button" class="btn btn-outline-primary btn-action-xs me-2">PM</button>
                                <button id="setTimeBtnEnd" type="button" class="btn btn-outline-primary btn-action-xs">Set Time</button>
                            </div>

                            <!-- Clock face -->
                            <div class="clock-face mx-auto mb-3">
                                <div class="clock-hand hour-hand" id="hourHandEnd"></div>
                                <div class="clock-hand minute-hand" id="minuteHandEnd"></div>
                                <div class="center-dot"></div>

                                <!-- Hour numbers -->
                                <div class="clock-number" style="--i:1;">1</div>
                                <div class="clock-number" style="--i:2;">2</div>
                                <div class="clock-number" style="--i:3;">3</div>
                                <div class="clock-number" style="--i:4;">4</div>
                                <div class="clock-number" style="--i:5;">5</div>
                                <div class="clock-number" style="--i:6;">6</div>
                                <div class="clock-number" style="--i:7;">7</div>
                                <div class="clock-number" style="--i:8;">8</div>
                                <div class="clock-number" style="--i:9;">9</div>
                                <div class="clock-number" style="--i:10;">10</div>
                                <div class="clock-number" style="--i:11;">11</div>
                                <div class="clock-number" style="--i:12;">12</div>
                            </div>
                        </div>
                    </div>

                    <!--pax-->
                    <div class="col-md-4">
                        <label for="pax" class="form-label">Pax <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" id="pax" placeholder="pax" maxlength="50">
                        <div class="text-danger small mt-1 error-msg d-none">Please enter Pax</div>
                    </div>

                    <!-- Row 5: Follow-up Date, Estimated Amount, Lead Source -->
                    <div class="col-md-4">
                        <label for="followUpDate" class="form-label">Follow-up Date</label>
                        <input class="form-control datetimepicker flatpickr-input" id="followUpDate" type="text" placeholder="dd/mm/yyyy" data-options="{&quot;disableMobile&quot;:true,&quot;dateFormat&quot;:&quot;d/m/Y&quot;}" readonly="readonly">
                    </div>
                    <div class="col-md-4">
                        <label for="estimatedAmount" class="form-label">Estimated Amount <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" id="estimatedAmount" placeholder="amount" value="0" step="0.01" min="0">
                        <div class="text-danger small mt-1 error-msg d-none">Please enter valid Amount</div>
                        <!-- ℹ️ Info Line -->
                        <p class="text-muted small mt-1 mb-2">
                            <i class="fa fa-info-circle me-1 text-primary"></i>
                            <span class="text-primary">
                                For Accurate reporting, Enter the <strong>Estimated Bill Amount</strong> as per PAX & Interested Package of the Guest.
                            </span>
                        </p>
                    </div>
                    <div class="col-md-4">
                        <label for="leadSourceDropdown" class="form-label">Lead Source <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <select id="leadSourceDropdown" class="form-select">
                                <option value="0">-- Select Lead Source --</option>
                            </select>
                            <button type="button" class="btn btn-outline-primary" id="openLeadSourceModal">+</button>
                        </div>
                        <div class="text-danger small mt-1 error-msg d-none">Please select lead source</div>
                        <!-- ℹ️ Info Line -->
                        <p class="text-muted small mt-1 mb-2">
                            <i class="fa fa-info-circle me-1 text-primary"></i>
                            <span class="text-primary">
                                Please select proper <strong>Lead Source</strong> to ensure accurate reports for Future Insights.
                            </span>
                        </p>
                    </div>

                    <!-- Row 6: Remarks -->
                    <div class="col-12">
                        <label for="remark" class="form-label">Remarks / Notes</label>
                        <textarea class="form-control" id="remark" rows="2" placeholder="Remarks"></textarea>
                    </div>

                    <!-- Submit -->
                    <div class="col-12 text-end">
                        <button type="button" class="btn btn-action-xs btn-outline-danger d-none" id="deleteDealBtn">
                            <i class="fa fa-trash"></i> Delete
                        </button>
                        <button type="submit" class="btn btn-action-xs btn-outline-warning" id="saveDealBtn">
                            <i class="fa fa-save"></i> Save Enquiry
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- 🗓️ Move - Deal Modal -->
<div class="modal fade" id="moveDealModal" tabindex="-1" aria-labelledby="moveDealModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title text-white" id="moveDealModalLabel">
                    Add Lead Followup
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <form id="moveDealForm">
                    <div class="row mb-3">
                        <!-- FOLLOW-UP DATE -->
                        <div class="col-md-6 position-relative">
                            <label for="nextFollowUpDate" class="form-label">
                                Next Follow-Up Date <span class="text-danger">*</span>
                            </label>
                            <input type="date" id="nextFollowUpDate" class="form-control text-center" placeholder="Select Date">
                            <div class="text-danger small mt-1 error-msg d-none">Please select a date</div>
                        </div>

                        <!-- FOLLOW-UP TIME -->
                        <div class="col-md-6 position-relative">
                            <label for="nextFollowUpTime" class="form-label">
                                Next Follow-Up Time <span class="text-danger">*</span>
                            </label>
                            <input type="text" id="nextFollowUpTime" class="form-control text-center" placeholder="Select Time" readonly>
                            <div class="text-danger small mt-1 error-msg d-none">Please select time</div>

                            <!-- CLOCK PICKER -->
                            <div id="clockPickerFollowUp" class="custom-clock-picker shadow-lg rounded-3 p-3 d-none">
                                <div class="text-center mb-3">
                                    <span id="hourDisplayFollowUp" class="fw-bold fs-3 text-primary clickable">12</span>
                                    <span class="fs-3 text-dark">:</span>
                                    <span id="minuteDisplayFollowUp" class="fw-bold fs-3 text-dark clickable">00</span>
                                </div>

                                <!-- AM/PM Toggle -->
                                <div class="d-flex justify-content-center mb-3">
                                    <button type="button" id="amBtnFollowUp" class="btn btn-outline-primary btn-action-xs me-2 active">AM</button>
                                    <button type="button" id="pmBtnFollowUp" class="btn btn-outline-primary btn-action-xs me-2">PM</button>
                                    <button type="button" id="setTimeBtnFollowUp" class="btn btn-outline-primary btn-action-xs">Set Time</button>
                                </div>

                                <!-- Clock Face -->
                                <div class="clock-face mx-auto mb-3">
                                    <div class="clock-hand hour-hand" id="hourHandFollowUp"></div>
                                    <div class="clock-hand minute-hand" id="minuteHandFollowUp"></div>
                                    <div class="center-dot"></div>

                                    <!-- Hour numbers -->
                                    <div class="clock-number" style="--i:1;">1</div>
                                    <div class="clock-number" style="--i:2;">2</div>
                                    <div class="clock-number" style="--i:3;">3</div>
                                    <div class="clock-number" style="--i:4;">4</div>
                                    <div class="clock-number" style="--i:5;">5</div>
                                    <div class="clock-number" style="--i:6;">6</div>
                                    <div class="clock-number" style="--i:7;">7</div>
                                    <div class="clock-number" style="--i:8;">8</div>
                                    <div class="clock-number" style="--i:9;">9</div>
                                    <div class="clock-number" style="--i:10;">10</div>
                                    <div class="clock-number" style="--i:11;">11</div>
                                    <div class="clock-number" style="--i:12;">12</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="remarks" class="form-label">Comments / Remarks</label>
                        <textarea class="form-control" id="remarks" rows="3" placeholder="Enter remarks"></textarea>
                    </div>
                    <!-- Attachment (Optional) -->
                    <div class="mb-3">
                        <label for="attachment" class="form-label">Attachment (Optional)</label>
                        <div id="attachmentDropzone" class="border border-2 border-dashed rounded p-4 text-center bg-light" style="cursor: pointer;">
                            <i class="fa fa-cloud-upload fa-2x mb-2 text-primary"></i>
                            <p class="mb-1 fw-semibold">Drop file here or Click to upload</p>
                            <p class="small text-muted mb-0">Allowed: Images, Videos, PDF, DOC, Excel, PPT, Text</p>
                            <p class="small text-muted">Max Size: 5 MB</p>
                            <input type="file" id="attachment" class="d-none"
                                   accept=".jpg,.jpeg,.png,.gif,.mp4,.mov,.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt">
                        </div>
                        <input type="hidden" id="attachmentBase64_enquiryMove">
                    </div>
                </form>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="saveMoveDealBtn" class="btn btn-outline-warning">Save & Move</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Follow up modal-->
<!-- Follow-Up Modal -->
<style>
    #followupModal .text-secondary {
        font-weight: 600;
        color: #6c757d !important;
    }

    #followupModal span {
        font-size: 14px;
    }

    /* Compact modal UI */
    #followupModal .modal-body,
    #followupModal .modal-header,
    #followupModal .modal-footer {
        padding: 10px 15px;
    }

    #followupModal .form-label {
        font-size: 0.75rem;
        margin-bottom: 2px;
        font-weight: 600;
    }

    #followupModal .form-control,
    #followupModal .form-select {
        padding: 3px 6px !important;
        font-size: 0.78rem !important;
        height: 28px;
    }

    #txtDiscussionNotes {
        height: 120px !important; /* or any height you want */
        padding: 6px !important;
        line-height: 1.3;
        resize: vertical;          /* allow user to expand */
    }


    #followupHistoryTable th,
    #followupHistoryTable td {
        font-size: 0.75rem !important;
        padding: 4px 6px !important;
    }

    #followupHistoryWrapper {
        max-height: 250px;
        overflow-y: auto;
        border: 1px solid #eee;
        border-radius: 4px;
    }
</style>
<!-- Follow-Up Modal -->
<div class="modal fade" id="followupModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header bg-warning py-2">
                <h6 class="modal-title text-white">Follow-Up</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <input type="hidden" id="hfEnquiryDealId" />
                <input type="hidden" id="hfFollowUpId" value="0">

                <!-- SECTION 1 : enquiry DETAILS (Display Only) -->
                <div class="small mb-2 border p-2 shadow-sm rounded" id="enquiryDetails">

                    <!-- Row 1 -->
                    <div class="row mb-1">

                        <!-- Long Field -->
                        <div class="col-md-5">
                            <span class="text-secondary fw-semibold">Enquirer:</span>
                            <span class="fw-bold" id="inqName"></span>
                        </div>

                        <!-- Short Field -->
                        <div class="col-md-2">
                            <span class="text-secondary fw-semibold">Contact:</span>
                            <span id="inqContact"></span>
                        </div>

                        <!-- Short Field -->
                        <div class="col-md-1">
                            <span class="text-secondary fw-semibold">Slot:</span>
                            <span id="inqSlot"></span>
                        </div>

                        <!-- Short Field -->
                        <div class="col-md-1">
                            <span class="text-secondary fw-semibold">Pax:</span>
                            <span id="inqPax"></span>
                        </div>

                        <!-- Long Field -->
                        <div class="col-md-3">
                            <span class="text-secondary fw-semibold">Event:</span>
                            <span id="inqEvent"></span>
                        </div>
                    </div>

                    <!-- Row 2 -->
                    <div class="row mb-1">

                        <div class="col-md-5">
                            <span class="text-secondary fw-semibold">Event Date:</span>
                            <span id="inqEventDate"></span>
                        </div>

                        <div class="col-md-3">
                            <span class="text-secondary fw-semibold">Halls:</span>
