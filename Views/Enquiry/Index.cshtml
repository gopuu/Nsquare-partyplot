            if (!nextFollowUpInput) return true;

            const nextFollowUpDate = new Date(nextFollowUpInput);

            // Invalid date
            if (isNaN(nextFollowUpDate.getTime())) {
                Swal.fire("Invalid Date", "Please enter a valid next follow-up date & time.", "error");
