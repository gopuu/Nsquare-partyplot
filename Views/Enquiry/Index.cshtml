<style>
    .custom-clock-picker {
        position: absolute;
        top: 100%;
        left: 0;
        width: 230px;
        background: #fff;
        z-index: 10;
        transform: translateY(8px);
    }

    .clock-face {
        position: relative;
        width: 180px;
        height: 180px;
        border-radius: 50%;
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        margin: 0 auto;
    }

    .clock-number {
        position: absolute;
        width: 32px;
        height: 32px;
        text-align: center;
        line-height: 32px;
        font-weight: 500;
        color: #333;
        cursor: pointer;
        transition: 0.2s ease;
        top: 42%;
        left: 40%;
        transform: rotate(calc(30deg * var(--i))) translateY(-70px) rotate(calc(-30deg * var(--i)));
    }

        .clock-number:hover {
            color: #0d6efd;
            font-weight: 600;
        }

    .clock-hand {
        position: absolute;
        left: 50%;
        transform-origin: bottom center;
        transition: 0.3s ease;
    }

    .hour-hand {
        top: 50px;
        height: 40px;
        width: 3px;
        background-color: #6c757d;
    }

    .minute-hand {
        top: 30px;
        height: 60px;
        width: 2px;
        background-color: #6c757d;
    }

    .active-hand {
        background-color: #0d6efd !important;
        box-shadow: 0 0 10px rgba(13, 110, 253, 0.6);
    }

    .center-dot {
        position: absolute;
        width: 10px;
        height: 10px;
        background: #0d6efd;
        border-radius: 50%;
        top: 85px;
        left: 85px;
    }

    .btn.active {
        background-color: #0d6efd !important;
        color: #fff !important;
    }

    #clockPicker::before {
        content: "";
        position: absolute;
        top: -7px;
        left: 25px;
