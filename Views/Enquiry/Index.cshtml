                                <div class="col-md-6 d-none">
                                    <label>Cheque Bank</label>
                                    <input type="text" class="form-control form-control-sm" value="" id="PaymentDetails_ChequeBank" maxlength="100">
                                </div>

                                <div class="col-md-6 d-none">
                                    <label>Cheque No.</label>
                                    <input type="text" class="form-control form-control-sm" value="" id="PaymentDetails_ChequeNo" maxlength="20">
                                </div>

                                <div class="col-md-6 d-none">
                                    <label>Cheque Date</label>
                                    <input type="date" class="form-control form-control-sm" id="PaymentDetails_ChequeDate" value="">
                                </div>

                                <div class="col-md-6">
                                    <label>Due Date</label>
                                    <input type="date" class="form-control form-control-sm" id="PaymentDetails_DueDate" value="">
                                </div>

                                <div class="col-12">
                                    <label>Payment Note</label>
                                    <textarea class="form-control form-control-sm" id="PaymentDetails_PaymentNote"></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>

            <div class="modal-footer d-flex justify-content-between align-items-center">
                <!-- Booking Type & Agent Checkbox-->
                <!-- LEFT SIDE -->
                <div class="d-flex align-items-center gap-3">
                    <!-- Booking Type -->
                    <div class="d-flex flex-column">
                        <label class="form-label mb-1">Booking Type</label>
                        <select class="form-select form-select-sm" id="BookingType">
                            <option value="1">Confirmed</option>
                            <option value="2">Tentative</option>
                        </select>
                    </div>

                    <!-- Agent Checkbox -->
                    <div class="form-check mt-4">
                        <input class="form-check-input" type="checkbox" id="AgentCheck">
                        <label class="form-check-label" for="AgentCheck">
                            Agent
                        </label>
                    </div>
                </div>

                <!-- RIGHT SIDE -->
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-secondary" id="btnReset">Reset</button>
                    <button type="button" class="btn btn-primary" id="btnBook">Book</button>
                </div>

            </div>
        </div>
    </div>
</div>

<!--AddOns -- MODAL -- START -->
<div class="modal fade" id="addonChargeModal" tabindex="-1" aria-labelledby="addonChargeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content rounded-3 shadow">
            <div class="modal-header bg-primary text-white py-1">
                <h5 class="modal-title fw-bold text-white">Select Addon Charges</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <div class="row">
                    <!-- LEFT SIDE (ITEMS) -->
                    <div class="col-md-8 border-end pe-3" style="max-height:70vh; overflow-y:auto;">
                        <div id="addonItemsContainer" class="space-y-3">
                            <!-- Groups & Items will be injected dynamically -->
                        </div>
                    </div>

                    <!-- RIGHT SIDE (SUMMARY) -->
                    <div class="col-md-4 ps-4">
                        <h6 class="fw-bold mb-3">Summary</h6>
                        <div id="headerSummaryContainer" class="mb-3">
                            <!-- HeaderName -> Total will be appended here -->
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between fw-bold fs-8">
                            <span>Total</span>
                            <span id="finalTotal">0</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary btn-saveAddOn">Save</button>
            </div>
        </div>
    </div>
</div>
<!--AddOns -- MODAL -- END -->

<!--Menu Item-- MODAL -- START -->
<div class=" modal fade" id="menuModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content rounded-3 shadow">
            <div class="modal-header bg-primary text-white py-1">
                <h5 class="modal-title fw-bold text-white">Menu Items</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body" id="menuModalBody">
                <!-- Dynamic menus & items will load here -->
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary btn-saveMenu">Save</button>
            </div>
        </div>
    </div>
</div>
<!--Menu Item-- MODAL -- END -->

