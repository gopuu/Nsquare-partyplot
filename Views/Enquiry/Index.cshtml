    // Drag & Drop setup
    function enableDragDrop() {
        const cards = document.querySelectorAll(".deal-card");
        const dropzones = document.querySelectorAll(".deal-dropzone");

        cards.forEach(card => {
            card.addEventListener("dragstart", e => {
                e.dataTransfer.setData("dealId", card.dataset.dealid);
                e.dataTransfer.setData("fromProcessId", card.dataset.processid);
            });
        });

        // dropzones.forEach(zone => {
        //     zone.addEventListener("dragover", e => e.preventDefault());
        //     zone.addEventListener("drop", e => {
        //         e.preventDefault();
        //         const dealId = parseInt(e.dataTransfer.getData("dealId"));
        //         const fromProcessId = parseInt(e.dataTransfer.getData("fromProcessId"));
        //         const toProcessId = parseInt(zone.closest(".process-column").dataset.processid);

        //         if (fromProcessId !== toProcessId) {
        //             moveDeal(dealId, fromProcessId, toProcessId);
        //         }
        //     });
        // });
        let pendingMoveData = {}; // temporarily store drag-drop data

        dropzones.forEach(zone => {
            zone.addEventListener("dragover", e => e.preventDefault());
            zone.addEventListener("drop", e => {
                e.preventDefault();
                const dealId = parseInt(e.dataTransfer.getData("dealId"));
                const fromProcessId = parseInt(e.dataTransfer.getData("fromProcessId"));
                const toProcessId = parseInt(zone.closest(".process-column").dataset.processid);

                if (fromProcessId !== toProcessId) {
                    // 🧠 store temporarily
                    pendingMoveData = { dealId, fromProcessId, toProcessId };

                    // Clear Move Deal Modal fields
                    // Clear Next Follow-Up fields
                    document.getElementById("nextFollowUpDate").value = "";
                    document.getElementById("nextFollowUpTime").value = "";
                    // (Optional) also hide the custom clock picker if visible
                    document.getElementById("clockPickerFollowUp").classList.add("d-none");

                    document.getElementById("remarks").value = "";
                    document.getElementById("attachment").value = "";
                    document.getElementById("attachmentBase64_enquiryMove").value = "";

                    // Optional: reset dropzone text to default
                    const dropzone = document.getElementById("attachmentDropzone");
                    dropzone.querySelector("p.fw-semibold").innerText = "Drop file here or Click to upload";

                    // open modal
                    const modal = new bootstrap.Modal(document.getElementById("moveDealModal"));
                    modal.show();
                }
            });
        });

        // 🧩 Handle Save Button in Modal
        document.getElementById("saveMoveDealBtn").addEventListener("click", () => {
            // Get Date & Time fields
            const dateVal = document.getElementById("nextFollowUpDate").value.trim();
            const timeVal = document.getElementById("nextFollowUpTime").value.trim(); // e.g. "02:30 PM"

            let nextFollowUp = "";

            if (dateVal && timeVal) {
                // Parse time (convert 12-hour format with AM/PM to 24-hour)
                const [timePart, ampm] = timeVal.split(" ");
                let [hour, minute] = timePart.split(":").map(Number);
                if (ampm === "PM" && hour < 12) hour += 12;
                if (ampm === "AM" && hour === 12) hour = 0;

                // Combine to ISO format (e.g. 2025-11-06T14:30)
                nextFollowUp = `${dateVal}T${hour.toString().padStart(2, "0")}:${minute.toString().padStart(2, "0")}`;
            }
            //const nextFollowUp = document.getElementById("nextFollowUp").value.trim();
            const remarks = document.getElementById("remarks").value.trim();
            const attachmentBase64_enquiryMove = document.getElementById("attachmentBase64_enquiryMove").value.trim();
            /*
            if (!venueVisitDate || !stageWise || !remarks) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Incomplete Details',
                    text: 'Please fill in all fields before saving.',
                    confirmButtonText: 'Okay',
                    confirmButtonColor: '#0d6efd'
                });
                return;
            }
            */

            const modalEl = document.getElementById("moveDealModal");
            const modal = bootstrap.Modal.getInstance(modalEl);
            modal.hide();

            // ✅ Call your moveDeal function with parameters
            moveDeal(
                pendingMoveData.dealId,
                pendingMoveData.fromProcessId,
                pendingMoveData.toProcessId,
                nextFollowUp,
                remarks,
                attachmentBase64_enquiryMove
            );
        });

        // Toggle clock picker visibility
        $("#nextFollowUpTime").on("focus click", function () {
            $("#clockPickerFollowUp").removeClass("d-none");
        });

        // Example: Set time on confirm
        $("#setTimeBtnFollowUp").on("click", function () {
            const hour = $("#hourDisplayFollowUp").text();
            const minute = $("#minuteDisplayFollowUp").text();
            const ampm = $("#amBtnFollowUp").hasClass("active") ? "AM" : "PM";
            $("#nextFollowUpTime").val(`${hour}:${minute} ${ampm}`);
            $("#clockPickerFollowUp").addClass("d-none");
        });

    }

    // Move deal between processes
    function moveDeal(dealId, fromProcessId, toProcessId, nextFollowUp, remarks, attachmentBase64_enquiryMove) {
        const fromProcess = processes.find(p => p.ProcessId === fromProcessId);
        const toProcess = processes.find(p => p.ProcessId === toProcessId);

        if (!fromProcess || !toProcess) return;

        const dealIndex = fromProcess.EnquiryDealsJson.findIndex(d => d.EnquiryDealId === dealId);
        if (dealIndex >= 0) {
            const deal = fromProcess.EnquiryDealsJson.splice(dealIndex, 1)[0];
            toProcess.EnquiryDealsJson.push(deal);

            // update totals
            fromProcess.TotalEnquiryDeals--;
            fromProcess.TotalAmount -= deal.Amount;
            toProcess.TotalEnquiryDeals++;
            toProcess.TotalAmount += deal.Amount;

            renderBoard();
            // var venueVisitDate = null
            // var stageWise = null
            // var remarks = null
            //console.log("moved-> from:",dealId, ", to:", toProcessId);
            // OPTIONAL: Call API to persist change
            // $.post("/api/EnquiryDeal/UpdateProcess", { dealId, toProcessId }, function(response) {
            //     console.log("Server update response:", response);
            // });
            var inputData = {
                EnquiryDealId: dealId,
                ProcessId: toProcessId,
                FollowUpDate: nextFollowUp,
                Remarks: remarks,
                FileUpload: attachmentBase64_enquiryMove, 
                ActionBy: userId // set actual logged-in user id
            };
            console.log("EnquiryDeal inputData:", inputData);
            $.ajax({
                url: "/api/EnquiryDeal/SaveEnquiryDeal_forDragNDrop",   // your API for saving banquet hall
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(inputData),
                success: function (response) {
                    if (response.status === "Success") {
                        Swal.fire({
                            position: "top-end",
                            icon: "success",
                            title: "Saved!",
                            showConfirmButton: false,
                            timer: 900
                        });
                        loadEnquiryDeals();
                    } else {
                        Swal.fire({
                            icon: "error",
                            title: "Error",
                            text: response.message
                        });
                    }
                },
                error: function (xhr, error, status) {
                    handleApiError(xhr, error, status, "Failed to save enquiry deals");
                },
                complete: function () {
                    //hideLoader();
                }
            });
        }
    }

