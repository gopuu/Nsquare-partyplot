@{
    ViewData["Title"] = "Inventory";
    Layout = "_Layout";
}
<link href="/assets2/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<script src="/assets2/js/jquery.dataTables.min.js"></script>
<script src="/assets2/js/dataTables.bootstrap5.min.js"></script>

@section Styles {
    <link href="~/assets2/css/customdatatable/customdatatable.css" asp-append-version="true" rel="stylesheet" />
    <link href="~/assets2/css/Inventory/Inventory.css" asp-append-version="true" rel="stylesheet" />
}
@section Scripts {
    <script src="~/assets2/js/Inventory/Inventory.js" asp-append-version="true"></script>
}

<!-- HTML container -->
<div class="content">
    <div class="pb-1">
        <div class="row g-2">
            <div class="col-12">
                <!-- Header Row -->
                <div class="d-flex justify-content-between align-items-start mb-3">

                    <!-- LEFT : Title -->
                    <h4 class="mb-0 text-warning">Inventory</h4>

                    <!-- RIGHT : Filters + Buttons -->
                    <div class="d-flex align-items-end gap-3">

                        <!-- Category -->
                        <div>
                            <label class="form-label mb-1">Category</label>
                            <select id="filterItemCategory" class="form-select form-select-sm"></select>
                        </div>

                        <!-- Raw Material -->
                        <div>
                            <label class="form-label mb-1">Raw Material</label>
                            <select id="filterRawMaterial" class="form-select form-select-sm"></select>
                        </div>

                        <!-- Unit -->
                        <div>
                            <label class="form-label mb-1">Unit</label>
                            <select id="filterUnit" class="form-select form-select-sm"></select>
                        </div>

                        <!-- Clear -->
                        <div>
                            <label class="form-label invisible">btn</label>
                            <button id="btnClearFilters" class="btn btn-outline-secondary btn-sm">
                                Clear
                            </button>
                        </div>

                        <!-- Save -->
                        <div>
                            <label class="form-label invisible">btn</label>
                            <button id="btnSaveStockOut" class="btn btn-warning btn-sm">
                                Save
                            </button>
                        </div>

                    </div>

                </div>

                <!-- DataTable -->
                <div id="tableMain">
                    <table id="inventoryTable" class="table table-striped table-bordered" style="width:100%">
                        <thead>
                            <tr>
                                <th>Category</th>
                                <th>Raw Material</th>
                                <th>Stock Available</th>
                                <th class="bg-ai">Stock Inward</th>
                                <th class="bg-warning-gradient">Stock Outward</th>
                                <th>Remarks</th>
                                <th>History</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- History -->
<div class="modal fade" id="historyModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header bg-warning py-2">
                <h5 class="modal-title text-white">
                    Stock History - <span id="historyItemName"></span>
                </h5>

                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div id="historyTimeline"></div>
            </div>

        </div>
    </div>
</div>
