@{
    ViewData["Title"] = "Account Master";
    Layout = "_Layout";
}

<link href="/assets2/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<script src="/assets2/js/jquery.dataTables.min.js"></script>
<script src="/assets2/js/dataTables.bootstrap5.min.js"></script>

@section Styles {
    <link href="~/assets2/css/customdatatable/customdatatable.css" rel="stylesheet" />

}

<!-- MAIN -->
<div class="content">
    <div class="pb-1">
        <div class="row g-2">
            <div class="col-12 col-xxl-12">
                <div class="mb-12">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="mb-0 text-warning">Account Master</h4>
                        <button class="btn btn-outline-warning" id="btn-add">
                            <i class="fa fa-plus-circle"></i> Add Account
                        </button>
                    </div>

                    <div id="tableMain">
                        <table class="table table-striped table-bordered" style="width:100%"></table>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<!-- ADD / EDIT MODAL -->
<div class="modal fade" id="accountModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">

            <div class="modal-header bg-warning text-white">
                <h5 class="modal-title text-white" id="accountModalTitle">Add Account</h5>
                <button class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="accountId" value="0">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Account Name <span class="text-danger">*</span></label>
                        <input type="text" id="accountName" class="form-control">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Account Type</label>
                        <select id="accountType" class="form-select">
                            <option value="0">Select</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Opening Balance</label>
                        <input type="number" id="openingBalance" class="form-control" value="0">
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Current Balance</label>
                        <input type="number" id="currentBalance" class="form-control" value="0">
                    </div>

                    <!-- BANK FIELDS -->
                    <div class="col-12"><hr></div>
                    <div class="col-md-4 bank-field">
                        <label class="form-label">Bank Name</label>
                        <input type="text" id="bankName" class="form-control">
                    </div>

                    <div class="col-md-4 bank-field">
                        <label class="form-label">Branch</label>
                        <input type="text" id="branchName" class="form-control">
                    </div>

                    <div class="col-md-4 bank-field">
                        <label class="form-label">IFSC</label>
                        <input type="text" id="ifsc" class="form-control">
                    </div>

                    <div class="col-md-4 bank-field">
                        <label class="form-label">Account Number</label>
                        <input type="text" id="accountNumber" class="form-control">
                    </div>

                    <div class="col-md-4 bank-field">
                        <label class="form-label">Account Holder Name</label>
                        <input type="text" id="accountHolderName" class="form-control">
                    </div>

                    <!-- UPI FIELD -->
                    <div class="col-md-4 upi-field">
                        <label class="form-label">UPI ID</label>
                        <input type="text" id="upiId" class="form-control">
                    </div>

                    <div class="col-md-12">
                        <label class="form-label">Description</label>
                        <textarea id="description" class="form-control"></textarea>
                    </div>

                </div>

            </div>

            <div class="modal-footer d-flex justify-content-between">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="isDefaultAccount">
                    <label class="form-check-label">Default</label>
                </div>

                <div>
                    <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                    <button class="btn btn-outline-warning" id="btnSaveAccount">Save</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- DELETE CONFIRMATION -->
<div class="modal fade" id="deleteModal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="text-white">Delete?</h5>
                <button class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <h4>Are you sure?</h4>
                <p class="text-muted">This account will be permanently deleted.</p>
                <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-outline-danger" id="confirmDelete">Delete</button>
            </div>
        </div>
    </div>
</div>


<script>
$(document).ready(function () {
    fetchData();
    loadAccountTypeDropdown();

    $("#btn-add").click(function () {
        if (!checkPermission("CanAdd")) return;
        resetForm();
        $("#accountModalTitle").text("Add Account");
        $("#accountModal").modal("show");
    });

    function loadAccountTypeDropdown() {
    $.ajax({
        type: "POST",
        url: "/api/AccountTypeMaster/GetAccountTypeList",
        contentType: "application/json",
        data: JSON.stringify({ Id: 0 }), // if API requires Id param
        success: function (response) {

            if (response.status === "Success" && response.data.length > 0) {

                let dropdown = $("#accountType");
                dropdown.empty(); // clear dropdown

                dropdown.append(`<option value="0">Select</option>`);

                response.data.forEach(item => {
                            dropdown.append(`<option value="${item.Id}">${item.TypeName}</option>`);
                });
            }
        },
        error: function (xhr, status, error) {
            handleApiError(xhr, status, error, "Error loading Account Type");
        }
    });
    }

    $("#btnSaveAccount").click(function () {
        if (!validateForm()) return;
        saveAccount();
    });

    $(document).on("click", ".btn-edit", function () {
        // Permission check
        if (!checkPermission("CanEdit")) return;
        resetForm(); // Clear previous data
        // Get datatable row data
        let table = $("#tableMain table").DataTable();
        let rowData = table.row($(this).closest("tr")).data();

        // Fill modal fields
        $("#accountId").val(rowData.Id);
        $("#accountName").val(rowData.AccountName);
        $("#accountType").val(rowData.AccountType).trigger("change");
        $("#openingBalance").val(rowData.OpeningBalance);
        $("#currentBalance").val(rowData.CurrentBalance);

        // Bank fields
        $("#bankName").val(rowData.BankName);
        $("#branchName").val(rowData.BranchName);
        $("#ifsc").val(rowData.IFSC);
        $("#accountNumber").val(rowData.AccountNumber);
        $("#accountHolderName").val(rowData.AccountHolderName);

        // UPI
        $("#upiId").val(rowData.UPI_Id);

        // General fields
        $("#description").val(rowData.Description);
        $("#isDefaultAccount").prop("checked", rowData.IsDefaultAccount);

        // Change modal title and open modal
        $("#accountModalTitle").text("Edit Account");
        $("#accountModal").modal("show");
    });

    $(document).on("click", ".btn-delete", function () {
        if (!checkPermission("CanDelete")) return;
        let table = $("#tableMain table").DataTable();
        let data = table.row($(this).closest("tr")).data();
        $("#deleteModal").data("id", data.Id).modal("show");
    });
        $("#confirmDelete").click(deleteAccount);
});

// PERMISSION CHECK
function checkPermission(type) {
    let allowed = (sessionStorage.getItem(type) || localStorage.getItem(type)) === "true";
    if (!allowed) Swal.fire("Access Denied", "Permission Required", "error");
    return allowed;
}
// FETCH DATA
function fetchData() {
    $.ajax({
        url: "/api/AccountMaster/GetAccount",
        type: "POST",
        contentType: "application/json",
        data: JSON.stringify({ Id: 0 }),
        success: function (res) {
            if (res.status === "Success") {
                renderTable(res.data);
            } else {
                console.warn("API Error:", res.message);
            }
        },
        error: function (xhr, status, error) {
               handleApiError(xhr, status, error, "Something went wrong fetching Account Data")
        },
    });
}

// RENDER TABLE
function renderTable(data) {

if ($.fn.DataTable.isDataTable("#tableMain table")) {
    $("#tableMain table").DataTable().clear().destroy();
}

$("#tableMain table").DataTable({
    data: data,
    responsive: true,
    pageLength: 10,
    scrollX: true,
    columns: [
        { data: "Id", title: "Sr. No", visible:true },
            { data: "AccountName", title: "Account Name" },
        {
            data: "OpeningBalance",
            title: "Opening Bal",
            render: d => d?.toLocaleString("en-IN")
        },
        {
            data: "CurrentBalance",
            title: "Current Bal",
            render: d => d?.toLocaleString("en-IN")
        },
            { data: "BankName", title: "Bank Name" },
            { data: "BranchName", title: "Branch" },
            { data: "IFSC", title: "IFSC Code" },
            { data: "AccountNumber", title: "Account No." },
            { data: "AccountHolderName", title: "Holder Name" },
        {
                data: "IsDefaultAccount",
            title: "Default",
            render: d => d
                ? `<span class="badge bg-success">Yes</span>`
                : `<span class="badge bg-secondary">No</span>`
        },
        {
            data: null,
            title: "Action",
            orderable: false,
            render: (data, type, row) => `
                    <button class="btn btn-sm btn-outline-warning btn-action-xss btn-edit" data-id="${row.Id}">
                    <i class="fa fa-edit"></i>
                </button>
                    <button class="btn btn-sm btn-outline-danger btn-action-xss btn-delete" data-id="${row.Id}">
                    <i class="fa fa-trash"></i>
                </button>`
        }
    ]
});
}

 // RESET FORM
 function resetForm() {
    $("input, textarea").val("");
    $("#accountId").val(0);
    $("#accountType").val("0");
    $("#isDefaultAccount").prop("checked", false);
      
}
// FILL FORM ON EDIT
function fillForm(d) {
    $("#accountId").val(d.Id);
    $("#accountName").val(d.AccountName);
    $("#accountType").val(d.AccountType).trigger("change");
    $("#openingBalance").val(d.OpeningBalance);
    $("#bankName").val(d.BankName);
    $("#upiId").val(d.UPI);
    $("#description").val(d.Description);
    $("#isDefaultAccount").prop("checked", d.IsDefault);
}
// SAVE
function saveAccount() {
    let payload = {
        Id: $("#accountId").val(),
        AccountName: $("#accountName").val().trim(),
        AccountType: $("#accountType").val(),
        OpeningBalance: $("#openingBalance").val(),
        CurrentBalance: $("#currentBalance").val(),
        BankName: $("#bankName").val(),
        BranchName: $("#branchName").val(),
        IFSC: $("#ifsc").val(),
        AccountNumber: $("#accountNumber").val(),
        AccountHolderName: $("#accountHolderName").val(),
        UPI_Id: $("#upiId").val(),
        Description: $("#description").val(),
        IsDefaultAccount: $("#isDefaultAccount").is(":checked"),
        ActionBy: sessionStorage.getItem("userId") ?? 0
    };
    $.ajax({
        url: "/api/AccountMaster/SaveAccount",
        type: "POST",
        data: JSON.stringify(payload),
        contentType: "application/json",
        success: function (res) {
            Swal.fire("Saved!", "", "success");
            $("#accountModal").modal("hide");
            fetchData();
        },
        error: function (xhr, status, error) {
               handleApiError(xhr, status, error, "Save Account Error")
       }
    });
}

// DELETE
function deleteAccount() {
    let id = $("#deleteModal").data("id");
    $.ajax({
        url: "/api/AccountMaster/DeleteAccount",
        type: "POST",
        contentType: "application/json",
        data: JSON.stringify({ Id: id }),
        success: function () {
            Swal.fire("Deleted!", "", "success");
            $("#deleteModal").modal("hide");
            fetchData();
        },
        error: function (xhr, status, error) {
            handleApiError(xhr, status, error, "Something went wrong!")
        }
    });
}

// VALIDATION
function validateForm() {
    if ($("#accountName").val().trim() === "") {
        Swal.fire("Required", "Account Name is required", "warning");
        return false;
    }
    return true;
}
</script>
