@{
    ViewData["Title"] = "Account Master";
    Layout = "_Layout";
}

<link href="/assets2/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<script src="/assets2/js/jquery.dataTables.min.js"></script>
<script src="/assets2/js/dataTables.bootstrap5.min.js"></script>

<!-- MAIN -->
<div class="content">
    <div class="pb-1">
        <div class="row g-2">
            <div class="col-12 col-xxl-10">
                <div class="mb-12">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="mb-0 text-warning">Account Master</h4>
                        <button class="btn btn-outline-warning" id="btn-add">
                            <i class="fa fa-plus-circle"></i> Add Account
                        </button>
                    </div>

                    <div id="tableMain">
                        <table class="table table-striped table-bordered" style="width:100%"></table>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<!-- ========== ADD / EDIT ACCOUNT MODAL ========== -->
<div class="modal fade" id="accountModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">

            <div class="modal-header bg-warning text-white">
                <h5 class="modal-title text-white" id="accountModalTitle">Add Account</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <input type="hidden" id="accountId" value="0">

                <div class="row g-3">

                    <div class="col-md-4">
                        <label class="form-label">Account Name</label>
                        <input type="text" id="accountName" class="form-control" placeholder="Enter name">
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Account Type</label>
                        <select id="accountType" class="form-select">
                            <option value="0">Select Type</option>
                            <option value="1">Cash</option>
                            <option value="2">Bank</option>
                            <option value="3">UPI</option>
                            <option value="4">Credit Card</option>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Opening Balance</label>
                        <input type="number" id="openingBalance" class="form-control" value="0">
                    </div>

                    <!-- BANK DETAILS -->
                    <div class="col-12"><hr /></div>

                    <div class="col-md-3 bank-field">
                        <label class="form-label">Bank Name</label>
                        <input type="text" id="bankName" class="form-control">
                    </div>

                    <div class="col-md-3 bank-field">
                        <label class="form-label">Branch Name</label>
                        <input type="text" id="branchName" class="form-control">
                    </div>

                    <div class="col-md-3 bank-field">
                        <label class="form-label">IFSC</label>
                        <input type="text" id="ifsc" class="form-control">
                    </div>

                    <div class="col-md-3 bank-field">
                        <label class="form-label">Account Number</label>
                        <input type="text" id="accountNumber" class="form-control">
                    </div>

                    <div class="col-md-4 bank-field">
                        <label class="form-label">Account Holder Name</label>
                        <input type="text" id="accountHolderName" class="form-control">
                    </div>

                    <!-- UPI -->
                    <div class="col-md-4 upi-field">
                        <label class="form-label">UPI ID</label>
                        <input type="text" id="upiId" class="form-control">
                    </div>

                    <div class="col-md-12">
                        <label class="form-label">Description</label>
                        <textarea id="description" class="form-control" rows="2"></textarea>
                    </div>

                </div>

            </div>

            <div class="modal-footer d-flex justify-content-between align-items-center">

                <!-- LEFT SIDE: Default Switch -->
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="isDefaultAccountSwitchFooter">
                    <label class="form-check-label" for="isDefaultAccountSwitchFooter">Default Account</label>
                </div>

                <!-- RIGHT SIDE BUTTONS -->
                <div>
                    <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                    <button class="btn btn-outline-warning ms-2" id="btnSaveAccount">Save</button>
                </div>

            </div>

        </div>
    </div>
</div>

<!-- DELETE MODAL -->
<div class="modal fade zoomIn" id="deleteRecordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title text-white">Delete Confirmation</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="text-center mt-2">
                    <h4>Are you sure?</h4>
                    <p class="text-muted">Delete this account?</p>
                </div>
                <div class="d-flex gap-2 justify-content-center mt-4 mb-2">
                    <button type="button" class="btn w-sm btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn w-sm btn-outline-danger" id="delete-record">Yes, Delete!</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>

    $(document).ready(function () {

        fetchData();
        hideConditionalFields();

        // -------------------------
        // Add Account Button
        // -------------------------
        $(document).on("click", "#btn-add", function (e) {
            let canAdd = (sessionStorage.getItem("CanAdd") || localStorage.getItem("CanAdd")) === "true";

            if (!canAdd) {
                Swal.fire("Access Denied", "You do not have permission to Add.", "error");
                return;
            }

            resetForm();
            $("#accountModalTitle").text("Add Account");
            $("#accountModal").modal("show");
        });

        // -------------------------
        // Account Type Change (Show/Hide Bank/UPI fields)
        // -------------------------
        $("#accountType").on("change", function () {
            hideConditionalFields();
        });

        function hideConditionalFields() {
            let type = $("#accountType").val();

            $(".bank-field").hide();
            $(".upi-field").hide();

            if (type === "Bank" || type === "CreditCard") $(".bank-field").show();
            if (type === "UPI") $(".upi-field").show();
        }

        // -------------------------
        // Edit Account
        // -------------------------
        $(document).on("click", ".btn-edit", function () {

            let canEdit = (sessionStorage.getItem("CanEdit") || localStorage.getItem("CanEdit")) === "true";
            if (!canEdit) {
                Swal.fire("Access Denied", "You do not have permission to Edit.", "error");
                return;
            }

            let table = $("#tableMain table").DataTable();
            let row = $(this).closest("tr");
            let rowData = table.row(row).data();

            resetForm();

            $("#accountId").val(rowData.Id);
            $("#accountName").val(rowData.AccountName);
            $("#accountType").val(rowData.AccountType);
            $("#openingBalance").val(rowData.OpeningBalance);
            //$("#isDefaultAccount").val(rowData.IsDefaultAccount);
            $('#isDefaultAccountSwitchFooter').prop("checked", rowData.IsDefault);

            $("#bankName").val(rowData.BankName);
            $("#branchName").val(rowData.BranchName);
            $("#ifsc").val(rowData.IFSC);
            $("#accountNumber").val(rowData.AccountNumber);
            $("#accountHolderName").val(rowData.AccountHolderName);

            $("#upiId").val(rowData.UPI_Id);
            $("#description").val(rowData.Description);

            hideConditionalFields();
            $("#accountModalTitle").text("Edit Account");
            $("#accountModal").modal("show");
        });

        // -------------------------
        // SAVE Account
        // -------------------------
        $("#btnSaveAccount").click(function () {

            let payload = {
                Id: $("#accountId").val(),
                AccountName: $("#accountName").val(),
                AccountType: $("#accountType").val(),
                OpeningBalance: $("#openingBalance").val(),
                IsDefaultAccount= $('#isDefaultAccountSwitchFooter').is(":checked")
                BankName: $("#bankName").val(),
                BranchName: $("#branchName").val(),
                IFSC: $("#ifsc").val(),
                AccountNumber: $("#accountNumber").val(),
                AccountHolderName: $("#accountHolderName").val(),
                UPI_Id: $("#upiId").val(),
                Description: $("#description").val(),
                ActionBy: sessionStorage.getItem("userId")
            };

            $.ajax({
                url: "/api/Account/SaveAccountMaster",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(payload),
                success: function (res) {

                    if (res.status === "Success") {
                        Swal.fire({
                            icon: "success",
                            title: "Saved!",
                            timer: 900,
                            showConfirmButton: false
                        });
                        $("#accountModal").modal("hide");
                        fetchData();
                    } else {
                        Swal.fire("Error", res.message, "error");
                    }
                }
            });
        });

        // -------------------------
        // Delete Click
        // -------------------------
        $(document).on("click", ".btn-delete", function () {

            let canDelete = (sessionStorage.getItem("CanDelete") || localStorage.getItem("CanDelete")) === "true";
            if (!canDelete) {
                Swal.fire("Access Denied", "You do not have permission to Delete.", "error");
                return;
            }

            let table = $("#tableMain table").DataTable();
            let row = $(this).closest("tr");
            let rowData = table.row(row).data();

            $("#deleteRecordModal").data("id", rowData.Id).modal("show");
        });

        // -------------------------
        // Delete Account Confirm
        // -------------------------
        $("#delete-record").click(function () {
            let id = $("#deleteRecordModal").data("id");

            let payload = {
                Id: id,
                ActionBy: sessionStorage.getItem("userId")
            };

            $.ajax({
                url: "/api/Account/DeleteAccountMaster",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(payload),
                success: function (res) {

                    if (res.status === "Success") {

                        Swal.fire("Deleted!", "Account removed.", "success");
                        fetchData();
                        $("#deleteRecordModal").modal("hide");

                    } else {
                        Swal.fire("Error", res.message, "error");
                    }
                }
            });
        });

    });

    // -------------------------
    // Fetch Data
    // -------------------------
    function fetchData() {

        $.ajax({
            url: "/api/Account/GetAccountMaster",
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify({ Id: 0 }),
            success: function (res) {
                renderTable(res.data);
            }
        });
    }

    // -------------------------
    // Render DataTable
    // -------------------------
    function renderTable(data) {

        if ($.fn.dataTable.isDataTable("#tableMain table")) {
            $("#tableMain table").DataTable().clear().destroy();
        }

        data.forEach((x, i) => x.srno = i + 1);

        $("#tableMain table").DataTable({
            data: data,
            columns: [
                { data: "srno", title: "Sr." },
                { data: "AccountName", title: "Account Name" },
                { data: "AccountType", title: "Type" },
                { data: "OpeningBalance", title: "Opening Balance" },
                { data: "CurrentBalance", title: "Current Balance" },
                {
                    data: null,
                    title: "Actions",
                    render: function () {
                        return `
                            <button class="btn btn-outline-warning btn-sm btn-edit">
                                <i class="fa fa-edit"></i>
                            </button>
                            <button class="btn btn-outline-danger btn-sm btn-delete">
                                <i class="fa fa-trash"></i>
                            </button>`;
                    }
                }
            ]
        });
    }

    // -------------------------
    // Reset Form
    // -------------------------
    function resetForm() {
        $("#accountId").val(0);
        $("#accountName").val("");
        $("#accountType").val("");
        $("#openingBalance").val("0");
        //$("#isDefaultAccount").val("0");
        $('#isDefaultAccountSwitchFooter').prop("checked", false);

        $("#bankName").val("");
        $("#branchName").val("");
        $("#ifsc").val("");
        $("#accountNumber").val("");
        $("#accountHolderName").val("");

        $("#upiId").val("");
        $("#description").val("");

        hideConditionalFields();
    }

</script>
