@{
    ViewData["Title"] = "Daily Sales Report";
    Layout = "_Layout";
}

<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<link href="/assets2/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<script src="/assets2/js/jquery.dataTables.min.js"></script>
<script src="/assets2/js/dataTables.bootstrap5.min.js"></script>
<link href="~/assets2/css/customdatatable/customdatatable.css" asp-append-version="true" rel="stylesheet" />

<!-- MAIN -->
<div class="content">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="text-warning mb-0">Daily Sales Report</h4>

        <!-- RIGHT CONTROLS -->
        <div class="d-flex align-items-center gap-2">

            <!-- FILTER BUTTON -->
            <button class="btn btn-outline-warning btn-sm" id="btnToggleFilter">
                <i class="fa fa-filter me-1"></i> Filter
            </button>

            <!-- WITH HEADER -->
            <div class="form-check form-switch mb-0">
                <input class="form-check-input" type="checkbox" id="toggleWithHeader">
                <label class="form-check-label fw-semibold" for="toggleWithHeader">
                    With Header
                </label>
            </div>

            <!-- SELECT COLUMNS -->
            <button class="btn btn-outline-info btn-sm" id="btn-select-columns">
                <i class="fa fa-list-check me-1"></i> Columns
            </button>

            <!-- DOWNLOAD -->
            <div class="dropdown">
                <button class="btn btn-outline-dark btn-sm dropdown-toggle"
                        type="button"
                        data-bs-toggle="dropdown">
                    <i class="fas fa-download"></i>
                </button>

                <ul class="dropdown-menu dropdown-menu-end">
                    <li>
                        <a class="dropdown-item"
                           href="javascript:void(0)"
                           onclick="ViewDailySalesReport('downloadPDF')">
                            <i class="fas fa-file-pdf text-danger me-2"></i> PDF
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item"
                           href="javascript:void(0)"
                           onclick="ViewDailySalesReport('downloadExcel')">
                            <i class="fas fa-file-excel text-success me-2"></i> Excel
                        </a>
                    </li>
                </ul>
            </div>

        </div>
    </div>

    <!-- GRID VIEW -->
    <div id="tableMain">
        <table class="table table-striped table-bordered w-100">
            <thead></thead>

            <tfoot>
                <tr>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                </tr>
            </tfoot>

        </table>
    </div>
</div>
<!-- /MAIN -->

<!-- RIGHT FILTER PANEL -->
<div id="filterPanel" class="filter-panel">

    <div class="filter-header bg-warning d-flex justify-content-between align-items-center px-3 py-2">
        <h6 class="mb-0 text-white">Filters</h6>
        <button type="button"
                class="btn-close btn-close-white"
                id="btnCloseFilter"
                aria-label="Close">
        </button>
    </div>

    <div class="filter-body">
        <div class="mb-3">
            <label class="form-label">Duration</label>
            <select id="quickRange" class="form-select form-select-sm">
                <option value="thismonth">This Month</option>
                <option value="lastmonth">Last Month</option>
                <option value="days">Last 7 Days</option>
                <option value="lastdays">Last 30 Days</option>
                <option value="yesterday">Yesterday</option>
                <option value="12months">Last 12 Months</option>
                <option value="customrange">Custom Range</option>
            </select>
        </div>

        <div class="row g-2">
            <div class="col-md-6 mb-3">
                <label class="form-label">From Date</label>
                <input type="date" id="fromDate" class="form-control form-control-sm">
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">To Date</label>
                <input type="date" id="toDate" class="form-control form-control-sm">
            </div>
        </div>
    </div>

    <div class="filter-footer">
        <button id="btnResetFilter" class="btn btn-outline-secondary btn-sm">Reset</button>
        <button id="btnApplyFilter" class="btn btn-warning btn-sm">Apply</button>
    </div>

</div>

<!-- SELECT COLUMNS MODAL -->
<div class="modal fade" id="modalColumns" tabindex="-1">
    <div class="modal-dialog modal-md">
        <div class="modal-content">

            <div class="modal-header bg-warning py-2">
                <h5 class="modal-title text-white">Select Columns</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="chk-select-all">
                        <label class="form-check-label fw-bold">Select All</label>
                    </div>
                    <button class="btn btn-sm btn-outline-secondary" id="btn-reset-columns">
                        <i class="fa fa-refresh"></i> Reset
                    </button>
                </div>

                <hr />

                <div id="column-list" class="row"></div>

            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button class="btn btn-warning" id="btn-save-columns">
                    <i class="fa fa-save"></i> Save
                </button>
            </div>

        </div>
    </div>
</div>
<!-- END MODAL -->

<!-- Daily Sales Details Modal -->
<div class="modal fade" id="dailySalesDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-xxl modal-dialog-scrollable">
        <div class="modal-content">

            <div class="modal-header bg-warning py-2 d-flex align-items-center justify-content-between">
                <h5 class="modal-title text-white mb-0">Daily Sales Invoice Details</h5>
                <div class="d-flex align-items-center gap-2 ms-auto">

                    <!-- SELECT COLUMNS -detail -->
                    <button class="btn btn-info btn-sm" id="btn-select-columns-detail">
                        <i class="fa fa-list-check me-1"></i> Columns
                    </button>

                    <!-- DOWNLOAD -->
                    <div class="dropdown">
                        <button class="btn btn-outline-dark btn-sm dropdown-toggle btn-white"
                                type="button"
                                data-bs-toggle="dropdown">
                            <i class="fas fa-download"></i>
                        </button>

                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <a class="dropdown-item"
                                   href="javascript:void(0)"
                                   onclick="ViewDailySalesDetailsReport('downloadPDF')">
                                    <i class="fas fa-file-pdf text-danger me-2"></i> PDF
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item"
                                   href="javascript:void(0)"
                                   onclick="ViewDailySalesDetailsReport('downloadExcel')">
                                    <i class="fas fa-file-excel text-success me-2"></i> Excel
                                </a>
                            </li>
                        </ul>
                    </div>
                    <button class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
            </div>

            <div class="modal-body">
                <div id="columns-section-detail">
                    <!--COLUMNS-->
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="chk-select-all-detail">
                            <label class="form-check-label fw-bold">Select All</label>
                        </div>
                        <button class="btn btn-sm btn-outline-secondary" id="btn-reset-columns-detail">
                            <i class="fa fa-refresh"></i> Reset
                        </button>
                    </div>

                    <hr />

                    <div id="column-list-details" class="row"></div>
                </div>

                <!--TABLE-->
                <div class="table-responsive">
                    <table id="tblDailySalesDetails" class="table table-bordered table-sm align-middle w-100">

                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Invoice No</th>
                                <th>Date</th>
                                <th>Client</th>
                                <th>Gross</th>
                                <th>Taxes</th>
                                <th>Net</th>
                                <th>Paid</th>
                                <th>Due</th>
                                <th>Payment Mode</th>
                            </tr>
                        </thead>

                        <tbody></tbody>

                        <tfoot class="table-secondary fw-bold">
                            <tr>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                            </tr>
                        </tfoot>

                    </table>
                </div>


            </div>

        </div>
    </div>
</div>
<!-- END - MODAL -->

@section Scripts {
    <script src="~/assets2/js/report_dailysales/report_dailysales.js" asp-append-version="true"></script>
    <script src="~/assets2/js/Shared/utility.js" asp-append-version="true"></script>
}

@section Styles {
    <link href="~/assets2/css/report_dailysales/report_dailysales.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/assets2/css/report_filters/report_filters.css" rel="stylesheet" asp-append-version="true" />
}
