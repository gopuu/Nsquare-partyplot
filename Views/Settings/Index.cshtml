@{
    ViewData["Title"] = "Settings";
    Layout = "_Layout";
}
<link href="/assets2/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<script src="/assets2/js/jquery.dataTables.min.js"></script>
<script src="/assets2/js/dataTables.bootstrap5.min.js"></script>

@section Styles {
    <link href="~/assets2/css/customdatatable/customdatatable.css" asp-append-version="true" rel="stylesheet" />
}

@section Scripts {
    <script src="~/assets2/js/Settings/Settings.js" asp-append-version="true"></script>
}

<!-- MAIN -->
<div class="content">
    <div class="pb-1">
        <div class="row g-2">
            <div class="col-12 col-xxl-12">
                <div class="mb-12">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="mb-0 text-warning">Settings</h4>
                    </div>

                    <div id="tableMain">
                        <table class="table table-striped table-bordered" style="width:100%"></table>
                    </div>

                </div>
            </div>
        </div>
    </div>

</div>

<!-- ========== Modal ========== -->
<div class="modal fade" id="addEventModal" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">

            <div class="modal-header bg-warning text-white py-2">
                <h5 class="modal-title text-white" id="addEventModalTitle">Settings</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="Id" value="0">
                <div class="row g-3">

                    <div class="col-md-12">
                        <label class="form-label fs-9" id="Name">Name</label>
                        <input type="text" id="Value" class="form-control" placeholder="Enter value" autofocus autocomplete="off">
                    </div>

                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-outline-warning btn-sm" id="btnSaveAddEventModal">Save</button>
            </div>

        </div>
    </div>
</div>
