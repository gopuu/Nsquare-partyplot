@{
    ViewData["Title"] = "Task Master";
    Layout = "_Layout";
}

<link href="/assets2/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<script src="/assets2/js/jquery.dataTables.min.js"></script>
<script src="/assets2/js/dataTables.bootstrap5.min.js"></script>

<div class="content">
    <div class="pb-1">
        <div class="row g-2">
            <div class="col-12 col-xxl-12">
                <div class="mb-12">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="mb-0 text-warning">Task Master</h4>
                        <button class="btn btn-outline-warning" id="btn-add-task">
                            <i class="fa fa-plus-circle"></i> Add Task
                        </button>
                    </div>

                    <div id="tableTask">
                        <table class="table table-striped table-bordered" style="width:100%"></table>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="TaskModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header bg-warning text-white">
                <h5 class="modal-title text-white" id="TaskModalTitle">Add Task</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="TaskId" value="0" />

                <div class="row g-3">

                    <div class="col-6">
                        <label class="form-label">Task Title <span class="text-danger">*</span></label>
                        <input type="text" id="TaskTitle" class="form-control" placeholder="Enter Task Title" />
                    </div>

                    <div class="col-6">
                        <label class="form-label">Task Description</label>
                        <textarea id="TaskDescription" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Category</label>
                        <select id="TaskCategoryId" class="form-select"></select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Assigned To</label>
                        <select id="TaskAssignedTo" class="form-select">
                            <option value="0">--Select AssignedTo--</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Assigned By</label>
                        <select id="TaskAssignedBy" class="form-select">
                            <option value="0">--Select AssignedBy--</option>

                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Status</label>
                        <select id="TaskStatusId" class="form-select"></select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Priority Level</label>
                        <select id="PriorityLevel" class="form-select">
                            <option value="0">--Select--</option>
                           
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Start Date</label>
                        <input type="date" id="StartDate" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Due Date</label>
                        <input type="date" id="DueDate" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Completed Date</label>
                        <input type="date" id="CompletedDate" class="form-control" />
                    </div>

                </div>
            </div>

            <div class="modal-footer d-flex">
                <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                <button class="btn btn-outline-warning" id="btnSaveTask">Save</button>
            </div>

        </div>
    </div>
</div>


<div class="modal fade zoomIn" id="deleteRecordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title text-white" id="deleteRecordModalLabel">Delete Confirmation</h5> <!-- Added Title -->
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" id="btn-close"></button>
            </div>
            <div class="modal-body">
                <div class="mt-2 text-center">
                    <lord-icon src="/assets/js/gsqxdxog.json" trigger="loop" colors="primary:#f7b84b,secondary:#f06548" style="width:100px;height:100px"></lord-icon>
                    <div class="mt-4 pt-2 fs-15 mx-4 mx-sm-5">
                        <h4>Are you Sure ?</h4>
                        <p class="text-muted mx-4 mb-0">Delete this record?</p>
                    </div>
                </div>
                <div class="d-flex gap-2 justify-content-center mt-4 mb-2">
                    <button type="button" class="btn w-sm btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn w-sm btn-outline-danger" id="delete-record">Yes, Delete It!</button>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script src="~/assets2/js/taskmaster/taskmaster.js" asp-append-version="true"></script>
}

@section Styles {
    <link href="~/assets2/css/customdatatable/customdatatable.css" rel="stylesheet" />

}

