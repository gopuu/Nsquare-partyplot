@{
    ViewData["Title"] = "Invoice Template Master";
    Layout = "_Layout";
}
<link href="/assets2/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<script src="/assets2/js/jquery.dataTables.min.js"></script>
<script src="/assets2/js/dataTables.bootstrap5.min.js"></script>

<!-- HTML container -->
<div class="content">
    <div class="pb-1">
        <div class="row g-2">
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="mb-0 text-warning">Invoice Templates</h4>
                </div>

                <!-- DataTable -->
                <div id="templateGrid" class="row g-3">
                    <!-- Templates will load here -->
                    <!-- CATEGORY TABS -->
                    <ul class="nav nav-tabs mb-3" id="templateTabs"></ul>

                    <!-- CATEGORY TAB CONTENT -->
                    <div class="tab-content" id="templateTabContent"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Full Image Preview Modal -->
<div class="modal fade" id="imgPreviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">

            <!-- HEADER -->
            <div class="modal-header bg-warning">
                <h5 class="modal-title text-white" id="InvoiceTemplatePreviewTitle">
                    Invoice Template Preview
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <!-- BODY -->
            <div class="modal-body d-flex justify-content-center align-items-center"
                 style="
                    background:#f2f2f2;      /* LIGHT GRAY BACKGROUND */
                    overflow:auto;           /* SCROLL IF IMAGE IS LARGE */
                    padding:20px;
                 ">

                <img id="fullPreviewImage"
                     src=""
                     alt="Full Preview"
                     style="
                        display:block;
                        background:white;
                        padding:10px;
                        border-radius:8px;

                        /* 🔥 SHOW ACTUAL SIZE IMAGE */
                        max-width:90%;
                        height:auto;

                        /* Allow full A4 size without cropping */
                        object-fit:contain;
                     ">
            </div>

        </div>
    </div>
</div>


<script>
    document.addEventListener("DOMContentLoaded", function () {
        fetchData();
    });

    function fetchData(categoryId=0) {

        $('#btnLoadStock').prop('disabled', true);
        const payload = {
            Id: 0,
            CategoryId: categoryId
        };

        $.ajax({
            url: "/api/InvoiceTemplateMaster/GetInvoiceTemplateMaster", // adjust if controller name differs
            method: "POST",
            contentType: "application/json",
            data: JSON.stringify(payload),
            success: function (response) {
                if (response && response.status === "Success") {
                    rawDataCache = response.data || [];
                    renderTable(rawDataCache);
                } else {
                    rawDataCache = [];
                    renderTable([]);
                    Swal.fire("Error", response?.message || "Failed to fetch templates", "error");
                }
            },
            error: function (xhr, status, error) {
                handleApiError(xhr, status, error, "Failed to fetch templates.");
            }
        });
    }

    function renderTable(list) {

        const tabs = document.getElementById("templateTabs");
        const tabContent = document.getElementById("templateTabContent");

        tabs.innerHTML = "";
        tabContent.innerHTML = "";

        // Group by CategoryId
        const grouped = {};
        list.forEach(item => {
            if (!grouped[item.CategoryId]) grouped[item.CategoryId] = [];
            grouped[item.CategoryId].push(item);
        });

        let isFirst = true;

        // Build Tabs + Tab Content
        Object.keys(grouped).forEach(categoryId => {

            const categoryName = grouped[categoryId][0].CategoryName;

            // ---------- TAB ----------
            tabs.innerHTML += `
                <li class="nav-item" role="presentation">
                    <button class="nav-link ${isFirst ? "active" : ""}"
                            id="tab-${categoryId}"
                            data-bs-toggle="tab"
                            data-bs-target="#content-${categoryId}"
                            type="button" role="tab">
                        ${categoryName}
                    </button>
                </li>
            `;

            // ---------- BUILD EACH TEMPLATE CARD ----------
            let cardsHtml = `<div class="row g-3">`;

            grouped[categoryId].forEach(item => {

                let isChecked = item.Is_Selected ? "checked" : "";

                cardsHtml += `
                    <div class="col-md-2">
                        <div class="card bg-white border-0 text-center">

                            <div class="position-relative">

                                <!-- DOWNLOAD ICON -->
                                <a href="${item.PdfName}" download
                                   class="download-icon"
                                   style="
                                        position:absolute;
                                        top:10px;
                                        left:10px;
                                        background:#ffffffdd;
                                        padding:6px 8px;
                                        border-radius:8px;
                                        cursor:pointer;
                                        z-index:5;">
                                    <i class="fa fa-download text-primary" style="font-size:16px;"></i>
                                </a>

                                <!-- Checkbox -->
                                <input type="checkbox"
                                    class="template-check form-check-input"
                                    data-id="${item.Id}"
                                    data-category-id="${item.CategoryId}"
                                    style="position:absolute; top:10px; right:10px; width:20px; height:20px; cursor:pointer; z-index:5;"
                                    ${isChecked} />

                                <!-- Thumbnail -->
                                <div class="a4-thumb-wrapper"
                                     data-img="${item.ImageName}"
                                     data-title="${item.Title}">
                                    <img src="${item.ImageName}" class="a4-thumb-img" alt="Template Preview">
                                </div>

                            </div>

                            <div class="card-body text-center py-2">
                                <h6 class="card-title mb-1" style="font-size:14px;">${item.Title}</h6>
                            </div>
                        </div>
                    </div>
                `;
            });

            cardsHtml += `</div>`;

            // ---------- TAB BODY ----------
            tabContent.innerHTML += `
                <div class="tab-pane fade ${isFirst ? "show active" : ""}"
                     id="content-${categoryId}" role="tabpanel">
                    ${cardsHtml}
                </div>
            `;

            isFirst = false;
        });

        attachCheckboxEvents();
    }

    function attachCheckboxEvents() {
        document.querySelectorAll(".template-check").forEach(chk => {
            chk.addEventListener("change", function () {

                let templateId = this.getAttribute("data-id");
                let categoryId = this.getAttribute("data-category-id");

                // Uncheck all in this category (UI)
                document.querySelectorAll(`input[data-category-id="${categoryId}"]`).forEach(item => {
                    item.checked = false;
                });

                this.checked = true;

                // CALL API
                updateSelectedTemplate(templateId, categoryId);
            });
        });
    }

    function updateSelectedTemplate(templateId, categoryId) {
        var payload = {
            TemplateId: templateId,
            CategoryId: categoryId,
            ActionBy: sessionStorage.getItem("userId") ?? 0
        };
        console.log("save payload:",payload);
        $.ajax({
            type: "POST",
            url: "/api/InvoiceTemplateMaster/SaveInvoiceTemplate_Selected",
            contentType: "application/json",
            data: JSON.stringify(payload),
            success: function (res) {

                if (res.status === "Success") {
                    console.log("Selected updated:", templateId);
                    // Reload templates
                    fetchData();
                }
                else {
                    Swal.fire("Error", response?.message || "Failed to save templates", "error");
                }
            },
            error: function (xhr, status, error) {
                handleApiError(xhr, status, error, "Selected Template Save error");
            }
        });

    }

    document.addEventListener("click", function (e) {
        if (e.target.classList.contains("a4-thumb-wrapper") ||
            e.target.classList.contains("a4-thumb-img")) {

            const wrapper = e.target.classList.contains("a4-thumb-img")
                ? e.target.parentElement
                : e.target;

            const imgSrc = wrapper.getAttribute("data-img");
            const title = wrapper.getAttribute("data-title");

            document.getElementById("fullPreviewImage").src = imgSrc;

            // SET TITLE
            document.getElementById("InvoiceTemplatePreviewTitle").textContent =
                "Invoice Template Preview - " + title;

            new bootstrap.Modal(document.getElementById("imgPreviewModal")).show();
        }
    });


</script>

<style>
    /* Wrapper container spacing */
    #templateTabs {
        border-bottom: 0 !important;
        margin-bottom: 10px;
    }

    /* Base tab styling */
    .nav-tabs .nav-link {
        background: transparent;
        border: none;
        color: #0d6efd; /* Primary blue */
        font-weight: 700; /* <-- BOLD FONT */
        padding: 10px 25px;
        border-radius: 4px 4px 0 0;
        margin-right: 8px;
        transition: 0.15s ease;
    }

        /* Active tab */
        .nav-tabs .nav-link.active {
            background: #ff9800 !important; /* Orange background */
            color: white !important;
            font-weight: 700; /* Bold */
            border: none;
            border-bottom: 4px solid #d17900; /* darker underline */
            box-shadow: 0px 2px 4px rgba(0,0,0,0.15);
        }

            /* Hover on ACTIVE tab -> DO NOTHING */
            .nav-tabs .nav-link.active:hover {
                background: #ff9800 !important;
                color: white !important;
            }

        /* Hover on INACTIVE tabs */
        .nav-tabs .nav-link:not(.active):hover {
            background: #ffe4bb;
            color: #d17900;
        }

    /* -------------------------
       Your existing styles below
    -------------------------- */

    .card-img-top {
        transition: 0.2s ease-in-out;
    }

        .card-img-top:hover {
            transform: scale(1.02);
        }

    .template-check {
        transform: scale(1.3);
        accent-color: #007bff;
    }

    .a4-thumb-wrapper {
        width: 100%;
        background: #fff;
        border-radius: 12px;
        padding: 12px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.15);
        display: flex;
        justify-content: center;
        align-items: center;
        cursor: pointer;
    }

    .a4-thumb-img {
        width: 100%;
        height: 250px;
        object-fit: contain;
        background: #fff;
        border-radius: 6px;
    }

    .download-icon:hover {
        background: #ffffff;
        transform: scale(1.05);
        transition: 0.1s ease-in-out;
    }
</style>
