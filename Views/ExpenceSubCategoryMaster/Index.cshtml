@{
    ViewData["Title"] = "Expence SubCategory Master";
    Layout = "_Layout";
}
<link href="/assets2/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<script src="/assets2/js/jquery.dataTables.min.js"></script>
<script src="/assets2/js/dataTables.bootstrap5.min.js"></script>

<!-- MAIN -->
<div class="content">
    <div class="pb-1">
        <div class="row g-2">
            <div class="col-12 col-xxl-6">
                <div class="mb-12">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="mb-0 text-warning">Expence SubCategory Master</h4>
                        <button class="btn btn-outline-warning" id="btn-add">
                            <i class="fa fa-plus-circle"></i> Add Expence SubCategory
                        </button>
                    </div>

                    <div id="tableMain">
                        <table class="table table-striped table-bordered" style="width:100%"></table>
                    </div>

                </div>
            </div>
        </div>
    </div>

</div>

<!-- ========== Modal ========== -->
<div class="modal fade" id="addEventModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <!-- HEADER -->
            <div class="modal-header bg-warning text-white">
                <h5 class="modal-title text-white" id="addEventModalTitle">Add Expence SubCategory Master</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <!-- BODY -->
            <div class="modal-body">
                <input type="hidden" id="SubCategoryId" value="0">
                <div class="row g-3">
                    <div class="col-12">
                        <select id="ddlExpenceCategory" class="form-select">
                            <option value="">-- Select Expence Category --</option>
                        </select>
                    </div>
                    <!-- SubCategory Name -->
                    <div class="col-12">
                        <label class="form-label">SubCategory Name<span class="text-danger">*</span></label>
                        <input type="text" id="SubCategoryName" class="form-control" placeholder="Enter SubCategory Name">
                    </div>

                    <!-- Description -->
                    <div class="col-12">
                        <label class="form-label">Description</label>
                        <textarea id="SubCategoryDescription" class="form-control" rows="4" placeholder="Enter Description"></textarea>
                    </div>

                </div>
            </div>

            <!-- FOOTER -->
            <div class="modal-footer d-flex justify-content-between align-items-center">
                <!-- RIGHT SIDE -->
                <div class="d-flex align-items-center gap-3">
                    <!-- Buttons -->
                    <div>
                        <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                        <button class="btn btn-outline-warning" id="btnSaveAddEventModal">Save</button>
                    </div>

                </div>

            </div>
        </div>
    </div>
</div>

<!-- DELETE MODAL -->
<div class="modal fade zoomIn" id="deleteRecordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title text-white" id="deleteRecordModalLabel">Delete Confirmation</h5> <!-- Added Title -->
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" id="btn-close"></button>
            </div>
            <div class="modal-body">
                <div class="mt-2 text-center">
                    <lord-icon src="/assets/js/gsqxdxog.json" trigger="loop" colors="primary:#f7b84b,secondary:#f06548" style="width:100px;height:100px"></lord-icon>
                    <div class="mt-4 pt-2 fs-15 mx-4 mx-sm-5">
                        <h4>Are you Sure ?</h4>
                        <p class="text-muted mx-4 mb-0">Delete this record?</p>
                    </div>
                </div>
                <div class="d-flex gap-2 justify-content-center mt-4 mb-2">
                    <button type="button" class="btn w-sm btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn w-sm btn-outline-danger" id="delete-record">Yes, Delete It!</button>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- END MODAL -->

<script>
$(document).ready(function () {
fetchData();
loadExpenceCategoryDropdown();

// Add button click
$(document).on('click', '#btn-add', function (event) {
// Check Add Permission from Session or Local Storage
var canAdd = (sessionStorage.getItem('CanAdd') || localStorage.getItem('CanAdd')) === 'true';
if (!canAdd) {
    // Display Access Denied Message
    Swal.fire({
        icon: "error",
        title: "Access Denied",
        text: "You don't have permission to Add. Please contact admin.",
        confirmButtonText: "OK"
    });
    event.preventDefault(); // Stop the modal from opening
    $('#addEventModal').modal('hide');
} else {
    resetFormFields(); // Reset form fields when modal is shown
        $("#addEventModalTitle").text("Add Expence SubCategory");
    $("#addEventModal").modal("show");
}
});

// SAVE - Handle form submission
$("#btnSaveAddEventModal").click(function (event) {
event.preventDefault();

// Validate required fields
if (!validateForm()) return;

    let id = $("#SubCategoryId").val();  // hidden field for edit
    let categoryId = $("#ddlExpenceCategory").val();
    let subCategoryName = $("#SubCategoryName").val().trim();
    let description = $("#SubCategoryDescription").val().trim();

if (categoryId === "") {
    Swal.fire("Required!", "Please select Expence Category", "warning");
    return;
}

let payload = {
    Id: id,
    CategoryId: categoryId,
    SubCategoryName: subCategoryName,
    Description: description,
    ActionBy: sessionStorage.getItem("userId") ?? 0
};
console.log("SAVE PAYLOAD:", payload);
$.ajax({
    url: "/api/ExpenseSubCategory/SaveExpenseSubCategory",
    type: "POST",
    contentType: "application/json",
    data: JSON.stringify(payload),
    success: function (response) {
        if (response.status === "Success") {
            Swal.fire({
                position: "top-end",
                icon: "success",
                title: "Saved!",
                showConfirmButton: false,
                timer: 1000
            });
            fetchData();  // reload table
            resetFormFields();  // reset
            $('#addEventModal').modal('hide');  // close modal
        }
        else {
            Swal.fire("Error", response.message, "error");
        }
    },
    error: function (xhr, status, error) {
        handleApiError(xhr, status, error, "Save Expence SubCategory Error");
    }
});
});

// ---- Edit Expence SubCategory ----
$(document).on("click", ".btn-edit", function () {

    // Permission Check
    let canEdit = (sessionStorage.getItem("CanEdit") || localStorage.getItem("CanEdit")) === "true";
    if (!canEdit) {
        Swal.fire({
            icon: "error",
            title: "Access Denied",
            text: "You don't have permission to Edit. Please contact admin.",
        });
        return;
    }

    resetFormFields();

    // Ensure table reference
        let table = $("#tableMain table").DataTable();
    let data = table.row($(this).closest("tr")).data();

    console.log("EDIT SubCategory Data:", data);

    if (!data) {
        console.error("❌ row data null. Check DataTable columns.");
        return;
    }

    // Load dropdown selected value dynamically
    loadExpenceCategoryDropdown(data.CategoryId);

    // Fill Form
    $("#SubCategoryId").val(data.Id);
    $("#SubCategoryName").val(data.SubCategoryName);
    $("#SubCategoryDescription").val(data.Description);

    // Update Modal Title & Show
    $("#addEventModalTitle").text("Edit Expence SubCategory");
    $("#addEventModal").modal("show");
});

    // Delete Event handler for remove button click
$(document).on('click', '.btn-delete', function (event) {
var canDelete = (sessionStorage.getItem('CanDelete') || localStorage.getItem('CanDelete')) === 'true';
if (!canDelete) {
    Swal.fire({
        icon: "error",
        title: "Access Denied",
        text: "You don't have permission to Delete. Please contact admin.",
        confirmButtonText: "OK"
    });
    event.preventDefault(); // Stop navigation
    $('#deleteRecordModal').modal('hide');
}
else {
    // Get the DataTable instance
    var table = $('#tableMain table').DataTable();

    // Get the row object for the clicked Edit button
    var row = $(this).closest('tr');
    var rowData = table.row(row).data(); // Get the data object for this row

    // Extract values from the row data object
    var id = rowData.Id;

    $('#deleteRecordModal').data('id', id).modal('show');
}
});

// Handle delete confirmation
$('#delete-record').click(function () {
var id = $('#deleteRecordModal').data('id');

let payload = {
    Id: id,
    ActionBy: sessionStorage.getItem("userId") ?? 0
};

$('#btn-loader').show();
$.ajax({
    url: "/api/ExpenseSubCategory/DeleteExpenseSubCategory",
    type: "POST",
    contentType: "application/json",
    data: JSON.stringify(payload),
    success: function (response) {
        //console.log("Delete Data:", response);
        // Parse the response if it's a string
        if (typeof response === 'string') {
            response = JSON.parse(response);
        }

        //debugger
        if (response.status === "Success") {
            Swal.fire({
                position: "top-end",
                icon: "success",
                title: "Deleted !!",
                showConfirmButton: false,
                timer: 900
            });
        }
        else {
            Swal.fire({
                title: "Delete Fail..!!",
                text: response.message,
                icon: "error"
            });
        }
        fetchData();
        //$('#btn-loader').hide();
        $('#deleteRecordModal').modal('hide');
    },
    error: function (xhr) {
            handleApiError(xhr, status, error, "Delete SubCategory Error")
    },
    complete: function () {
        $('#btn-loader').hide(); // Ensure loader is hidden in any case
    }
});
$('#deleteRecordModal').modal('hide');
});

    });

function fetchData() {
        $('#btn-loader').show();
        $('.search').val('');
        $.ajax({
            url: "/api/ExpenseSubCategory/GetExpenseSubCategoryList",
            method: "POST",
            contentType: "application/json",
            data: JSON.stringify({ Id: 0 }),
            success: function (response) {
                //data = response; // Store the fetched data
                console.log("response fetchData:", response);
                var data = response.data;
                renderTable(data);
            },
            error: function (xhr, status, error) {
                    handleApiError(xhr, status, error, "Get ExpenceSubCategory Error")
            }
        });
    }
function renderTable(data) {

console.log("Expence SubCategory Data:", data);

// Destroy existing instance
if ($.fn.dataTable.isDataTable('#tableMain table')) {
    $('#tableMain table').DataTable().clear().destroy();
}

// Handle empty data
if (!data || data.length === 0) {
    $('#tableMain tbody').html(`
        <tr>
            <td colspan="5" class="text-center fw-bold text-danger">No Data Found !!</td>
        </tr>
    `);

    return;
}

// Add SrNo
data.forEach((item, index) => item.srno = index + 1);

$('#tableMain table').DataTable({
    data: data,
    columns: [
        { data: 'srno', title: 'Sr. No.' },
        { data: 'CategoryName', title: 'Category' },
        { data: 'SubCategoryName', title: 'SubCategory' },
        { data: 'Description', title: 'Description' },
        {
            data: null,
            title: 'Actions',
            render: () => `
                <div class="d-flex flex-column flex-sm-row gap-2">
                    <button class="btn btn-outline-warning btn-action-xs btn-edit">
                        <i class="fa fa-edit"></i>
                    </button>
                    <button class="btn btn-outline-danger btn-action-xs btn-delete">
                        <i class="fa fa-trash"></i>
                    </button>
                </div>`
        }
    ],
    columnDefs: [
        { targets: 0, className: "text-center", width: "8%" },
        { targets: 4, className: "text-center", width: "10%" } // FIXED INDEX
    ],
    pageLength: 10,
    ordering: true,
    searching: true,
    lengthChange: false,
    pagingType: "full_numbers"
});
}

    function loadExpenceCategoryDropdown(selectedId = "") {
        $.ajax({
            url: "/api/ExpenseCategory/GetExpenseCategoryList",
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify({ Id: 0 }),
            success: function (response) {

                let dropdown = $("#ddlExpenceCategory");
                dropdown.empty(); // clear previous values

                dropdown.append(`<option value="">-- Select Expence Category --</option>`);

                response.data.forEach(item => {
                    dropdown.append(
                        `<option value="${item.Id}" ${selectedId == item.Id ? "selected" : ""}>
                            ${item.CategoryName}
                        </option>`
                    );
                });
            },
            error: function (xhr, status, error) {
                handleApiError(xhr, status, error, "Dropdown Load Error");
            }
        });
    }
    function resetFormFields() {
            $("#SubCategoryModeId").val(0);
            $("#ddlExpenceCategory").val("");
            $("#SubCategoryName").val("");
            $("#SubCategoryDescription").val("");
    }
    function validateForm() {
        if ($("#ddlExpenceCategory").val() === "") {
            Swal.fire("Required!", "Please select category", "warning");
            return false;
        }
            if ($("#SubCategoryName").val().trim() === "") {
            Swal.fire("Required!", "Please enter subcategory name", "warning");
            return false;
        }

        return true;
    }

</script>