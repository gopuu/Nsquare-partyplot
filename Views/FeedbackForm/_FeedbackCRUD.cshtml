@model ERPAdmin.Views.FeedbackForm._FeedbackCRUDModel
@{
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        .feedback-card {
            max-width: 500px;
            margin: auto;
            border-radius: 20px;
            box-shadow: 0 20px 40px rgba(0,0,0,.15);
            overflow: hidden;
        }

        .step {
            display: none;
            animation: fade .3s ease-in-out;
        }

            .step.active {
                display: block;
            }

        .option-btn {
            border: 2px solid #ddd;
            border-radius: 12px;
            padding: 12px;
            cursor: pointer;
            transition: .2s;
        }

            .option-btn:hover {
                background: #f8f9fa;
            }

            .option-btn input {
                display: none;
            }

            .option-btn.active {
                border-color: #0d6efd;
                background: #e7f1ff;
            }

        .emoji-option {
            border: 2px solid #ddd;
            border-radius: 18px;
            padding: 18px;
            cursor: pointer;
            transition: .25s;
            display: flex;
            justify-content: center;
            align-items: center;
        }

            .emoji-option img {
                width: 56px;
                height: 56px;
            }

            .emoji-option.active {
                border-color: #0d6efd;
                background: #e7f1ff;
                box-shadow: 0 8px 18px rgba(13,110,253,.25);
            }

    </style>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <div class="container py-5">
        <div class="feedback-card p-4">
            <h4 class="text-center mb-4" id="stepTitle"></h4>
            <div id="stepsContainer"></div>
            <div class="d-flex mt-4">
                <button class="btn btn-secondary me-auto" id="btnPrev">Previous</button>
                <button class="btn btn-primary ms-auto" id="btnNext">Next</button>
            </div>

        </div>
    </div>

}
