@{
    ViewData["Title"] = "FeedbackForm";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
    .feedback-card {
        max-width: 500px;
        margin: auto;
        border-radius: 20px;
        box-shadow: 0 20px 40px rgba(0,0,0,.15);
        overflow: hidden;
    }
    .step {
        display: none;
        animation: fade .3s ease-in-out;
    }
    .step.active {
        display: block;
    }
    .option-btn {
        border: 2px solid #ddd;
        border-radius: 12px;
        padding: 12px;
        cursor: pointer;
        transition: .2s;
    }
    .option-btn:hover {
        background: #f8f9fa;
    }

    .option-btn input {
        display: none;
    }

    .option-btn.active {
        border-color: #0d6efd;
        background: #e7f1ff;
    }
    .emoji-option {
        border: 2px solid #ddd;
        border-radius: 18px;
        padding: 18px;
        cursor: pointer;
        transition: .25s;
        display: flex;
        justify-content: center;
        align-items: center;
    }
    .emoji-option img {
        width: 56px;
        height: 56px;
    }

    .emoji-option.active {
        border-color: #0d6efd;
        background: #e7f1ff;
        box-shadow: 0 8px 18px rgba(13,110,253,.25);
    }

</style>

<div class="container py-5">
    <div class="feedback-card p-4">
        <h4 class="text-center mb-4" id="stepTitle"></h4>
        <div id="stepsContainer"></div>
        <div class="d-flex justify-content-between mt-4">
            <button class="btn btn-secondary" id="btnPrev">Previous</button>
            <button class="btn btn-primary" id="btnNext">Next</button>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<script>
    let steps = [];
    let currentStep = 0;
    let answers = {};
    const imgMapStep1 = {
        "Very Good": "/assets2/img/Feedback/Heart_Eyes_Emoji.png",
        "Good": "/assets2/img/Feedback/Smiling_Emoj.png",
        "Poor": "/assets2/img/Feedback/Slightly_Smiling_Emoji.png",
        "Very Poor": "/assets2/img/Feedback/Very_Sad_Emoji.png"
    };
    const imgMapStep2 = {
        "Food": "/assets2/img/Feedback/foods.png",
        "Service": "/assets2/img/Feedback/restaurant.png",
        "Ambience": "/assets2/img/Feedback/drinks.png",
        "Cleanliness": "/assets2/img/Feedback/cleans.png",
        "Value For Money": "/assets2/img/Feedback/value.png"
    };

    const imgMapStep3 = {
        "Zomato / Swiggy": "/assets2/img/Feedback/swaggy-zometo.png",
        "Friends & Family": "/assets2/img/Feedback/friends-and-family.png",
        "Walking By": "/assets2/img/Feedback/walk.png",
        "Social Media": "/assets2/img/Feedback/social-media.png"
    };


    $(document).ready(function () {
        loadFeedbackForm();

        $("#btnPrev").click(() => changeStep(-1));
        $("#btnNext").click(() => changeStep(1));
    });

    function loadFeedbackForm() {
        $.ajax({
            url: "/api/Feedback/GetFeedbackFormData", // 🔁 change API
            type: "GET",
            success: function (res) {
                steps = res.data.sort((a, b) => a.StepOrder - b.StepOrder);
                renderSteps();
                showStep(0);
            }
        });
    }

    function renderSteps() {
        let html = "";
        steps.forEach((step, index) => {
            html += `<div class="step" data-step="${index}">
                <p style="font-size:15px;font-weight:700;">${step.StepTitle}</p>`;
            if (step.Options && step.Options.length > 0) {
                let mapObj = null;
                if (step.StepOrder === 1) mapObj = imgMapStep1;
                else if (step.StepOrder === 2) mapObj = imgMapStep2;
                else if (step.StepOrder === 3) mapObj = imgMapStep3;
                if (mapObj) {
                    html += `<div class="row justify-content-center">`;

                    step.Options.forEach(opt => {
                        html += `
                        <div class="col-6  justify-content-center">
                            <label class="emoji-option mb-3">
                                <input type="${step.StepOrder === 2 ? 'checkbox' : 'radio'}"
                                       name="step_${step.StepId}"
                                       value="${opt.OptionId}"
                                       hidden>
                                <img src="${mapObj[opt.OptionName]}"
                                     alt="${opt.OptionName}"
                                     title="${opt.OptionName}">
                            </label>
                        </div>`;
                    });

                    html += `</div>`;
                }
            }

            if (step.HasTextBox) {
                html += `<textarea class="form-control mt-3"
                                  rows="3"
                                  placeholder="Type here..."
                                  data-textbox="${step.StepId}"></textarea>`;
            }

            html += `</div>`;
        });
        $("#stepsContainer").html(html);

        // ✅ CLICK HANDLING (FINAL)
        $(document).off("click", ".emoji-option");
        $(document).on("click", ".emoji-option", function (e) {
            e.preventDefault(); // ⭐ MOST IMPORTANT ⭐
            let input = $(this).find("input");
            let type = input.attr("type");

            if (type === "radio") {
                // STEP 1 & STEP 3 (single select)
                $(this).closest(".step").find(".emoji-option").removeClass("active");
                $(this).addClass("active");
                input.prop("checked", true);
            }
            else {
                // STEP 2 (multi select)
                let isChecked = input.prop("checked");

                if (isChecked) {
                    input.prop("checked", false);
                    $(this).removeClass("active");
                } else {
                    input.prop("checked", true);
                    $(this).addClass("active");
                }
            }
        });

    }

    function showStep(index) {
        $(".step").removeClass("active");
        $(`.step[data-step=${index}]`).addClass("active");

        $("#stepTitle").text(`Step ${index + 1} of ${steps.length}`);

        $("#btnPrev").toggle(index > 0);
        $("#btnNext").text(index === steps.length - 1 ? "Submit" : "Next");
    }

    function changeStep(dir) {
        if (dir === 1 && currentStep === steps.length - 1) {
            submitFeedback();
            return;
        }
        currentStep += dir;
        showStep(currentStep);
    }

    // SAVE FUNCTION
    function submitFeedback() {
        let responses = [];
        steps.forEach(step => {
            let selectedOptions = [];
            $(`input[name=step_${step.StepId}]:checked`).each(function () {
                selectedOptions.push(parseInt($(this).val()));
            });

            let text = $(`textarea[data-textbox=${step.StepId}]`).val() || null;

            if (selectedOptions.length > 0) {
                selectedOptions.forEach(optId => {
                    responses.push({
                        StepId: step.StepId,
                        OptionId: optId,
                        TextResponse: text
                    });
                });
            } else if (text) {
                responses.push({
                    StepId: step.StepId,
                    OptionId: null,
                    TextResponse: text
                });
            }
        });

        let request = { Created_By: null, Responses: responses };
        console.log("FINAL PAYLOAD", JSON.stringify(request, null, 2));

        $.ajax({
            url: "/api/Feedback/SaveFeedback",
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify(request),
            success: function (res) {
                if (res.status === "Success") {
                     Swal.fire({
                            position: "top-end",
                            icon: "success",
                            title: "Saved!",
                            showConfirmButton: false,
                            timer: 900
                        });
                    resetForm(); // reload with Step 1 default active
                    currentStep = 0;
                    showStep(currentStep);
                } else {
                    Swal.fire("Error", res.message, "error");
                }
            },
            error: function (xhr, status, error) {
               handleApiError(xhr, status, error, "Save ExpenseTransaction Error")
        }
        });
    }

    // RESET FORM
    function resetForm() {
        $("#stepsContainer").empty();
        loadFeedbackForm();
    }
</script>
