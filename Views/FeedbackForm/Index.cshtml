@{
    ViewData["Title"] = "Feedback Form";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - Infinity</title>

    <!-- ===============================================-->
    <!--    Favicons-->
    <!-- ===============================================-->
    <link rel="apple-touch-icon" sizes="180x180" href="/assets2/img/favicons/infinity_apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/assets2/img/favicons/infinity_favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/assets2/img/favicons/infinity_favicon-16x16.png">
    <link rel="shortcut icon" type="image/x-icon" href="/assets2/img/favicons/infinity_favicon.ico">
    <link rel="manifest" href="/assets2/img/favicons/manifest.json">
    <meta name="msapplication-TileImage" content="/assets2/img/favicons/mstile-150x150.png">
    <meta name="theme-color" content="#ffffff">
    <!-- Bootstrap -->
    <link href="~/assets2/css/bootstrap.min.css" rel="stylesheet" />

    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous">

    <!-- SweetAlert -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #1e293b, #0f172a);
        }

        .loading-state {
            min-height: 200px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 12px;
            color: #6c757d;
        }

        .feedback-card {
            background: #ffffff;
            max-width: 500px;
            margin: auto;
            border-radius: 20px;
            box-shadow: 0 20px 40px rgba(0,0,0,.15);
            padding: 25px;
        }

        .option-grid {
            display: flex;
            justify-content: center;
            gap: 20px;
            flex-wrap: wrap;
        }

        .option-card {
            text-align: center;
            cursor: pointer;
        }

            .option-card img {
                width: 70px;
                height: 70px;
                border-radius: 50%;
                padding: 10px;
                border: 2px dashed #ddd;
            }

            .option-card.active img {
                border: 3px solid orange;
            }

        .option-text {
            margin-top: 6px;
            font-weight: 500;
        }

        .nav-btn {
            width: 56px;
            height: 56px;
            border-radius: 50%;
            border: none;
            background-color: var(--bs-primary);
            color: #fff;
            font-size: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            box-shadow: 0 4px 10px rgba(13,110,253,0.35);
        }

            .nav-btn:hover {
                background-color: var(--bs-primary-bg-subtle);
                color: var(--bs-primary);
            }

            .nav-btn.save {
                background-color: var(--bs-success);
            }

            .nav-btn.hidden {
                visibility: hidden;
            }

        .feedback-hint {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 12px 16px;
            margin: 0 auto;
            max-width: 90%;
            border-radius: 14px;
            font-size: 15px;
            font-weight: 500;
            box-shadow: 0 8px 20px rgba(0,0,0,0.15);
        }

            .feedback-hint.positive {
                background: linear-gradient(135deg, #e7fff3, #ffffff);
                border: 1px dashed #28a745;
                color: #155724;
            }

                .feedback-hint.positive i {
                    color: #28a745;
                }

            .feedback-hint.neutral {
                background: linear-gradient(135deg, #fff7e6, #ffffff);
                border: 1px dashed #f4a259;
                color: #6c4a00;
            }

                .feedback-hint.neutral i {
                    color: #f4a259;
                }

            .feedback-hint.negative {
                background: linear-gradient(135deg, #fff1f1, #ffffff);
                border: 1px dashed #dc3545;
                color: #721c24;
            }

                .feedback-hint.negative i {
                    color: #dc3545;
                }

        .save-loader {
            position: fixed;
            inset: 0;
            background: rgba(255,255,255,0.85);
            z-index: 9999;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            font-weight: 500;
            color: #0d6efd;
        }

        .thank-you-screen {
            position: fixed;
            inset: 0;
            background: linear-gradient(135deg, #f5f7fa, #e4ebf5);
            z-index: 9998;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .thank-you-card {
            background: #ffffff;
            padding: 40px 30px;
            border-radius: 24px;
            max-width: 360px;
            width: 90%;
            text-align: center;
            box-shadow: 0 30px 60px rgba(0,0,0,0.2);
            animation: popIn .5s ease;
        }

        .thank-icon {
            width: 72px;
            height: 72px;
            background: linear-gradient(135deg, #28a745, #4cd964);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 16px;
            color: #fff;
            font-size: 32px;
        }

        .thank-you-card h3 {
            font-weight: 700;
            margin-bottom: 8px;
        }

        .thank-you-card p {
            color: #6c757d;
            font-size: 15px;
        }

        .thank-sub {
            margin-top: 10px;
            font-size: 14px;
            color: #495057;
        }

        @@keyframes popIn {
            from

        {
            transform: scale(.9);
            opacity: 0;
        }

        to {
            transform: scale(1);
            opacity: 1;
        }

        }
    </style>
</head>

<body>
    <div class="container py-5">
        <div class="feedback-card">
            <h4 class="text-center mb-4 text-primary" id="stepTitle"></h4>

            <div id="stepsContainer">
                <div class="loading-state">
                    <div class="spinner-border text-primary" role="status"></div>
                    <div>Please wait, loading feedback form…</div>
                </div>
            </div>

            <div class="d-flex justify-content-center gap-4 mt-4 btn-actions d-none">
                <button class="nav-btn" id="btnPrev">
                    <i class="fa-solid fa-chevron-left"></i>
                </button>
                <button class="nav-btn" id="btnNext">
                    <i class="fa-solid fa-chevron-right"></i>
                </button>
            </div>
        </div>
    </div>
    <div id="saveLoader" class="save-loader d-none">
        <div class="spinner-border text-primary" role="status"></div>
        <div class="mt-2">Saving your feedback…</div>
    </div>

    <div id="thankYouScreen" class="thank-you-screen d-none">
        <div class="thank-you-card">
            <div class="thank-icon">
                <i class="fa-solid fa-heart"></i>
            </div>

            <h3>Thank You!</h3>
            <p>Your feedback helps us improve and serve you better.</p>

            <div class="thank-sub">
                We truly appreciate your time.
            </div>
        </div>
    </div>

    <script>
        /* ================= GLOBALS ================= */
        let steps = [];
        let currentStepIndex = 0;
        let feedbackResponses = {};

        let bookingId = 0;
        let customerName = "";
        let whatsappNo = "";

        /* ================= INIT ================= */
        $(document).ready(function () {

            // Decode URL params
            const params = new URLSearchParams(window.location.search);
            if (params.has("bid")) bookingId = atobFix(params.get("bid"));
            if (params.has("n")) customerName = atobFix(params.get("n"));
            if (params.has("w")) whatsappNo = atobFix(params.get("w"));

            loadFeedbackForm();

            $("#btnNext").on("click", handleNext);
            $("#btnPrev").on("click", handlePrev);
        });

        /* ================= LOAD FORM ================= */
        function loadFeedbackForm() {
            $.get("/api/Feedback/GetFeedbackFormData", function (res) {
                steps = res.data.sort((a, b) => a.StepOrder - b.StepOrder);
                console.log("res steps:", steps);
                currentStepIndex = 0;
                feedbackResponses = {};
                renderStep();
            });
        }

        /* ================= RENDER STEP ================= */
        function renderStep() {
            const step = steps[currentStepIndex];

            $("#stepTitle").text(step.StepTitle);
            $("#stepsContainer").empty();
            $(".btn-actions").removeClass("d-none");

            step.HasTextBox ? renderTextBox(step) : renderOptions(step);
            updateNavButtons();
        }

        /* ================= OPTIONS ================= */
        function renderOptions(step) {
            //const container = $('<div class="option-grid"></div>');
            const container = $('<div class="d-flex justify-content-center gap-4 flex-nowrap option-row"></div>');

            step.Options.forEach(opt => {
                const card = $(`
                    <div class="option-card" data-id="${opt.OptionId}">
                        <img src="${encodeURI(opt.IconUrl)}">
                        <div class="option-text">${opt.OptionName}</div>
                    </div>
                `);

                card.on("click", function () {

                    if (!step.IsMultiSelect) {
                        container.find(".option-card").removeClass("active");
                        feedbackResponses[step.StepId] = [];
                    }

                    $(this).toggleClass("active");

                    const selected = container.find(".option-card.active")
                        .map((_, el) => $(el).data("id"))
                        .get();

                    feedbackResponses[step.StepId] = selected;

                    $("#hiddenMessage").remove();
                    if (opt.HiddenMessage) {

                        let hintClass = "neutral";

                        if (opt.DisplayOrder <= 2) {
                            hintClass = "positive";
                        }
                        else if (opt.DisplayOrder >= 4) {
                            hintClass = "negative";
                        }
                        let icon = "fa-heart";
                        if (hintClass === "negative") icon = "fa-face-sad-tear";
                        if (hintClass === "neutral") icon = "fa-face-meh";

                        $("#stepsContainer").append(`
                            <div id="hiddenMessage" class="feedback-hint ${hintClass} mt-4">
                                <i class="fa-solid ${icon}"></i>
                                <span>${opt.HiddenMessage}</span>
                            </div>
                        `);
                    }

                    console.log("feedbackResponses:", feedbackResponses);
                });

                container.append(card);
            });

            $("#stepsContainer").append(container);
        }

        /* ================= TEXTBOX ================= */
        function renderTextBox(step) {
            const textarea = $(`<textarea class="form-control" rows="4"
                placeholder="Enter your feedback"></textarea>`);

            textarea.on("input", function () {
                feedbackResponses[step.StepId] = $(this).val();
            });

            $("#stepsContainer").append(textarea);
        }

        /* ================= NAVIGATION ================= */
        function handleNext() {
            const stepId = steps[currentStepIndex].StepId;

            if (!feedbackResponses[stepId]) {
                Swal.fire("Please provide feedback before continuing");
                return;
            }

            if (currentStepIndex === steps.length - 1) {
                submitFeedback();
                return;
            }

            currentStepIndex++;
            renderStep();
        }

        function handlePrev() {
            currentStepIndex--;
            renderStep();
        }

        function updateNavButtons() {
            const isFirst = currentStepIndex === 0;
            const isLast = currentStepIndex === steps.length - 1;

            $("#btnPrev").toggleClass("hidden", isFirst);

            const icon = $("#btnNext i");
            if (isLast) {
                icon.removeClass("fa-chevron-right").addClass("fa-check");
                $("#btnNext").addClass("save");
            } else {
                icon.removeClass("fa-check").addClass("fa-chevron-right");
                $("#btnNext").removeClass("save");
            }
        }

        /* ================= SUBMIT ================= */
        function submitFeedback() {

            let responses = [];

            steps.forEach(step => {
                const val = feedbackResponses[step.StepId];

                if (Array.isArray(val)) {
                    val.forEach(id => responses.push({
                        StepId: step.StepId,
                        OptionId: id,
                        TextResponse: null
                    }));
                }

                if (typeof val === "string" && val.trim()) {
                    responses.push({
                        StepId: step.StepId,
                        OptionId: null,
                        TextResponse: val
                    });
                }
            });

            const payload = {
                BookingId: Number(bookingId),
                CustomerName: customerName,
                WhatsappNo: whatsappNo,
                Responses: responses
            };
            console.log("payload:", payload);

            $.ajax({
                url: "/api/Feedback/SaveFeedback",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(payload),
                beforeSend: function () {
                    showSaveLoader();   // 👈 loader ON + buttons disabled
                },
                success: function () {
                    $(".feedback-card").fadeOut(300, function () {
                        $("#thankYouScreen").removeClass("d-none");
                    });
                },
                error: function (xhr, status, error) {
                    Swal.fire("Error", "Unable to save feedback. Please try again.", "error");
                },
                complete: function () {
                    hideSaveLoader();   // 👈 loader OFF + buttons enabled
                }
            });
        }

        /* ================= UTIL ================= */
        function atobFix(v) {
            v = v.replace(/-/g, '+').replace(/_/g, '/');
            while (v.length % 4) v += '=';
            return atob(v);
        }

        function showSaveLoader() {
            $("#saveLoader").removeClass("d-none");
            disableNavButtons(true);
        }

        function hideSaveLoader() {
            $("#saveLoader").addClass("d-none");
            disableNavButtons(false);
        }

        function disableNavButtons(disable) {
            $("#btnNext, #btnPrev").prop("disabled", disable);
        }

    </script>
</body>
</html>
