@{
    ViewData["Title"] = "Feedback Form";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - Infinity</title>

    <!-- ===============================================-->
    <!--    Favicons-->
    <!-- ===============================================-->
    <link rel="apple-touch-icon" sizes="180x180" href="/assets2/img/favicons/infinity_apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/assets2/img/favicons/infinity_favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/assets2/img/favicons/infinity_favicon-16x16.png">
    <link rel="shortcut icon" type="image/x-icon" href="/assets2/img/favicons/infinity_favicon.ico">
    <link rel="manifest" href="/assets2/img/favicons/manifest.json">
    <meta name="msapplication-TileImage" content="/assets2/img/favicons/mstile-150x150.png">
    <meta name="theme-color" content="#ffffff">
    <!-- Bootstrap -->
    <link href="~/assets2/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous">
    <link href="~/assets2/css/FeedbackForm/FeedbackForm.css" asp-append-version="true" rel="stylesheet" />
</head>

<body>
    <div class="container py-5">
        <h3 class="feedback-title">Your Feedback Matters..</h3>
        <div class="feedback-card">
            <h4 class="text-center mb-4 text-primary" id="stepTitle"></h4>

            <div id="stepsContainer">
                <div class="loading-state">
                    <div class="spinner-border text-primary" role="status"></div>
                    <div>Please wait, loading feedback form…</div>
                </div>
            </div>

            <div id="feedbackError" class="text-danger text-center mt-2 d-none">
                Please provide feedback before continuing
            </div>
        </div>
    </div>
    
    <div id="saveLoader" class="save-loader d-none">
        <div class="spinner-border text-primary" role="status"></div>
        <div class="mt-2">Saving your feedback…</div>
    </div>

    <div id="thankYouScreen" class="thank-you-screen d-none">
        <div class="thank-you-card">
            <div class="thank-icon">
                <i class="fa-solid fa-heart"></i>
            </div>

            <h3>Thank You!</h3>
            <p>Your feedback helps us improve and serve you better.</p>

            <div class="thank-sub">
                We truly appreciate your time.
            </div>

            <hr />
            <div id="reloadCountdown" class="text-muted small mt-2">
                Starting again in <span id="countdownSeconds">3</span> seconds...
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script src="~/assets2/js/FeedbackForm/FeedbackForm.js" asp-append-version="true"></script>
</body>

</html>
