@{
    ViewData["Title"] = "Unit Master";
    Layout = "_Layout";
}
<link href="/assets2/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<script src="/assets2/js/jquery.dataTables.min.js"></script>
<script src="/assets2/js/dataTables.bootstrap5.min.js"></script>
@section Styles {
    <link href="~/assets2/css/customdatatable/customdatatable.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/assets2/css/unitmaster/unitmaster.css" rel="stylesheet" asp-append-version="true" />
}
@section Scripts {
    <script src="~/assets2/js/unitmaster/UnitMaster.js" asp-append-version="true"></script>
}

<!-- MAIN -->
<div class="content">
    <div class="pb-1">
        <div class="row g-2">
            <div class="col-12 col-xxl-12">
                <div class="mb-12">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="mb-0 text-warning">Unit Measurement Master</h4>
                        <button class="btn btn-outline-warning" id="btn-add">
                            <i class="fa fa-plus-circle"></i> Add Unit
                        </button>
                    </div>

                    <div id="tableMain">
                        <table class="table table-striped table-bordered" style="width:100%"></table>
                    </div>

                </div>
            </div>
        </div>
    </div>

</div>

<!-- ========== Modal ========== -->
<div class="modal fade" id="addEventModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header bg-warning text-white py-2">
                <h5 class="modal-title text-white" id="addEventModalTitle">Add Unit Measurement</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <input type="hidden" id="unitId" value="0">

                <div class="row g-3">

                    <div class="col-md-8">
                        <label class="form-label">Unit Name</label>
                        <input type="text" id="unitName" class="form-control" placeholder="Enter Unit Name">
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Short Name</label>
                        <input type="text" id="shortName" class="form-control" placeholder="Enter Short Name">
                    </div>
                </div>

            </div>
            <div class="modal-footer d-flex justify-content-between align-items-center">

                <!-- LEFT SIDE -->
                <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" id="isActive" checked>
                    <label class="form-check-label" for="isActive">Active</label>
                </div>

                <!-- RIGHT SIDE BUTTONS -->
                <div>
                    <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                    <button class="btn btn-outline-warning" id="btnSaveAddEventModal">Save</button>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- DELETE MODAL -->
<div class="modal fade zoomIn" id="deleteRecordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title text-white" id="deleteRecordModalLabel">Delete Confirmation</h5> <!-- Added Title -->
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" id="btn-close"></button>
            </div>
            <div class="modal-body">
                <div class="mt-2 text-center">
                    <lord-icon src="/assets2/js/gsqxdxog.json" trigger="loop" colors="primary:#f7b84b,secondary:#f06548" style="width:100px;height:100px"></lord-icon>
                    <div class="mt-4 pt-2 fs-15 mx-4 mx-sm-5">
                        <h4>Are you Sure ?</h4>
                        <p class="text-muted mx-4 mb-0">Delete this record?</p>
                    </div>
                </div>
                <div class="d-flex gap-2 justify-content-center mt-4 mb-2">
                    <button type="button" class="btn w-sm btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn w-sm btn-outline-danger" id="delete-record">Yes, Delete It!</button>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- END MODAL -->

