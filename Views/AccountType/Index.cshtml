@{
    ViewData["Title"] = "Account Type Master";
    Layout = "_Layout";
}

<link href="/assets2/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<script src="/assets2/js/jquery.dataTables.min.js"></script>
<script src="/assets2/js/dataTables.bootstrap5.min.js"></script>

<div class="content">
    <div class="pb-1">
        <div class="row g-2">
            <div class="col-12 col-xxl-8">
                <div class="mb-12">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="mb-0 text-warning">Account Type Master</h4>
                        <button class="btn btn-outline-warning" id="btn-add">
                            <i class="fa fa-plus-circle"></i> Add Account Type
                        </button>
                    </div>

                    <div id="tableMain">
                        <table class="table table-striped table-bordered" style="width:100%"></table>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<!-- ADD / EDIT MODAL -->
<div class="modal fade" id="accountTypeModal" tabindex="-1">
    <div class="modal-dialog modal-md">
        <div class="modal-content">

            <div class="modal-header bg-warning text-white">
                <h5 class="modal-title text-white" id="accountTypeModalTitle">Add Account Type</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="accountTypeId" value="0" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Type Name</label>
                        <input type="text" id="typeName" class="form-control" placeholder="e.g. Cash" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Type Code</label>
                        <input type="text" id="typeCode" class="form-control" placeholder="e.g. CASH" />
                    </div>

                    <div class="col-md-12">
                        <label class="form-label">Description</label>
                        <textarea id="typeDescription" class="form-control" rows="2"></textarea>
                    </div>
                </div>
            </div>

            <div class="modal-footer d-flex justify-content-between align-items-center">

                <!-- LEFT SIDE: Is Active Switch -->
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="isActiveSwitch" checked>
                    <label class="form-check-label" for="isActiveSwitch">Active</label>
                </div>

                <!-- RIGHT SIDE: Buttons -->
                <div>
                    <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                    <button class="btn btn-outline-warning ms-2" id="btnSaveAccountType">Save</button>
                </div>

            </div>

        </div>
    </div>
</div>

<!-- DELETE MODAL -->
<div class="modal fade zoomIn" id="deleteRecordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title text-white">Delete Confirmation</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="text-center mt-2">
                    <h4>Are you sure?</h4>
                    <p class="text-muted">Delete this account type?</p>
                </div>
                <div class="d-flex gap-2 justify-content-center mt-4 mb-2">
                    <button type="button" class="btn w-sm btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn w-sm btn-outline-danger" id="delete-record">Yes, Delete!</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(function () {
        fetchData();

        // Add button
        $(document).on('click', '#btn-add', function () {
            const canAdd = (sessionStorage.getItem('CanAdd') || localStorage.getItem('CanAdd')) === 'true';
            if (!canAdd) {
                Swal.fire("Access Denied", "You do not have permission to Add.", "error");
                return;
            }
            resetForm();
            $('#accountTypeModalTitle').text('Add Account Type');
            $('#accountTypeModal').modal('show');
        });

        // Edit button
        $(document).on('click', '.btn-edit', function () {
            const canEdit = (sessionStorage.getItem('CanEdit') || localStorage.getItem('CanEdit')) === 'true';
            if (!canEdit) {
                Swal.fire("Access Denied", "You do not have permission to Edit.", "error");
                return;
            }

            const table = $('#tableMain table').DataTable();
            const row = $(this).closest('tr');
            const rowData = table.row(row).data();

            resetForm();

            $('#accountTypeId').val(rowData.Id);
            $('#typeName').val(rowData.TypeName);
            $('#typeCode').val(rowData.TypeCode);
            $('#isActiveSwitch').prop("checked", rowData.IsActive);
            $('#typeDescription').val(rowData.Description);

            $('#accountTypeModalTitle').text('Edit Account Type');
            $('#accountTypeModal').modal('show');
        });

        // Save
        $('#btnSaveAccountType').on('click', function () {
            // validation
            const name = $('#typeName').val().trim();
            if (!name) {
                Swal.fire("Validation", "Type Name is required", "warning");
                return;
            }

            const payload = {
                Id: Number($('#accountTypeId').val() || 0),
                TypeName: name,
                TypeCode: $('#typeCode').val().trim() || null,
                Description: $('#typeDescription').val().trim() || null,
                IsActive: $('#isActiveSwitch').is(":checked"),
                ActionBy: sessionStorage.getItem('userId') ?? 0
            };

            $('#btnSaveAccountType').prop('disabled', true);
            $.ajax({
                url: '/api/AccountTypeMaster/SaveAccountType', // change controller route if required
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (res) {
                    if (res && (res.status === 'Success' || (res.status && res.status.toLowerCase() === 'success'))) {

                        Swal.fire({
                            position: "top-end",
                            icon: "success",
                            title: "Deleted !!",
                            showConfirmButton: false,
                            timer: 900
                        });

                        $('#accountTypeModal').modal('hide');
                        fetchData();
                    } else {
                        Swal.fire("Error", res?.message || 'Save failed', "error");
                    }
                },
                error: function (xhr, status, error) {
                    handleApiError(xhr, status, error, "Save AccountType Error");
                },
                complete: function () {
                    $('#btnSaveAccountType').prop('disabled', false);
                }
            });
        });

        // Delete click
        $(document).on('click', '.btn-delete', function () {
            const canDelete = (sessionStorage.getItem('CanDelete') || localStorage.getItem('CanDelete')) === 'true';
            if (!canDelete) {
                Swal.fire("Access Denied", "You do not have permission to Delete.", "error");
                return;
            }

            const table = $('#tableMain table').DataTable();
            const row = $(this).closest('tr');
            const rowData = table.row(row).data();

            $('#deleteRecordModal').data('id', rowData.Id).modal('show');
        });

        // Delete confirm
        $('#delete-record').on('click', function () {
            const id = $('#deleteRecordModal').data('id');
            const payload = { Id: id, ActionBy: sessionStorage.getItem('userId') ?? 0 };

            $('#delete-record').prop('disabled', true);
            $.ajax({
                url: '/api/AccountTypeMaster/DeleteAccountType', // change controller route if required
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (res) {
                    if (res && res.status === 'Success') {
                        Swal.fire({ icon: 'success', title: 'Deleted', showConfirmButton: false, timer: 900 });
                        fetchData();
                        $('#deleteRecordModal').modal('hide');
                    } else {
                        Swal.fire("Error", res?.message || 'Delete failed', "error");
                    }
                },
                error: function (xhr, status, error) {
                    handleApiError(xhr, status, error, "Delete AccountType Error");
                },
                complete: function () {
                    $('#delete-record').prop('disabled', false);
                }
            });
        });
    });

    // Fetch data
    function fetchData() {
        $.ajax({
            url: '/api/AccountTypeMaster/GetAccountTypeList',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ Id: 0 }),
            success: function (res) {
                const data = (res && res.data) ? res.data : [];
                renderTable(data);
            },
            error: function (xhr, status, error) {
                handleApiError(xhr, status, error, "Fetch AccountType Error");
            }
        });
    }

    // Render table
    function renderTable(data) {
        if ($.fn.dataTable.isDataTable('#tableMain table')) {
            $('#tableMain table').DataTable().clear().destroy();
        }

        if (!data || data.length === 0) {
            // initialize empty table with headers
            $('#tableMain table').DataTable({
                data: [],
                columns: [
                    { data: 'srno', title: 'Sr. No.' },
                    { data: 'TypeName', title: 'Type Name' },
                    { data: 'TypeCode', title: 'Code' },
                    { data: 'IsActive', title: 'Active', render: function(d){ return d ? 'Yes' : 'No'; } },

                    {
                        data: null,
                        title: 'Actions',
                        render: function () {
                            return `
                                <button class="btn btn-outline-warning btn-sm btn-edit"><i class="fa fa-edit"></i></button>
                                <button class="btn btn-outline-danger btn-sm btn-delete"><i class="fa fa-trash"></i></button>
                            `;
                        }
                    }
                ],
                columnDefs: [{ targets: 0, className: 'text-center' }],
                pageLength: 10,
                ordering: true,
                searching: true,
                lengthChange: false
            });
            return;
        }

        data.forEach((x, i) => x.srno = i + 1);

        $('#tableMain table').DataTable({
            data: data,
            columns: [
                { data: 'srno', title: 'Sr. No.' },
                { data: 'TypeName', title: 'Type Name' },
                { data: 'TypeCode', title: 'Code' },
                {
                    data: 'IsActive',
                    title: 'Status',
                    render: function (data) {
                        return data
                            ? `<span class="badge bg-success">Active</span>`
                            : `<span class="badge bg-danger">Inactive</span>`;
                    }
                },
                {
                    data: null,
                    title: 'Actions',
                    render: function () {
                        return `
                            <div class="d-flex gap-2">
                                <button class="btn btn-outline-warning btn-action-xs btn-edit"><i class="fa fa-edit"></i></button>
                                <button class="btn btn-outline-danger btn-action-xs btn-delete"><i class="fa fa-trash"></i></button>
                            </div>`;
                    }
                }
            ],
            columnDefs: [{ targets: 0, className: 'text-center' }],
            pageLength: 10,
            ordering: true,
            searching: true,
            lengthChange: false
        });
    }

    function resetForm() {
        $('#accountTypeId').val(0);
        $('#typeName').val('');
        $('#typeCode').val('');
        $('#typeDescription').val('');
        $('#isActiveSwitch').prop("checked", true);
    }
</script>
