@{
    ViewData["Title"] = "Status Master";
    Layout = "_Layout";
}

<link href="/assets2/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<script src="/assets2/js/jquery.dataTables.min.js"></script>
<script src="/assets2/js/dataTables.bootstrap5.min.js"></script>

<div class="content">
    <div class="pb-1">
        <div class="row g-2">
            <div class="col-12 col-xxl-8">
                <div class="mb-12">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="mb-0 text-warning">Status Master</h4>
                        <button class="btn btn-outline-warning" id="btn-add">
                            <i class="fa fa-plus-circle"></i> Add Status
                        </button>
                    </div>

                    <div id="tableStatusMaster">
                        <table class="table table-striped table-bordered" style="width:100%"></table>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>


<!-- ADD / EDIT STATUS MODAL -->
<div class="modal fade" id="statusModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning text-white">
                <h5 class="modal-title text-white" id="statusModalTitle">Add Status</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="statusId" value="0" />

                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label">Status Type <span class="text-danger">*</span></label>
                        <input type="text" id="txtStatusType" class="form-control" placeholder="Enter Status Type" />
                    </div>

                    <div class="col-12">
                        <label class="form-label">Status Name <span class="text-danger">*</span></label>
                        <input type="text" id="txtStatusName" class="form-control" placeholder="Enter Status Name" />
                    </div>

                    <div class="col-12">
                        <label class="form-label">Priority No</label>
                        <input type="number" id="txtPriorityNo" class="form-control" placeholder="Enter Priority No" />
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                <button class="btn btn-outline-warning" id="btnSaveStatus">Save</button>
            </div>
        </div>
    </div>
</div>



<!-- DELETE MODAL -->
<div class="modal fade zoomIn" id="deleteRecordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title text-white" id="deleteRecordModalLabel">Delete Confirmation</h5> <!-- Added Title -->
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" id="btn-close"></button>
            </div>
            <div class="modal-body">
                <div class="mt-2 text-center">
                    <lord-icon src="/assets/js/gsqxdxog.json" trigger="loop" colors="primary:#f7b84b,secondary:#f06548" style="width:100px;height:100px"></lord-icon>
                    <div class="mt-4 pt-2 fs-15 mx-4 mx-sm-5">
                        <h4>Are you Sure ?</h4>
                        <p class="text-muted mx-4 mb-0">Delete this record?</p>
                    </div>
                </div>
                <div class="d-flex gap-2 justify-content-center mt-4 mb-2">
                    <button type="button" class="btn w-sm btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn w-sm btn-outline-danger" id="delete-record">Yes, Delete It!</button>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- END MODAL -->


<script>
$(document).ready(function () {
    fetchStatusData();

    // ADD Button
    $(document).on('click', '#btn-add', function () {
        const canAdd = (sessionStorage.getItem('CanAdd') || localStorage.getItem('CanAdd')) === 'true';
        if (!canAdd) {
            Swal.fire("Access Denied", "You do not have permission to Add.", "error");
            return;
        }
        resetStatusForm();
        $('#statusModalTitle').text('Add Status');
        $('#statusModal').modal('show');
    });

    // SAVE
    $('#btnSaveStatus').on('click', function () {
        const type = $('#txtStatusType').val().trim();
        const name = $('#txtStatusName').val().trim();

        if (!type || !name) {
        Swal.fire("Validation", "Status Type & Status Name are required!", "warning");
        return;
        }

        const payload = {
        Id: Number($('#statusId').val() || 0),
        StatusType: type,
        StatusName: name,
        PriorityNo: Number($('#txtPriorityNo').val() || 0),
        ActionBy: sessionStorage.getItem('userId') ?? 0
        };
        $('#btnSaveStatus').prop("disabled", true);
        $.ajax({
            url: "/api/StatusMaster/SaveStatusMaster",
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify(payload),
            success: function (res) {
                    if (res?.status === "Success") {
                    Swal.fire({
                        icon: "success",
                        title: "Saved!",
                        showConfirmButton: false,
                        timer: 1000
                    });

                    $('#statusModal').modal('hide');
                    fetchStatusData();
                    } else {
                    Swal.fire("Error", res?.message || "Save failed", "error");
                    }
            },
            complete: function () {
                  $('#btnSaveStatus').prop("disabled", false);
            }
        });
    });

    // EDIT BUTTON
    $(document).on('click', '.btn-edit-status', function () {
        const canEdit = (sessionStorage.getItem('CanEdit') || localStorage.getItem('CanEdit')) === 'true';
        if (!canEdit) {
            Swal.fire("Access Denied", "You do not have permission to Edit.", "error");
            return;
        }
        const table = $('#tableStatusMaster table').DataTable();
        const rowData = table.row($(this).closest('tr')).data();

        resetStatusForm();
        $('#statusId').val(rowData.Id);
        $('#txtStatusType').val(rowData.StatusType);
        $('#txtStatusName').val(rowData.StatusName);
        $('#txtPriorityNo').val(rowData.PriorityNo);

        $('#statusModalTitle').text("Edit Status");
        $('#statusModal').modal('show');
    });

    // Delete button click
    $(document).on('click', '.btn-delete', function () {
        const canDelete = (sessionStorage.getItem('CanDelete') || localStorage.getItem('CanDelete')) === 'true';
        if (!canDelete) {
            Swal.fire("Access Denied", "You do not have permission to Delete.", "error");
            return;
        }
        let table = $('#tableStatusMaster table').DataTable();
        let rowData = table.row($(this).closest('tr')).data();
        $("#deleteRecordModal")
            .data("id", rowData.Id)
            .modal("show");
    });

    // Confirm Delete
    $("#delete-record").click(function () {
        let id = $("#deleteRecordModal").data("id");
        let payload = {
            Id: id,
            ActionBy: sessionStorage.getItem("userId") ?? 0
        };
        $('#btn-loader').show();
        $.ajax({
            url: "/api/StatusMaster/DeleteStatusMaster",
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify(payload),

            success: function (response) {
                if (typeof response === "string") {
                    response = JSON.parse(response);
                }
                if (response.status === "Success") {

                    Swal.fire({
                        position: "top-end",
                        icon: "success",
                        title: "Leave Type Deleted!",
                        showConfirmButton: false,
                        timer: 1000
                    });

                } else {
                    Swal.fire("Delete Failed", response.message, "error");
                }

                $("#deleteRecordModal").modal("hide");
                    fetchStatusData(); // reload updated list
            },
            error: function (xhr, status, error) {
                handleApiError(xhr, status, error, "Delete Leave Type Error");
            },
            complete: function () {
                $('#btn-loader').hide();
            }
        });
    });

});

function resetStatusForm() {
$('#statusId').val(0);
$('#txtStatusType').val('');
$('#txtStatusName').val('');
$('#txtPriorityNo').val('');
}

function fetchStatusData() {
    $.ajax({
        url: "/api/StatusMaster/GetStatusMaster",
        type: "POST",
        contentType: "application/json",
        data: JSON.stringify({ Id: 0, StatusType: null }),
        success: function (res) {
        renderStatusTable(res?.data || []);
        }
    });
}

function renderStatusTable(data) {
    if ($.fn.dataTable.isDataTable('#tableStatusMaster table')) {
    $('#tableStatusMaster table').DataTable().clear().destroy();
    }

    data.forEach((x, i) => x.srno = i + 1);
    $('#tableStatusMaster table').DataTable({
        data: data,
        columns: [
            { data: "srno", title: "Sr No" },
            { data: "StatusType", title: "Status Type" },
            { data: "StatusName", title: "Status Name" },
            { data: "PriorityNo", title: "Priority" },
            {
            data: null,
                title: "Actions",
                render: () => `
                    <button class="btn btn-outline-warning btn-sm btn-edit-status  btn-action-xs"><i class="fa fa-edit"></i></button>
                    <button class="btn btn-outline-danger btn-sm btn-delete  btn-action-xs"><i class="fa fa-trash"></i></button>
                 `
            }
        ]
    });
}

</script>