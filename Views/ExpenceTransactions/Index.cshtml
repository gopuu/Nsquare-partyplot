@{
    ViewData["Title"] = "Expense Transactions";
    Layout = "_Layout";
}
<link href="/assets2/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<script src="/assets2/js/jquery.dataTables.min.js"></script>
<script src="/assets2/js/dataTables.bootstrap5.min.js"></script>

<div class="content">
    <div class="pb-1">
        <div class="row g-2">
            <div class="col-12 col-xxl-6">
                <div class="mb-12">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="mb-0 text-warning">Expense Transactions</h4>
                        <button class="btn btn-outline-warning" id="btn-add-transactions">
                            <i class="fa fa-plus-circle"></i> Add Expense Transactions
                        </button>
                    </div>

                    <div id="tableTransactions">
                        <table class="table table-striped table-bordered" style="width:100%"></table>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="ExpenceTransactionModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <!-- HEADER -->
            <div class="modal-header bg-warning text-white">
                <h5 class="modal-title text-white" id="ExpenceTransactionModalTitle">Add Expense Transaction</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <!-- BODY -->
            <div class="modal-body">
                <input type="hidden" id="ExpenceTransactionId" value="0">

                <div class="mb-3">
                    <label class="form-label">Account<span class="text-danger">*</span></label>
                    <select id="ddlAccount" class="form-select">
                        <option value="">-- Select Account --</option>
                        <!-- populate options dynamically -->
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Category<span class="text-danger">*</span></label>
                    <select id="ddlExpenceCategory" class="form-select">
                        <option value="">-- Select Category --</option>
                        <!-- populate options dynamically -->
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">SubCategory</label>
                    <select id="ddlSubCategory" class="form-select">
                        <option value="">-- Select SubCategory --</option>
                        <!-- populate options dynamically -->
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Amount<span class="text-danger">*</span></label>
                    <input type="number" id="txtAmount" class="form-control" placeholder="Enter Amount">
                </div>

                <div class="mb-3">
                    <label class="form-label">Transaction Date<span class="text-danger">*</span></label>
                    <input type="date" id="txtTransactionDate" class="form-control">
                </div>

                <div class="mb-3">
                    <label class="form-label">Payment Mode</label>
                    <input type="text" id="txtPaymentMode" class="form-control" placeholder="Enter Payment Mode">
                </div>

                <div class="mb-3">
                    <label class="form-label">Reference No</label>
                    <input type="text" id="txtReferenceNo" class="form-control" placeholder="Enter Reference No">
                </div>

                <div class="mb-3">
                    <label class="form-label">Notes</label>
                    <textarea id="txtNotes" class="form-control" rows="3"></textarea>
                </div>
            </div>

            <!-- FOOTER -->
            <div class="modal-footer">
                <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                <button class="btn btn-outline-warning" id="btnSaveExpenceTransaction">Save</button>
            </div>
        </div>
    </div>
</div>

<!-- DELETE MODAL -->
<div class="modal fade zoomIn" id="deleteRecordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title text-white" id="deleteRecordModalLabel">Delete Confirmation</h5> <!-- Added Title -->
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" id="btn-close"></button>
            </div>
            <div class="modal-body">
                <div class="mt-2 text-center">
                    <lord-icon src="/assets/js/gsqxdxog.json" trigger="loop" colors="primary:#f7b84b,secondary:#f06548" style="width:100px;height:100px"></lord-icon>
                    <div class="mt-4 pt-2 fs-15 mx-4 mx-sm-5">
                        <h4>Are you Sure ?</h4>
                        <p class="text-muted mx-4 mb-0">Delete this record?</p>
                    </div>
                </div>
                <div class="d-flex gap-2 justify-content-center mt-4 mb-2">
                    <button type="button" class="btn w-sm btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn w-sm btn-outline-danger" id="delete-record">Yes, Delete It!</button>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- END MODAL -->


<script>
    $(document).ready(function () {
     //fetchData();
    loadExpenceCategoryDropdown();
    loadExpenceSubCategoryDropdown();
    loadAccountDropdown();
    loadAccountDropdown();
    fetchExpenceTransactions();

     const today = new Date().toISOString().split('T')[0];
    document.getElementById('txtTransactionDate').value = today;

    // Add button click
    $("#btn-add-transactions").click(function () {
            resetFormFields();
            $("#ExpenceTransactionModalTitle").text("Add Expence Transactions");
            $("#txtTransactionDate").val(new Date().toISOString().split('T')[0]); // set today
            $("#ExpenceTransactionModal").modal("show");
        });

    // Save Expence Transaction
    $("#btnSaveExpenceTransaction").click(function (e) {
        e.preventDefault();
        // Basic validation
        if ($("#ddlAccount").val() === "") {
            Swal.fire("Validation", "Please select Account", "warning");
            return;
        }
        if ($("#ddlCategory").val() === "") {
            Swal.fire("Validation", "Please select Category", "warning");
            return;
        }
        if ($("#txtAmount").val().trim() === "" || parseFloat($("#txtAmount").val()) <= 0) {
        Swal.fire("Validation", "Amount must be greater than 0", "warning");
        return;
        }
        if ($("#txtTransactionDate").val() === "") {
        Swal.fire("Validation", "Please select Transaction Date", "warning");
        return;
        }
           let payload = {
            Id: $("#ExpenceTransactionId").val(),
            AccountId: $("#ddlAccount").val(),
            CategoryId: $("#ddlExpenceCategory").val(), // Corrected
            SubCategoryId: $("#ddlSubCategory").val() || null,
            Amount: parseFloat($("#txtAmount").val()),
            TransactionDate: $("#txtTransactionDate").val(),
            PaymentMode: $("#txtPaymentMode").val().trim() || null,
            ReferenceNo: $("#txtReferenceNo").val().trim() || null,
            Notes: $("#txtNotes").val().trim() || null,
            ActionBy: sessionStorage.getItem("userId") ?? 0
        };
            console.log("SAVE PAYLOAD:", payload);
        $.ajax({
        url: "/api/ExpenseTransactions/SaveExpenseTransaction",
        type: "POST",
        contentType: "application/json",
        data: JSON.stringify(payload),
        success: function (response) {
            if (response.status === "Success") {
                Swal.fire({
                    position: "top-end",
                    icon: "success",
                    title: "Saved!",
                    showConfirmButton: false,
                    timer: 1000
                });
                // Reset form & hide modal
                resetFormFields();
                $("#ExpenceTransactionModal").modal("hide");

                // Reload table or data
                fetchExpenceTransactions();
            } else {
                Swal.fire("Error", response.message, "error");
            }
        },
        error: function (xhr, status, error) {
               handleApiError(xhr, status, error, "Save ExpenceTransaction Error")
        }
    });
    });

    // Edit button click for Expence Transactions
    $(document).on('click', '.btn-edit', function (event) {
        var canEdit = (sessionStorage.getItem('CanEdit') || localStorage.getItem('CanEdit')) === 'true';
        if (!canEdit) {
            Swal.fire({
                icon: "error",
                title: "Access Denied",
                text: "You don't have permission to Edit. Please contact admin.",
                confirmButtonText: "OK"
            });
            event.preventDefault();
            return;
        }

        resetFormFields(); // Clear previous values

        // Get the DataTable instance
        var table = $('#tableTransactions table').DataTable();

        // Get the row object for the clicked Edit button
        var row = $(this).closest('tr');
        var rowData = table.row(row).data(); // Get the data object for this row

        // Fill modal fields with selected row data
        $("#ExpenceTransactionId").val(rowData.Id);

        // Load Account dropdown first, then select value
        loadAccountDropdown(rowData.AccountId);

        // Load Expence Category dropdown, then select value
        loadExpenceCategoryDropdown(rowData.CategoryId);

        // Load SubCategory based on selected category, then select value
        loadExpenceSubCategoryDropdown(rowData.CategoryId, rowData.SubCategoryId);

        $("#txtAmount").val(rowData.Amount);

        // Format date as yyyy-mm-dd
        if (rowData.TransactionDate) {
            let date = new Date(rowData.TransactionDate);
            let yyyy = date.getFullYear();
            let mm = ("0" + (date.getMonth() + 1)).slice(-2);
            let dd = ("0" + date.getDate()).slice(-2);
            $("#txtTransactionDate").val(`${yyyy}-${mm}-${dd}`);
        } else {
            $("#txtTransactionDate").val(new Date().toISOString().split('T')[0]);
        }

        $("#txtPaymentMode").val(rowData.PaymentMode);
        $("#txtReferenceNo").val(rowData.ReferenceNo);
        $("#txtNotes").val(rowData.Notes);

        // Update modal title
        $("#ExpenceTransactionModalTitle").text("Edit Expence Transaction");

        // Show modal
        $('#ExpenceTransactionModal').modal('show');
    });

    // Delete button click in table
    $(document).on("click", ".btn-delete", function () {
    // Get DataTable instance
    var table = $("#tableTransactions table").DataTable(); // make sure this matches your table id
    var rowData = table.row($(this).closest("tr")).data();

    if (!rowData || !rowData.Id) {
        Swal.fire("Error", "Unable to get selected row data.", "error");
        return;
    }

    // Store Id in modal using jQuery data
    $("#deleteRecordModal").data("id", rowData.Id).modal("show");
    });

    // Confirm delete
    $("#delete-record").click(function () {
    var id = $("#deleteRecordModal").data("id");

    if (!id) {
        Swal.fire("Error", "Record Id not found.", "error");
        return;
    }

    let payload = {
        Id: id,
        ActionBy: sessionStorage.getItem("userId") ?? 0
    };

        $.ajax({
            url: "/api/ExpenseTransactions/DeleteExpenseTransaction",
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify(payload),
            success: function (response) {
                if (response.status === "Success") {
                    Swal.fire("Deleted!", response.message, "success");
                    $("#deleteRecordModal").modal("hide");

                    // Reload table
                    fetchExpenceTransactions();
                } else {
                    Swal.fire("Error", response.message, "error");
                }
            },
                error: function (xhr) {
                        handleApiError(xhr, status, error, "Delete ExpenceTransaction Error")
            },
        });
    });

    });

    // Optional: Reset form fields
    function resetFormFields() {
        $("#ExpenceTransactionId").val(0);
        $("#ddlAccount").val("");
        $("#ddlCategory").val("");
        $("#ddlSubCategory").val("");
        $("#txtAmount").val("");
        $("#txtTransactionDate").val("");
        $("#txtPaymentMode").val("");
        $("#txtReferenceNo").val("");
        $("#txtNotes").val("");
    }

    function loadExpenceCategoryDropdown(selectedId = "") {
        $.ajax({
            url: "/api/ExpenseCategory/GetExpenseCategoryList",
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify({ Id: 0 }),
            success: function (response) {

                let dropdown = $("#ddlExpenceCategory");
                dropdown.empty(); // clear previous values

                dropdown.append(`<option value="">-- Select Expence Category --</option>`);

                response.data.forEach(item => {
                    dropdown.append(
                        `<option value="${item.Id}" ${selectedId == item.Id ? "selected" : ""}>
                            ${item.CategoryName}
                        </option>`
                    );
                });
            },
            error: function (xhr, status, error) {
                handleApiError(xhr, status, error, "Dropdown Load Error");
            }
        });
    }

    // Load SubCategory dropdown based on selected Expence Category
    function loadExpenceSubCategoryDropdown(categoryId = 0, selectedId = "") {
            if (!categoryId) {
                $("#ddlSubCategory").empty().append('<option value="">-- Select SubCategory --</option>');
                return;
            }
            $.ajax({
                url: "/api/ExpenseSubCategory/GetExpenseSubCategoryList",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify({ Id: 0, CategoryId: categoryId }),
                success: function (response) {
                    let dropdown = $("#ddlSubCategory");
                    dropdown.empty();
                    dropdown.append('<option value="">-- Select SubCategory --</option>');

                    response.data.forEach(item => {
                        dropdown.append(
                            `<option value="${item.Id}" ${selectedId == item.Id ? "selected" : ""}>
                                ${item.SubCategoryName}
                            </option>`
                        );
                    });
                },
                error: function (xhr, status, error) {
                    console.error("Error loading SubCategories:", error);
                }
            });
        }

    // Trigger SubCategory load when Expence Category changes
    $("#ddlExpenceCategory").change(function () {
        let selectedCategoryId = $(this).val();
        loadExpenceSubCategoryDropdown(selectedCategoryId);
    });

    // Load Account dropdown dynamically
    function loadAccountDropdown(selectedId = "") {
        $.ajax({
            url: "/api/AccountMaster/GetAccount",
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify({ Id: 0 }), // 0 = fetch all accounts
            success: function (response) {
                let dropdown = $("#ddlAccount");
                dropdown.empty(); // clear previous values
                dropdown.append('<option value="">-- Select Account --</option>');

                if (response.status === "Success" && response.data.length > 0) {
                    response.data.forEach(item => {
                        dropdown.append(
                            `<option value="${item.Id}" ${selectedId == item.Id ? "selected" : ""}>
                                ${item.AccountName} (${item.AccountType})
                            </option>`
                        );
                    });
                }
            },
            error: function (xhr, status, error) {
                console.error("Error loading Accounts:", error);
            }
        });
    }

    // Fetch Expence Transactions
    function fetchExpenceTransactions(accountId = 0, categoryId = 0, fromDate = "", toDate = "") {
    $('#btn-loader').show(); // optional loader

    const payload = {
        Id: 0,               // 0 = all transactions, or pass a specific Id
        AccountId: accountId,
        CategoryId: categoryId,
        FromDate: fromDate,  // format: 'yyyy-mm-dd'
        ToDate: toDate       // format: 'yyyy-mm-dd'
    };

    $.ajax({
            url: "/api/ExpenseTransactions/GetExpenseTransactionList",
        method: "POST",
        contentType: "application/json",
        data: JSON.stringify(payload),
        success: function (response) {
            console.log("Expence Transactions:", response);
            var data = response.data || [];
            renderExpenceTransactionTable(data);
        },
        error: function (xhr, status, error) {
            handleApiError(xhr, status, error, "Get Expence Transactions Error");
        },
        complete: function() {
            $('#btn-loader').hide();
        }
    });
    }

    // Render DataTable
    function renderExpenceTransactionTable(data) {
        if ($.fn.dataTable.isDataTable("#tableTransactions  table")) {
            $("#tableTransactions  table").DataTable().destroy();
    }

    // Add Sr No
    data.forEach((x, i) => x.srno = i + 1);

        $("#tableTransactions  table").DataTable({
        data: data,
        columns: [
            { data: "srno", title: "Sr. No.", className: "text-center" },
            { data: "AccountName", title: "Account" },
            { data: "CategoryName", title: "Category" },
            { data: "SubCategoryName", title: "SubCategory" },
            { data: "Amount", title: "Amount", className: "text-end" },
            { data: "TransactionDate", title: "Transaction Date" },
            { data: "PaymentMode", title: "Payment Mode" },
            { data: "ReferenceNo", title: "Reference No" },
            { data: "Notes", title: "Notes" },
            {
                data: null,
                title: "Actions",
                render: (row) => `
                    <button class="btn btn-outline-warning btn-edit"><i class="fa fa-edit"></i></button>
                    <button class="btn btn-outline-danger btn-delete"><i class="fa fa-trash"></i></button>
                `
            }
        ],
        pageLength: 10,
        ordering: true,
        searching: true,
        lengthChange: false,
        pagingType: "full_numbers"
    });
    }

</script>