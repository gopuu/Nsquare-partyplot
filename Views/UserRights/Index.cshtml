@{
    ViewData["Title"] = "User Rights";
    Layout = "_Layout";
}

<div class="container-fluid page-content">
    <div class="card shadow-sm">
        <div class="card-header bg-warning d-flex justify-content-between align-items-center py-2 px-3">
            <h5 class="mb-0 text-white">User Rights</h5>

            <div class="d-flex gap-3 align-items-stretch">
                <select id="ddlStaff" class="form-select form-select-sm"></select>

                <button class="btn btn-outline-light btn-sm d-flex align-items-center px-4" id="btnSave">
                    <i class="fa fa-save me-2"></i>
                    Save
                </button>
            </div>
        </div>

        <div class="card-body">
            <div id="noStaffMsg" class="text-center text-muted py-5">
                <h5 class="mb-2">Select Staff for access rights.</h5>
                <small>Please choose an employee from the dropdown above</small>
            </div>

            <div id="rightsMainContent" class="row g-3 d-none">

                <!-- MODULE RIGHTS -->
                <div class="col-xl-7 col-lg-12">
                    <div class="rights-section h-100">
                        <div class="rights-section-header">
                            <div>
                                <h6 class="mb-0">Module Access Rights</h6>
                                <small>Manage module permissions for selected staff</small>
                            </div>
                        </div>

                        <ul class="nav nav-tabs mt-1" id="rightsTabs" role="tablist"></ul>

                        <div class="tab-content p-0" id="rightsTabsContent"></div>
                    </div>
                </div>

                <!-- SOP RIGHTS -->
                <div class="col-xl-5 col-lg-12">
                    <div class="rights-section">
                        <div class="rights-section-header">
                            <div>
                                <h6 class="mb-0">SOP Access Rights</h6>
                                <small>Control which documents staff can view</small>
                            </div>

                            <div class="form-check mb-0">
                                <input type="checkbox" class="form-check-input" id="chkSOPSelectAll">
                                <label class="form-check-label small" for="chkSOPSelectAll">
                                    View All
                                </label>
                            </div>
                        </div>

                        <div id="sopRightsContent">
                            <div class="text-center text-muted py-5">
                                <small>Select staff to load SOP rights.</small>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/assets2/js/UserRights/UserRights.js" asp-append-version="true"></script>
}

@section Styles {
    <link href="~/assets2/css/UserRights/UserRights.css" rel="stylesheet" asp-append-version="true" />
}
