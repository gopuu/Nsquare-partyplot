@{
    ViewData["Title"] = "Expense Category Master";
    Layout = "_Layout";
}
<link href="/assets2/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<script src="/assets2/js/jquery.dataTables.min.js"></script>
<script src="/assets2/js/dataTables.bootstrap5.min.js"></script>
@section Styles {
    <link href="~/assets2/css/customdatatable/customdatatable.css" asp-append-version="true" rel="stylesheet" />

}


<!-- MAIN -->
<div class="content">
    <div class="pb-1">
        <div class="row g-2">
            <div class="col-12 col-xxl-12">
                <div class="mb-12">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="mb-0 text-warning">Expense Category Master</h4>
                        <button class="btn btn-outline-warning" id="btn-add">
                            <i class="fa fa-plus-circle"></i> Add Expense Category
                        </button>
                    </div>

                    <div id="tableMain">
                        <table class="table table-striped table-bordered" style="width:100%"></table>
                    </div>

                </div>
            </div>
        </div>
    </div>

</div>

<!-- MODAL -->
<div class="modal fade" id="expenseModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header bg-warning text-white">
                <h5 class="modal-title text-white" id="expenseModalTitle">Add Expense Category</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="expenseCategoryId" value="0">

                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label">Category Name <span class="text-danger">*</span></label>
                        <input type="text" id="categoryName" class="form-control" placeholder="Enter Category Name">
                    </div>

                    <div class="col-12">
                        <label class="form-label">Description</label>
                        <textarea id="categoryDescription" class="form-control" placeholder="Enter Description"></textarea>
                    </div>
                </div>
            </div>

            <div class="modal-footer d-flex justify-content-end">
                <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                <button class="btn btn-outline-warning" id="btnSaveExpenseCategory">Save</button>
            </div>

        </div>
    </div>
</div>

<!-- DELETE MODAL -->
<div class="modal fade zoomIn" id="deleteRecordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title text-white" id="deleteRecordModalLabel">Delete Confirmation</h5> <!-- Added Title -->
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" id="btn-close"></button>
            </div>
            <div class="modal-body">
                <div class="mt-2 text-center">
                    <lord-icon src="/assets2/js/gsqxdxog.json" trigger="loop" colors="primary:#f7b84b,secondary:#f06548" style="width:100px;height:100px"></lord-icon>
                    <div class="mt-4 pt-2 fs-15 mx-4 mx-sm-5">
                        <h4>Are you Sure ?</h4>
                        <p class="text-muted mx-4 mb-0">Delete this record?</p>
                    </div>
                </div>
                <div class="d-flex gap-2 justify-content-center mt-4 mb-2">
                    <button type="button" class="btn w-sm btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn w-sm btn-outline-danger" id="delete-record">Yes, Delete It!</button>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- END MODAL -->

<script>

$(document).ready(function () {
    fetchData();
    // Add button click
    $(document).on('click', '#btn-add', function (event) {
        // Check Add Permission from Session or Local Storage
        var canAdd = (sessionStorage.getItem('CanAdd') || localStorage.getItem('CanAdd')) === 'true';
        if (!canAdd) {
            // Display Access Denied Message
            Swal.fire({
                icon: "error",
                title: "Access Denied",
                text: "You don't have permission to Add. Please contact admin.",
                confirmButtonText: "OK"
            });
            event.preventDefault(); // Stop the modal from opening
            $('#expenseModal').modal('hide');
        } else {
            resetFormFields(); // Reset form fields when modal is shown
            $("#expenseModalTitle").text("Add Expense Category");
            $("#expenseModal").modal("show");
        }
    });

    $("#btnSaveExpenseCategory").click(function (e) {
    e.preventDefault();
    if (!validateExpenseForm()) return;
    let payload = {
        Id: $("#expenseCategoryId").val(),
        CategoryName: $("#categoryName").val().trim(),
        Description: $("#categoryDescription").val().trim(),
        ActionBy: sessionStorage.getItem("userId") ?? 0
    };
    $.ajax({
        url: "/api/ExpenseCategory/SaveExpenseCategory",
        type: "POST",
        contentType: "application/json",
        data: JSON.stringify(payload),
        success: function (response) {
            var obj = response;
            if (obj.status.toLowerCase() == "success") {
                handleApiSuccess("Saved");
                fetchData();
                resetFormFields();
                $("#expenseModal").modal("hide");
            } else {
                $('#message').removeAttr('hidden');
                $('#message').text(obj.message).css('color', 'red').fadeIn(300).delay(5000).fadeOut(300);
            }                       
        },
        error: function (xhr, status, error) {
            handleApiError(xhr, status, error, "Save Expense Category Error")
        }
    });

    });

    $(document).on("click", ".btn-edit", function () {
            resetFormFields();

            let table = $("#tableMain table").DataTable();
            let rowData = table.row($(this).closest("tr")).data();

            $("#expenseCategoryId").val(rowData.Id);
            $("#categoryName").val(rowData.CategoryName);
            $("#categoryDescription").val(rowData.Description);

            $("#expenseModalTitle").text("Edit Expense Category");
            $("#expenseModal").modal("show");
        });

    // Delete button click event
    $(document).on('click', '.btn-delete', function () {
    let table = $('#tableMain table').DataTable();
    let rowData = table.row($(this).closest('tr')).data();
    $("#deleteRecordModal")
        .data("id", rowData.Id)
        .modal("show");
    });
    $("#delete-record").click(function () {
        let id = $("#deleteRecordModal").data("id");
        let payload = {
            Id: id,
            ActionBy: sessionStorage.getItem("userId") ?? 0
        };

        $('#btn-loader').show();
        $.ajax({
            url: "/api/ExpenseCategory/DeleteExpenseCategory",
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify(payload),

            success: function (response) {

                if (typeof response === "string") {
                    response = JSON.parse(response);
                }

                if (response.status === "Success") {
                    handleApiSuccess("Deleted");
                } else {
                    Swal.fire({
                        title: "Delete Failed",
                        text: response.message,
                        icon: "error"
                    });
                }

                $("#deleteRecordModal").modal("hide");
                fetchData(); // Refresh data
            },
            error: function (xhr, status, error) {
                handleApiError(xhr, status, error, "Delete Expense Category Error");
            },
            complete: function () {
                $('#btn-loader').hide();
            }
        });
    });
});

function renderTable(data) {
    //console.log("ExpenseCategory Data:", data);
    // Destroy existing DataTable if already initialized
    if ($.fn.dataTable.isDataTable('#tableMain table')) {
        $('#tableMain table').DataTable().clear().destroy();
    }

    // If no data received
    if (!data || data.length === 0) {
        $('#tableMain table').html(`
            <thead>
                <tr>
                    <th>Sr No</th>
                    <th>Category Name</th>
                    <th>Description</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td colspan="4" class="text-center fw-bold text-danger">No Data Found !!</td>
                </tr>
            </tbody>
        `);
        return;
    }

    // Add Serial Number
    data.forEach((item, index) => {
        item.srno = index + 1;
    });
    // Build DataTable
    $('#tableMain table').DataTable({
    data: data,
    columns: [
        { data: 'srno', title: 'Sr. No.' },
        { data: 'CategoryName', title: 'Category Name' },
        { data: 'Description', title: 'Description' },
        {
            data: null,
            title: 'Actions',
            render: function (data, type, row) {
                return `
                    <div class="d-flex flex-column flex-sm-row gap-2">

                        <button class="btn btn-outline-warning btn-action-xss btn-edit">
                            <i class="fa fa-edit"></i>
                        </button>

                        <button class="btn btn-outline-danger btn-action-xss btn-delete">
                            <i class="fa fa-trash"></i>
                        </button>

                    </div>
                `;
            }
        }
    ],
    columnDefs: [
        { targets: 0 },
        { targets: 3 }
    ],
    pageLength: 10,
    ordering: true,
    searching: true,
    lengthChange: false,
    pagingType: "full_numbers"
    });
}

 function fetchData() {
    $('#btn-loader').show();
    $('.search').val('');
    $.ajax({
        url: "/api/ExpenseCategory/GetExpenseCategoryList",
        method: "POST",
        contentType: "application/json",
        data: JSON.stringify({ Id: 0 }),
        success: function (response) {
            //data = response; // Store the fetched data
            console.log("response fetchData:", response);
            var data = response.data;
            renderTable(data);
        },
        error: function (xhr, status, error) {
               handleApiError(xhr, status, error, "Something went wrong fetching ExpenseCategory data.")
        }
    });
}

 function resetFormFields() {
    $("#expenseCategoryId").val(0);
    $("#categoryName").val("");
    $("#categoryDescription").val("");
}

function validateExpenseForm() {
    if ($("#categoryName").val().trim() === "") {
        Swal.fire("Validation", "Category name is required", "warning");
        return false;
    }
    return true;
}

</script>