@{
    ViewData["Title"] = "Wallet";
    Layout = "_Layout";
    var domain = Context.Request.Scheme + "://" + Context.Request.Host;
}

<link href="~/assets2/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<script src="~/assets2/js/jquery.dataTables.min.js"></script>
<script src="~/assets2/js/dataTables.bootstrap5.min.js"></script>

@*
<link href="/assets2/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<script src="/assets2/js/jquery.dataTables.min.js"></script>
<script src="/assets2/js/dataTables.bootstrap5.min.js"></script>
*@

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>


@section Styles {
    <link href="~/assets2/css/Wallet/Wallet.css" asp-append-version="true" rel="stylesheet" />
}

@section Scripts {
    <script src="~/assets2/js/Wallet/Wallet.js" asp-append-version="true"></script>
}

<div class="content">
    <div class="row g-2">

        <!-- Wallet Balance -->
        <div class="col-12 ">
            <div class="wallet-card d-flex justify-content-between align-items-center">
                <div>
                    <div class="wallet-label text-dark">Wallet Balance</div>
                    <div class="wallet-balance walletBal2" id="walletBalance">₹0.00</div>
                </div>

                <div class="recharge-container">
                    <button class="btn btn-warning d-none" id="btnRecharge">
                        <i class="fa fa-bolt"></i> Recharge
                    </button>

                    <div class="recharge-title text-warning">Quick Recharge
                        <div id="rechargeNote" class="small text-muted fw-normal mt-1 fst-italic"></div>
                    </div>
                    <div class="recharge-buttons">
                        @* <form><script src="https://checkout.razorpay.com/v1/payment-button.js" data-payment_button_id="pl_T9OiyBq5s5lL4K" async> </script> </form> *@
                        <form><script src="https://checkout.razorpay.com/v1/payment-button.js" data-payment_button_id="pl_T9PpQSlo8NqAst" async> </script> </form>
                        <form><script src="https://checkout.razorpay.com/v1/payment-button.js" data-payment_button_id="pl_T9PuXnPqLHLR0S" async> </script> </form>
                        <form><script src="https://checkout.razorpay.com/v1/payment-button.js" data-payment_button_id="pl_T9Px7sXQ8JLcBj" async> </script> </form>
                        <form><script src="https://checkout.razorpay.com/v1/payment-button.js" data-payment_button_id="pl_T9Q0cKlatZ1EVt" async> </script> </form>
                    </div>

                </div>
            </div>
        </div>

        <!-- Ledger -->
        <div class="col-12">
            <div class="card mt-3">
                <div class="card-header bg-warning py-2">
                    <h5 class="mb-0 text-white">Wallet Transactions</h5>
                </div>
                <div class="card-body p-1">
                    <table id="walletTable" class="table table-striped table-bordered" style="width:100%"></table>
                </div>
            </div>
        </div>

    </div>
</div>