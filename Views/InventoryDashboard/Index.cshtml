@{
    ViewData["Title"] = "Inventory Dashboard";
    Layout = "_Layout";
}
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

@*Inventory Dashboard*@
<div class="content">
    <div class="pb-1 d-none">
        <div class="row g-1 align-items-center">
            <div class="col-6">
                <h4 class="mb-0">Inventory Dashboard</h4>
            </div>
        </div>
    </div>

    <!-- 🔹 DASHBOARD WIDGETS -->
    <div class="row g-3 mb-4">

        <!-- 🟡 Widget 1: Key Statistics -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100 bg-warning-gradient">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="mb-0 fw-bold">Key Statistics</h6>
                        <div class="d-flex align-items-center gap-2">
                            <div class="dropdown mr-4 chart-filter-Statistics">
                                <button class="btn btn-outline-secondary btn-sm dropdown-toggle"
                                        type="button"
                                        id="jobChartFilter"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false">
                                    This Month
                                </button>

                                <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="jobChartFilter">
                                    <li><a class="dropdown-item" href="#">Yesterday</a></li>
                                    <li><a class="dropdown-item" href="#">Last 7 Days</a></li>
                                    <li><a class="dropdown-item" href="#">Last 30 Days</a></li>
                                    <li><a class="dropdown-item active" href="#">This Month</a></li>
                                    <li><a class="dropdown-item" href="#">Last Month</a></li>
                                    <li><a class="dropdown-item" href="#">Last 12 Months</a></li>
                                    <li><a class="dropdown-item" href="#">Custom Range</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-2 p-2 rounded bg-warning text-white">
                        <span>Total Sales</span>
                        <span><i class="fa fa-inr me-1"></i><span id="totalSales">0</span></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-2 p-2 rounded bg-light">
                        <span>Purchase</span>
                        <span><i class="fa fa-inr me-1"></i><span id="totalPurchase">0</span></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center p-2 rounded bg-light">
                        <span>Wastage</span>
                        <span>
                            <i class="fa fa-balance-scale me-1"></i>
                            <span id="totalWastage">0</span> Kg
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 🔵 Widget 2: COGS -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100 position-relative bg-warning-gradient">
                <div class="card-body d-flex flex-column justify-content-between h-100 position-relative">

                    <!-- 🔹 Top Bar: Title + Filter + Info -->
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="fw-bold mb-0 text-start">COGS</h6>
                        <div class="d-flex align-items-center gap-2">
                            <div class="dropdown mr-4 chart-filter-COGS">

                                <button class="btn btn-outline-secondary btn-sm dropdown-toggle"
                                        type="button"
                                        id="COGSChartFilter"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false">
                                    This Month
                                </button>

                                <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="COGSChartFilter">
                                    <li><a class="dropdown-item sort-option" data-value="yesterday" href="#">Yesterday</a></li>
                                    <li><a class="dropdown-item sort-option" data-value="last7days" href="#">Last 7 Days</a></li>
                                    <li><a class="dropdown-item sort-option" data-value="last30days" href="#">Last 30 Days</a></li>
                                    <li><a class="dropdown-item sort-option active" data-value="thismonth" href="#">This Month</a></li>
                                    <li><a class="dropdown-item sort-option" data-value="lastmonth" href="#">Last Month</a></li>
                                    <li><a class="dropdown-item sort-option" data-value="last12months" href="#">Last 12 Months</a></li>
                                    <li><a class="dropdown-item sort-option" data-value="customrange" href="#">Custom Range</a></li>
                                </ul>

                            </div>
                        </div>
                    </div>
                    <!-- 🔹 Centered Content -->
                    <div class="d-flex flex-column justify-content-center align-items-center flex-grow-1 text-center">
                        <h3 class="mb-1"><i class="fa fa-inr me-1"></i><span id="WorthofStockConsumed">0</span></h3>
                        <p class="text-muted mb-0 small">Worth of Stock Consumed</p>
                    </div>

                </div>
            </div>
        </div>

        <!-- 🟠 Widget 3: Pending Purchases -->
        <div class="col-md-3 d-none">
            <div class="card border-0 shadow-sm h-100 position-relative">
                <div class="card-body d-flex flex-column justify-content-between h-100 position-relative">

                    <!-- 🔹 Top Bar: Title + Info -->
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="mb-0 fw-semibold text-start">Pending Purchases</h6>
                        <i class="fa fa-info-circle text-muted" data-bs-toggle="tooltip" title="Pending purchase orders"></i>
                    </div>

                    <!-- 🔹 Centered Content -->
                    <div class="d-flex flex-column justify-content-center align-items-center flex-grow-1 text-center">
                        <h5 class="fw-bold text-danger mb-1">
                            <span id="pendingpurchases_msg">Coming Soon..</span>
                        </h5>
                        <h2 class="fw-bold text-danger mb-1">
                            <span id="pendingpurchases">0</span>
                        </h2>
                        <p class="text-muted small mb-0">PO's</p>
                    </div>

                    <!-- 🔹 Bottom-right Button -->
                    <div class="text-end">
                        <a href="#" class="btn btn-sm btn-outline-primary">View</a>
                    </div>

                </div>
            </div>
        </div>

        <!-- 🟣 Widget 4: Pending PO Approvals -->
        <div class="col-md-3 d-none">
            <div class="card border-0 shadow-sm h-100 position-relative">
                <div class="card-body d-flex flex-column justify-content-between h-100 position-relative">

                    <!-- 🔹 Top Bar: Title + Info -->
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="mb-0 fw-semibold text-start">Pending PO Approvals</h6>
                        <i class="fa fa-info-circle text-muted" data-bs-toggle="tooltip" title="Pending PO approvals"></i>
                    </div>

                    <!-- 🔹 Centered Content -->
                    <div class="d-flex flex-column justify-content-center align-items-center flex-grow-1 text-center">
                        <h5 class="fw-bold text-success mb-1"> <span id="pendingapprovals_msg">Coming Soon..</span> </h5>
                        <h2 class="fw-bold text-success mb-1"> <span id="pendingapprovals">0</span> </h2>
                        <p class="text-muted small mb-0">PO's</p>
                    </div>

                </div>
            </div>
        </div>

    </div>

    <!-- 🔹 SECOND ROW -->
    <div class="row g-3">

        <!-- 🟢 Widget 1: Stock Level -->
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-0">

                    <!-- Header -->
                    <div class="d-flex justify-content-between align-items-center mb-3 bg-warning-gradient rounded px-3 py-3">
                        <div>
                            <h6 class="mb-0 fw-semibold text-dark">Stock Level</h6>
                            <small class="text-muted">Current available inventory</small>
                        </div>

                        <select class="form-select form-select-sm w-auto" id="categoryFilter"></select>
                    </div>

                    <!-- Divider -->
                    <hr class="my-2">

                    <!-- Content -->
                    <div id="stockList" style="max-height:280px; overflow-y:auto;" class="p-2">
                        <div class="text-muted text-center py-4">
                            No stock data found
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- 📉 Widget 2: Stock-Out Summary (Raw Material Wise) -->
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-0">

                    <!-- Header -->
                    <div class="d-flex justify-content-between align-items-center mb-3 bg-warning-gradient rounded px-3 py-3">
                        <div>
                            <h6 class="mb-0 fw-semibold text-dark">Stock-Out Summary</h6>
                            <small class="text-muted">Raw material wise consumption</small>
                        </div>

                        <div class="d-flex align-items-center gap-2">
                            <select id="stockOutDuration"
                                    class="form-select form-select-sm w-auto">
                                <option value="yesterday">Yesterday</option>
                                <option value="days">Last 7 Days</option>
                                <option value="lastdays">Last 30 Days</option>
                                <option value="thismonth" selected>This Month</option>
                                <option value="lastmonth">Last Month</option>
                                <option value="12months">Last 12 Months</option>
                                <option value="customrange">Custom Range</option>
                            </select>

                            <input type="date"
                                   id="stockOutFromDate"
                                   class="form-control form-control-sm date-filter">

                            <span class="text-muted small">to</span>

                            <input type="date"
                                   id="stockOutToDate"
                                   class="form-control form-control-sm date-filter">
                        </div>
                    </div>

                    <!-- Divider -->
                    <hr class="my-2">

                    <!-- Content -->
                    <div class="stockout-list p-2" style="max-height:280px; overflow-y:auto;">
                        <div class="text-muted text-center py-4">
                            No stock-out data found
                        </div>
                    </div>

                </div>
            </div>
        </div>

    </div>
</div>

@section Styles {
    <link href="~/assets2/css/inventorydashboard/inventorydashboard.css" asp-append-version="true" rel="stylesheet" />
}

@section Scripts {
    <script src="~/assets2/js/inventorydashboard/inventorydashboard.js" asp-append-version="true"></script>
}