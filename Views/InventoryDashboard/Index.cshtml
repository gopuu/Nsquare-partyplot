                                    <span class="ms-2 fw-semibold supplier-name">Zarna Bhatt</span>
                                </div>
                                <button class="btn btn-sm btn-outline-primary raise-po-btn">Raise PO</button>
                            </div>
                            <div id="supplier1" class="mt-2 ms-4">
                                <p class="mb-1 small">Butter Milk - 25</p>
                                <p class="mb-1 small">Cream Milk - 18</p>
                                <p class="mb-1 small">Curd - 10</p>
                            </div>
                        </div>

                        <!-- Supplier 2 -->
                        <div class="supplier mb-3">
                            <div class="d-flex justify-content-between align-items-center border-bottom py-2 bg-light px-2 rounded">
                                <div class="d-flex align-items-center">
                                    <button class="btn btn-sm btn-outline-secondary toggle-btn" data-target="#supplier2">-</button>
                                    <span class="ms-2 fw-semibold supplier-name">Nidhi Traders</span>
                                </div>
                                <button class="btn btn-sm btn-outline-primary raise-po-btn">Raise PO</button>
                            </div>
                            <div id="supplier2" class="mt-2 ms-4">
                                <p class="mb-1 small">Salt - 5</p>
                                <p class="mb-1 small">Besan - 7</p>
                            </div>
                        </div>

                        <!-- Supplier 3 -->
                        <div class="supplier mb-3">
                            <div class="d-flex justify-content-between align-items-center border-bottom py-2 bg-light px-2 rounded">
                                <div class="d-flex align-items-center">
                                    <button class="btn btn-sm btn-outline-secondary toggle-btn" data-target="#supplier3">-</button>
                                    <span class="ms-2 fw-semibold supplier-name">Anand Foods</span>
                                </div>
                                <button class="btn btn-sm btn-outline-primary raise-po-btn">Raise PO</button>
                            </div>
                            <div id="supplier3" class="mt-2 ms-4">
                                <p class="mb-1 small">Paneer - 8</p>
                                <p class="mb-1 small">Cheese Slice - 12</p>
                                <p class="mb-1 small">Butter - 15</p>
                            </div>
                        </div>

                        <!-- Supplier 4 -->
                        <div class="supplier mb-3">
                            <div class="d-flex justify-content-between align-items-center border-bottom py-2 bg-light px-2 rounded">
                                <div class="d-flex align-items-center">
                                    <button class="btn btn-sm btn-outline-secondary toggle-btn" data-target="#supplier4">-</button>
                                    <span class="ms-2 fw-semibold supplier-name">Ramesh Distributors</span>
                                </div>
                                <button class="btn btn-sm btn-outline-primary raise-po-btn">Raise PO</button>
                            </div>
                            <div id="supplier4" class="mt-2 ms-4">
                                <p class="mb-1 small">Oil - 20</p>
                                <p class="mb-1 small">Flour - 25</p>
                            </div>
                        </div>

                        <!-- Supplier 5 -->
                        <div class="supplier mb-3">
                            <div class="d-flex justify-content-between align-items-center border-bottom py-2 bg-light px-2 rounded">
                                <div class="d-flex align-items-center">
                                    <button class="btn btn-sm btn-outline-secondary toggle-btn" data-target="#supplier5">-</button>
                                    <span class="ms-2 fw-semibold supplier-name">Sunrise Supplies</span>
                                </div>
                                <button class="btn btn-sm btn-outline-primary raise-po-btn">Raise PO</button>
                            </div>
                            <div id="supplier5" class="mt-2 ms-4">
                                <p class="mb-1 small">Juice Pack - 9</p>
                                <p class="mb-1 small">Soft Drink - 15</p>
                                <p class="mb-1 small">Water Bottle - 30</p>
                                <p class="mb-1 small">Lassi - 6</p>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <!-- 🧾 Widget 2: Supplier List -->
        <script>
            // ✅ Toggle supplier details (+/-)
            document.querySelectorAll('.toggle-btn').forEach(btn => {
              btn.addEventListener('click', function () {
                const target = document.querySelector(this.dataset.target);
                const isVisible = target.style.display !== "none";
                target.style.display = isVisible ? "none" : "block";
                this.textContent = isVisible ? "+" : "-";
              });
            });

            // ✅ Raise PO button click event
            document.querySelectorAll('.raise-po-btn').forEach(btn => {
              btn.addEventListener('click', function () {
                const supplierName = this.closest('.supplier').querySelector('.supplier-name').textContent.trim();
                console.log("Raise PO clicked for:", supplierName);
              });
            });
        </script>

    </div>
</div>

