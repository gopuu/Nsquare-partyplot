                </div>
            </div>
        </div>

        <!-- 🟠 Widget 3: Pending Purchases -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100 position-relative">
                <div class="card-body d-flex flex-column justify-content-between h-100 position-relative">

                    <!-- 🔹 Top Bar: Title + Info -->
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="mb-0 fw-semibold text-start">Pending Purchases</h6>
                        <i class="fa fa-info-circle text-muted" data-bs-toggle="tooltip" title="Pending purchase orders"></i>
                    </div>

                    <!-- 🔹 Centered Content -->
                    <div class="d-flex flex-column justify-content-center align-items-center flex-grow-1 text-center">
                        <h2 class="fw-bold text-danger mb-1">12</h2>
                        <p class="text-muted small mb-0">PO's</p>
                    </div>

                    <!-- 🔹 Bottom-right Button -->
                    <div class="text-end">
                        <a href="#" class="btn btn-sm btn-outline-primary">View</a>
                    </div>

                </div>
            </div>
        </div>

        <!-- 🟣 Widget 4: Pending PO Approvals -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100 position-relative">
                <div class="card-body d-flex flex-column justify-content-between h-100 position-relative">

                    <!-- 🔹 Top Bar: Title + Info -->
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="mb-0 fw-semibold text-start">Pending PO Approvals</h6>
                        <i class="fa fa-info-circle text-muted" data-bs-toggle="tooltip" title="Pending PO approvals"></i>
                    </div>

                    <!-- 🔹 Centered Content -->
                    <div class="d-flex flex-column justify-content-center align-items-center flex-grow-1 text-center">
                        <h2 class="fw-bold text-success mb-1">0</h2>
                        <p class="text-muted small mb-0">PO's</p>
                    </div>

                </div>
            </div>
        </div>

    </div>

    <!-- 🔹 SECOND ROW -->
    <div class="row g-3">

        <!-- 🟢 Widget 1: Stock Level -->
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="mb-0 fw-semibold">Stock Level</h6>
                        <select class="form-select form-select-sm w-auto" id="categoryFilter">
                            <option value="all">All Categories</option>
                            <option value="dairy">Dairy</option>
                            <option value="beverages">Beverages</option>
                        </select>
                    </div>

                    <div id="stockList"></div>
                </div>
            </div>
        </div>

        <!-- 🟢 Widget 1: Stock Level -->
        <script>
            const stockData = [
              { name: "500ml Butter Milk", count: 25, category: "dairy" },
              { name: "Cream Milk", count: 18, category: "dairy" },
              { name: "Amul 7 Up", count: 10, category: "beverages" },
              { name: "Paneer Block", count: 7, category: "dairy" },
              { name: "Cheese Slice", count: 5, category: "dairy" },
              { name: "Curd", count: 3, category: "dairy" },
              { name: "Lassi", count: 1, category: "beverages" },
            ];

            const limit = 5;

            function renderStockList(filter = "all") {
              const container = document.getElementById("stockList");
              container.innerHTML = "";

              // Filter and sort descending by count
              let filtered = stockData
                .filter(item => filter === "all" || item.category === filter)
                .sort((a, b) => b.count - a.count);

              filtered.forEach(item => {
                const ratio = Math.min(item.count / limit, 1); // Cap at 100%
                const percent = ratio * 100;
                const barColor = ratio >= 1 ? "#ffc107" : "#ffc107"; // warning color
                const emptyColor = "#f8f9fa";

                const stockItem = `
                  <div class="mb-3">
                    <div class="d-flex justify-content-between">
                      <span class="fw-semibold small">${item.name}</span>
                      <span class="small text-muted">${item.count}</span>
                    </div>
                    <div class="progress" style="height: 8px; background-color: ${emptyColor}; border-radius: 5px;">
                      <div class="progress-bar" role="progressbar"
                           style="width: ${percent}%; background-color: ${barColor};"
                           aria-valuenow="${percent}" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                  </div>
                `;

                container.insertAdjacentHTML("beforeend", stockItem);
              });
            }

            // Initial render
            renderStockList();

            // Category filter
            document.getElementById("categoryFilter").addEventListener("change", function () {
              renderStockList(this.value);
            });
        </script>

        <!-- 🧾 Widget 2: Supplier List -->
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h6 class="fw-semibold mb-3">Suppliers & Items</h6>

                    <!-- Scrollable supplier list -->
                    <div class="supplier-list" style="max-height: 300px; overflow-y: auto;">

                        <!-- Supplier 1 -->
                        <div class="supplier mb-3">
