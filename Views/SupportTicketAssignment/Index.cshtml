@{
    ViewData["Title"] = "Support Ticket Assignment";
    Layout = "_Layout";
}

<link href="/assets2/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<script src="/assets2/js/jquery.dataTables.min.js"></script>
<script src="/assets2/js/dataTables.bootstrap5.min.js"></script>


<!-- MAIN -->
<div class="content">
    <div class="pb-1">
        <div class="row g-2">
            <div class="col-12">
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="mb-0 text-warning">Support Ticket Assignment</h4>
                        <button class="btn btn-outline-warning" id="btn-add">
                            <i class="fa fa-plus-circle"></i> Add Ticket Assignment
                        </button>
                    </div>

                    <div id="tableAssignments">
                        <table class="table table-striped table-bordered w-100"></table>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>



<div class="modal fade" id="AssignmentModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning text-white">
                <h5 class="modal-title text-white" id="AssignmentModalTitle">Add Support Ticket Assignment</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="AssignmentId" value="0" />

                <div class="mb-3">
                    <label class="form-label">Ticket <span class="text-danger">*</span></label>
                    <select id="TicketId" class="form-select">
                        <option value="">-- Select Support Ticket --</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Assigned To <span class="text-danger">*</span></label>
                    <select id="ddlStaff" class="form-select">
                        <option value="">-- Select Staff --</option>
                    </select>
                </div>
               
            </div>

            <div class="modal-footer d-flex justify-content-between align-items-center">
                <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" id="IsActive" checked>
                    <label class="form-check-label" for="IsActive">Active</label>
                </div>

                <div>
                    <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                    <button class="btn btn-outline-warning" id="btnSaveAssignment">Save</button>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- DELETE MODAL -->
<div class="modal fade" id="deleteRecordModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title text-white">Delete Confirmation</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body text-center">
                <h4>Are you sure?</h4>
                <p class="text-muted">Delete this ticket type?</p>

                <div class="d-flex justify-content-center gap-2">
                    <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                    <button class="btn btn-outline-danger" id="delete-record">Yes, Delete</button>
                </div>
            </div>
        </div>
    </div>
</div>



@section Scripts {

    <script src="~/assets2/js/supportticketassignment/supportticketassignment.js" asp-append-version="true"></script>

}



