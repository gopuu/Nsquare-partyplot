@{
    ViewData["Title"] = "TaskComments";
    Layout = "_Layout";
}

<link href="/assets2/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<script src="/assets2/js/jquery.dataTables.min.js"></script>
<script src="/assets2/js/dataTables.bootstrap5.min.js"></script>

<div class="content">
    <div class="pb-1">
        <div class="row g-2">
            <div class="col-12 col-xxl-8">
                <div class="mb-12">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="mb-0 text-warning">Task Comments </h4>
                        <button class="btn btn-outline-warning" id="btn-add">
                            <i class="fa fa-plus-circle"></i> Add Task Comments
                        </button>
                    </div>

                    <div id="tableTaskCommets">
                        <table class="table table-striped table-bordered" style="width:100%"></table>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="TaskCommentModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning text-white">
                <h5 class="modal-title text-white" id="taskCommentModalTitle">Add Task Comment</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="TaskCommentId" value="0" />
                <div class="row g-3">
                    <div class="col-md-12">
                        <label class="form-label">Task</label>
                        <select id="ddlTaskId" class="form-select"></select>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Comment Text</label>
                        <input type="text" id="TaskCommenttext" class="form-control" placeholder="Enter Comment Text" />
                    </div>
                </div>
            </div>
            <div class="modal-footer d-flex  align-items-center">
                <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                <button class="btn btn-outline-warning ms-2" id="btnSaveComment">Save</button>
            </div>
        </div>
    </div>
</div>

<!-- DELETE MODAL -->
<div class="modal fade zoomIn" id="deleteRecordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title text-white" id="deleteRecordModalLabel">Delete Confirmation</h5> <!-- Added Title -->
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" id="btn-close"></button>
            </div>
            <div class="modal-body">
                <div class="mt-2 text-center">
                    <lord-icon src="/assets/js/gsqxdxog.json" trigger="loop" colors="primary:#f7b84b,secondary:#f06548" style="width:100px;height:100px"></lord-icon>
                    <div class="mt-4 pt-2 fs-15 mx-4 mx-sm-5">
                        <h4>Are you Sure ?</h4>
                        <p class="text-muted mx-4 mb-0">Delete this record?</p>
                    </div>
                </div>
                <div class="d-flex gap-2 justify-content-center mt-4 mb-2">
                    <button type="button" class="btn w-sm btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn w-sm btn-outline-danger" id="delete-record">Yes, Delete It!</button>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- END MODAL -->



<script>
$(document).ready(function () {
    loadTaskDropdown();
    resetTaskCommentForm();
    loadComments();

    $("#btn-add").click(function () {
        const canAdd = (sessionStorage.getItem("CanAdd") === "true");
        if (!canAdd) return Swal.fire("Access Denied", "You cannot Add.", "error");

         resetTaskCommentForm();
        $("#taskCommentModalTitle").text("Add Task Comment");
        $("#TaskCommentModal").modal("show");
    });

    // ➤ Save Comment
    $("#btnSaveComment").click(function () {

        let text = $("#TaskCommenttext").val().trim();
        let taskId = Number($("#ddlTaskId").val());

        const payload = {
            Id: Number($("#TaskCommentId").val() || 0),
            TaskId: taskId,
            CommentText: text,
            CommentedBy: sessionStorage.getItem("userId") ?? 0,
            ActionBy: sessionStorage.getItem("userId") ?? 0
        };

        $.ajax({
            url: "/api/TaskComments/SaveTaskComments",
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify(payload),
            success: function (res) {
                if (res.status === "Success") {
                    Swal.fire({
                        icon: "success",
                        title: "Saved!",
                        position: "top-end",
                        showConfirmButton: false,
                        timer: 1000
                    });
                    loadComments();
                    $("#TaskCommentModal").modal("hide");
                } else {
                    Swal.fire("Error", res.message, "error");
                }
            }
        });
    });

    // ➤ Edit
    $(document).on("click", ".btn-edit-comment", function () {

        // Get selected row data
        let row = $("#tableTaskCommets table")
            .DataTable()
            .row($(this).closest("tr"))
            .data();

        // Reset form first (optional but recommended)
        resetTaskCommentForm();

        // Fill modal fields
        $("#TaskCommentId").val(row.Id);
        $("#TaskCommenttext").val(row.CommentText);

        // Select task from dropdown
        $("#ddlTaskId").val(row.TaskId).trigger("change");

        // Update modal title
        $("#taskCommentModalTitle").text("Edit Task Comment");

        // Show modal
        $("#TaskCommentModal").modal("show");
    });

     // ----------------- DELETE BUTTON -----------------
    $(document).on("click", ".btn-delete", function () {

        const canDelete =
            (sessionStorage.getItem('CanDelete') || localStorage.getItem('CanDelete')) === 'true';

        if (!canDelete) {
            Swal.fire("Access Denied", "You do not have permission to Delete.", "error");
            return;
        }

        let table = $("#tableTaskCommets table").DataTable();
        let rowData = table.row($(this).closest("tr")).data();

        // Store ID inside modal
        $("#deleteRecordModal")
            .data("id", rowData.Id)
            .modal("show");
    });

    // ----------------- CONFIRM DELETE -----------------
    $("#delete-record").click(function () {

        let id = $("#deleteRecordModal").data("id");

        const payload = {
            Id: id,
            ActionBy: sessionStorage.getItem("userId") ?? 0
        };

        $.ajax({
            url: "/api/TaskComments/DeleteTaskComments",
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify(payload),
            success: function (res) {

                if (res?.status === "Success") {
                    Swal.fire({
                        position: "top-end",
                        icon: "success",
                        title: "Deleted Successfully!",
                        showConfirmButton: false,
                        timer: 1000
                    });
                } else {
                    Swal.fire("Delete Failed", res?.message || "Unable to delete", "error");
                }

                $("#deleteRecordModal").modal("hide");

                // Reload Comments
                loadComments();
            },
            error: function (xhr, status, error) {
                Swal.fire("Error", "Unable to delete record", "error");
            }
        });
    });


});

function loadTaskDropdown() {
    $.ajax({
        url: "/api/TaskMaster/GetTaskMaster",
        type: "POST",
        contentType: "application/json",
        data: JSON.stringify({ Id: 0 }),
        success: function (res) {
            let options = `<option value="">-- Select Task --</option>`;
            res.data.forEach(task => {
                options += `<option value="${task.Id}">${task.TaskTitle}</option>`;
            });
            $("#ddlTaskId").html(options);
        }
    });
}


function resetTaskCommentForm() {
    $("#TaskCommentId").val(0);             // Reset hidden ID
    $("#ddlTaskId").val("").change();       // Reset dropdown
    $("#TaskCommenttext").val("");          // Clear comment textbox

    $("#taskCommentModalTitle").text("Add Task Comment");  // Reset modal title
}

function renderCommentTable(data) {

    // Destroy if exists
    if ($.fn.dataTable.isDataTable("#tableTaskCommets table")) {
        $("#tableTaskCommets table").DataTable().destroy();
    }

    // Add Sr No
    data.forEach((x, i) => x.srno = i + 1);

    // Initialize DataTable
    $("#tableTaskCommets table").DataTable({
        data: data,
        columns: [
            { data: "srno", title: "Sr No" },
            { data: "CommentText", title: "Comment" },
            { data: "TaskTitle", title: "Task" },
            {
                data: null,
                title: "Actions",
                render: () => `
                    <button class="btn btn-outline-warning btn-action-xs btn-edit-comment">
                        <i class="fa fa-edit"></i>
                    </button>
                        <button class="btn btn-outline-danger btn-action-xs btn-delete">
                        <i class="fa fa-trash"></i>
                    </button>
                `
            }
        ]
    });
}

function loadComments(taskId = 0) {
    $.ajax({
        url: "/api/TaskComments/GetTaskComments",
        type: "POST",
        contentType: "application/json",
        data: JSON.stringify({ TaskId: taskId }),
        success: function (res) {

            if (res.status === "Success") {
                renderCommentTable(res.data);
            } else {
                Swal.fire("Error", res.message, "error");
            }
        }
    });
}


</script>