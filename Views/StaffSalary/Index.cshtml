@{
    ViewData["Title"] = "Staff Salary";
    Layout = "_Layout";
}

<link href="/assets2/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<script src="/assets2/js/jquery.dataTables.min.js"></script>
<script src="/assets2/js/dataTables.bootstrap5.min.js"></script>

<div class="content">
    <div class="pb-1">
        <div class="row g-2">
            <div class="col-12 col-xxl-12">
                <div class="mb-12">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="mb-0 text-warning">Staff Salary</h4>
                        <button class="btn btn-outline-warning" id="btn-add">
                            <i class="fa fa-plus-circle"></i> Add Staff Salary
                        </button>
                    </div>

                    <div id="tableStaffSalary">
                        <table class="table table-striped table-bordered" style="width:100%"></table>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="staffSalaryModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <!-- HEADER -->
            <div class="modal-header bg-warning text-white">
                <h5 class="modal-title text-white" id="staffSalaryModalTitle">Add Staff Salary</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <!-- BODY -->
            <div class="modal-body">
                <input type="hidden" id="salaryId" value="0">

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Staff<span class="text-danger">*</span></label>
                        <select id="ddlStaff" class="form-select">
                            <option value="">-- Select Staff --</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Salary Month<span class="text-danger">*</span></label>
                        <input type="month" id="txtSalaryMonth" class="form-control">
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Basic Salary<span class="text-danger">*</span></label>
                        <input type="number" id="txtBasicSalary" class="form-control" placeholder="Enter Amount">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Deduction</label>
                        <input type="number" id="txtDeductions" class="form-control" placeholder="Enter Deduction">
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Status<span class="text-danger">*</span></label>
                        <select id="ddlStatus" class="form-select">
                            <option value="">-- Select Status --</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Paid Date</label>
                        <input type="date" id="txtPaidDate" class="form-control">
                    </div>
                </div>

            </div>

            <!-- FOOTER -->
            <div class="modal-footer">
                <button class="btn btn-outline-dark" data-bs-dismiss="modal">Close</button>
                <button class="btn btn-outline-warning" id="btnSaveStaffSalary">Save</button>
            </div>
        </div>
    </div>
</div>

<!-- DELETE MODAL -->
<div class="modal fade zoomIn" id="deleteRecordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title text-white" id="deleteRecordModalLabel">Delete Confirmation</h5> <!-- Added Title -->
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" id="btn-close"></button>
            </div>
            <div class="modal-body">
                <div class="mt-2 text-center">
                    <lord-icon src="/assets/js/gsqxdxog.json" trigger="loop" colors="primary:#f7b84b,secondary:#f06548" style="width:100px;height:100px"></lord-icon>
                    <div class="mt-4 pt-2 fs-15 mx-4 mx-sm-5">
                        <h4>Are you Sure ?</h4>
                        <p class="text-muted mx-4 mb-0">Delete this record?</p>
                    </div>
                </div>
                <div class="d-flex gap-2 justify-content-center mt-4 mb-2">
                    <button type="button" class="btn w-sm btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn w-sm btn-outline-danger" id="delete-record">Yes, Delete It!</button>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- END MODAL -->
@section Scripts {
    <script src="~/assets2/js/staffsalary/staffsalary.js" asp-append-version="true"></script>

}

@section Styles {
    <link href="~/assets2/css/customdatatable/customdatatable.css" rel="stylesheet" />
}