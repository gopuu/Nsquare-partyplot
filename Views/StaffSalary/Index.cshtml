@{
    ViewData["Title"] = "Staff Salary";
    Layout = "_Layout";
}

<link href="/assets2/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<script src="/assets2/js/jquery.dataTables.min.js"></script>
<script src="/assets2/js/dataTables.bootstrap5.min.js"></script>

<div class="content">
    <div class="pb-1">
        <div class="row g-2">
            <div class="col-12 col-xxl-12">
                <div class="mb-12">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="mb-0 text-warning">Staff Salary</h4>
                        <button class="btn btn-outline-warning" id="btn-add">
                            <i class="fa fa-plus-circle"></i> Add Staff Salary
                        </button>
                    </div>

                    <div id="tableStaffSalary">
                        <table class="table table-striped table-bordered" style="width:100%"></table>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>



<div class="modal fade" id="staffSalaryModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <!-- HEADER -->
            <div class="modal-header bg-warning text-white">
                <h5 class="modal-title text-white" id="staffSalaryModalTitle">Add Staff Salary</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <!-- BODY -->
            <div class="modal-body">
                <input type="hidden" id="salaryId" value="0">

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Staff<span class="text-danger">*</span></label>
                        <select id="ddlStaff" class="form-select">
                            <option value="">-- Select Staff --</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Salary Month<span class="text-danger">*</span></label>
                        <input type="month" id="txtSalaryMonth" class="form-control">
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Basic Salary<span class="text-danger">*</span></label>
                        <input type="number" id="txtBasicSalary" class="form-control" placeholder="Enter Amount">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Deduction</label>
                        <input type="number" id="txtDeductions" class="form-control" placeholder="Enter Deduction">
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Status<span class="text-danger">*</span></label>
                        <select id="ddlStatus" class="form-select">
                            <option value="">-- Select Status --</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Paid Date</label>
                        <input type="date" id="txtPaidDate" class="form-control">
                    </div>
                </div>

            </div>

            <!-- FOOTER -->
            <div class="modal-footer">
                <button class="btn btn-outline-dark" data-bs-dismiss="modal">Close</button>
                <button class="btn btn-outline-warning" id="btnSaveStaffSalary">Save</button>
            </div>
        </div>
    </div>
</div>

<!-- DELETE MODAL -->
<div class="modal fade zoomIn" id="deleteRecordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title text-white" id="deleteRecordModalLabel">Delete Confirmation</h5> <!-- Added Title -->
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" id="btn-close"></button>
            </div>
            <div class="modal-body">
                <div class="mt-2 text-center">
                    <lord-icon src="/assets/js/gsqxdxog.json" trigger="loop" colors="primary:#f7b84b,secondary:#f06548" style="width:100px;height:100px"></lord-icon>
                    <div class="mt-4 pt-2 fs-15 mx-4 mx-sm-5">
                        <h4>Are you Sure ?</h4>
                        <p class="text-muted mx-4 mb-0">Delete this record?</p>
                    </div>
                </div>
                <div class="d-flex gap-2 justify-content-center mt-4 mb-2">
                    <button type="button" class="btn w-sm btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn w-sm btn-outline-danger" id="delete-record">Yes, Delete It!</button>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- END MODAL -->


<script>
function loadStaffDropdown(selectedId = null) {
$.ajax({
    url: "/api/StaffMaster/GetStaffMaster",
    type: "POST",
    contentType: "application/json",
    data: JSON.stringify({ Id: 0 }),
    success: function (response) {
        let ddl = $("#ddlStaff");
        ddl.empty().append(`<option value="">-- Select Staff --</option>`);

        response.data.forEach(staff => {
            ddl.append(`<option value="${staff.Id}">${staff.Name}</option>`);
        });

        if (selectedId) ddl.val(selectedId);
    },
    error: function (xhr, status, error) {
                handleApiError(xhr, status, error, "Failed to load dropdown data");
        }
});
}

function loadStatusDropdown(selectedId = null) {
$.ajax({
    url: "/api/StatusMaster/GetStatusMaster",
    type: "POST",
    contentType: "application/json",
    data: JSON.stringify({ Id: 0, StatusType: "Salary" }),
    success: function (response) {
        let ddl = $("#ddlStatus");
        ddl.empty().append(`<option value="">-- Select Status --</option>`);

        response.data.forEach(status => {
            ddl.append(`<option value="${status.Id}">${status.StatusName}</option>`);
        });

        if (selectedId) ddl.val(selectedId);
    },
    error: function (xhr, status, error) {
                handleApiError(xhr, status, error, "Failed to load dropdown data");
        }
});
}

function resetStaffSalaryFields() {
    $("#salaryId").val(0);
    $("#ddlStaff").val("");
    $("#txtSalaryMonth").val("");
    $("#txtBasicSalary").val("");
    $("#txtDeductions").val("");
    $("#ddlStatus").val("");
    $("#txtPaidDate").val(new Date().toISOString().split('T')[0]);
}

$(document).ready(function () {
    resetStaffSalaryFields();
    loadStaffDropdown();
    loadStatusDropdown();
    fetchStaffSalary();

    $("#btn-add").click(function () {
        $("#staffSalaryModalTitle").text("Add Staff Salary");

        $("#txtPaidDate").val(new Date().toISOString().split('T')[0]); // Default today

        $("#staffSalaryModal").modal("show");
    });

    $("#btnSaveStaffSalary").click(function () {

        if ($("#ddlStaff").val() === "") {
            Swal.fire("Validation", "Please select Staff", "warning");
            return;
        }

        if ($("#txtSalaryMonth").val() === "") {
            Swal.fire("Validation", "Please enter Salary Month", "warning");
            return;
        }

        if ($("#txtBasicSalary").val() === "" || parseFloat($("#txtBasicSalary").val()) <= 0) {
            Swal.fire("Validation", "Basic Salary must be greater than 0", "warning");
            return;
        }

        let payload = {
            Id: $("#salaryId").val(),
            StaffId: $("#ddlStaff").val(),
            SalaryMonth: $("#txtSalaryMonth").val(),
            BasicSalary: parseFloat($("#txtBasicSalary").val()),
            Deductions: $("#txtDeductions").val() ? parseFloat($("#txtDeductions").val()) : 0,
            StatusId: $("#ddlStatus").val() || null,
            PaidDate: $("#txtPaidDate").val() || null,
            ActionBy: sessionStorage.getItem("userId") ?? 0
        };

        $.ajax({
            url: "/api/StaffSalary/SaveStaffSalary",
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify(payload),
            success: function (response) {
                if (response.status === "Success") {
                    Swal.fire({
                        position: "top-end",
                        icon: "success",
                        title: "Saved",
                        showConfirmButton: false,
                        timer: 1000
                    });

                    resetStaffSalaryFields();
                    $("#staffSalaryModal").modal("hide");

                    fetchStaffSalary(); // reload table
                } else {
                    Swal.fire("Error", response.message, "error");
                }
            },
            error: function (xhr, status, error) {
                   handleApiError(xhr, status, error, "Save StaffSalary  Error")
            }
        });
    });

    $(document).on("click", ".btn-edit-salary", function () {

        let table = $("#tableStaffSalary table").DataTable();
        let rowData = table.row($(this).closest("tr")).data();
        resetStaffSalaryFields();

        $("#salaryId").val(rowData.Id);
        loadStaffDropdown(rowData.StaffId);
        loadStatusDropdown(rowData.StatusId);
        $("#txtSalaryMonth").val(rowData.SalaryMonth);
        $("#txtBasicSalary").val(rowData.BasicSalary);
        $("#txtDeductions").val(rowData.Deductions);
        if (rowData.PaidDate) {
            const date = new Date(rowData.PaidDate);
            const yyyy = date.getFullYear();
            const mm = String(date.getMonth() + 1).padStart(2, '0');
            const dd = String(date.getDate()).padStart(2, '0');
            $('#txtPaidDate').val(`${yyyy}-${mm}-${dd}`);
        }
        $("#staffSalaryModalTitle").text("Edit Staff Salary");
        $("#staffSalaryModal").modal("show");
    });

    // Delete button click in table
    $(document).on("click", ".btn-delete", function () {
             // Get DataTable instance
        var table = $("#tableStaffSalary table").DataTable(); // make sure this matches your table id
        var rowData = table.row($(this).closest("tr")).data();

        if (!rowData || !rowData.Id) {
            Swal.fire("Error", "Unable to get selected row data.", "error");
            return;
        }

        // Store Id in modal using jQuery data
        $("#deleteRecordModal").data("id", rowData.Id).modal("show");
        });

        // Confirm delete
        $("#delete-record").click(function () {
        var id = $("#deleteRecordModal").data("id");

        if (!id) {
            Swal.fire("Error", "Record Id not found.", "error");
            return;
        }

        let payload = {
            Id: id,
            ActionBy: sessionStorage.getItem("userId") ?? 0
        };
            $.ajax({
                url: "/api/StaffSalary/DeleteStaffSalary",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(payload),
                success: function (response) {
                    if (response.status === "Success") {
                        Swal.fire("Deleted!", response.message, "success");
                        $("#deleteRecordModal").modal("hide");
                        // Reload table
                        fetchStaffSalary();
                    } else {
                        Swal.fire("Error", response.message, "error");
                    }
                },
                error: function (xhr, status, error) {
                        handleApiError(xhr, status, error, "Something went wrong!");
                }
            });
    });

});

// Fetch Staff Salary
function fetchStaffSalary(staffId = 0) {
    $('#btn-loader').show(); // optional loader

    const payload = {
        Id: 0 // 0 = all salaries
       // StaffId: staffId
    };

    $.ajax({
        url: "/api/StaffSalary/GetStaffSalary",
        method: "POST",
        contentType: "application/json",
        data: JSON.stringify(payload),
        success: function (response) {
            var data = response.data || [];
            renderStaffSalaryTable(data);
        },
        error: function (xhr, status, error) {
                 handleApiError(xhr, status, error, "Something went wrong fetching Staff Salary");
        },
        complete: function () {
            $('#btn-loader').hide();
        }
    });
}

// Render DataTable
function renderStaffSalaryTable(data) {
    if ($.fn.dataTable.isDataTable("#tableStaffSalary table")) {
        $("#tableStaffSalary table").DataTable().destroy();
    }

    // Add Sr No
    data.forEach((x, i) => x.srno = i + 1);

    $("#tableStaffSalary table").DataTable({
        data: data,
        columns: [
            { data: "srno", title: "Sr. No.", className: "text-center" },
            { data: "StaffName", title: "Staff"},
            {
                data: "SalaryMonth",
                title: "Salary Month",
                render: function (data) {
                    if (!data) return "";
                    const months = ["January","February","March","April","May","June","July","August","September","October","November","December"];
                    let [year, m] = data.split("-");
                    return `${year}-${months[parseInt(m,10)-1]}`;
                }
            },
            { data: "BasicSalary", title: "Basic Salary", className: "text-end" },
            { data: "Deductions", title: "Deductions", className: "text-end" },
            { data: "NetSalary", title: "Net Salary", className: "text-end" },
            { data: "StatusName", title: "Status"},
            {
                data: "PaidDate",
                title: "Paid Date",
                render: function(d) {
                    if (!d) return '';
                    let date = new Date(d);
                    return date.toLocaleDateString(); // shows only date
                }
            },
            {
                data: null,
                title: "Actions",
                render: (row) => `
                    <button class="btn btn-outline-warning btn-action-xs btn-edit-salary"><i class="fa fa-edit"></i></button>
                    <button class="btn btn-outline-danger btn-action-xs btn-delete"><i class="fa fa-trash"></i></button>
                `
            }
        ],
        pageLength: 10,
        ordering: true,
        searching: true,
        lengthChange: false,
        pagingType: "full_numbers"
    });
}

</script>

