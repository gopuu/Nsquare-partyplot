@{
    ViewData["Title"] = "Feedback Detail";
    Layout = "_Layout";
}

<link href="/assets2/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<script src="/assets2/js/jquery.dataTables.min.js"></script>
<script src="/assets2/js/dataTables.bootstrap5.min.js"></script>

<div class="content">
    <div class="pb-1">
        <div class="row g-2">
            <div class="col-12 col-xxl-12">
                <div class="mb-12">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="mb-0 text-warning">Feedback Detail</h4>
                      
                    </div>

                    <div id="tableMain">
                        <table class="table table-striped table-bordered" style="width:100%"></table>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>


<script>
$(document).ready(function () {
    var feedbackId = 0;
    fetchFeedbackData(feedbackId);
});

function fetchFeedbackData(feedbackId) {
    $.ajax({
        url: '/api/Feedback/GetFeedback',
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify({ FeedbackId: feedbackId }),
        success: function (res) {
            if (res && res.status === "Success") {

                let tableData = res.data;   // 👈 FULL DATA OBJECT

                console.log("Table Data:", tableData);
                renderFeedbackTable(tableData);

            } else {
                Swal.fire("Error", res.message || "No data", "error");
            }
        },
        error: function (xhr, status, error) {
            handleApiError(xhr, status, error, "Fetch Feedback Error");
        }
    });
}
    function renderFeedbackTable(data) {

        // ✅ ensure array
        if (!Array.isArray(data)) {
            if (data && data.data && Array.isArray(data.data)) {
                data = data.data;
            } else {
                data = [];
            }
        }

        if ($.fn.dataTable.isDataTable('#tableMain table')) {
            $('#tableMain table').DataTable().clear().destroy();
        }

        if (data.length === 0) {
            $('#tableMain table').DataTable({
                data: [],
                columns: [
                    { title: 'Sr. No.' },
                    { title: 'Customer Name' },
                    { title: 'Whatsapp No' },
                    { title: 'Booking SubEvent Name' },
                    { title: 'Text Response' },
                    { title: 'Created At' }
                ]
            });
            return;
        }

        // ✅ safe now
        data.forEach((x, i) => x.srno = i + 1);

        $('#tableMain table').DataTable({
            data: data,
            columns: [
                { data: 'srno', title: 'Sr. No.', className: 'text-center' },
                { data: 'CustomerName', title: 'Customer Name' },
                { data: 'WhatsappNo', title: 'Whatsapp No' },
                { data: 'Booking_SubEventName', title: 'Booking SubEvent Name' },
                {
                    data: 'Responses',
                    title: 'Text Response',
                    render: d => d ? d : '-'
                },
                {
                    data: 'Created_At_Format',
                    title: 'Created At',
                    render: d => d ? moment(d).format('DD-MM-YYYY HH:mm') : '-'
                }
            ]
        });
    }


</script>