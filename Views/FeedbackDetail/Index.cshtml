@{
    ViewData["Title"] = "Feedback Detail";
    Layout = "_Layout";
}

<link href="/assets2/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<script src="/assets2/js/jquery.dataTables.min.js"></script>
<script src="/assets2/js/dataTables.bootstrap5.min.js"></script>
<!-- Moment.js -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.4/moment.min.js"></script>
@section Styles {
    <link href="~/assets2/css/customdatatable/customdatatable.css" asp-append-version="true" rel="stylesheet" />
}

<div class="content">
    <div class="pb-1">
        <div class="row g-2">
            <div class="col-12 col-xxl-12">
                <div class="mb-12">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="mb-0 text-warning">Feedback Detail</h4>
                      
                    </div>

                    <div id="tableMain">
                        <table class="table table-striped table-bordered" style="width:100%"></table>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/assets2/js/FeedbackDetail/FeedbackDetail.js" asp-append-version="true"></script>
}
