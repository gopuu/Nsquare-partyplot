@{
    ViewData["Title"] = "Infinity ERP";
    Layout = null;
}

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- ===============================================-->
    <!--    Document Title-->
    <!-- ===============================================-->
    <title>@ViewBag.Title</title>

    <!-- ===============================================-->
    <!--    Favicons-->
    <!-- ===============================================-->
    <link rel="apple-touch-icon" sizes="180x180" href="/assets2/img/favicons/infinity_apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/assets2/img/favicons/infinity_favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/assets2/img/favicons/infinity_favicon-16x16.png">
    <link rel="shortcut icon" type="image/x-icon" href="/assets2/img/favicons/infinity_favicon.ico">
    <link rel="manifest" href="/assets2/img/favicons/manifest.json">
    <meta name="msapplication-TileImage" content="/assets2/img/favicons/mstile-150x150.png">
    <meta name="theme-color" content="#ffffff">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>

    <link href="/assets2/css/AllInOneLink/AllInOneLink.css" asp-append-version="true" rel="stylesheet" />
    <script src="/assets2/js/AllInOneLink/AllInOneLink.js" asp-append-version="true"></script>
</head>

<div class="container-fluid page-content">
    <div class="profile-card">

        <!-- HEADER -->
        <div class="profile-header">
            <div class="logo-box">
                <img src="" class="img_logo">
            </div>

            <h4 id="propertyName">Loading...</h4>
            <h6 id="companyName"></h6>
        </div>

        <!-- BODY -->
        <div class="card-body">
            <div id="allInOneGrid" class="row">
                <!-- Dynamic icons -->
            </div>
        </div>

        <!-- FOOTER -->
        <div class="footer-section">
            <h6 id="footer_msg" class="fst-italic"></h6>

            <div class="footer-divider"></div>

            <div class="footer-credit">
                Developed with ❤️ by
                <a href="https://nsquaresoftware.in" target="_blank" class="text-white text-decoration-none fw-bold">
                    Nsquare Software Solution
                </a>
            </div>
        </div>

    </div>
</div>