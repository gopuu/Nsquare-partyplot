@{
    ViewData["Title"] = "Account Rights";
    Layout = "_Layout";
}

<div class="container-fluid page-content">
    <div class="card shadow-sm">
        <div class="card-header bg-warning py-2">
            <h5 class="mb-0 text-white">Account Rights</h5>
        </div>

        <div class="card-body">
            <div class="row">

                <!-- ================= LEFT : STAFF LIST ================= -->
                <div class="col-md-3 border-end">
                    <h6 class="fw-bold mb-2">Staff Directory</h6>

                    <input type="text" class="form-control form-control-sm mb-3"
                           id="txtSearchStaff" placeholder="Find Staff...">

                    <div id="staffList" class="staff-list">
                        <!-- JS inject -->
                    </div>
                </div>

                <!-- ================= RIGHT : ACCOUNT RIGHTS ================= -->
                <div class="col-md-9">
                    <h6 class="fw-bold mb-3">Account Access & Permissions</h6>

                    <div class="table-responsive rights-table-wrapper">
                        <table class="table rights-table">
                            <thead>
                                <tr>
                                    <th class="col-sr">#</th>
                                    <th class="col-account">Account</th>
                                    <th class="col-perm text-center">Edit</th>
                                    <th class="col-perm text-center">View</th>
                                    <th class="col-perm text-center">Transfer Funds</th>
                                </tr>
                            </thead>
                            <tbody id="rightsTableBody">
                                <!-- JS inject -->
                            </tbody>
                        </table>
                    </div>

                    <!-- 🔴 Error / Info Message -->
                    <div id="rightsMsg" class="alert alert-danger py-2 px-3 mb-2 d-none mt-2" role="alert">
                        <!-- JS inject text -->
                    </div>

                    <div class="d-flex gap-2 mt-3">
                        <button class="btn btn-warning btn-sm px-4" id="btnSave">
                            <i class="fa fa-save me-2"></i>
                            Assign Rights
                        </button>
                        <button class="btn btn-outline-secondary btn-sm px-4" id="btnClear">
                            Clear All
                        </button>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/assets2/js/AccountRights/AccountRights.js" asp-append-version="true"></script>
}

@section Styles {
    <link href="~/assets2/css/AccountRights/AccountRights.css" rel="stylesheet" asp-append-version="true" />
}
