@{
    ViewData["Title"] = "Manage Notification";
    Layout = "_Layout";
}
<link href="/assets2/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<script src="/assets2/js/jquery.dataTables.min.js"></script>
<script src="/assets2/js/dataTables.bootstrap5.min.js"></script>
@section Styles {
    <link href="~/assets2/css/customdatatable/customdatatable.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/assets2/css/notificationTemplate/notificationTemplate.css" rel="stylesheet" asp-append-version="true" />
}
@section Scripts {
    <script src="~/assets2/js/notificationTemplate/notificationTemplate.js" asp-append-version="true"></script>
}

<!-- MAIN -->
<div class="content">
    <div class="pb-1">
        <div class="row g-2">
            <div class="col-12 col-xxl-12">
                <div class="mb-12">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="mb-0 text-warning">Manage Notification</h4>
                    </div>

                    <div id="tableMain">
                        <table class="table table-striped table-bordered" style="width:100%"></table>
                    </div>

                </div>
            </div>
        </div>
    </div>

</div>

<!-- ===================================================== -->
<!-- REMINDER MODAL -->
<!-- ===================================================== -->
<div class="modal fade" id="reminderModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg">
            <!-- HEADER -->
            <div class="modal-header bg-warning text-white py-2">
                <h5 class="modal-title text-white">Manage Event Reminders</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <!-- BODY -->
            <div class="modal-body">
                <!-- ================================ -->
                <!-- FORM -->
                <!-- ================================ -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-light p-2">
                        <h6 class="mb-0 fw-bold" id="reminderModalTitle">Add / Edit Reminder</h6>
                    </div>

                    <div class="card-body">
                        <input type="hidden" id="Reminder_Id" value="0">
                        <div class="row g-3">
                            <!-- TITLE -->
                            <div class="col-lg-4">
                                <label class="form-label fw-semibold">Title</label>
                                <input type="text" class="form-control" id="Reminder_Title" placeholder="Ex: 1 Day Before">
                            </div>

                            <!-- TRIGGER DAYS -->
                            <div class="col-lg-2">
                                <label class="form-label fw-semibold">Trigger Days</label>
                                <input type="number" class="form-control" id="Reminder_TriggerDays" placeholder="Ex: 1">
                            </div>

                            <!-- TRIGGER TIME -->
                            <div class="col-lg-2">
                                <label class="form-label fw-semibold">Trigger Time</label>
                                <select class="form-control" id="Reminder_TriggerTime"></select>
                            </div>

                            <!-- ENABLE -->
                            <div class="col-lg-2">
                                <label class="form-label fw-semibold d-block">Status</label>
                                <div class="form-check form-switch mt-2">
                                    <input class="form-check-input" type="checkbox" id="Reminder_IsEnabled" checked>
                                    <label class="form-check-label" for="Reminder_IsEnabled">Enabled</label>
                                </div>
                            </div>

                            <!-- SAVE BUTTON -->
                            <div class="col-lg-2 pt-3">
                                <button type="button" class="btn btn-success px-4" id="btnSaveReminder">
                                    <i class="fa fa-save me-1"></i>
                                    Save
                                </button>
                            </div>

                        </div>
                    </div>
                </div>

                <!-- ================================ -->
                <!-- GRID -->
                <!-- ================================ -->
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-light p-2">
                        <h6 class="mb-0 fw-bold p-1">Reminder Settings</h6>
                    </div>

                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover align-middle" id="tableReminder" width="100%">
                                <thead class="table-light">
                                    <tr>
                                        <th>#</th>
                                        <th>Title</th>
                                        <th>Days</th>
                                        <th>Time</th>
                                        <th>Status</th>
                                        <th>Modified</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>