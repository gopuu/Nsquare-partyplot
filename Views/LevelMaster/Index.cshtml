@{
    ViewData["Title"] = "Level Master";
    Layout = "_Layout";
}

<link href="/assets2/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<script src="/assets2/js/jquery.dataTables.min.js"></script>
<script src="/assets2/js/dataTables.bootstrap5.min.js"></script>

<div class="content">
    <div class="pb-1">
        <div class="row g-2">
            <div class="col-12 col-xxl-8">
                <div class="mb-12">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="mb-0 text-warning">Level Master</h4>
                        <button class="btn btn-outline-warning" id="btn-add">
                            <i class="fa fa-plus-circle"></i> Add Level
                        </button>
                    </div>

                    <div id="tableMain">
                        <table class="table table-striped table-bordered" style="width:100%"></table>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<!-- ADD / EDIT MODAL -->
<div class="modal fade" id="LevelModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning text-white">
                <h5 class="modal-title text-white" id="LevelModalTitle">Add Leave Type</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="LevelId" value="0" />
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label">Level Name <span class="text-danger">*</span></label>
                        <input type="text" id="LevelName" class="form-control" placeholder="Enter Level Name" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Priority No</label>
                        <input type="number" id="priorityNo" class="form-control" placeholder="Enter Priority No" />
                    </div>
                </div>
            </div>
            <div class="modal-footer d-flex justify-content-between align-items-center">
                
                <div>
                    <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                    <button class="btn btn-outline-warning ms-2" id="btnSaveLevel">Save</button>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- DELETE MODAL -->
<div class="modal fade zoomIn" id="deleteRecordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title text-white" id="deleteRecordModalLabel">Delete Confirmation</h5> <!-- Added Title -->
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" id="btn-close"></button>
            </div>
            <div class="modal-body">
                <div class="mt-2 text-center">
                    <lord-icon src="/assets/js/gsqxdxog.json" trigger="loop" colors="primary:#f7b84b,secondary:#f06548" style="width:100px;height:100px"></lord-icon>
                    <div class="mt-4 pt-2 fs-15 mx-4 mx-sm-5">
                        <h4>Are you Sure ?</h4>
                        <p class="text-muted mx-4 mb-0">Delete this record?</p>
                    </div>
                </div>
                <div class="d-flex gap-2 justify-content-center mt-4 mb-2">
                    <button type="button" class="btn w-sm btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn w-sm btn-outline-danger" id="delete-record">Yes, Delete It!</button>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- END MODAL -->

<script>
$(document).ready(function () {
    loadLevelMasterData();
    // ----------------- ADD BUTTON CLICK -----------------
    $(document).on('click', '#btn-add', function () {

    const canAdd = (sessionStorage.getItem('CanAdd') || localStorage.getItem('CanAdd')) === 'true';
    if (!canAdd) {
    Swal.fire("Access Denied", "You do not have permission to Add.", "error");
    return;
    }

    resetLevelForm();
        $('#LevelModalTitle').text("Add Level");
        $('#LevelModal').modal('show');
    });

    // ----------------- SAVE LEVEL -----------------
    $("#btnSaveLevel").click(function () {
            let name = ($("#LevelName").val());
    console.log("levelname :",name);
    if (!name) {
        Swal.fire("Validation", "Level Name is required!", "warning");
        return;
    }

    const payload = {
        Id: Number($("#LevelId").val() || 0),
    LevelName: name,
        PriorityNo: Number($("#priorityNo").val() || 0),
    ActionBy: sessionStorage.getItem("userId") ?? 0
    };

    $("#btnSaveLevel").prop("disabled", true);

    $.ajax({
            url: "/api/LevelMaster/SaveLevelMaster",
        type: "POST",
        contentType: "application/json",
        data: JSON.stringify(payload),
        success: function (response) {
            if (response?.status === "Success") {
               Swal.fire({
                    position: "top-end",
                    icon: "success",
                    title: "Saved",
                    showConfirmButton: false,
                    timer: 1000
                });
                $('#LevelModal').modal('hide');
                loadLevelMasterData();
            } else {
                Swal.fire("Error", response?.message || "Save Failed!", "error");
            }
        },
        error: function (xhr, status, error) {
        handleApiError(xhr, status, error, "Save Level Error");
        },
        complete: function () {
        $("#btnSaveLevel").prop("disabled", false);
        }
    });
    });
    // ----------------- EDIT BUTTON -----------------
    $(document).on("click", ".btn-edit", function () {
        const canEdit = (sessionStorage.getItem('CanEdit') || localStorage.getItem('CanEdit')) === 'true';
        if (!canEdit) {
        Swal.fire("Access Denied", "You do not have permission to Edit.", "error");
        return;
        }
        let table = $("#tableMain table").DataTable();
        let row = $(this).closest("tr");
        let rowData = table.row(row).data();
        resetLevelForm();
            $("#LevelId").val(rowData.Id);
        $("#LevelName").val(rowData.LevelName);
            $("#priorityNo").val(rowData.PriorityNo);

        $('#LevelModalTitle').text("Edit Level");
        $("#LevelModal").modal("show");
    });

    // ----------------- DELETE BUTTON -----------------
    $(document).on("click", ".btn-delete", function () {
        const canDelete = (sessionStorage.getItem('CanDelete') || localStorage.getItem('CanDelete')) === 'true';
        if (!canDelete) {
        Swal.fire("Access Denied", "You do not have permission to Delete.", "error");
        return;
        }
        let table = $("#tableMain table").DataTable();
        let rowData = table.row($(this).closest("tr")).data();
        $("#deleteRecordModal")
        .data("id", rowData.Id)
        .modal("show");
    });

    // ----------------- CONFIRM DELETE -----------------
    $("#delete-record").click(function () {
        let id = $("#deleteRecordModal").data("id");
        const payload = {
        Id: id,
        ActionBy: sessionStorage.getItem("userId") ?? 0
        };
        $.ajax({
        url: "/api/LevelMaster/DeleteLevelMaster",
        type: "POST",
        contentType: "application/json",
        data: JSON.stringify(payload),
        success: function (res) {
            if (res?.status === "Success") {
                Swal.fire({
                    position: "top-end",
                    icon: "success",
                    title: "Deleted Successfully!",
                    showConfirmButton: false,
                    timer: 1000
                });
            } else {
                Swal.fire("Delete Failed", res?.message || "Unable to delete", "error");
            }

            $("#deleteRecordModal").modal("hide");
            loadLevelMasterData();
        },
        error: function (xhr, status, error) {
                 handleApiError(xhr, status, error, "Delete Level Error");
        }
        });
    });

});

// ----------------- RESET FORM -----------------
function resetLevelForm() {
        $("#LevelId").val(0);
        $("#LevelName").val('');
        $("#priorityNo").val('');
}

// ----------------- FETCH DATA -----------------
function loadLevelMasterData() {
    $.ajax({
        url: "/api/LevelMaster/GetLevelMaster",
        type: "POST",
        contentType: "application/json",
        data: JSON.stringify({ Id: 0 }),
        success: function (res) {
            renderLevelTable(res?.data || []);
        },
        error: function (xhr, status, error) {
                 handleApiError(xhr, status, error, "Fetch Level Error");
        }
    });

}

// ----------------- RENDER TABLE -----------------
function renderLevelTable(data) {

    if ($.fn.dataTable.isDataTable("#tableMain table")) {
    $("#tableMain table").DataTable().destroy();
    }
    data.forEach((item, i) => item.srno = i + 1);
    $("#tableMain table").DataTable({
        data: data,
        columns: [
            { data: "srno", title: "Sr. No." },
            { data: "LevelName", title: "Level Name" },
            { data: "PriorityNo", title: "Priority No." },
            {
            data: null,
            title: "Actions",
            render: function () {
                return `
                        <button class="btn btn-outline-warning btn-action-xs btn-sm btn-edit"><i class="fa fa-edit"></i></button>
                            <button class="btn btn-outline-danger btn-action-xs btn-sm btn-delete"><i class="fa fa-trash"></i></button>
                `;
            }
            }
        ],
        pageLength: 10,
        ordering: true,
        searching: true
    });
}
</script>
