@{
    ViewData["Title"] = "Support Ticket";
    Layout = "_Layout";
}

<link href="/assets2/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<script src="/assets2/js/jquery.dataTables.min.js"></script>
<script src="/assets2/js/dataTables.bootstrap5.min.js"></script>

@section Styles {
    <link href="~/assets2/css/customdatatable/customdatatable.css" rel="stylesheet" asp-append-version="true"/>
    <link href="~/assets2/css/SupportTicket/SupportTicket.css" rel="stylesheet" asp-append-version="true" />
}

<div class="content">
    <div class="pb-1">
        <div class="row g-2">
            <div class="col-12 col-xxl-12">
                <div class="mb-12">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="mb-0 text-warning">Support Ticket</h4>
                        <button class="btn btn-outline-warning" id="btn-add">
                            <i class="fa fa-plus-circle"></i> Add Support Ticket
                        </button>
                    </div>

                    <div id="tableMain">
                        <table class="table table-striped table-bordered" style="width:100%"></table>
                    </div>

                </div>
            </div>
        </div>
    </div>

</div>

<!-- Support Ticket Modal -->
<div class="modal fade" id="SupportTicketModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content shadow-lg border-0 rounded-3">

            <!-- Header -->
            <div class="modal-header bg-warning text-white">
                <h5 class="modal-title text-white" id="ticketModalTitle">Add Support Ticket</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <!-- Body -->
            <div class="modal-body">
                <input type="hidden" id="TicketId" value="0" />

                <div class="row g-3">

                    <div class="col-md-4">
                        <label class="form-label">Ticket Number <span class="text-danger">*</span> </label>
                        <input type="text" id="TicketNumber" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Ticket Type</label>
                        <select id="TicketTypeId" class="form-select"></select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Priority </label>
                        <select id="PriorityId" class="form-select"></select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Status </label>
                        <select id="StatusId" class="form-select"></select>
                    </div>

                    <div class="col-md-8">
                        <label class="form-label">Title </label>
                        <input type="text" id="Title" class="form-control" />
                    </div>

                    <div class="col-md-12">
                        <label class="form-label">Description </label>
                        <textarea id="Description" class="form-control" rows="4"></textarea>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="mb-0 text-primary">Ticket Attachment</h6>

                        <div>
                            <button type="button" class="btn btn-sm btn-primary" id="btnAddRow">
                                <i class="fa fa-plus"></i>
                            </button>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-bordered align-middle" id="tblDocuments">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:50px;">#</th>
                                    <th>Title</th>
                                    <th>Document File</th>
                                    <th style="width:150px;">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Dynamic rows -->
                            </tbody>
                        </table>
                    </div>


                </div>
            </div>

            <!-- Footer -->
            <div class="modal-footer d-flex justify-content-between align-items-center">

                <!-- LEFT SIDE -->
                <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" id="IsClosed">
                    <label class="form-check-label">Is Closed</label>
                </div>
                <div>
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-outline-warning" id="btnSave">Save</button>
                </div>
               
            </div>

        </div>
    </div>
</div>

<!-- DELETE MODAL -->
<div class="modal fade zoomIn" id="deleteRecordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title text-white" id="deleteRecordModalLabel">Delete Confirmation</h5> <!-- Added Title -->
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" id="btn-close"></button>
            </div>
            <div class="modal-body">
                <div class="mt-2 text-center">
                    <lord-icon src="/assets2/js/gsqxdxog.json" trigger="loop" colors="primary:#f7b84b,secondary:#f06548" style="width:100px;height:100px"></lord-icon>
                    <div class="mt-4 pt-2 fs-15 mx-4 mx-sm-5">
                        <h4>Are you Sure ?</h4>
                        <p class="text-muted mx-4 mb-0">Delete this record?</p>
                    </div>
                </div>
                <div class="d-flex gap-2 justify-content-center mt-4 mb-2">
                    <button type="button" class="btn w-sm btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn w-sm btn-outline-danger" id="delete-record">Yes, Delete It!</button>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- END MODAL -->

@section Scripts {
    <script src="~/assets2/js/supportticket/supportticket.js" asp-append-version="true"></script>
}
