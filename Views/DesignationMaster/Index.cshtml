@{
    ViewData["Title"] = "Designation Master";
    Layout = "_Layout";
}
<link href="/assets2/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<script src="/assets2/js/jquery.dataTables.min.js"></script>
<script src="/assets2/js/dataTables.bootstrap5.min.js"></script>

<!-- MAIN -->
<div class="content">
    <div class="pb-1">
        <div class="row g-2">
            <div class="col-12 col-xxl-6">
                <div class="mb-12">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="mb-0 text-warning">Designation Master</h4>
                        <button class="btn btn-outline-warning" id="btn-add">
                            <i class="fa fa-plus-circle"></i> Add Designation
                        </button>
                    </div>

                    <div id="DesignationTable">
                        <table class="table table-striped table-bordered" style="width:100%"></table>
                    </div>

                </div>
            </div>
        </div>
    </div>

</div>

<!-- ADD / EDIT DESIGNATION MODAL -->
<div class="modal fade" id="DesignationModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning text-white">
                <h5 class="modal-title text-white" id="DesignationModalTitle">Add Designation</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="DesignationId" value="0" />
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label">Designation Name <span class="text-danger">*</span></label>
                        <input type="text" id="DesignationName" class="form-control"
                               placeholder="Enter Designation Name" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Select Level <span class="text-danger">*</span></label>
                        <select id="LevelId" class="form-select">
                            <option value="">-- Select Level --</option>
                        </select>
                    </div>

                </div>
            </div>

            <div class="modal-footer d-flex  align-items-center">
                <div>
                    <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                    <button class="btn btn-outline-warning ms-2" id="btnSaveDesignation">Save</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- DELETE MODAL -->
<div class="modal fade zoomIn" id="deleteRecordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title text-white" id="deleteRecordModalLabel">Delete Confirmation</h5> <!-- Added Title -->
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" id="btn-close"></button>
            </div>
            <div class="modal-body">
                <div class="mt-2 text-center">
                    <lord-icon src="/assets/js/gsqxdxog.json" trigger="loop" colors="primary:#f7b84b,secondary:#f06548" style="width:100px;height:100px"></lord-icon>
                    <div class="mt-4 pt-2 fs-15 mx-4 mx-sm-5">
                        <h4>Are you Sure ?</h4>
                        <p class="text-muted mx-4 mb-0">Delete this record?</p>
                    </div>
                </div>
                <div class="d-flex gap-2 justify-content-center mt-4 mb-2">
                    <button type="button" class="btn w-sm btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn w-sm btn-outline-danger" id="delete-record">Yes, Delete It!</button>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- END MODAL -->


<script>
    $(document).ready(function () {
        loadDesignationData();
        loadLevelDropdown();

    // -------- ADD BUTTON --------
    $("#btn-add").click(function () {
        const canAdd = (sessionStorage.getItem('CanAdd') || localStorage.getItem('CanAdd')) === 'true';
        if (!canAdd) return Swal.fire("Access Denied", "You do not have permission to Add.", "error");

        resetDesignationForm();
        $('#DesignationModalTitle').text("Add Designation");
        $('#DesignationModal').modal('show');
    });

    // -------- SAVE DESIGNATION --------
    $("#btnSaveDesignation").click(function () {
        let name = ($("#DesignationName").val() || "").trim();
        let levelId = $("#LevelId").val();

        if (!name) return Swal.fire("Validation", "Designation Name is required!", "warning");
        if (!levelId) return Swal.fire("Validation", "Please select a Level!", "warning");

        const payload = {
            Id: Number($("#DesignationId").val() || 0),
            DesignationName: name,
            LevelId: Number(levelId),
            ActionBy: sessionStorage.getItem("userId") ?? 0
        };

        $("#btnSaveDesignation").prop("disabled", true);

        $.ajax({
            url: "/api/DesignationMaster/SaveDesignationMaster",
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify(payload),
            success: function (response) {
                if (response?.status === "Success") {

                    Swal.fire({
                        icon: "success",
                        title:  "Saved!",
                        timer: 1200,
                        showConfirmButton: false,
                        position: "top-end"
                    });

                    $('#DesignationModal').modal('hide');
                    loadDesignationData();
                }
                else {
                    Swal.fire("Error", response?.message || "Save Failed!", "error");
                }
            },
            error: function (xhr, status, error) {
                handleApiError(xhr, status, error, "Save Designation Error");
            },
            complete: function () {
                $("#btnSaveDesignation").prop("disabled", false);
            }
        });
    });

    // -------- EDIT BUTTON --------
    $(document).on("click", ".btn-edit-designation", function () {
        let table = $("#DesignationTable table").DataTable();
        let rowData = table.row($(this).closest("tr")).data();

        const canEdit = (sessionStorage.getItem('CanEdit') || localStorage.getItem('CanEdit')) === 'true';
        if (!canEdit) return Swal.fire("Access Denied", "You do not have permission to Edit.", "error");

        resetDesignationForm();

        $("#DesignationId").val(rowData.Id);
        $("#DesignationName").val(rowData.DesignationName);
        $("#LevelId").val(rowData.LevelId);

        $('#DesignationModalTitle').text("Edit Designation");
        $('#DesignationModal').modal('show');
    });

    // ----------------- DELETE BUTTON -----------------
    $(document).on("click", ".btn-delete", function () {
        const canDelete = (sessionStorage.getItem('CanDelete') || localStorage.getItem('CanDelete')) === 'true';
        if (!canDelete) {
        Swal.fire("Access Denied", "You do not have permission to Delete.", "error");
        return;
        }
        let table = $("#DesignationTable table").DataTable();
        let rowData = table.row($(this).closest("tr")).data();
        $("#deleteRecordModal")
        .data("id", rowData.Id)
        .modal("show");
    });

    // ----------------- CONFIRM DELETE -----------------
    $("#delete-record").click(function () {
        let id = $("#deleteRecordModal").data("id");
        const payload = {
        Id: id,
        ActionBy: sessionStorage.getItem("userId") ?? 0
        };
        $.ajax({
        url: "/api/DesignationMaster/DeleteDesignationMaster",
        type: "POST",
        contentType: "application/json",
        data: JSON.stringify(payload),
        success: function (res) {
            if (res?.status === "Success") {
                Swal.fire({
                    position: "top-end",
                    icon: "success",
                    title: "Deleted Successfully!",
                    showConfirmButton: false,
                    timer: 1000
                });
            } else {
                Swal.fire("Delete Failed", res?.message || "Unable to delete", "error");
            }

            $("#deleteRecordModal").modal("hide");
            loadDesignationData();
        },
        error: function (xhr, status, error) {
                    handleApiError(xhr, status, error, "Delete Level Error");
        }
        });
    });
    });

    // -------- RESET FORM --------
    function resetDesignationForm() {
        $("#DesignationId").val(0);
        $("#DesignationName").val('');
        $("#LevelId").val('');
    }

    // -------- FETCH TABLE --------
    function loadDesignationData() {
        $.ajax({
        url: "/api/DesignationMaster/GetDesignationMaster",
        type: "POST",
        contentType: "application/json",
        data: JSON.stringify({ Id: 0 }),
        success: function (res) {
            renderDesignationTable(res?.data || []);
        },
        error: function (xhr, status, error) {
            handleApiError(xhr, status, error, "Fetch Designation Error");
        }
        });
    }

    // -------- RENDER DATATABLE --------
    function renderDesignationTable(data) {
        if ($.fn.dataTable.isDataTable("#DesignationTable table"))
        $("#DesignationTable table").DataTable().destroy();

        data.forEach((item, i) => item.srno = i + 1);

        $("#DesignationTable table").DataTable({
        data: data,
        columns: [
            { data: "srno", title: "Sr.No" },
            { data: "DesignationName", title: "Designation Name" },
            { data: "LevelName", title: "Level" },
            {
                data: null, title: "Actions",
                render: () => `
                        <button class="btn btn-outline-warning btn-sm btn-action-xs btn-edit-designation"><i class="fa fa-edit"></i></button>
                        <button class="btn btn-outline-danger btn-sm btn-action-xs btn-delete"><i class="fa fa-trash"></i></button>
                          `
            }
        ],
        pageLength: 10
        });
    }

    // -------- LOAD LEVEL DROPDOWN --------
    function loadLevelDropdown() {
        $.ajax({
        url: "/api/LevelMaster/GetLevelMaster",
        type: "POST",
        contentType: "application/json",
        data: JSON.stringify({ Id: 0 }),
        success: function (res) {

            let dropdown = $("#LevelId");
            dropdown.empty().append(`<option value="">-- Select Level --</option>`);

            res?.data?.forEach(item => {
                dropdown.append(`<option value="${item.Id}">${item.LevelName}</option>`);
            });
        },
        error: function (xhr, status, error) {
            handleApiError(xhr, status, error, "Dropdown Load Error");
        }
        });
    }

</script>