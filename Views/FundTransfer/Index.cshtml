@{
    ViewData["Title"] = "Fund Transfer";
    Layout = "_Layout";
}
<link href="/assets2/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
<script src="/assets2/js/jquery.dataTables.min.js"></script>
<script src="/assets2/js/dataTables.bootstrap5.min.js"></script>

@section Styles {
    <link href="~/assets2/css/customdatatable/customdatatable.css" asp-append-version="true" rel="stylesheet" />
    <link href="~/assets2/css/report_filters/report_filters.css" rel="stylesheet" asp-append-version="true" />
}
@section Scripts {
    <script src="~/assets2/js/FundTransfer/FundTransfer.js" asp-append-version="true"></script>
}

<!--MAIN-->
<div class="content">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="text-warning mb-0">Fund Transfer</h4>

        <div class="d-flex align-items-center gap-2">

            <button class="btn btn-outline-warning btn-sm" id="btn-add-fund-transfer">
                <i class="fa fa-plus-circle"></i> Add Fund Transfer
            </button>

            <button class="btn btn-outline-warning btn-sm" id="btnToggleFilter">
                <i class="fa fa-filter me-1"></i> Filter
            </button>

            <div class="form-check form-switch mb-0">
                <input class="form-check-input" type="checkbox" id="toggleWithHeader">
                <label class="form-check-label fw-semibold" for="toggleWithHeader">
                    With Header
                </label>
            </div>

            <button class="btn btn-outline-info btn-sm" id="btn-select-columns">
                <i class="fa fa-list-check me-1"></i> Columns
            </button>

            <div class="dropdown">
                <button class="btn btn-outline-dark btn-sm dropdown-toggle"
                        type="button"
                        data-bs-toggle="dropdown">
                    <i class="fas fa-download"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li>
                        <a class="dropdown-item" href="javascript:void(0)"
                           onclick="ViewFundTransferReport('downloadPDF')">
                            <i class="fas fa-file-pdf text-danger me-2"></i> PDF
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item" href="javascript:void(0)"
                           onclick="ViewFundTransferReport('downloadExcel')">
                            <i class="fas fa-file-excel text-success me-2"></i> Excel
                        </a>
                    </li>
                </ul>
            </div>

        </div>
    </div>

    <!-- GRID -->
    <div id="tableMain">
        <table class="table table-striped table-bordered w-100">
            <tfoot>
                <tr>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>

                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>

                    <th></th>
                </tr>
            </tfoot>
        </table>
    </div>

</div>

<!-- FILTER PANEL -->
<div id="filterPanel" class="filter-panel">

    <div class="filter-header bg-warning d-flex justify-content-between align-items-center px-3 py-2">
        <h6 class="mb-0 text-white">Filters</h6>
        <button type="button" class="btn-close btn-close-white" id="btnCloseFilter"></button>
    </div>

    <div class="filter-body">

        <div class="mb-3">
            <label class="form-label">Duration</label>
            <select id="quickRange" class="form-select form-select-sm">
                <option value="thismonth">This Month</option>
                <option value="lastmonth">Last Month</option>
                <option value="days">Last 7 Days</option>
                <option value="lastdays">Last 30 Days</option>
                <option value="yesterday">Yesterday</option>
                <option value="12months">Last 12 Months</option>
                <option value="customrange">Custom Range</option>
            </select>
        </div>

        <div class="row g-2">
            <div class="col-md-6 mb-3">
                <label class="form-label">From Date</label>
                <input type="date" id="fromDate" class="form-control form-control-sm">
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">To Date</label>
                <input type="date" id="toDate" class="form-control form-control-sm">
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Amount</label>
            <input type="number" id="filter_txtAmount" class="form-select form-select-sm" placeholder="Search Amount" step="1" min="0" />
        </div>

        <div class="mb-3">
            <label class="form-label">From Account</label>
            <select id="filter_ddlFromAccount" class="form-select form-select-sm"></select>
        </div>

        <div class="mb-3">
            <label class="form-label">To Account</label>
            <select id="filter_ddlToAccount" class="form-select form-select-sm"></select>
        </div>

    </div>

    <div class="filter-footer">
        <button id="btnResetFilter" class="btn btn-outline-secondary btn-sm">Reset</button>
        <button id="btnApplyFilter" class="btn btn-warning btn-sm">Apply</button>
    </div>

</div>

<!-- COLUMNS MODAL -->
<div class="modal fade" id="modalColumns" tabindex="-1">
    <div class="modal-dialog modal-md">
        <div class="modal-content">

            <div class="modal-header bg-warning py-2">
                <h5 class="modal-title text-white">Select Columns</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="chk-select-all">
                        <label class="form-check-label fw-bold">Select All</label>
                    </div>
                    <button class="btn btn-sm btn-outline-secondary" id="btn-reset-columns">
                        <i class="fa fa-refresh"></i> Reset
                    </button>
                </div>
                <hr />
                <div id="column-list" class="row"></div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button class="btn btn-warning" id="btn-save-columns">
                    <i class="fa fa-save"></i> Save
                </button>
            </div>

        </div>
    </div>
</div>

<!-- Add Fund Transfer -->
<div class="modal fade" id="FundTransferModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header bg-warning text-white py-2">
                <h5 class="modal-title text-white" id="FundTransferModalTitle">Add Fund Transfer</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="FundTransferId" value="0">

                <div class="row g-3">

                    <div class="col-md-6">
                        <label class="form-label">From<span class="text-danger">*</span></label>
                        <select id="ddlFromAccount" class="form-select">
                            <option value="">-- Select From --</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">To<span class="text-danger">*</span></label>
                        <select id="ddlToAccount" class="form-select">
                            <option value="">-- Select To --</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Amount <span class="text-danger">*</span></label>
                        <input type="number" id="txtAmount" class="form-control" placeholder="Enter Amount">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Transfer Date <span class="text-danger">*</span></label>
                        <input type="date" id="txtTransferDate" class="form-control">
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Reference No</label>
                        <input type="text" id="txtReferenceNo" class="form-control" placeholder="Enter Reference No">
                    </div>

                    <!-- Notes full row -->
                    <div class="col-12">
                        <label class="form-label">Notes</label>
                        <textarea id="txtNotes" class="form-control" rows="3" placeholder="Write full notes..."></textarea>
                    </div>

                </div>
            </div>


            <div class="modal-footer">
                <button class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Close</button>
                <button class="btn btn-outline-warning btn-sm" id="btnSaveFundTransfer">Save</button>
            </div>
        </div>
    </div>
</div>

<!-- DELETE MODAL -->
<div class="modal fade zoomIn" id="deleteRecordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title text-white" id="deleteRecordModalLabel">Delete Confirmation</h5> <!-- Added Title -->
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" id="btn-close"></button>
            </div>
            <div class="modal-body">
                <div class="mt-2 text-center">
                    <lord-icon src="/assets2/js/gsqxdxog.json" trigger="loop" colors="primary:#f7b84b,secondary:#f06548" style="width:100px;height:100px"></lord-icon>
                    <div class="mt-4 pt-2 fs-15 mx-4 mx-sm-5">
                        <h4>Are you Sure ?</h4>
                        <p class="text-muted mx-4 mb-0">Delete this record?</p>
                    </div>
                </div>
                <div class="d-flex gap-2 justify-content-center mt-4 mb-2">
                    <button type="button" class="btn w-sm btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn w-sm btn-outline-danger" id="delete-record">Yes, Delete It!</button>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- END MODAL -->
