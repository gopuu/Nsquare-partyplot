@{
    ViewData["Title"] = "Feedback Dashboard";
    Layout = "_Layout";
}


@section Styles {
    <link href="~/assets2/css/feedbackdashboard/feedbackdashboard.css" rel="stylesheet" asp-append-version="true" />

}

<div class="content container-fluid">
    <div class="pb-5">
        <div class="row g-4">
            <div class="col-12 col-xxl-12">
                <div class="row align-items-center justify-content-between mb-2">
                    <div class="col-12">
                        <div class="mb-0">
                            <div class="header-flex">
                                <h4 class="mb-0 fw-bold">📊 Feedback & Insights</h4>
                                <div class="dropdown mr-4 chart-filter-feedback">
                                    <button class="btn btn-outline-secondary btn-sm dropdown-toggle"
                                            type="button"
                                            id="jobChartFilter"
                                            data-bs-toggle="dropdown"
                                            aria-expanded="false">
                                        This Month
                                    </button>

                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="jobChartFilter">
                                        <li><a class="dropdown-item" href="#">Yesterday</a></li>
                                        <li><a class="dropdown-item" href="#">Last 7 Days</a></li>
                                        <li><a class="dropdown-item" href="#">Last 30 Days</a></li>
                                        <li><a class="dropdown-item active" href="#">This Month</a></li>
                                        <li><a class="dropdown-item" href="#">Last Month</a></li>
                                        <li><a class="dropdown-item" href="#">Last 12 Months</a></li>
                                        <li><a class="dropdown-item" href="#">Custom Range</a></li>
                                    </ul>
                                </div>
                            </div>
                            <div class="row g-4 align-items-stretch">
                                <!--1 Total Feedback -->
                                <div class="col-lg-2 col-md-4">
                                    <div class="card metric-card">
                                        <div class="metric-top bg-feedback"></div>
                                        <div class="card-body d-flex justify-content-between align-items-center">
                                            <div>
                                                <div class="metric-title" id="lblTotalFeedback">Total Feedback</div>
                                                <div class="metric-value" id="valTotalFeedback">0</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!--2 Avg Rating -->
                                <div class="col-lg-2 col-md-4">
                                    <div class="card metric-card">
                                        <div class="metric-top bg-rating"></div>
                                        <div class="card-body d-flex justify-content-between align-items-center">
                                            <div>
                                                <div class="metric-title" id="lblAvgRating">Avg Rating</div>
                                                <div class="metric-value" id="valAvgRating">0</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!--3 AI Assisted -->
                                <div class="col-lg-2 col-md-4">
                                    <div class="card metric-card">
                                        <div class="metric-top bg-ai"></div>
                                        <div class="card-body d-flex justify-content-between align-items-center">
                                            <div>
                                                <div class="metric-title" id="lblAI">Assisted Reviews</div>
                                                <div class="metric-value" id="valAI">0</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!--4 Sentiment -->
                                <div class="col-lg-3 col-md-6">
                                    <div class="card metric-card">
                                        <div class="metric-top bg-rating"></div>
                                        <div class="card-body d-flex align-items-center py-3">
                                            <div class="row text-center w-100">
                                                <div class="col-4 border-end">
                                                    😊
                                                    <div class="metric-title text-success">Positive</div>
                                                    <div class="metric-value text-success" id="valPositive">0%</div>
                                                </div>
                                                <div class="col-4 border-end">
                                                    🙁
                                                    <div class="metric-title text-danger">Negative</div>
                                                    <div class="metric-value text-danger" id="valNegative">0%</div>
                                                </div>
                                                <div class="col-4">
                                                    😐
                                                    <div class="metric-title text-secondary">Neutral</div>
                                                    <div class="metric-value text-secondary" id="valNeutral">0%</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!--5 Host vs Visitor -->
                                <div class="col-lg-3 col-md-6">
                                    <div class="card metric-card">
                                        <div class="metric-top bg-feedback"></div>
                                        <div class="card-body py-3">

                                            <div class="row text-center small-metric-row">

                                                <!-- Hosts -->
                                                <div class="col-6 border-end">
                                                    <div class="mini-title text-primary" data-bs-toggle="tooltip" data-bs-placement="top" title="Feedback from Hosts">
                                                        Hosts Feedback
                                                    </div>
                                                    <div class="mini-stat" id="hostTotal" data-bs-toggle="tooltip" data-bs-placement="top" title="Total">0</div>
                                                    <div class="mini-sub">
                                                        <span data-bs-toggle="tooltip" data-bs-placement="top" title="Avg Rating">
                                                            ⭐ <span id="hostAvg">0</span>
                                                        </span>
                                                        <span class="text-danger ms-1" id="hostNegative" data-bs-toggle="tooltip" data-bs-placement="top" title="Negative">
                                                            0%
                                                        </span>
                                                    </div>
                                                </div>

                                                <!-- Visitors -->
                                                <div class="col-6">
                                                    <div class="mini-title text-success" data-bs-toggle="tooltip" data-bs-placement="top" title="Feedback from Visitors">
                                                        Visitors Feedback
                                                    </div>
                                                    <!-- Total -->
                                                    <div class="mini-stat" id="visitorTotal" data-bs-toggle="tooltip" data-bs-placement="top" title="Total">0</div>
                                                    <div class="mini-sub">
                                                        <!-- Avg Rating -->
                                                        <span data-bs-toggle="tooltip" data-bs-placement="top" title="Avg Rating">
                                                            ⭐ <span id="visitorAvg">0</span>
                                                        </span>

                                                        <!-- Negative -->
                                                        <span class="text-danger ms-1" id="visitorNegative" data-bs-toggle="tooltip" data-bs-placement="top" title="Negative">
                                                            0%
                                                        </span>
                                                    </div>
                                                </div>

                                            </div>

                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
                <div class="row g-4">
                    <!--Category wise rating-->
                    <div class="col-md-4">
                        <div class="card category-card mt-2">
                            <div class="card-header bg-rating d-flex justify-content-between align-items-center py-2">
                                <span class="fw-bold text-dark">
                                    Category wise rating
                                </span>
                                <div class="dropdown chart-filter-rating">
                                    <button class="btn btn-outline-light btn-xs dropdown-toggle"
                                            type="button"
                                            id="jobChartFilter"
                                            data-bs-toggle="dropdown"
                                            aria-expanded="false">
                                        This Month
                                    </button>

                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                        <li><a class="dropdown-item" href="#">Yesterday</a></li>
                                        <li><a class="dropdown-item" href="#">Last 7 Days</a></li>
                                        <li><a class="dropdown-item" href="#">Last 30 Days</a></li>
                                        <li><a class="dropdown-item active" href="#">This Month</a></li>
                                        <li><a class="dropdown-item" href="#">Last Month</a></li>
                                        <li><a class="dropdown-item" href="#">Last 12 Months</a></li>
                                        <li><a class="dropdown-item " href="#">Custom Range</a></li>
                                    </ul>
                                </div>
                            </div>

                            <div class="card-body" id="rating-container">
                            </div>
                        </div>
                    </div>
                    <!--Rating Breakdown & Ratings over time-->
                    <div class="col-md-8">
                        <div class="row g-4">

                            <!--Rating Breakdown-->
                            <div class="col-md-6">
                                <div class="card rating-breakdown-card mt-2">
                                    <div class="card-header bg-rating d-flex justify-content-between align-items-center py-2">
                                        <span class="fw-bold text-dark">
                                            Rating Breakdown
                                        </span>
                                        <div class="dropdown chart-filter-RatingBreakdown">
                                            <button class="btn btn-outline-light btn-xs dropdown-toggle"
                                                    type="button"
                                                    id="ratingBreakdownFilter"
                                                    data-bs-toggle="dropdown"
                                                    aria-expanded="false">
                                                This Month
                                            </button>

                                            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                                <li><a class="dropdown-item" href="#">Yesterday</a></li>
                                                <li><a class="dropdown-item" href="#">Last 7 Days</a></li>
                                                <li><a class="dropdown-item" href="#">Last 30 Days</a></li>
                                                <li><a class="dropdown-item active" href="#">This Month</a></li>
                                                <li><a class="dropdown-item" href="#">Last Month</a></li>
                                                <li><a class="dropdown-item" href="#">Last 12 Months</a></li>
                                                <li><a class="dropdown-item " href="#">Custom Range</a></li>
                                            </ul>
                                        </div>
                                    </div>
                                    <div class="card-body">
                                        <div id="ratingBreakdownContainer" class="rating-chart d-flex justify-content-between align-items-end"></div>
                                    </div>

                                </div>
                            </div>

                            <!--Ratings over time-->
                            <div class="col-md-6">
                                <div class="card rating-time-card mt-2">
                                    <div class="card-header bg-rating d-flex justify-content-between align-items-center py-2">
                                        <span class="fw-bold text-dark">Ratings over time</span>
                                        <div class="dropdown chart-filter-ratingtime">
                                            <button class="btn btn-outline-light btn-xs dropdown-toggle"
                                                    type="button"
                                                    id="ratingTimeFilter"
                                                    data-bs-toggle="dropdown"
                                                    aria-expanded="false">
                                                This Month
                                            </button>

                                            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                                <li><a class="dropdown-item" href="#">Yesterday</a></li>
                                                <li><a class="dropdown-item" href="#">Last 7 Days</a></li>
                                                <li><a class="dropdown-item" href="#">Last 30 Days</a></li>
                                                <li><a class="dropdown-item active" href="#">This Month</a></li>
                                                <li><a class="dropdown-item" href="#">Last Month</a></li>
                                                <li><a class="dropdown-item" href="#">Last 12 Months</a></li>
                                                <li><a class="dropdown-item " href="#">Custom Range</a></li>
                                            </ul>
                                        </div>
                                    </div>
                                    <div class="card-body">
                                        <div class="time-chart">

                                            <!-- Emoji Scale -->
                                            <div class="emoji-scale">
                                                <div>😍</div>
                                                <div>🙂</div>
                                                <div>😐</div>
                                                <div>😟</div>
                                                <div>😡</div>
                                            </div>
                                            <!-- Chart Area -->
                                            <div class="spike-area" id="ratingSpikeArea"></div>
                                        </div>
                                        <!-- Dates -->
                                        <div class="date-row" id="ratingDateRow"></div>
                                    </div>
                                </div>
                            </div>

@*                             <!-- Feedback from Event Hosts -->
                            <div class="col-md-6">
                                <div class="card mt-4 border-0 feedback-card host-card">

                                    <div class="card-header bg-transparent border-0 pb-0 d-flex align-items-center">
                                        <h5 class="fw-semibold mb-0" id="hostTitle">Event Hosts</h5>
                                    </div>

                                    <div class="card-body pt-3">
                                        <div class="row text-center">
                                            <div class="col-4">
                                                <div class="stat-value" id="hostTotal">0</div>
                                                <div class="stat-label">Total</div>
                                            </div>
                                            <div class="col-4">
                                                <div class="stat-value" id="hostAvg">0</div>
                                                <div class="stat-label">Avg Rating</div>
                                            </div>
                                            <div class="col-4">
                                                <div class="stat-value negative" id="hostNegative">0%</div>
                                                <div class="stat-label negative">Negative</div>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>

                            <!-- Feedback from Visitors -->
                            <div class="col-md-6">
                                <div class="card mt-4 border-0 feedback-card visitor-card">

                                    <div class="card-header bg-transparent border-0 pb-0 d-flex align-items-center">
                                        <h5 class="fw-semibold mb-0" id="visitorTitle">Visitors</h5>
                                    </div>

                                    <div class="card-body pt-3">
                                        <div class="row text-center">
                                            <div class="col-4">
                                                <div class="stat-value" id="visitorTotal">0</div>
                                                <div class="stat-label">Total</div>
                                            </div>
                                            <div class="col-4">
                                                <div class="stat-value" id="visitorAvg">0</div>
                                                <div class="stat-label">Avg Rating</div>
                                            </div>
                                            <div class="col-4">
                                                <div class="stat-value negative" id="visitorNegative">0%</div>
                                                <div class="stat-label negative">Negative</div>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>
 *@
                        </div>
                    </div>
                </div>

                <div class="mb-3 py-5">
                    <h4 class="fw-semibold mb-3"> Top insights for you</h4>
                    <div class="row g-3">
                        <!-- Card 1 -->
                        <div class="col-md-3">
                            <div class="card insight-card h-100">
                                <!-- HEADER -->
                                <div class="card-header bg-transparent border-0
                                    d-flex justify-content-between align-items-center
                                    pb-3 mb-0">
                                    <h5 class="mb-0">
                                        <span id="insightTitle1">Your Overall avg. billing value</span>
                                    </h5>
                                    <i class="bi bi-info-circle"></i>
                                </div>
                                <!-- BODY -->
                                <div class="card-body pt-1">
                                    <h4 id="totalRevenue" class="mt-0 mb-1">₹100</h4>
                                    <p class="text-muted mb-2">
                                        revenue and <span id="totalVisits">123</span> visits via Reelo 🚀
                                    </p>
                                    <img src="~/assets2/img/avgbill.png" class="img-fluid rounded img_logo">
                                </div>
                            </div>
                        </div>


                        <!-- Card 2 -->
                        <div class="col-md-3">
                            <div class="card insight-card h-100">

                                <div class="card-header bg-transparent border-0
                                        d-flex justify-content-between align-items-center
                                        pb-3 mb-0">
                                    <h5 class="mb-0">
                                        <span id="RevenueText">Revenue Distribution</span>
                                    </h5>
                                    <i class="bi bi-info-circle"></i>
                                </div>

                                <div class="card-body pt-1">
                                    <div class="d-flex justify-content-between">
                                        <div class="text-center">
                                            <img src="~/assets2/img/corporate_avgbillhigh.png"
                                                 class="img-fluid img_logo_revenue1 mb-1">
                                            <h4 id="customerPercentValue" class="mt-0 mb-0">0%</h4>
                                            <small class="text-muted">customers contribute</small>
                                        </div>

                                        <div class="text-center">
                                            <img src="~/assets2/img/corporate_avgbilllow.png"
                                                 class="img-fluid img_logo_revenue2 mb-1">
                                            <h4 id="revenuePercent" class="mt-0 mb-0">0%</h4>
                                            <small class="text-muted">of total revenue</small>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>


                        <!-- Card 3 -->
                        <div class="col-md-3">
                            <div class="card insight-card h-100">

                                <div class="card-header bg-transparent border-0
                                    d-flex justify-content-between align-items-center
                                    pb-3 mb-0">
                                    <h5 class="mb-0">
                                        <span id="avgordertext">Avg Order Value</span>
                                    </h5>
                                    <i class="bi bi-info-circle"></i>
                                </div>

                                <div class="card-body pt-1">
                                    <p class="mt-0 mb-2">
                                        ₹<span id="avgOrderValueAmount">0</span>
                                        with customers ordering
                                        <strong><span id="avgItems">0</span></strong>
                                        items per order 💰
                                    </p>

                                    <img src="~/assets2/img/fmiyavg.png"
                                         class="img-fluid rounded img_logo_corporate">
                                </div>

                            </div>
                        </div>


                        <!-- Card 4 -->
                        <div class="col-md-3">
                            <div class="card insight-card h-100">

                                <div class="card-header bg-transparent border-0
                                        d-flex justify-content-between align-items-center
                                        pb-3 mb-0">
                                    <h5 class="mb-0">
                                        <span id="customervisittext">Customer Visits</span>
                                    </h5>
                                    <i class="bi bi-info-circle"></i>
                                </div>

                                <div class="card-body pt-1">
                                    <p class="mt-0 mb-2">
                                        Customers visit on average
                                        <strong><span id="visitFrequencyValue">0</span></strong>
                                        time(s) a year 🙂
                                    </p>

                                    <img src="~/assets2/img/customeravg.png"
                                         class="img-fluid rounded img_logo_family">
                                </div>

                            </div>
                        </div>

                    </div>
                </div>
                <!-- Dynamic Widgets -->
                <div id="dashboard-widgets" class="row g-3"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/assets2/js/feedbackdashboard/feedbackdashboard.js" asp-append-version="true"></script>
}




