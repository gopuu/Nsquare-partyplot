@{
    ViewData["Title"] = "Feedback Dashboard";
    Layout = "_Layout";
}


@section Styles {
    <link href="~/assets2/css/feedbackdashboard/feedbackdashboard.css" rel="stylesheet" />

}

<div class="content container-fluid">
    <div class="pb-5">
        <div class="row g-4">
            <div class="col-12 col-xxl-12">
                <div class="row align-items-center justify-content-between mb-4">
                    <div class="col-12">
                        <div class="mb-0">
                            <h4 class="mb-4 fw-bold">📊 Feedback & Insights</h4>
                            <div class="row g-4 align-items-stretch">
                                <!-- Total Feedback -->
                                <div class="col-lg-3 col-md-4">
                                    <div class="card metric-card">
                                        <div class="metric-top bg-feedback"></div>
                                        <div class="card-body d-flex justify-content-between align-items-center">
                                            <div>
                                                <div class="metric-title">Total Feedback</div>
                                                <div class="metric-value">152</div>
                                            </div>
                                            <div class="metric-icon bg-feedback">
                                                <i class="bi bi-chat-dots"></i>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Avg Rating -->
                                <div class="col-lg-3 col-md-4">
                                    <div class="card metric-card">
                                        <div class="metric-top bg-rating"></div>
                                        <div class="card-body d-flex justify-content-between align-items-center">
                                            <div>
                                                <div class="metric-title">Avg Rating</div>
                                                <div class="metric-value">3.95</div>
                                            </div>
                                            <div class="metric-icon bg-rating">
                                                <i class="bi bi-star-fill"></i>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- AI Assisted -->
                                <div class="col-lg-3 col-md-4">
                                    <div class="card metric-card">
                                        <div class="metric-top bg-ai"></div>
                                        <div class="card-body d-flex justify-content-between align-items-center">
                                            <div>
                                                <div class="metric-title">Assisted Reviews & Ratings</div>
                                                <div class="metric-value">74</div>
                                            </div>
                                            <div class="metric-icon bg-ai">
                                                <i class="bi bi-emoji-smile"></i>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Positive / Negative / Neutral -->
                                <div class="col-lg-3 col-md-4">
                                    <div class="card metric-card metric-width">
                                        <div class="metric-top bg-feedback"></div>
                                        <div class="card-body d-flex align-items-center">
                                            <div class="row text-center w-100">
                                                <div class="col-4 border-end">
                                                    <img src="~/assets2/img/smiling_emoji.png" class="emoji_icon mb-1" />
                                                    <div class="metric-title">Positive</div>
                                                    <div class="metric-value text-success">73%</div>
                                                </div>
                                                <div class="col-4 border-end">
                                                    <img src="~/assets2/img/very_sad.png" class="emoji_icon mb-1" />
                                                    <div class="metric-title">Negative</div>
                                                    <div class="metric-value text-danger">20%</div>
                                                </div>
                                                <div class="col-4">
                                                    <img src="~/assets2/img/neutral_face.png" class="emoji_icon mb-1" />
                                                    <div class="metric-title">Neutral</div>
                                                    <div class="metric-value text-secondary">7%</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row g-4">
                    <div class="col-md-4">
                        <div class="card category-card mt-4">
                            <div class="card-header bg-white fw-bold">
                                Category wise rating
                            </div>

                            <div class="card-body p-0">
                                <!-- Row -->
                                <div class="rating-row">
                                    <div class="category-name">Service</div>
                                    <div class="avg-box bg-success">
                                        <div class="avg-title">Avg Rating</div>
                                        <div class="avg-value">4.19</div>
                                        <div class="avg-sub">Out of 5</div>
                                    </div>
                                    <div class="rating-stat positive">
                                        😊 <span>88</span>
                                        <small>Positive</small>
                                    </div>
                                    <div class="rating-stat neutral">
                                        😐 <span>2</span>
                                        <small>Neutral</small>
                                    </div>
                                    <div class="rating-stat negative">
                                        ☹️ <span>18</span>
                                        <small>Negative</small>
                                    </div>
                                </div>
                                <!-- Row -->
                                <div class="rating-row">
                                    <div class="category-name">Value for money</div>

                                    <div class="avg-box bg-success">
                                        <div class="avg-title">Avg Rating</div>
                                        <div class="avg-value">4.17</div>
                                        <div class="avg-sub">Out of 5</div>
                                    </div>

                                    <div class="rating-stat positive">😊 <span>75</span> <h6> <small>Positive</small></h6></div>
                                    <div class="rating-stat neutral">😐 <span>3</span> <h6><small>Neutral</small></h6></div>
                                    <div class="rating-stat negative">☹️ <span>15</span> <h6><small>Negative</small></h6></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="card rating-breakdown-card mt-4">
                            <div class="card-header bg-white fw-bold">
                                Rating Breakdown
                            </div>

                            <div class="card-body">
                                <div class="rating-chart">

                                    <!-- Very Poor -->
                                    <div class="rating-col">
                                        <div class="bar" style="height:40px;"></div>
                                        <div class="emoji">😡</div>
                                        <div class="percent">10.5%</div>
                                        <div class="count">16 Ratings</div>
                                    </div>

                                    <!-- Poor -->
                                    <div class="rating-col">
                                        <div class="bar" style="height:35px;"></div>
                                        <div class="emoji">😟</div>
                                        <div class="percent">9.9%</div>
                                        <div class="count">15 Ratings</div>
                                    </div>

                                    <!-- Average -->
                                    <div class="rating-col">
                                        <div class="bar" style="height:25px;"></div>
                                        <div class="emoji">😐</div>
                                        <div class="percent">6.8%</div>
                                        <div class="count">10 Ratings</div>
                                    </div>

                                    <!-- Good -->
                                    <div class="rating-col">
                                        <div class="bar" style="height:70px;"></div>
                                        <div class="emoji">🙂</div>
                                        <div class="percent">20.4%</div>
                                        <div class="count">31 Ratings</div>
                                    </div>

                                    <!-- Excellent -->
                                    <div class="rating-col">
                                        <div class="bar highlight" style="height:130px;"></div>
                                        <div class="emoji">😍</div>
                                        <div class="percent">52.6%</div>
                                        <div class="count">80 Ratings</div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="card rating-time-card mt-4">
                            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                                <span class="fw-bold">Ratings over time</span>
                                <span class="badge bg-light text-dark">Last 6 Months</span>
                            </div>

                            <div class="card-body">

                                <div class="time-chart">

                                    <!-- Emoji Scale -->
                                    <div class="emoji-scale">
                                        <div>😍</div>
                                        <div>🙂</div>
                                        <div>😐</div>
                                        <div>😟</div>
                                        <div>😢</div>
                                    </div>

                                    <!-- Chart Area -->
                                    <div class="spike-area">
                                        <div class="spike" style="height:120px"></div>
                                        <div class="spike" style="height:150px"></div>
                                        <div class="spike" style="height:180px"></div>
                                        <div class="spike" style="height:90px"></div>
                                        <div class="spike" style="height:200px"></div>
                                        <div class="spike" style="height:160px"></div>
                                        <div class="spike" style="height:140px"></div>
                                        <div class="spike" style="height:190px"></div>
                                    </div>

                                </div>

                                <!-- Dates -->
                                <div class="date-row">
                                    <span>Oct</span>
                                    <span>Nov</span>
                                    <span>Dec</span>
                                    <span>Jan</span>
                                    <span>Feb</span>
                                    <span>Mar</span>
                                    <span>Apr</span>
                                    <span>May</span>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>

                <!-- Dynamic Widgets -->
                <div id="dashboard-widgets" class="row g-3"></div>
            </div>
        </div>
    </div>
</div>
