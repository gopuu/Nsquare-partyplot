@{
    ViewData["Title"] = "Feedback Dashboard";
    Layout = "_Layout";
}


@section Styles {
    <link href="~/assets2/css/feedbackdashboard/feedbackdashboard.css" rel="stylesheet" asp-append-version="true" />

}

<div class="content container-fluid">
    <div class="pb-5">
        <div class="row g-4">
            <div class="col-12 col-xxl-12">
                <div class="row align-items-center justify-content-between mb-4">
                    <div class="col-12">
                        <div class="mb-0">
                            <div class="header-flex">
                                <h4 class="mb-0 fw-bold">📊 Feedback & Insights</h4>
                                <div class="dropdown mr-4 chart-filter-feedback">
                                    <button class="btn btn-outline-secondary btn-sm dropdown-toggle"
                                            type="button"
                                            id="jobChartFilter"
                                            data-bs-toggle="dropdown"
                                            aria-expanded="false">
                                        This Month
                                    </button>

                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="jobChartFilter">
                                        <li><a class="dropdown-item" href="#">Yesterday</a></li>
                                        <li><a class="dropdown-item" href="#">Last 7 Days</a></li>
                                        <li><a class="dropdown-item" href="#">Last 30 Days</a></li>
                                        <li><a class="dropdown-item active" href="#">This Month</a></li>
                                        <li><a class="dropdown-item" href="#">Last Month</a></li>
                                        <li><a class="dropdown-item" href="#">Last 12 Months</a></li>
                                        <li><a class="dropdown-item" href="#">Custom Range</a></li>
                                    </ul>
                                </div>
                            </div>
                            <div class="row g-4 align-items-stretch">
                                <!-- Total Feedback -->
                                <div class="col-lg-3 col-md-4">
                                    <div class="card metric-card">
                                        <div class="metric-top bg-feedback"></div>
                                        <div class="card-body d-flex justify-content-between align-items-center">
                                            <div>
                                                <div class="metric-title" id="lblTotalFeedback">Total Feedback</div>
                                                <div class="metric-value" id="valTotalFeedback">0</div>
                                            </div>
                                            <div class="metric-icon bg-feedback">
                                                <i class="bi bi-chat-dots"></i>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Avg Rating -->
                                <div class="col-lg-3 col-md-4">
                                    <div class="card metric-card">
                                        <div class="metric-top bg-rating"></div>
                                        <div class="card-body d-flex justify-content-between align-items-center">
                                            <div>
                                                <div class="metric-title" id="lblAvgRating">Avg Rating</div>
                                                <div class="metric-value" id="valAvgRating">0</div>
                                            </div>
                                            <div class="metric-icon bg-rating">
                                                <i class="bi bi-star-fill"></i>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- AI Assisted -->
                                <div class="col-lg-3 col-md-4">
                                    <div class="card metric-card">
                                        <div class="metric-top bg-ai"></div>
                                        <div class="card-body d-flex justify-content-between align-items-center">
                                            <div>
                                                <div class="metric-title" id="lblAI">Assisted Reviews & Ratings</div>
                                                <div class="metric-value" id="valAI">0</div>
                                            </div>
                                            <div class="metric-icon bg-ai">
                                                <i class="bi bi-emoji-smile"></i>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Sentiment -->
                                <div class="col-lg-3 col-md-4">
                                    <div class="card metric-card metric-width">
                                        <div class="metric-top bg-feedback"></div>
                                        <div class="card-body d-flex align-items-center">
                                            <div class="row text-center w-100">
                                                <div class="col-4 border-end">
                                                    <img src="~/assets2/img/smiling_emoji.png" class="emoji_icon mb-1" />
                                                    <div class="metric-title">Positive</div>
                                                    <div class="metric-value text-success" id="valPositive">0%</div>
                                                </div>
                                                <div class="col-4 border-end">
                                                    <img src="~/assets2/img/very_sad.png" class="emoji_icon mb-1" />
                                                    <div class="metric-title">Negative</div>
                                                    <div class="metric-value text-danger" id="valNegative">0%</div>
                                                </div>
                                                <div class="col-4">
                                                    <img src="~/assets2/img/neutral_face.png" class="emoji_icon mb-1" />
                                                    <div class="metric-title">Neutral</div>
                                                    <div class="metric-value text-secondary" id="valNeutral">0%</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
                <div class="row g-4">
                    <div class="col-md-4">
                        <div class="card category-card mt-4">
                            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                                <span class="fw-bold">
                                    Category wise rating
                                </span>
                                <div class="dropdown chart-filter-rating">
                                    <button class="btn btn-outline-secondary btn-xs dropdown-toggle"
                                            type="button"
                                            id="jobChartFilter"
                                            data-bs-toggle="dropdown"
                                            aria-expanded="false">
                                        This Month
                                    </button>

                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                        <li><a class="dropdown-item" href="#">Yesterday</a></li>
                                        <li><a class="dropdown-item" href="#">Last 7 Days</a></li>
                                        <li><a class="dropdown-item" href="#">Last 30 Days</a></li>
                                        <li><a class="dropdown-item active" href="#">This Month</a></li>
                                        <li><a class="dropdown-item" href="#">Last Month</a></li>
                                        <li><a class="dropdown-item" href="#">Last 12 Months</a></li>
                                        <li><a class="dropdown-item " href="#">Custom Range</a></li>
                                    </ul>
                                </div>
                            </div>

                            <div class="card-body" id="rating-container">
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="card rating-breakdown-card mt-4">
                            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                                <span class="fw-bold">
                                    Rating Breakdown
                                </span>
                                <div class="dropdown chart-filter-RatingBreakdown">
                                    <button class="btn btn-outline-secondary btn-xs dropdown-toggle"
                                            type="button"
                                            id="ratingBreakdownFilter"
                                            data-bs-toggle="dropdown"
                                            aria-expanded="false">
                                        This Month
                                    </button>

                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                        <li><a class="dropdown-item" href="#">Yesterday</a></li>
                                        <li><a class="dropdown-item" href="#">Last 7 Days</a></li>
                                        <li><a class="dropdown-item" href="#">Last 30 Days</a></li>
                                        <li><a class="dropdown-item active" href="#">This Month</a></li>
                                        <li><a class="dropdown-item" href="#">Last Month</a></li>
                                        <li><a class="dropdown-item" href="#">Last 12 Months</a></li>
                                        <li><a class="dropdown-item " href="#">Custom Range</a></li>
                                    </ul>
                                </div>
                            </div>
                            <div class="card-body">
                                <div id="ratingBreakdownContainer"
                                     class="rating-chart d-flex justify-content-between align-items-end">
                                </div>
                            </div>

                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="card rating-time-card mt-4">
                            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                                <span class="fw-bold">Ratings over time</span>
                                <div class="dropdown chart-filter">
                                    <button class="btn btn-outline-secondary btn-xs dropdown-toggle"
                                            type="button"
                                            id="jobChartFilter"
                                            data-bs-toggle="dropdown"
                                            aria-expanded="false">
                                        This Month
                                    </button>

                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                        <li><a class="dropdown-item" href="#">Yesterday</a></li>
                                        <li><a class="dropdown-item" href="#">Last 7 Days</a></li>
                                        <li><a class="dropdown-item" href="#">Last 30 Days</a></li>
                                        <li><a class="dropdown-item active" href="#">This Month</a></li>
                                        <li><a class="dropdown-item" href="#">Last Month</a></li>
                                        <li><a class="dropdown-item" href="#">Last 12 Months</a></li>
                                        <li><a class="dropdown-item " href="#">Custom Range</a></li>
                                    </ul>
                                </div>
                            </div>

                            <div class="card-body">

                                <div class="time-chart">

                                    <!-- Emoji Scale -->
                                    <div class="emoji-scale">
                                        <div>😍</div>
                                        <div>🙂</div>
                                        <div>😐</div>
                                        <div>😟</div>
                                        <div>😢</div>
                                    </div>

                                    <!-- Chart Area -->
                                    <div class="spike-area">
                                        <div class="spike" style="height:120px"></div>
                                        <div class="spike" style="height:150px"></div>
                                        <div class="spike" style="height:180px"></div>
                                        <div class="spike" style="height:90px"></div>
                                        <div class="spike" style="height:200px"></div>
                                        <div class="spike" style="height:160px"></div>
                                        <div class="spike" style="height:140px"></div>
                                        <div class="spike" style="height:190px"></div>
                                    </div>

                                </div>

                                <!-- Dates -->
                                <div class="date-row">
                                    <span>Oct</span>
                                    <span>Nov</span>
                                    <span>Dec</span>
                                    <span>Jan</span>
                                    <span>Feb</span>
                                    <span>Mar</span>
                                    <span>Apr</span>
                                    <span>May</span>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>

                <!-- Dynamic Widgets -->
                <div id="dashboard-widgets" class="row g-3"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/assets2/js/feedbackdashboard/feedbackdashboard.js" asp-append-version="true"></script>

}