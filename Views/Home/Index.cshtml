@{
    ViewData["Title"] = "Login";
    Layout = "_LayoutEmpty";
}

@section Styles {
    <link href="~/assets2/css/Login/Login.css" asp-append-version="true" rel="stylesheet" />
}
@section Scripts {
    <script src="~/assets2/js/Login/Login.js" asp-append-version="true"></script>
}

<div class="container-fluid bg-body-tertiary dark__bg-gray-1200 min-vh-100 d-flex flex-center">
    <div class="col-lg-9 col-xxl-7 py-3 position-relative">
        <!-- Background shapes -->
        <img class="bg-auth-circle-shape"
             src="~/assets2/img/icons/illustrations/bg-shape.png"
             alt="" width="250">
        <img class="bg-auth-circle-shape-2"
             src="~/assets2/img/icons/illustrations/shape-1.png"
             alt="" width="150">
        <div class="card overflow-hidden z-1 auth-card">
            <div class="card-body p-0">
                <div class="row g-0 h-100">
                    <!-- ================= LEFT SIDE ================= -->
                    <div class="col-md-5 text-center bg-card-gradient">
                        <div class="position-relative p-3 pt-md-5 pb-md-7" data-bs-theme="light">
                            <div class="bg-holder bg-auth-card-shape"
                                 style="background-image:url('~/assets2/img/icons/illustrations/half-circle.png');">
                            </div>
                            <div class="z-1 position-relative">
                                <a class="link-light mb-4 fs-4 fw-bolder d-inline-block mb-2" href="/">
                                    <img class="img-fluid me-1"
                                         src="~/assets2/img/TenXSoftware.png"
                                         alt="Logo" width="70%" />
                                </a>

                                <p class="opacity-75 text-white">
                                    Driven By Purpose, Powered By Code
                                </p>

                                <p class="text-white fw-semi-bold mb-0 d-none d-md-block">
                                    <a class="text-white" href="https://www.nsquaresoftware.com" target="_blank">
                                        <i class="fas fa-globe me-2"></i>www.nsquaresoftware.com
                                    </a>
                                </p>
                            </div>
                        </div>
                        <!-- Contact Info -->
                        <div class="mt-3 mb-4 mt-md-4 mb-md-5 d-none d-md-block" data-bs-theme="light">
                            <p class="text-white">
                                Need support?<br>
                                <span class="opacity-75">Expert assistance is one call away.</span>
                            </p>

                            <p class="text-white fw-semi-bold mb-1">
                                <a class="text-white me-3" href="tel:8980846250">
                                    <i class="fas fa-phone-alt me-2"></i>8980846250
                                </a>
                                <a class="text-white" href="https://wa.me/918980846250" target="_blank">
                                    <i class="fab fa-whatsapp me-2"></i>Chat
                                </a>
                            </p>

                            <p class="text-white fw-semi-bold mb-1">
                                <a class="text-white me-3" href="tel:9054296682">
                                    <i class="fas fa-phone-alt me-2"></i>9054296682
                                </a>
                                <a class="text-white" href="https://wa.me/919054296682" target="_blank">
                                    <i class="fab fa-whatsapp me-2"></i>Chat
                                </a>
                            </p>

                            <p class="text-white fw-semi-bold mb-0 d-none d-md-block">
                                <a class="text-white" href="mailto:nsquaresoftwarsolution@gmail.com">
                                    <i class="fas fa-envelope me-2"></i>
                                    nsquaresoftwarsolution@gmail.com
                                </a>
                            </p>
                        </div>
                    </div>

                    <!-- ================= RIGHT SIDE ================= -->
                    <div class="col-md-7 d-flex flex-center">
                        <div class="p-4 p-md-5 flex-grow-1">
                            <h3 class="text-center mb-4">Sign In</h3>

                            <!-- LOGIN FORM (unchanged logic) -->
                            <form id="loginForm">
                                <div class="mb-3">
                                    <label class="form-label" for="UserName">Username or Email</label>
                                    <input class="form-control" type="text" id="UserName" name="UserName" placeholder="Username or Email" autofocus autocomplete="off" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="password">Password</label>
                                    <div class="form-icon-container" data-password="data-password">
                                        <input class="form-control" id="Password" type="password" placeholder="Password" data-password-input="data-password-input" autocomplete="off" />
                                            @*<span class="fas fa-key text-body fs-9 form-icon"></span>*@                                        
                                            <button type="button" class="btn px-3 py-0 h-100 position-absolute top-0 end-0 fs-7 text-body-tertiary" data-password-toggle="data-password-toggle">
                                            <span class="uil uil-eye show"></span><span class="uil uil-eye-slash hide"></span>
                                        </button>
                                    </div>
                                </div>
                                <div class="mb-1">
                                    <button class="btn btn-warning w-100 mb-3" type="submit">Sign In</button>
                                </div>
                                <div class="row mb-3">
                                    <label class="text-danger text-center" id="errorMessage"></label>
                                </div>
                                <hr />
                            </form>

                            <!-- Greeting / Quote -->
                            <div class="text-center mb-2">
                                <span class="fw-semibold text-dark" id="dailyGreeting"></span>
                            </div>

                            <!-- Date -->
                            <div class="text-center text-muted small mb-1" id="currentDate"></div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
