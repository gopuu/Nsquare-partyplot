@{
    ViewBag.Title = "Home";
    Layout = "_Layout";
}

@section Styles {
    <link href="~/assets2/css/dashboard/dashboard.css" rel="stylesheet" asp-append-version="true" />
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/morris.js/0.5.1/morris.css">
@* <link rel="stylesheet" href="https://www.cdnjs.cloudflare.com/ajax/libs/morris.js/0.5.1/morris.css" /> *@

<script src="https://cdnjs.cloudflare.com/ajax/libs/raphael/2.3.0/raphael.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/morris.js/0.5.1/morris.min.js"></script>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2"></script>
<script type="text/javascript" src="https://www.gstatic.com/charts/loader.js"></script>

@* <script src="https://cdnjs.cloudflare.com/ajax/libs/raphael/2.1.0/raphael-min.js"></script> *@
<script src="https://code.jquery.com/jquery-1.8.2.min.js"></script>
@* <script src="https://cdnjs.cloudflare.com/ajax/libs/morris.js/0.5.1/morris.min.js"></script> *@

<div class="content container-fluid">
    <div class="pb-5">
        <div class="row g-5" id="dashboard-widgets">
            <div class="col-12 col-xxl-12">
                <div class="row align-items-center justify-content-between mb-4">
                    <div class="col-12">
                        <div class="mb-0">
                            <div class="row align-items-center mb-4 py-1">
                                <!-- LEFT : TITLE -->
                                <div class="col-md-6">
                                    <h4 class="mb-1 text-warning">Dashboard</h4>
                                    <h5 class="text-body-tertiary fw-semibold mb-0">
                                        Here’s what’s going on at your business right now
                                    </h5>
                                </div>

                                <!-- RIGHT : FILTERS -->
                                <div class="col-md-6">
                                    <div class="d-flex justify-content-end gap-2 flex-wrap">
                                        <button id="btnSummary"
                                                class="btn btn-sm summary-icon-btn d-none"
                                                title="Summary">
                                            <i class="fa-solid fa-circle-info"></i>
                                        </button>

                                        <!-- Month Filter -->
                                        <div class="dropdown mt-1">
                                            <button class="btn btn-outline-secondary btn-sm fw-bold dropdown-toggle"
                                                    type="button" id="sortByDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                                Filter : This Month
                                            </button>
                                            <ul class="dropdown-menu" aria-labelledby="sortByDropdown">
                                                <li><a class="dropdown-item sort-option" data-value="yesterday" href="#">Yesterday</a></li>
                                                <li><a class="dropdown-item sort-option" data-value="last7days" href="#">Last 7 days</a></li>
                                                <li><a class="dropdown-item sort-option" data-value="last30days" href="#">Last 30 days</a></li>
                                                <li><a class="dropdown-item sort-option active" data-value="thismonth" href="#">This Month</a></li>
                                                <li><a class="dropdown-item sort-option" data-value="lastmonth" href="#">Last Month</a></li>
                                                <li><a class="dropdown-item sort-option" data-value="last12months" href="#">Last 12 Months</a></li>
                                                <li><a class="dropdown-item sort-option" data-value="customrange" href="#">Custom Range</a></li>
                                            </ul>
                                        </div>

                                        <!-- From Date -->
                                        <input type="date"
                                               class="form-control form-control-sm w-auto"
                                               id="fromDate">

                                        <!-- To Date -->
                                        <input type="date"
                                               class="form-control form-control-sm w-auto"
                                               id="toDate">

                                        <!-- Apply Button -->
                                        <button class="btn btn-sm btn-outline-danger" id="btnReset">
                                            Reset
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!---------- Widgets - start ---------->
                            <div class="row g-3 py-2">

                                <!-- Card 1 : Total Sales -->
                                <div class="col-md-3">
                                    <div class="stat-box bg-mint">
                                        <div class="stat-top mint"></div>
                                        <div class="stat-body">
                                            <span class="kpi-tooltip" id="tooltipTotalSales">
                                                Total Sales
                                            </span>
                                            <h3 class="value cursor-pointer" id="totalSales">₹ 0</h3>
                                            <span class="sub sub_count">In This Month</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Card 2 : Total Orders -->
                                <div class="col-md-2">
                                    <div class="stat-box bg-lavender">
                                        <div class="stat-top lavender"></div>
                                        <div class="stat-body">
                                            <span class="kpi-tooltip" id="tooltipTotalOrders">
                                                Total Orders
                                            </span>
                                            <h3 class="value cursor-pointer" id="totalEvents">0</h3>
                                            <span class="sub sub_count">In This Month</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Card 3 : Total Customer Visits -->
                                <div class="col-md-2">
                                    <div class="stat-box bg-sky">
                                        <div class="stat-top sky"></div>
                                        <div class="stat-body">
                                            <span class="kpi-tooltip" id="tooltipTotalCustomers">
                                                Total Customer Visits
                                            </span>
                                            <h3 class="value cursor-pointer" id="totalCustomers">0</h3>
                                            <span class="sub sub_count">In This Month</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Card 4 : Events Lost -->
                                <div class="col-md-2">
                                    <div class="stat-box bg-lavender">
                                        <div class="stat-top lavender"></div>
                                        <div class="stat-body">
                                            <span class="kpi-tooltip text-danger" id="tooltipEventsLost">
                                                Events Lost <span id="eventLostCount" class="cursor-pointer">(0)</span>
                                            </span>
                                            <h3 class="value text-danger cursor-pointer" id="totalEventsLost">₹ 0</h3>
                                            <span class="sub sub_count">In This Month</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- ADD Tool TIP -->
                                <!-- Card 5 : Upcoming Events -->
                                <div class="col-md-3">
                                    <div class="stat-box bg-mint">
                                        <div class="stat-top mint"></div>

                                        <div class="stat-body">

                                            <!-- Header with Filter -->
                                            <div class="d-flex justify-content-between align-items-center mb-1">

                                                <span class="kpi-tooltip text-success" id="tooltipUpcomingEvents">
                                                    Upcoming Events
                                                    <span id="upcomingEventsCount">(0)</span>
                                                </span>

                                                <!-- Small Dropdown Filter -->
                                                <div class="dropdown upcoming-filter">
                                                    <button class="btn btn-outline-secondary btn-xs dropdown-toggle"
                                                            type="button"
                                                            id="upcomingFilterBtn"
                                                            data-bs-toggle="dropdown">
                                                        This Month
                                                    </button>

                                                    <ul class="dropdown-menu dropdown-menu-end py-2">
                                                        <li><a class="dropdown-item py-1 active" data-value="thismonth_upcoming" href="#">This Month</a></li>
                                                        <li><a class="dropdown-item py-1" data-value="next3month" href="#">Next 3 Months</a></li>
                                                        <li><a class="dropdown-item py-1" data-value="next6month" href="#">Next 6 Months</a></li>
                                                        <li><a class="dropdown-item py-1" data-value="next12month" href="#">Next 12 Months</a></li>
                                                        <li><a class="dropdown-item py-1" data-value="overall_upcoming" href="#">Overall</a></li>
                                                    </ul>
                                                </div>

                                            </div>

                                            <h3 class="value text-success" id="upcomingEventsAmount">₹ 0</h3>
                                            <span class="sub sub_upcoming">In This Month</span>

                                        </div>
                                    </div>
                                </div>

                            </div>
                            <!---------- Widgets - end---------->

                            <!---------- Corporate Event vs Family Events / Corporate & Sub type of Event / Family & Subtype of Event - END ---------->
                            <div class="row g-3 py-2">
                                <!---------- Corporate Event vs Family Events ----------->
                                <div class="col-md-4 text-center">
                                    <div class="chart-box position-relative">
                                        <!-- small dropdown -->
                                        <div class="dropdown chart-filter-pie">
                                            <button class="btn btn-outline-secondary btn-xs dropdown-toggle"
                                                    type="button"
                                                    id="jobChartFilter"
                                                    data-bs-toggle="dropdown"
                                                    aria-expanded="false">
                                                This Month
                                            </button>

                                            <ul class="dropdown-menu py-2" aria-labelledby="sortByDropdown">
                                                <li><a class="dropdown-item sort-option py-1" data-value="yesterday" href="#">Yesterday</a></li>
                                                <li><a class="dropdown-item sort-option py-1" data-value="last7days" href="#">Last 7 days</a></li>
                                                <li><a class="dropdown-item sort-option py-1" data-value="last30days" href="#">Last 30 days</a></li>
                                                <li><a class="dropdown-item sort-option py-1" data-value="lastmonth" href="#">Last Month</a></li>
                                                <li><a class="dropdown-item sort-option py-1" data-value="last12months" href="#">Last 12 Months</a></li>
                                                <li><a class="dropdown-item sort-option py-1 active" href="#" data-value="thismonth">This Month</a></li>
                                                <li><a class="dropdown-item sort-option py-1" href="#" data-value="next3month">Next 3 Months</a></li>
                                                <li><a class="dropdown-item sort-option py-1" href="#" data-value="next6month">Next 6 Months</a></li>
                                                <li><a class="dropdown-item sort-option py-1" href="#" data-value="next12month">Next 12 Months</a></li>
                                                <li><a class="dropdown-item sort-option py-1" href="#" data-value="overall">Overall</a></li>
                                            </ul>
                                        </div>

                                        <!-- chart -->
                                        <canvas id="jobPie" class="mt-3"></canvas>

                                        <!-- label -->
                                        <div class="chart-label">
                                            Corporate vs Family Events
                                        </div>
                                    </div>
                                </div>

                                <!---------- Corporate & Sub type of Event ----------->
                                <div class="col-md-4 text-center">
                                    <div class="chart-box position-relative">
                                        <!-- small dropdown -->
                                        <div class="dropdown chart-filter-eventPie">
                                            <button class="btn btn-outline-secondary btn-xs dropdown-toggle"
                                                    type="button"
                                                    id="eventPieChartFilter"
                                                    data-bs-toggle="dropdown"
                                                    aria-expanded="false">
                                                This Month
                                            </button>

                                            <ul class="dropdown-menu py-2" aria-labelledby="sortByDropdown">
                                                <li><a class="dropdown-item sort-option py-1" data-value="yesterday" href="#">Yesterday</a></li>
                                                <li><a class="dropdown-item sort-option py-1" data-value="last7days" href="#">Last 7 days</a></li>
                                                <li><a class="dropdown-item sort-option py-1" data-value="last30days" href="#">Last 30 days</a></li>
                                                <li><a class="dropdown-item sort-option py-1" data-value="lastmonth" href="#">Last Month</a></li>
                                                <li><a class="dropdown-item sort-option py-1" data-value="last12months" href="#">Last 12 Months</a></li>
                                                <li><a class="dropdown-item sort-option py-1 active" href="#" data-value="thismonth">This Month</a></li>
                                                <li><a class="dropdown-item sort-option py-1" href="#" data-value="next3month">Next 3 Months</a></li>
                                                <li><a class="dropdown-item sort-option py-1" href="#" data-value="next6month">Next 6 Months</a></li>
                                                <li><a class="dropdown-item sort-option py-1" href="#" data-value="next12month">Next 12 Months</a></li>
                                                <li><a class="dropdown-item sort-option py-1" href="#" data-value="overall">Overall</a></li>
                                            </ul>
                                        </div>
                                        <canvas id="eventPie" class="mt-3"></canvas>
                                        <div class="chart-label">Corporate & Sub-Events</div>
                                    </div>
                                </div>

                                <!---------- Family & Subtype of Event - END ---------->
                                <div class="col-md-4 text-center">
                                    <div class="chart-box position-relative">
                                        <!-- small dropdown -->
                                        <div class="dropdown chart-filter-salepie">
                                            <button class="btn btn-outline-secondary btn-xs dropdown-toggle"
                                                    type="button"
                                                    id="salepieChartFilter"
                                                    data-bs-toggle="dropdown"
                                                    aria-expanded="false">
                                                This Month
                                            </button>

                                            <ul class="dropdown-menu py-2" aria-labelledby="sortByDropdown">
                                                <li><a class="dropdown-item sort-option py-1" data-value="yesterday" href="#">Yesterday</a></li>
                                                <li><a class="dropdown-item sort-option py-1" data-value="last7days" href="#">Last 7 days</a></li>
                                                <li><a class="dropdown-item sort-option py-1" data-value="last30days" href="#">Last 30 days</a></li>
                                                <li><a class="dropdown-item sort-option py-1" data-value="lastmonth" href="#">Last Month</a></li>
                                                <li><a class="dropdown-item sort-option py-1" data-value="last12months" href="#">Last 12 Months</a></li>
                                                <li><a class="dropdown-item sort-option py-1 active" href="#" data-value="thismonth">This Month</a></li>
                                                <li><a class="dropdown-item sort-option py-1" href="#" data-value="next3month">Next 3 Months</a></li>
                                                <li><a class="dropdown-item sort-option py-1" href="#" data-value="next6month">Next 6 Months</a></li>
                                                <li><a class="dropdown-item sort-option py-1" href="#" data-value="next12month">Next 12 Months</a></li>
                                                <li><a class="dropdown-item sort-option py-1" href="#" data-value="overall">Overall</a></li>
                                            </ul>
                                        </div>
                                        <canvas id="salesPie" class="mt-3"></canvas>
                                        <div class="chart-label">Family & Sub-Events </div>
                                    </div>
                                </div>
                            </div>
                            <!---------- Corporate Event vs Family Events / Corporate & Sub type of Event / Family & Subtype of Event - END ---------->

                            <!--Overall Bookings Statistics & Lead Source --- START -->
                            <div class="row g-3 py-2">

                                <!-- Overall Bookings Statistics - START -->
                                <div class="col-md-8">
                                    <div class="card">
                                        <!-- Card Header -->
                                        <div class="card-header bg-rating d-flex justify-content-between align-items-center py-2">
                                            <h5 class="mb-0"
                                                data-bs-toggle="tooltip"
                                                data-bs-placement="top"
                                                title="Summary of all booking data.">
                                                Overall Bookings Statistics
                                            </h5>

                                            <!-- Year Dropdown -->
                                            <div class="d-flex align-items-center gap-2">
                                                <label class="fw-semibold mb-0">Year:</label>

                                                <div class="dropdown">
                                                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle"
                                                            type="button"
                                                            id="yearDropdown"
                                                            data-bs-toggle="dropdown"
                                                            aria-expanded="false">
                                                        Select Year
                                                    </button>

                                                    <ul class="dropdown-menu dropdown-menu-end"
                                                        id="yearDropdownMenu"
                                                        aria-labelledby="yearDropdown">
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Card Body -->
                                        <div class="card-body">
                                            <div style="height:400px; position:relative; z-index:2;">
                                                <canvas id="bookingBarChart"></canvas>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <!-- Overall Bookings Statistics - END -->

                                <!-- Lead Source -- START -->
                                <div class="col-md-4">
                                    <div class="card">
                                        <!-- Card Header -->
                                        <div class="card-header bg-rating d-flex justify-content-between align-items-center py-3">
                                            <h5 class="mb-0"
                                                data-bs-toggle="tooltip"
                                                data-bs-placement="top"
                                                title="Lead Source means where your customer enquiry came from — like Walk-In, Social Media, Website, Google Ads, Referral, etc.">
                                                Enquiry Lead Source
                                            </h5>
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="dropdown pie-chart-filter">
                                                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle"
                                                            type="button"
                                                            id="leadSourceFilterBtn"
                                                            data-bs-toggle="dropdown">
                                                        This Month
                                                    </button>
                                                    <ul class="dropdown-menu dropdown-menu-end py-2">
                                                        <li><a class="dropdown-item py-1" href="#" data-value="yesterday">Yesterday</a></li>
                                                        <li><a class="dropdown-item py-1" href="#" data-value="last7days">Last 7 days</a></li>
                                                        <li><a class="dropdown-item py-1" href="#" data-value="last30days">Last 30 days</a></li>
                                                        <li><a class="dropdown-item py-1" href="#" data-value="lastmonth">Last Month</a></li>
                                                        <li><a class="dropdown-item py-1" href="#" data-value="last12months">Last 12 Months</a></li>
                                                        <li><a class="dropdown-item py-1 active" href="#" data-value="thismonth">This Month</a></li>
                                                        <li><a class="dropdown-item py-1" href="#" data-value="next3month">Next 3 Months</a></li>
                                                        <li><a class="dropdown-item py-1" href="#" data-value="next6month">Next 6 Months</a></li>
                                                        <li><a class="dropdown-item py-1" href="#" data-value="next12month">Next 12 Months</a></li>
                                                        <li><a class="dropdown-item py-1" href="#" data-value="overall">Overall</a></li>
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="card-body">
                                            <div class="position-relative chart-scroll-wrapper">
                                                <canvas id="leadSourceChart"></canvas>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <!-- Lead Source -- END -->

                            </div>
                            <!--Overall Bookings Statistics & Lead Source --- END -->

                            <!--Top Revenue Events --- START -->
                            <div class="row g-3 py-2">

                                <!-- Top Revenue List --- START -->
                                <div class="col-md-8">
                                    <div class="card shadow-sm border-0 h-100">

                                        <!-- 🔹 Card Header -->
                                        <div class="card-header bg-rating d-flex justify-content-between align-items-center py-2">
                                            <h5 class="mb-0"
                                                data-bs-toggle="tooltip"
                                                data-bs-placement="top"
                                                title="Shows events that earned the most revenue based on generated invoices.">
                                                Top Revenue Events
                                            </h5>

                                            <div class="dropdown chart-filter-Revenue">
                                                <button class="btn btn-sm btn-outline-secondary dropdown-toggle"
                                                        type="button"
                                                        id="RevenueChartFilter"
                                                        data-bs-toggle="dropdown">
                                                    This Month
                                                </button>

                                                <ul class="dropdown-menu shadow-sm dropdown-menu-end py-2">
                                                    <li><a class="dropdown-item revenuchart-option py-1" href="#" data-value="yesterday">Yesterday</a></li>
                                                    <li><a class="dropdown-item revenuchart-option py-1" href="#" data-value="last7days">Last 7 days</a></li>
                                                    <li><a class="dropdown-item revenuchart-option py-1" href="#" data-value="last30days">Last 30 days</a></li>
                                                    <li><a class="dropdown-item revenuchart-option py-1 active" href="#" data-value="thismonth">This Month</a></li>
                                                    <li><a class="dropdown-item revenuchart-option py-1" href="#" data-value="lastmonth">Last Month</a></li>
                                                    <li><a class="dropdown-item revenuchart-option py-1" href="#" data-value="last12months">Last 12 Months</a></li>
                                                </ul>
                                            </div>
                                        </div>

                                        <!-- 🔹 Card Body -->
                                        <div class="card-body">
                                            <ul class="list-group list-group-flush" id="topRevenueEventsList">
                                                <li class="list-group-item text-muted text-center">
                                                    Loading...
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                                <!-- Top Revenue List --- END -->

                                <!-- Lead Lost Analysis -- START -->
                                <div class="col-md-4">
                                    <div class="card">

                                        <!-- Card Header -->
                                        <div class="card-header bg-rating d-flex justify-content-between align-items-center py-3">
                                            <h5 class="mb-0"
                                                data-bs-toggle="tooltip"
                                                data-bs-placement="top"
                                                title="Lead Lost Analysis shows which event types are losing the most enquiries — helping identify weak conversion areas like Wedding, Corporate, Birthday, etc.">
                                                Lead Lost Analysis
                                            </h5>

                                            <div class="d-flex align-items-center gap-2">
                                                <div class="dropdown pie-chart-filter">
                                                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle"
                                                            type="button"
                                                            id="leadLostFilterBtn"
                                                            data-bs-toggle="dropdown">
                                                        This Month
                                                    </button>

                                                    <ul class="dropdown-menu dropdown-menu-end py-2">
                                                        <li><a class="dropdown-item py-1" href="#" data-value="yesterday">Yesterday</a></li>
                                                        <li><a class="dropdown-item py-1" href="#" data-value="last7days">Last 7 days</a></li>
                                                        <li><a class="dropdown-item py-1" href="#" data-value="last30days">Last 30 days</a></li>
                                                        <li><a class="dropdown-item py-1" href="#" data-value="lastmonth">Last Month</a></li>
                                                        <li><a class="dropdown-item py-1" href="#" data-value="last12months">Last 12 Months</a></li>
                                                        <li><a class="dropdown-item py-1 active" href="#" data-value="thismonth">This Month</a></li>
                                                        <li><a class="dropdown-item py-1" href="#" data-value="next3month">Next 3 Months</a></li>
                                                        <li><a class="dropdown-item py-1" href="#" data-value="next6month">Next 6 Months</a></li>
                                                        <li><a class="dropdown-item py-1" href="#" data-value="next12month">Next 12 Months</a></li>
                                                        <li><a class="dropdown-item py-1" href="#" data-value="overall">Overall</a></li>
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Card Body -->
                                        <div class="card-body">
                                            <div class="position-relative" style="height:300px;">
                                                <canvas id="leadLostChart"></canvas>
                                            </div>
                                        </div>

                                    </div>
                                </div>
                                <!-- Lead Lost Analysis -- END -->
                            </div>
                            <!--Top Revenue Events --- END -->

                            <!---------- Comparative Insights - START ---------->
                            <div class="row g-2 py-2">
                                <div class="position-relative">
                                    <!-- small dropdown -->
                                    <div class="col-md-12">
                                        <div class="card shadow-sm border-0">

                                            <!-- Card Header -->
                                            <div class="card-header bg-rating border-0 py-2">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <h4 class="mb-0"
                                                        data-bs-toggle="tooltip"
                                                        data-bs-placement="top"
                                                        title="Comparison of revenue, expenses, and profit across months.">
                                                    Comparative Insights</h4>
                                                    <div class="dropdown">
                                                        <button class="btn btn-outline-secondary btn-sm dropdown-toggle"
                                                                type="button"
                                                                id="pnlFilterBtn"
                                                                data-bs-toggle="dropdown">
                                                            Last 3 Months
                                                        </button>

                                                        <ul class="dropdown-menu dropdown-menu-end">
                                                            <li><a class="dropdown-item" onclick="loadComparativeInsightsChart('last3months')">Last 3 Months</a></li>
                                                            <li><a class="dropdown-item" onclick="loadComparativeInsightsChart('last4months')">Last 4 Months</a></li>
                                                            <li><a class="dropdown-item" onclick="loadComparativeInsightsChart('last5months')">Last 5 Months</a></li>
                                                            <li><a class="dropdown-item" onclick="loadComparativeInsightsChart('last6months')">Last 6 Months</a></li>
                                                            <li><a class="dropdown-item" onclick="loadComparativeInsightsChart('last12months')">Last 12 Months</a></li>
                                                        </ul>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Card Body -->
                                            <div class="card-body">
                                                <canvas id="pnlCategoryChart" height="90"></canvas>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>
                            <!---------- Comparative Insights - END ---------->

                            <!---------- Smart Insights - START---------->
                            <div class="row py-2">
                                <div class="col-12">

                                    <div class="card">

                                        <!-- Header -->
                                        <div class="card-header bg-rating d-flex justify-content-between align-items-center py-2">

                                            <h5 class="mb-0"
                                                data-bs-toggle="tooltip"
                                                data-bs-placement="top"
                                                title="AI-powered insights showing booking trends and revenue performance.">
                                                <i class="fa-solid fa-lightbulb text-warning me-2"></i>
                                                Smart Insights
                                            </h5>

                                            <div class="d-flex align-items-center gap-2">

                                                <label class="fw-semibold mb-0">Year:</label>

                                                <div class="dropdown">
                                                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle"
                                                            type="button"
                                                            id="insightYearBtn"
                                                            data-bs-toggle="dropdown">
                                                        Select Year
                                                    </button>

                                                    <ul class="dropdown-menu dropdown-menu-end"
                                                        id="ddlInsightYear">
                                                    </ul>
                                                </div>

                                            </div>

                                        </div>

                                        <!-- Body -->
                                        <div class="card-body">

                                            <div class="row g-3">

                                                <!-- Peak Booking -->
                                                <div class="col-xl-3 col-md-6">

                                                    <div class="insight-card insight-success">

                                                        <div class="insight-header">

                                                            <span>
                                                                <i class="fa-solid fa-arrow-trend-up me-2"></i>
                                                                Peak Booking
                                                            </span>

                                                        </div>

                                                        <div id="peakBookingList"></div>

                                                    </div>

                                                </div>

                                                <!-- Low Booking -->
                                                <div class="col-xl-3 col-md-6">

                                                    <div class="insight-card insight-danger">

                                                        <div class="insight-header">

                                                            <span>
                                                                <i class="fa-solid fa-arrow-trend-down me-2"></i>
                                                                Low Booking
                                                            </span>

                                                        </div>

                                                        <div id="lowBookingList"></div>

                                                    </div>

                                                </div>

                                                <!-- Highest Revenue -->
                                                <div class="col-xl-3 col-md-6">

                                                    <div class="insight-card insight-primary">

                                                        <div class="insight-header">

                                                            <span>
                                                                <i class="fa-solid fa-indian-rupee-sign me-2"></i>
                                                                Highest Revenue
                                                            </span>

                                                        </div>

                                                        <div id="highRevenueList"></div>

                                                    </div>

                                                </div>

                                                <!-- Lowest Revenue -->
                                                <div class="col-xl-3 col-md-6">

                                                    <div class="insight-card insight-warning">

                                                        <div class="insight-header">

                                                            <span>
                                                                <i class="fa-solid fa-coins me-2"></i>
                                                                Lowest Revenue
                                                            </span>

                                                        </div>

                                                        <div id="lowRevenueList"></div>

                                                    </div>

                                                </div>

                                            </div>

                                        </div>

                                    </div>

                                </div>
                            </div>
                            <!---------- Smart Insights - END ---------->

                            <!---------- Hall Occupancy - START ---------->
                            <div class="row py-2">
                                <div class="col-5">

                                    <div class="card">

                                        <div class="card-header bg-rating d-flex justify-content-between align-items-center py-2">

                                            <h5 class="mb-0"
                                                data-bs-toggle="tooltip"
                                                title="Monthly hall occupancy based on booked slots vs available slots.">
                                                <i class="fa-solid fa-chart-column me-2 text-primary"></i>
                                                Hall Occupancy Rate
                                            </h5>

                                            <div class="d-flex align-items-center gap-2">

                                                <span class="fw-semibold">Month:</span>

                                                <input type="month"
                                                       class="form-control form-control-sm"
                                                       id="txtOccupancyMonth"
                                                       style="width:170px;" />

                                            </div>

                                        </div>

                                        <div class="card-body">

                                            <div class="mb-3 text-end">
                                                <span class="badge bg-primary fs-7">
                                                    Overall Occupancy :
                                                    <span id="lblOverallOccupancy">0%</span>
                                                </span>
                                            </div>

                                            <div id="hallOccupancyContainer"></div>

                                        </div>

                                    </div>

                                </div>
                            </div>
                            <!---------- Hall Occupancy - END ---------->



                        </div>
                    </div>
                </div>
            </div>

            <!-- Dynamic Widgets -->
            <div class="row g-3"></div>
        </div>
    </div>
</div>

