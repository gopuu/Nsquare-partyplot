@{
    ViewData["Title"] = "Report Cashflow";
    Layout = "_Layout";
}

<div class="content">
    <div class="pb-1">
        <div class="card shadow-sm">
            <!-- CARD HEADER -->
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="mb-0 fw-semibold">
                    Cashflow Report
                </h3>
                <button class="btn btn-danger"
                        onclick="ViewCashflowReport('downloadPDF')">
                    <i class="fas fa-download"></i>

                </button>
            </div>
            <div class="card-body pt-2">
                <!-- PDF Preview Container -->
                <div id="pdfPreviewContainer" style="border: 1px solid #ddd; padding: 10px; width: 100%; min-height: 600px; height: calc(100vh - 100px); overflow: auto;">
                    <p style="text-align: center; color: gray;">PDF Preview will appear here...</p>
                </div>

                <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
                <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="~/assets2/js/report_cashflow/report_cashflow.js" asp-append-version="true"></script>

}
